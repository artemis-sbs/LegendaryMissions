# Station KINDS - Command, Industrial, Science and Civil bases for every race.
# The table, the hull rule and the spawner are station_kinds.py; the scaled hulls are
# media/stations/extraShipData_station_kinds.yaml (generated by make_station_kinds.py).
provides station_kinds
import station_kinds.py

# TOP LEVEL, and it has to be: the engine reads extra ship data inside create_new_sim(),
# so a declaration inside a label is too late (turrets/__init__.mast says why at length).
# With EXTRA_SHIP_DATA off this declares nothing and every kind spawns the race's plain
# starbase - never a hull the engine was not given.
station_kinds_declare_ships()
