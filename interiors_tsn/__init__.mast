# Ship interiors, migrated from data/grid_data.json.
#
# One ASCII floor plan per hull - see sbs_utils/GRID_ASCII_FORMAT.md. The hull
# outline in each file is the ENGINE's own is_grid_point_open, captured by the
# LM_TestRange 'PROBE hull map' map, so a room cannot sit outside the hull.
#
# Regenerate rather than hand-editing the outline; rooms are yours to move.
provides interiors_tsn

grid_merge_ascii(media_read_relative_file("tsn_battle_cruiser.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_battleship.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_bomber.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_carrier.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_destroyer.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_dreadnought.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_escort.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_fighter.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_heavy_cruiser.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_juggernaut.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_light_carrier.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_light_cruiser.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_mine_layer.grid"), "interiors_tsn")
grid_merge_ascii(media_read_relative_file("tsn_missile_cruiser.grid"), "interiors_tsn")
