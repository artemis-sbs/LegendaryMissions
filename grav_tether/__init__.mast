provides grav_tether

# ...and again at RUNTIME, for an addon that only WANTS the tether. `provides` is
# compile-time only, so a soft dependant has nothing to test; this shared flag is
# what it tests. Order-safe: whichever of the two top levels runs first, the other
# is a `default shared` and leaves this True.
shared LM_HAS_TETHER = True

# The fighter one-button interaction (lm_tether_press) lives here, and the hangar's
# cockpit console calls it - so this addon has to announce itself.
import tether_mass.py
import tether_fighter.py
import tether_salvage.py
import tether_growth.py
import tether_brains.mast
import grav_tether.mast

# TOP LEVEL: installs LM's mass table and switches the constraints layer on. Without it
# the library's rules are inert (everything weighs the same), which is the right default
# for a library and the wrong one for a game.
lm_tether_load_masses()

# Watch tethered hulks for arrival at a friendly station. Towing pays only if towing
# somewhere pays; without this a derelict is scenery.
lm_tether_salvage_start()
