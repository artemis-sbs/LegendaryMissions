#
# Loads the hangar sortie quests once (parsed AMD tree, shared) so the hangar
# quest board and assignment can read them. See hangar_quests.amd.
#
shared HANGAR_QUEST_DOC = document_get_amd_file(None, "Hangar", content=media_read_relative_file("hangar_quests.amd"))

# The board is an OFFER source now, so a sortie is reachable from any console's PADD -
# and from the cockpit - rather than only from the flight deck's own screen. The panel
# there has become a pointer; this is where the work actually lives.
hangar_offers_register()
