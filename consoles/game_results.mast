#
# Game Data
#

shared game_stats = ~~{
    "tsn_destroyed": 0,
    "kralien_ships_destroyed": 0,
    "skaraan_ships_destroyed": 0,
    "arvonian_ships_destroyed": 0,
    "torgoth_ships_destroyed": 0,
    "ximni_ships_destroyed": 0,
    "ships_surrender": 0,
    "start_time": sim.time_tick_counter
}~~


//damage/killed if not has_role(DAMAGE_SELECTED_ID, "standby")
    #
    # A ship killed by damage. This is the KILLED route, not the DESTROY route:
    # killed fires "about to be removed" - the victim is still registered (its
    # side/hull read cleanly for the tally + tonnage) and the attacker rides the
    # damage event (DAMAGE_PARENT/SOURCE). The DESTROY route is a lifetime REMOVAL
    # event: it also fires for script deletes (e.g. unused player slots, which is
    # why it used to over-count) and the victim can already be gone (to_object ->
    # None -> tonnage 0). The victim here is DAMAGE_SELECTED_ID.
    #
    obj = to_object(DAMAGE_SELECTED_ID)
    if obj is not None:
        side = "{obj.side.lower()}_destroyed"
        count = game_stats.get(side, 0)
        game_stats[side] = count + 1

        race = obj.art_id
        under = race.find("_")
        if under>=0:
            race = race[0:under]
            if race=="xim":
                race= "ximni"

            race = "{race.lower()}_ships_destroyed"
            count = game_stats.get(race, 0)
            game_stats[race] = count + 1

    # Credit the kill + the victim's tonnage to the player BRIDGE ship that landed
    # the final blow. (Fighter/shuttle kills are credited by the hangar addon, so a
    # console-less mission still tracks pilots and the two never double-count.)
    # //damage/killed always carries the attacker in DAMAGE_PARENT/SOURCE.
    results_credit_kill(DAMAGE_PARENT_ID, DAMAGE_SOURCE_ID, DAMAGE_SELECTED_ID)
    ->END


# Option-B "impact" stat: accumulate raw damage dealt per player BRIDGE ship.
# Filtered to player attackers so the per-hit body stays cheap, and gated by
# TRACK_DAMAGE so a host on weak hardware can switch it off. (//damage/object is
# already routed by other addons, so this adds a handler, not new per-frame
# dispatch.)
//damage/object if SETTINGS.get("TRACK_DAMAGE", True) and (has_role(DAMAGE_PARENT_ID, "__player__") or has_role(DAMAGE_SOURCE_ID, "__player__"))
    results_credit_damage(DAMAGE_PARENT_ID, DAMAGE_SOURCE_ID, EVENT.sub_float)
    ->END


//signal/show_game_results


    sim_pause()

    GAME_ENDED = True
    START_TEXT = START_TEXT.strip()
    if START_TEXT == "":
        START_TEXT = "Game Over"
    # This route is MEANT to run per console - every console shows the end-of-game
    # results screen, which is what gui_task_jump below does. The save is scheduled per
    # console too, but save_game_results_yaml opens with `default shared RESULTS_SAVED`
    # and returns immediately once set, so the file is written once however many consoles
    # fire it. The ticker rule cannot see a guard inside the task it points at.
    # lint: allow signal-side-effect-ticker
    task_schedule(save_game_results_yaml)
    gui_task_jump(show_game_results_gui)


=== show_game_results_gui

    # Tabbed results: a lean Summary lands first (same for every console); Fleet,
    # Air Wing, Quests and the per-race Enemies breakdown are one click away. The
    # selected tab is held in RESULTS_TAB (default keeps it across the re-jump each
    # tab button does).
    default RESULTS_TAB = "summary"

    mission = get_mission_name()
    start_mission = get_startup_mission_name()
    if start_mission is not None:
        same = mission == start_mission
    if start_mission is None or start_mission=="":
        same = True
        start_mission = mission
    show_replay = IS_SERVER or CONSOLE_SELECT == "operator" or CONSOLE_SELECT == "gamemaster"

    end_time = int((sim.time_tick_counter - game_stats["start_time"]) / 30  /60)
    totals = results_summary()

    # Tab strip (key, label) for this screen.
    results_tabs = [["summary","Summary"], ["fleet","Fleet"], ["airwing","Air Wing"], ["quests","Quests"], ["enemies","Enemies"]]

    # Top tab strip (styled like the console top tabs).
    #
    # These are IN-PAGE tabs - each one re-jumps this same label with a different
    # RESULTS_TAB - so they are NOT //gui/tab routes, which would add them to every
    # console's top bar instead.
    #
    # Built with data={} + on_press= rather than a loop-registered `on gui_message`:
    # a handler registered inside a `for` loop is flaky and an inline block captures
    # the loop variable at its LAST value. This replaces a call to `gui_screen_tabs`,
    # a helper that does not exist anywhere in sbs_utils or LegendaryMissions - it
    # raised NameError on TAB_KEY (see results_set_tab), which killed the results
    # page's GUI task and left the replay button with no main GUI task to return to.
    gui_section(style="area: 28, 0, 99, 5;")
    gui_row("row-height:35px;")
    for _tab_key, _tab_label in results_tabs:
        if _tab_key == RESULTS_TAB:
            _tab_style = f"$text:{_tab_label};justify:center;color:white;"
        else:
            _tab_style = f"$text:{_tab_label};justify:center;color:#8aa;"
        gui_button(_tab_style, data={"results_tab_key": _tab_key}, on_press="results_set_tab")

    # LEFT RAIL: what happened. RIGHT: the numbers.
    #
    # This used to be a centered title band across the top with the stats below it, and
    # the stats were one gui_row each with no height - so six of them shared three
    # quarters of the screen and sat a hand's width apart, with a longer list running off
    # the bottom unreachable. Splitting identity from data gives the tables somewhere to
    # be dense, and gives a long outcome line somewhere to wrap.
    #
    # The three identity rows are sized in EMS, not `content`. A `"""..."""` row is a
    # TEXT AREA, and a text area is deliberately unmeasurable (it scrolls its own
    # overflow, so it never asks the row to grow - see TextArea.measure). `content` on
    # one therefore resolves to nothing and falls back to FLEX, so all three took an
    # equal share of the rail alongside the outcome below: four rows of 22%, the
    # mission name and the run time floating a hand's width apart, and the outcome
    # squeezed into the bottom quarter. An em is one line of the row's own font, so
    # the identity block now costs 115px of a 1300px rail and the rest is the outcome.
    #
    # The `font:` on each ROW is load-bearing: em arithmetic uses the ROW's font, so
    # without it the title would reserve lines of the default font (gui-2) while
    # drawing in gui-5, and come up short.
    #
    gui_section(style="area: 2, 6, 26, 94;")
    gui_row("row-height: 1.6em; font: gui-5;")
    """color:white;justify:left;font: gui-5;$text:Game results"""
    gui_row("row-height: 1.3em; font: gui-1;")
    """color:#8aa;justify:left;font:gui-1;$text:{mission}"""
    gui_row("row-height: 1.3em; font: gui-1;")
    """color:#8aa;justify:left;font:gui-1;$text:{end_time} minutes"""
    # A TEXT AREA, not a text row: the outcome is written by the mission and can be a
    # sentence. In a rail a quarter of the screen wide a plain text widget would overrun
    # its rect - the engine does not clip - and paint straight over the tab content.
    #
    # START_TEXT is passed as a VARIABLE, not interpolated into a literal: a `{` in it
    # would otherwise be re-run as an f-string, and this is mission-authored text.
    gui_row("row-height: 1fr;")
    gui_text_area(START_TEXT, style="color:cyan;padding:0,8px,0,0;")

    # Credits earned this mission (opt-in): a mission captures CREDITS_START + CREDIT_SIDE_IDS
    # at start; missions that don't leave CREDITS_START None and the row stays hidden. Credits
    # bank per side, so summing the captured side ids is robust even if ships were lost.
    default CREDITS_START = None
    default CREDIT_SIDE_IDS = []
    credits_earned = None
    if CREDITS_START is not None:
        _ccn = 0
        for _s in CREDIT_SIDE_IDS:
            _ccn = _ccn + get_inventory_value(_s, "credits", 0)
        credits_earned = _ccn - CREDITS_START

    # Multiplayer standings (opt-in): the top per-ship earner (pt_earned), shown if any ship
    # has earned. Missions that don't track pt_earned simply have no earners -> row hidden.
    mp_top_name = ""
    mp_top = 0
    mp_any = False
    for _mp in to_object_list(role("__player__")):
        _e = get_inventory_value(_mp.id, "pt_earned", 0) or 0
        if _e > 0:
            mp_any = True
        if _e > mp_top:
            mp_top = _e
            mp_top_name = _mp.name

    # Active tab content - right of the rail, and top-aligned under the tabs.
    gui_section(style="area: 28, 6, 99, 94;")

    if RESULTS_TAB == "summary":
        # One widget, one string. `credits_earned` None and an empty `mp_top_name` hide
        # their rows, which is the same opt-in the row-per-stat version had.
        gui_text_area(results_summary_md(DIFFICULTY, game_stats["ships_surrender"], end_time, credits_earned, mp_top_name, mp_top), style="padding:10px,15px,10px,15px;")

    if RESULTS_TAB == "fleet":
        fleet_box = gui_list_box(results_ship_items(), "padding:0,0,10px,0;", item_template=results_ship_template, title_template=results_ship_title_template, select=False)

    if RESULTS_TAB == "airwing":
        wing_items = results_pilot_items()
        if len(wing_items)==0:
            gui_row()
            """color:yellow;justify: center;$text:No sorties were flown."""
        else:
            wing_box = gui_list_box(wing_items, "padding:0,0,10px,0;", item_template=results_pilot_template, title_template=results_pilot_title_template, select=False)

    if RESULTS_TAB == "quests":
        quest_items = results_quest_items()
        if len(quest_items)==0:
            gui_row()
            """color:yellow;justify: center;$text:No quests."""
        else:
            # Match the in-game quest log: collapsible Game/ship sections on the
            # left, the selected quest's description on the right.
            q_sel_desc = "Select a quest to see its details."
            gui_section(style="area: 28, 6, 62, 94;")
            quest_box = gui_list_box(quest_items, "item-gap:0.1em;", item_template=quest_log_template, title_template=quest_log_title, select=True, collapsible=True)
            gui_section(style="area: 64, 6, 99, 94; background:#1572;")
            q_desc = gui_text_area("{q_sel_desc}", style="padding:10px,15px,10px,15px;")
            on change quest_box.get_value():
                qsel = quest_box.get_value()
                if qsel is not None and not gui_list_box_is_header(qsel):
                    q_sel_desc = qsel.get("desc")
                    q_desc.value = q_sel_desc
                elif qsel is not None:
                    # Selecting an ARC shows its description + step checklist here too -
                    # same renderer as the in-game tab, so both logs read alike.
                    q_sel_desc = quest_log_parent_summary(qsel)
                    if q_sel_desc == "":
                        q_sel_desc = "Select a quest to see its details."
                    q_desc.value = q_sel_desc

    if RESULTS_TAB == "enemies":
        # Races with no kills are omitted rather than listed as zero - and a mod's own
        # races are picked up from the stats dict, which the fixed six-race list could
        # never show. See results_enemies_md.
        gui_text_area(results_enemies_md(game_stats), style="padding:10px,15px,10px,15px;")

    await gui():
        + "replay" if show_replay:
            sbs.run_next_mission(mission)
        + "run startup" if not same:
            sbs.run_next_mission(start_mission)

    # Kind of need to restart, which is good for now since cleanup is not guaranteed


=== results_set_tab
    # A results tab was clicked. The key arrives as task data from the button's
    # data={} dict (see the strip in show_game_results_gui) - it used to come from
    # a TAB_KEY global that nothing ever defined.
    #
    # The `default` is load-bearing, and copying the button call without it is what
    # kept this label raising NameError: this runs as its own task, so if the data
    # dict does not seed the scope the bare name is simply undefined. `default` sets
    # it only when it is missing, so passed-in data still wins. Same guard the casino
    # market handler uses (`default mkey = ""`). A literal fallback, not RESULTS_TAB -
    # that is task-scoped to show_game_results_gui and is not defined here either.
    default results_tab_key = "summary"
    RESULTS_TAB = results_tab_key
    jump show_game_results_gui


=== save_game_results_yaml
    #
    # Append this game's outcome + stats to a YAML file (one record per completed
    # game) in the Artemis data dir. Useful for soak / overnight runs - the record
    # count is the number of games played - and for reviewing balance over time.
    # Runs in its own task and is best-effort, so a write error never blocks the
    # results screen. Guarded by a shared flag so a double-emitted signal saves once
    # (the flag resets naturally when run_next_mission reloads shared state).
    #
    default shared RESULTS_SAVED = False
    ->END if RESULTS_SAVED
    RESULTS_SAVED = True

    # Keep only the most recent games so the file stays small and quick to open.
    # Records now carry the dense per-ship / per-pilot / quest breakdown (more than
    # the GUI shows), so each is a few KiB and scales with crew/quest count - lower
    # this if the file gets large.
    default shared GAME_RESULTS_MAX = 200

    results_file = get_missions_dir() + "/game_results.yaml"
    results = load_yaml_data(results_file)
    if results is None or not isinstance(results, list):
        results = []

    end_ticks = sim.time_tick_counter - game_stats.get("start_time", sim.time_tick_counter)
    # Timestamp comes from a python helper (results_helpers.py): datetime's strftime
    # can't run inside MAST's restricted-builtins eval, but a module function can.
    stamp = game_results_timestamp()
    default WORLD_SELECT = None
    map_name = game_results_map(WORLD_SELECT)
    # Dense breakdown (per-ship / per-pilot / quest) the GUI omits - kept in the save.
    extra = results_record_extra()
    record = ~~{
        "time": stamp,
        "mission": get_mission_name(),
        "map": map_name,
        "outcome": START_TEXT,
        "difficulty": DIFFICULTY,
        "game_minutes": int(end_ticks / 30 / 60),
        # drop start_time (an internal sim-tick marker, not a stat; game_minutes covers duration)
        "stats": {k: v for k, v in game_stats.items() if k != "start_time"},
        "summary": extra["summary"],
        "ships": extra["ships"],
        "pilots": extra["pilots"],
        "quests": extra["quests"],
    }~~
    results.append(record)
    if len(results) > GAME_RESULTS_MAX:
        results = results[-GAME_RESULTS_MAX:]
    save_yaml_data(results_file, results)
    log(f"game results saved ({len(results)} games) -> {results_file}", "game_results")
    ->END

//signal/show_game_results if SETTINGS.get("AUTO_START")
    # Wall-clock delay (delay_app, not delay_sim): the sim is paused at game end,
    # so sim time is frozen and delay_sim would never fire.
    await delay_app(SETTINGS.get("AUTO_START_DELAY", 10))
    mission = get_mission_name()
    sbs.run_next_mission(mission)
