shared COMMS_PROTOTYPE  = SETTINGS.get("COMMS_PROTOTYPE", False)

#=== layout_comms_engine_widgets
//gui/normal_comm

    jump mike_comms if COMMS_PROTOTYPE

    
    # Left
    gui_section(style="area:0,45px,100,100;")
    
    default tab = 1
    # Top Left
    
    with gui_sub_section("col-width:280px;"):
        gui_row("row-height: 400px-3em;")
        #gui_layout_widget("ship_data")
        gui_info_panel(tab=tab)
        gui_info_panel_add("message", 83, gui_panel_console_message,None, gui_panel_console_message_tick)
        # The log/replay tab: every card ever filed, re-readable. Cards only take
        # over the "message" tab when they interrupt (a button, or notify=True).
        gui_info_panel_add("messages", 84, gui_panel_console_message_list, None)
        # The ship's LOG - the text waterfall's replacement (LOG_PANEL_PLAN.md), mounted
        # first on comms because it carries the most traffic. The waterfall is deliberately
        # still shown in the middle column: comms_broadcast writes BOTH surfaces during the
        # changeover, so the two can be read side by side before anything is retired.
        gui_info_panel_add("log", 112, gui_panel_log, None, gui_panel_log_tick)
        # Same store, filtered: Ship is the crew's own news (damage, systems,
        # docking), Mission is objective and quest beats. Anything untagged still
        # shows in Log, which is everything - so a subset tab can never hide a message.
        gui_info_panel_add("ship", 66, gui_panel_log_ship, None, gui_panel_log_tick)
        gui_info_panel_add("mission", 85, gui_panel_log_mission, None, gui_panel_log_tick)
        # Every incoming hail this ship has had, re-readable. Selecting one replays
        # it - strictly READ-ONLY: a replay cannot change or undo a choice already
        # made, which hail_answer enforces rather than the layout.
        gui_info_panel_add("hails", hail_panel_icon(), hail_panel_history, None)

        # The space the text waterfall used to occupy, directly under ship data on every
        # console so the crew always looks in ONE place for the latest line. The waterfall
        # was declared by gui_console and could not be styled from script; this is the same
        # traffic in a text area the console owns. The history is the log tab. LOG_PANEL_PLAN.md
        #
        # The strip comes OUT of the panel's height (the `400px-Nem` row above), not
        # below it: the waterfall used to be the bottom few lines of that same block,
        # with ship data shrunk to suit. Appending a row instead pushed the strip a whole
        # strip-height further down - below where the waterfall was, and off the bottom of
        # the half-screen section Engineering gives this column.
        gui_row("row-height: 4em;")
        gui_log_tail()
        # if is_dev_build():
        #     gui_info_panel_add("upgrades", 105, gui_panel_upgrade_list,None)
        #     gui_info_panel_add("objective", 85, gui_panel_console_message,None)
        #     gui_info_panel_add("objectives", 86, gui_panel_console_message_list,None)

        gui_row()
        gui_blank()

        # NOT sbs.get_ship_of_client: while an orbit hail runs, this console is
        # ASSIGNED to the hailer, so the engine would answer with the raider.
        _hail_ship = viewscreen_home_ship(client_id)

        # Where an incoming hail shows for THIS console: Off / This Console /
        # Main Screen / Both. Above the list, because it is a standing setting and the
        # list underneath it is what changes.
        gui_row("row-height: 40px;margin:0,0,0,10px;")
        hail_where_dropdown(client_id, "col-width:150px;")
        # Ticked means SOUND. It is the ship's setting, not this console's, because the
        # audio plays once for the whole bridge.
        hail_audio_checkbox(client_id, "col-width:90px;")

        # "Incoming Hails" - the waiting hails, or the open conversation's replies. One
        # call, and the library owns which of its three states applies. A listbox, so a
        # queue longer than the space still scrolls rather than being dropped.
        hail_choice_strip(_hail_ship, client_id)


    _comms_text_height = "30"
    # Middle
    with gui_sub_section():
        gui_row(f"row-height:{_comms_text_height};")
        gui_layout_widget("comms_waterfall")
        # The zoom control belongs to the view it zooms: a 45px band directly above it,
        # spanning the same width, which is what the cockpit does (hangar.mast). It used
        # to sit in an absolute box of its own with no relationship to the view at all.
        # 45px because the control is small and fixed - it does not want stretching.
        gui_row("row-height:45px;")
        gui_layout_widget("radar_zoom_ctrl")
        gui_row()
        # A hail placed on THIS console takes the radar's space. gui_widget_offscreen
        # is the only reliable way to be rid of an engine widget - gui_hide does not
        # work on them.
        if hail_shows_here(client_id):
            gui_widget_offscreen("comms_2d_view", client_id)
            hail_view(_hail_ship, client_id)
        else:
            gui_layout_widget("comms_2d_view")
        
    # Right
    ss = gui_screen_size(client_id)

    default select_2d = False
    _widget = "comms_2d_view"
    #if select_2d:
    #    _widget = "comms_2d_view"
    with gui_sub_section("col-width:25;"):

        # Put this next to the waterfall, same height
        gui_row(f"row-height:{_comms_text_height};")
        gui_layout_widget("comms_control")
        gui_row("row-height:100px;")
        gui_layout_widget("comms_face")

        gui_row("row-height:15;")
        gui_property_list_box("Options")




        # gui_screen_size returns a 1024x768 PLACEHOLDER (z==99) until the client
        # reports its size, which read as a small screen and cramped wide displays.
        # When unknown, assume the LARGER layout - it degrades better.
        if gui_screen_size_known(client_id) and ss.x < 1600:
            gui_row("row-height: 35px;col-width:25px;")
        else:
            gui_row("row-height: 35px;col-width:45px;")


        gui_row("row-height:20px;")
        gui_blank()
        gui_row() #"padding:0,25px,10px,0")
        gui_layout_widget("comms_sorted_list")

        # Follow and RED ALERT ride here, under the contact list, rather than in the
        # left column: that column already carries a 400px info panel and a log tail,
        # and the incoming-hail answer strip needs the room. One row, one height, so
        # they read as a single control bar.
        gui_row("row-height: 40px;")
        follow_tag = get_inventory_value(client_id, "2d_follow", True)
        # Set back in case of default
        set_inventory_value(client_id, "2d_follow", follow_tag)
        gui_layout_widget("red_alert")
        gui_checkbox("Follow", var="follow_tag")
        
        on change follow_tag:
            ship = viewscreen_home_ship(client_id)
            _sel = get_comms_selection(ship)
            set_inventory_value(client_id, "2d_follow", follow_tag)
            comms_set_2dview_focus(client_id, _sel)
        
        
    


    yield idle



//gui/normal_sci
    ss = gui_screen_size(client_id)
    # Ship Data overlap
    gui_section(style="area:0,45px,100,100;")
    
    default tab = 1
    gui_row("row-height: 400px-3em;col-width:280px;")
    gui_info_panel(tab=tab)
    gui_info_panel_add("message", 83, gui_panel_console_message,None, gui_panel_console_message_tick)
    # The log/replay tab: every card ever filed, re-readable. Cards only take
    # over the "message" tab when they interrupt (a button, or notify=True).
    gui_info_panel_add("messages", 84, gui_panel_console_message_list, None)
    # The ship's log (LOG_PANEL_PLAN.md). Same store on every console - it is the CREW's
    # log - so what one console sees, all of them see.
    gui_info_panel_add("log", 112, gui_panel_log, None, gui_panel_log_tick)
    gui_info_panel_add("ship", 66, gui_panel_log_ship, None, gui_panel_log_tick)
    gui_info_panel_add("mission", 85, gui_panel_log_mission, None, gui_panel_log_tick)

    # The space the text waterfall used to occupy, directly under ship data on every
    # console so the crew always looks in ONE place for the latest line. The waterfall
    # was declared by gui_console and could not be styled from script; this is the same
    # traffic in a text area the console owns. The history is the log tab. LOG_PANEL_PLAN.md
    #
    # The strip comes OUT of the panel's height (the `400px-Nem` row above), not
    # below it: the waterfall used to be the bottom few lines of that same block,
    # with ship data shrunk to suit. Appending a row instead pushed the strip a whole
    # strip-height further down - below where the waterfall was, and off the bottom of
    # the half-screen section Engineering gives this column.
    gui_row("row-height: 4em;col-width:280px;")
    gui_log_tail()

    gui_section(style="area:0,45px,100,100;")
    with gui_sub_section():
        # Same band above the view as comms and the cockpit.
        gui_row("row-height:45px;")
        gui_blank(1,"col-width:280px")
        gui_layout_widget("radar_zoom_ctrl")
        gui_row()
        gui_layout_widget("science_2d_view")

    # Right
    with gui_sub_section("col-width:30;"):
        gui_row("row-height:70px;")
        gui_layout_widget("science_data_tabs")
        gui_row("row-height:40px;")
        gui_layout_widget("science_data_freq")
        gui_row("row-height:200px;")
        gui_layout_widget("science_data")
        gui_row("row-height: 35px;")
        default follow_tag = False
        gui_checkbox("Follow","col-width:90px;", var="follow_tag")
        # "On screen" - science hands the MAIN SCREEN a shot of whatever it has
        # selected, which is the console that already has the thing selected. Same
        # grammar as Follow, one row over. The item list comes from the library so the
        # labels here and the mode names there cannot drift. VIEWSCREEN_PLAN.md
        # NO `var=` AND NO `default`. The label is a pure function of the SHIP,
        # recomputed on every build, so the dial cannot show a shot that is not
        # running - the Director's rundown drop-downs are built the same way.
        #
        # `default on_screen = ...` was the trap: `default` skips when the name
        # already resolves, and a route sub-task's variables live on the client's GUI
        # TASK, not the sub-task - so after one pick the dial kept reading
        # "On Screen - Orbit" through every later rebuild, through a console change,
        # and after helm had taken the screen away. Then one touch of a lying dial
        # re-applied a shot nobody asked for.
        _sci_ship = viewscreen_home_ship(client_id)
        _sci_owner = viewscreen_owner_token("science", client_id)
        # OURS or "Off". The dial is this console's control, not a status light for
        # the ship: reading "On Screen - Orbit" because WEAPONS put something up
        # invites science to think they are driving, and picking Off on it would be
        # refused - so it would be advertising an action it cannot take.
        on_screen_dd = gui_drop_down(
            viewscreen_shot_props(viewscreen_dial_label(_sci_ship, _sci_owner)))
        on gui_message(on_screen_dd):
            _ship = viewscreen_home_ship(client_id)
            # NAMED, so the screen knows who is driving it. Two consoles can reach for
            # the same main screen and the last one wins - the token is what lets this
            # console tell "still mine" from "weapons took it", instead of assuming.
            _owner = viewscreen_owner_token("science", client_id)
            # The widget's own value, set from the event before this block runs - not
            # a task variable that outlives the widget.
            viewscreen_set(_ship, viewscreen_mode_for(on_screen_dd.value), get_science_selection(_ship), owner=_owner)

        # The dial must not lie. Somebody else taking the screen - weapons, an incoming
        # hail, a cutscene, helm's own control - has to move it back. `on change`, not
        # `on signal`: a GUI task sitting in await gui() does not repaint because a
        # signal fired, which is the same reason hail_console_revision is polled.
        on change viewscreen_revision(client_id):
            on_screen_dd.value = viewscreen_dial_label(
                viewscreen_home_ship(client_id),
                viewscreen_owner_token("science", client_id))
        # gui_screen_size returns a 1024x768 PLACEHOLDER (z==99) until the client
        # reports its size, which read as a small screen and cramped wide displays.
        # When unknown, assume the LARGER layout - it degrades better.
        if gui_screen_size_known(client_id) and ss.x < 1600:
            gui_row("row-height: 35px;col-width:25px;")
        else:
            gui_row("row-height: 35px;col-width:45px;")
        
        
        gui_row("row-height:20px;")
        gui_blank()
        gui_row()
        gui_layout_widget("science_sorted_list")

    on change follow_tag:
        ship = viewscreen_home_ship(client_id)
        _sel = get_science_selection(ship)
        set_inventory_value(client_id, "2d_follow", follow_tag)
        science_set_2dview_focus(client_id, _sel)
        
    yield idle

//focus/science if not has_role(SCIENCE_SELECTED_ID, 'admiral')
    ->END if SCIENCE_SELECTED is None
    #
    #
    # Something else selected get out of give orders
    #
    nav_focus_id = EVENT.client_id
    science_set_2dview_focus(EVENT.client_id, EVENT.selected_id)
    # If this console is driving the main screen, the shot follows the selection - the
    # crew picked a new contact, they did not ask to go back to a black screen.
    _vs_ship = viewscreen_home_ship(EVENT.client_id)
    # ONLY IF THE SHOT IS OURS. `viewscreen_is_live` asks whether ANYBODY is driving
    # the screen, so re-pointing on that used to yank a contact weapons had put up
    # the moment science happened to select something else - weapons kept a private
    # token to protect itself and science had none, so science always won the race.
    _vs_owner = viewscreen_owner_token("science", EVENT.client_id)
    if viewscreen_owns(_vs_ship, _vs_owner):
        viewscreen_set(_vs_ship, viewscreen_mode(_vs_ship), EVENT.selected_id, owner=_vs_owner)


//gui/normal_engi
    default tab = 1
    # Ship Data, 
    gui_section(style="area:0,45px,min(55,900px),50-50px;")
    with gui_sub_section("col-width:280px;"):
        gui_row("row-height: 400px-3em;")
        gui_info_panel(tab=tab)
        gui_info_panel_add("message", 83, gui_panel_console_message,None, gui_panel_console_message_tick)
        # The log/replay tab: every card ever filed, re-readable. Cards only take
        # over the "message" tab when they interrupt (a button, or notify=True).
        gui_info_panel_add("messages", 84, gui_panel_console_message_list, None)
        # The ship's log (LOG_PANEL_PLAN.md). Same store on every console - it is the
        # CREW's log - so what one console sees, all of them see.
        gui_info_panel_add("log", 112, gui_panel_log, None, gui_panel_log_tick)
        gui_info_panel_add("ship", 66, gui_panel_log_ship, None, gui_panel_log_tick)
        gui_info_panel_add("mission", 85, gui_panel_log_mission, None, gui_panel_log_tick)
        # The space the text waterfall used to occupy, directly under ship data on every
        # console so the crew always looks in ONE place for the latest line. The waterfall
        # was declared by gui_console and could not be styled from script; this is the same
        # traffic in a text area the console owns. The history is the log tab. LOG_PANEL_PLAN.md
        #
        # The strip comes OUT of the panel's height (the `400px-Nem` row above), not
        # below it: the waterfall used to be the bottom few lines of that same block,
        # with ship data shrunk to suit. Appending a row instead pushed the strip a whole
        # strip-height further down - below where the waterfall was, and off the bottom of
        # the half-screen section Engineering gives this column.
        gui_row("row-height: 4em;")
        gui_log_tail()
    with gui_sub_section():
        gui_row()
        # gui_section(style="area:285px,90px,800px,390px;")
        gui_layout_widget("eng_heat_controls")

    gui_section(style="area:0,50+50px,min(55,900px),100;")
    
    gui_layout_widget("eng_power_controls")
    gui_row("row-height: 35px")
    #gui_section(style="area:285px,45px,45,85px;")
    gui_layout_widget("eng_presets")
    # gui_row("row-height:100-100px;")

    gui_section(style="area:min(55,850px),45px,100,100;")
    with gui_sub_section():
        gui_layout_widget("ship_internal_view")
    # Right
    # 18 percent, not 14. col-width is in the same units as the enclosing `area:` -
    # SCREEN percent - so 14 stayed pinned to its own 200px floor all the way to a
    # ~1430px-wide screen, i.e. the column never actually grew across the range most
    # people play at. 18 starts growing just above 1024 (1280 -> 230px, 1600 -> 288,
    # 1920 -> 346) while the 200px floor still protects the interior view on a small
    # screen, where the section it shares is only ~460px wide in total.
    with gui_sub_section("col-width:max(200px,18);"):
    # with gui_sub_section():
        # We own this rectangle now. grid_face is retired - it drew one oversized crew
        # glyph plus a `^`-separated status string, on the only FLEX row in this column,
        # so it was also the thing that collapsed at low resolution.
        #
        # Dropping gui_layout_widget is NOT enough: gui_console("engineering") declares
        # grid_face in the widget list, and an engine widget that is declared but never
        # given a rect draws at its own default position. So drop it from the list this
        # build declares, and park the one a console was already showing off screen.
        gui_update_widgets("", "grid_face")
        gui_widget_offscreen("grid_face")
        gui_row()
        # Selected / Orders / Systems. Tabs, so each gets the WHOLE of a row that is
        # 587px tall at 1920 and 227 at 1280x720. Built with gui_tabbed_panel, never
        # gui_info_panel: pending_info_panel is a singleton and the left column owns it.
        eng_grid_panel()
        gui_row("row-height:200px;")
        gui_layout_widget("grid_control")
        gui_row("row-height:2em;")
        gui_blank(1)
        gui_row("row-height:200px;")
        gui_layout_widget("grid_object_list")


    yield idle


//gui/normal_helm
    default tab = 1
    # Ship Data, 0
    gui_section(style="area:0,45px,100-300px,100;")
    with gui_sub_section("col-width:280px;"):
        gui_row("row-height: 400px-3em;")
        gui_info_panel(tab=tab)
        gui_info_panel_add("message", 83, gui_panel_console_message,None, gui_panel_console_message_tick)
        # The log/replay tab: every card ever filed, re-readable. Cards only take
        # over the "message" tab when they interrupt (a button, or notify=True).
        gui_info_panel_add("messages", 84, gui_panel_console_message_list, None)
        # The ship's log (LOG_PANEL_PLAN.md). Same store on every console - it is the
        # CREW's log - so what one console sees, all of them see.
        gui_info_panel_add("log", 112, gui_panel_log, None, gui_panel_log_tick)
        gui_info_panel_add("ship", 66, gui_panel_log_ship, None, gui_panel_log_tick)
        gui_info_panel_add("mission", 85, gui_panel_log_mission, None, gui_panel_log_tick)

        # The space the text waterfall used to occupy, directly under ship data on every
        # console so the crew always looks in ONE place for the latest line. The waterfall
        # was declared by gui_console and could not be styled from script; this is the same
        # traffic in a text area the console owns. The history is the log tab. LOG_PANEL_PLAN.md
        #
        # The strip comes OUT of the panel's height (the `400px-Nem` row above), not
        # below it: the waterfall used to be the bottom few lines of that same block,
        # with ship data shrunk to suit. Appending a row instead pushed the strip a whole
        # strip-height further down - below where the waterfall was, and off the bottom of
        # the half-screen section Engineering gives this column.
        gui_row("row-height: 4em;")
        gui_log_tail()

    gui_section(style="area:0,45px,100,100;")
    with gui_sub_section():
        # Same band above the view as comms and the cockpit.
        gui_row("row-height:45px;")
        gui_blank(1,"col-width:280px")
        gui_layout_widget("radar_zoom_ctrl")
        gui_blank(1,"col-width:25")
        gui_row()
        gui_layout_widget("2dview")

    # THE ENGINE'S WIDGETS, NOW OWNED BY THIS CONSOLE - IN PIXELS.
    #
    # Everything above this line was already placed here; everything below was left to
    # the engine's default layout, which meant NOTHING EVER SENT IT A RECT - so nothing
    # could put one back either. The library parks a widget offscreen when it falls off
    # the console's widget list (an engine widget cannot be un-declared, and one left
    # declared draws against whatever the console last pointed at, which is how a client
    # died in ViewGridObjectListDraw). Coming back it could only guess, and guessing the
    # full console stacked every control on this screen on top of each other: click the
    # Upgrades tab, click back, console hosed.
    #
    # PIXELS, NOT PERCENT. The arrangement is the engine's own (data/guiboxdata.txt,
    # normal_helm) measured at 1272x962, but held in pixels and anchored to an EDGE, so
    # every control is the same size and in the same place on every screen. The engine's
    # percentages grew and shrank with the display, which is what put the shield button
    # somewhere different on each one. Same reason as //gui/normal_weap below.
    #
    # ANCHORS: the right-hand stack hangs off the right edge, the drive controls off the
    # bottom, so widening a screen adds space in the middle rather than stretching them.

    # Right-hand stack: the camera dial, then shields and dock beneath it. One section,
    # its own spacers, exactly as the weapons column is built. The two buttons are
    # narrower than the dial, so a blank holds their left margin - a blank draws nothing,
    # which is why it is safe to share an engine widget's row when a real control is not.
    gui_section(style="area:100-356px,48px,100,404px;")

    gui_row("row-height:231px;")
    gui_layout_widget("main_screen_control")

    gui_row("row-height:19px;")
    gui_blank()
    gui_row("row-height:48px;")
    gui_blank(1,"col-width:127px")
    gui_layout_widget("shield_control")

    gui_row("row-height:10px;")
    gui_blank()
    gui_row("row-height:48px;")
    gui_blank(1,"col-width:127px")
    gui_layout_widget("request_dock")

    # The two drive controls, bottom-left, anchored to the bottom edge.
    gui_section(style="area:0,100-366px,127px,100;")
    gui_layout_widget("throttle")

    gui_section(style="area:127px,100-269px,509px,100;")
    gui_layout_widget("helm_movement")

    # Only when the ship HAS a jump drive: gui_console(CONSOLE_SELECT, is_jump) declares
    # these two only then, and gui_layout_widget ADDS to the widget list - so placing
    # them unconditionally would put a jump drive on a warp ship.
    #
    # THE HULL, NOT THE BLOB. This used to read `jump_drive_active`, which
    # //shared/signal/grid_interior_built writes after the interior is BUILT - and an
    # interior is built late and asynchronously, so a console that opened first asked
    # too early, got "no", and drew itself without the jump controls. Nothing told it
    # to look again, so the crew had to switch console and come back before the drive
    # appeared. Reported on a xim_dreadnought, whose hull plainly has one.
    # grid_hull_has_role reads the hull's own floor plan, which is true from the moment
    # the ship exists.
    if grid_hull_has_role(sbs.get_ship_of_client(client_id), "jump"):
        # The jump bar, along the bottom, anchored bottom-right.
        gui_section(style="area:100-840px,100-77px,100,100;")
        gui_layout_widget("helm_jump")

        # The jump selector, moved over to the right edge with a 30px gap. It used to
        # sit a third of the way in, adrift between the 2D view and the right-hand
        # stack; it belongs with the other controls, not in the middle of the radar.
        #
        # Anchored to the BOTTOM, not the top, so it keeps station above the jump bar
        # instead of descending onto it: 30px of clear air over an 77px bar. That lands
        # it in exactly the place it occupies today on a 962-tall screen, and keeps it
        # off the bar on a short one, where a fixed 606px from the top would overlap.
        gui_section(style="area:100-94px,100-356px,100-30px,100-202px;")
        gui_layout_widget("quick_jump")

//gui/normal_weap
    default tab = 1
    # Ship Data, 
    gui_section(style="area:0,45px,100-300px,100;")
    with gui_sub_section("col-width:280px;"):
        gui_row("row-height: 400px-3em;")
        gui_info_panel(tab=tab)
        gui_info_panel_add("message", 83, gui_panel_console_message,None, gui_panel_console_message_tick)
        # The log/replay tab: every card ever filed, re-readable. Cards only take
        # over the "message" tab when they interrupt (a button, or notify=True).
        gui_info_panel_add("messages", 84, gui_panel_console_message_list, None)
        # The ship's log (LOG_PANEL_PLAN.md). Same store on every console - it is the
        # CREW's log - so what one console sees, all of them see.
        gui_info_panel_add("log", 112, gui_panel_log, None, gui_panel_log_tick)
        gui_info_panel_add("ship", 66, gui_panel_log_ship, None, gui_panel_log_tick)
        gui_info_panel_add("mission", 85, gui_panel_log_mission, None, gui_panel_log_tick)

        # The space the text waterfall used to occupy, directly under ship data on every
        # console so the crew always looks in ONE place for the latest line. The waterfall
        # was declared by gui_console and could not be styled from script; this is the same
        # traffic in a text area the console owns. The history is the log tab. LOG_PANEL_PLAN.md
        #
        # The strip comes OUT of the panel's height (the `400px-Nem` row above), not
        # below it: the waterfall used to be the bottom few lines of that same block,
        # with ship data shrunk to suit. Appending a row instead pushed the strip a whole
        # strip-height further down - below where the waterfall was, and off the bottom of
        # the half-screen section Engineering gives this column.
        gui_row("row-height: 4em;")
        gui_log_tail()

    gui_section(style="area:0,45px,100,100;")
    with gui_sub_section():
        # Same band above the view as comms and the cockpit.
        gui_row("row-height:45px;")
        gui_blank(1,"col-width:280px")
        gui_layout_widget("radar_zoom_ctrl")
        gui_blank(1,"col-width:25")
        gui_row()
        gui_layout_widget("weapon_2d_view")

    # THE ENGINE'S WIDGETS, NOW OWNED BY THIS CONSOLE - ONE COLUMN, IN PIXELS.
    #
    # These used to be left to the engine's own layout (data/guiboxdata.txt), which
    # meant nothing ever sent them a rect - so nothing could put one back either. The
    # library parks a widget offscreen when it falls off the console's widget list (an
    # engine widget cannot be un-declared, and one left declared draws against whatever
    # the console last pointed at, which is how a client died in ViewGridObjectListDraw).
    # Coming back it could only guess, and guessing the full console stacked every
    # control on this screen on top of each other: click the Upgrades tab, click back,
    # console hosed.
    #
    # PIXELS, NOT PERCENT, and one section rather than six. The engine's own numbers
    # are percentages with a 200px hole in the middle of them, so the shield button
    # sat somewhere different on every screen size and the column read as two halves.
    # A pixel column is the same column at every resolution - which is the whole point
    # of owning it - and the rows below are a single stack with a spacer between each.
    #
    # THE CAMERA DIAL KEEPS ITS SHAPE: 280x180 is its aspect, so it is round rather
    # than squashed. If it ever looks wrong, that pair is the one thing to change here -
    # the rest of the column just follows it down.
    #
    # manual_weapons rides this same widget list, so it inherits this column too.
    gui_section(style="area:100-280px,45px,100,485px;")

    gui_row("row-height:180px;")
    gui_layout_widget("main_screen_control")

    # A wider spacer here than between the rows below it: the dial is a different
    # KIND of control from the four that follow, and butting it up against SHIELDS
    # read as one block. 16px separates the two groups; 8px separates rows within
    # the lower one.
    gui_row("row-height:16px;")
    gui_blank()
    gui_row("row-height:45px;")
    gui_layout_widget("shield_control")

    gui_row("row-height:8px;")
    gui_blank()
    gui_row("row-height:58px;")
    gui_layout_widget("weap_beam_freq")

    gui_row("row-height:8px;")
    gui_blank()
    gui_row("row-height:55px;")
    gui_layout_widget("weap_beam_speed")

    gui_row("row-height:8px;")
    gui_blank()
    gui_row("row-height:62px;")
    gui_layout_widget("weap_torp_conversion")

    # The fire controls keep the engine's own corner - they are the one widget on this
    # console that is not part of the right-hand column.
    gui_section(style="area:65,78,100,100;")
    gui_layout_widget("weapon_control", alt="75,77,100,100")

//gui/normal_main
