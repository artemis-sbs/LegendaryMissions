        gui_info_panel_add("log", 112, gui_panel_log, None, gui_panel_log_tick)
        gui_info_panel_add("ship", 66, gui_panel_log_ship, None, gui_panel_log_tick)
        gui_info_panel_add("mission", 85, gui_panel_log_mission, None, gui_panel_log_tick)

        # The space the text waterfall used to occupy, directly under ship data on every
        # console so the crew always looks in ONE place for the latest line. The waterfall
        # was declared by gui_console and could not be styled from script; this is the same
        # traffic in a text area the console owns. The history is the log tab. LOG_PANEL_PLAN.md
        #
        # The strip comes OUT of the panel's height (the `400px-Nem` row above), not
        # below it: the waterfall used to be the bottom few lines of that same block,
        # with ship data shrunk to suit. Appending a row instead pushed the strip a whole
        # strip-height further down - below where the waterfall was, and off the bottom of
        # the half-screen section Engineering gives this column.
        gui_row("row-height: 4em;")
        gui_log_tail()

    # THE ENGINE'S OWN PLACEMENT, NOW OWNED BY THIS CONSOLE.
    # data/guiboxdata.txt gives normal_main's 3dview 0,0,100,100 in BOTH rects - the
    # full bleed this screen already had, with the data column an overlay on top of
    # it. See //gui/normal_helm for why it stopped being the engine's business; this
    # screen is the one that toggles its view constantly, every time the crew goes
    # Tactical and back, so it is the one that met the un-park most often.
    #
    # Guarded by the SAME test gui_console("mainscreen") uses to pick the widget list,
    # because gui_layout_widget ADDS to that list: on an lrs/tactical/data screen
    # 3dview is not declared, and placing it here would declare it. The 2D shot places
    # its own view in show_main_game_screen, which owns that condition.
    _msv = get_inventory_value(viewscreen_home_ship(client_id), "MAIN_SCREEN_VIEW", "3d_view")
    if _msv != "lrs" and _msv != "tactical" and _msv != "data":
        gui_section(style="area:0,0,100,100;")
        gui_layout_widget("3dview")


