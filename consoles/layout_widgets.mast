shared COMMS_PROTOTYPE  = SETTINGS.get("COMMS_PROTOTYPE", False)

#=== layout_comms_engine_widgets
//gui/normal_comm

    jump mike_comms if COMMS_PROTOTYPE

    
    # Left
    gui_section(style="area:0,45px,100,100;")
    
    default tab = 1
    # Top Left
    
    with gui_sub_section("col-width:280px;"):
        gui_row("row-height: 400px;")
        #gui_layout_widget("ship_data")
        gui_info_panel(tab=tab)
        gui_info_panel_add("message", 83, gui_panel_console_message,None, gui_panel_console_message_tick)
        # The log/replay tab: every card ever filed, re-readable. Cards only take
        # over the "message" tab when they interrupt (a button, or notify=True).
        gui_info_panel_add("messages", 84, gui_panel_console_message_list, None)
        # The ship's LOG - the text waterfall's replacement (LOG_PANEL_PLAN.md), mounted
        # first on comms because it carries the most traffic. The waterfall is deliberately
        # still shown in the middle column: comms_broadcast writes BOTH surfaces during the
        # changeover, so the two can be read side by side before anything is retired.
        gui_info_panel_add("log", 112, gui_panel_log, None, gui_panel_log_tick)
        # Same store, filtered: Ship is the crew's own news (damage, systems,
        # docking), Mission is objective and quest beats. Anything untagged still
        # shows in Log, which is everything - so a subset tab can never hide a message.
        gui_info_panel_add("ship", 66, gui_panel_log_ship, None, gui_panel_log_tick)
        gui_info_panel_add("mission", 85, gui_panel_log_mission, None, gui_panel_log_tick)
        # Every incoming hail this ship has had, re-readable. Selecting one replays
        # it - strictly READ-ONLY: a replay cannot change or undo a choice already
        # made, which hail_answer enforces rather than the layout.
        gui_info_panel_add("hails", hail_panel_icon(), hail_panel_history, None)

        # The space the text waterfall used to occupy, directly under ship data on every
        # console so the crew always looks in ONE place for the latest line. The waterfall
        # was declared by gui_console and could not be styled from script; this is the same
        # traffic in a text area the console owns. The history is the log tab. LOG_PANEL_PLAN.md
        gui_row("row-height: 4em;")
        gui_log_tail()
        # if is_dev_build():
        #     gui_info_panel_add("upgrades", 105, gui_panel_upgrade_list,None)
        #     gui_info_panel_add("objective", 85, gui_panel_console_message,None)
        #     gui_info_panel_add("objectives", 86, gui_panel_console_message_list,None)

        gui_row()
        gui_blank()

        # NOT sbs.get_ship_of_client: while an orbit hail runs, this console is
        # ASSIGNED to the hailer, so the engine would answer with the raider.
        _hail_ship = viewscreen_home_ship(client_id)
        # One call, three states: nothing at all, an Answer entry per waiting hail,
        # or the open conversation's choices. The library owns which.
        hail_choice_strip(_hail_ship, client_id)
        
        # Where an incoming hail shows for THIS console: Off / This Console /
        # Main Screen / Both. The dial owns its own change handler, so a console
        # cannot drift from the library about what the labels mean.
        gui_row("row-height: 40px;margin:0,0,0,10px;")
        hail_where_dropdown(client_id, "col-width:150px;")



    # Middle
    with gui_sub_section():
        gui_row("row-height:30;")
        gui_layout_widget("comms_waterfall")
        # The zoom control belongs to the view it zooms: a 45px band directly above it,
        # spanning the same width, which is what the cockpit does (hangar.mast). It used
        # to sit in an absolute box of its own with no relationship to the view at all.
        # 45px because the control is small and fixed - it does not want stretching.
        gui_row("row-height:45px;")
        gui_layout_widget("radar_zoom_ctrl")
        gui_row()
        # A hail placed on THIS console takes the radar's space. gui_widget_offscreen
        # is the only reliable way to be rid of an engine widget - gui_hide does not
        # work on them.
        if hail_shows_here(client_id):
            gui_widget_offscreen("comms_2d_view", client_id)
            hail_view(_hail_ship, client_id)
        else:
            gui_layout_widget("comms_2d_view")
        
    # Right
    ss = gui_screen_size(client_id)

    default select_2d = False
    _widget = "comms_2d_view"
    #if select_2d:
    #    _widget = "comms_2d_view"
    with gui_sub_section("col-width:25;"):
        gui_row("row-height:100px;")
        gui_layout_widget("comms_face")

        gui_row("row-height:15;")
        gui_property_list_box("Options")

        gui_row()
        gui_layout_widget("comms_control")



        # gui_screen_size returns a 1024x768 PLACEHOLDER (z==99) until the client
        # reports its size, which read as a small screen and cramped wide displays.
        # When unknown, assume the LARGER layout - it degrades better.
        if gui_screen_size_known(client_id) and ss.x < 1600:
            gui_row("row-height: 35px;col-width:25px;")
        else:
            gui_row("row-height: 35px;col-width:45px;")


        gui_row("row-height:20px;")
        gui_blank()
        gui_row() #"padding:0,25px,10px,0")
        gui_layout_widget("comms_sorted_list")

        # Follow and RED ALERT ride here, under the contact list, rather than in the
        # left column: that column already carries a 400px info panel and a log tail,
        # and the incoming-hail answer strip needs the room. One row, one height, so
        # they read as a single control bar.
        gui_row("row-height: 40px;")
        follow_tag = get_inventory_value(client_id, "2d_follow", True)
        # Set back in case of default
        set_inventory_value(client_id, "2d_follow", follow_tag)
        gui_checkbox("Follow","col-width:90px;", var="follow_tag")
        on change follow_tag:
            ship = viewscreen_home_ship(client_id)
            _sel = get_comms_selection(ship)
            set_inventory_value(client_id, "2d_follow", follow_tag)
            comms_set_2dview_focus(client_id, _sel)
        # RED ALERT gets its OWN row. An engine widget is drawn by the engine from the
        # rect the placeholder computes, and sharing a row with a control left it both
        # overlapped and stretched - a column width is not enough to make the engine
        # lay it out beside something else. Its own row is what worked before.
        gui_layout_widget("red_alert")
    


    yield idle



//gui/normal_sci
    ss = gui_screen_size(client_id)
    # Ship Data overlap
    gui_section(style="area:0,45px,100,100;")
    
    default tab = 1
    gui_row("row-height: 400px;col-width:280px;")
    gui_info_panel(tab=tab)
    gui_info_panel_add("message", 83, gui_panel_console_message,None, gui_panel_console_message_tick)
    # The log/replay tab: every card ever filed, re-readable. Cards only take
    # over the "message" tab when they interrupt (a button, or notify=True).
    gui_info_panel_add("messages", 84, gui_panel_console_message_list, None)
    # The ship's log (LOG_PANEL_PLAN.md). Same store on every console - it is the CREW's
    # log - so what one console sees, all of them see.
    gui_info_panel_add("log", 112, gui_panel_log, None, gui_panel_log_tick)
    gui_info_panel_add("ship", 66, gui_panel_log_ship, None, gui_panel_log_tick)
    gui_info_panel_add("mission", 85, gui_panel_log_mission, None, gui_panel_log_tick)

    # The space the text waterfall used to occupy, directly under ship data on every
    # console so the crew always looks in ONE place for the latest line. The waterfall
    # was declared by gui_console and could not be styled from script; this is the same
    # traffic in a text area the console owns. The history is the log tab. LOG_PANEL_PLAN.md
    gui_row("row-height: 4em;col-width:280px;")
    gui_log_tail()

    gui_section(style="area:0,45px,100,100;")
    with gui_sub_section():
        # Same band above the view as comms and the cockpit.
        gui_row("row-height:45px;")
        gui_layout_widget("radar_zoom_ctrl")
        gui_row()
        gui_layout_widget("science_2d_view")

    # Right
    with gui_sub_section("col-width:30;"):
        gui_row("row-height:70px;")
        gui_layout_widget("science_data_tabs")
        gui_row("row-height:40px;")
        gui_layout_widget("science_data_freq")
        gui_row("row-height:200px;")
        gui_layout_widget("science_data")
        gui_row("row-height: 35px;")
        default follow_tag = False
        gui_checkbox("Follow","col-width:90px;", var="follow_tag")
        # "On screen" - science hands the MAIN SCREEN a shot of whatever it has
        # selected, which is the console that already has the thing selected. Same
        # grammar as Follow, one row over. The item list comes from the library so the
        # labels here and the mode names there cannot drift. VIEWSCREEN_PLAN.md
        _sci_ship = viewscreen_home_ship(client_id)
        default on_screen = viewscreen_label_for(viewscreen_mode(_sci_ship))
        on_screen_dd = gui_drop_down(viewscreen_shot_props(on_screen), var="on_screen")
        on gui_message(on_screen_dd):
            _ship = viewscreen_home_ship(client_id)
            viewscreen_set(_ship, viewscreen_mode_for(on_screen), get_science_selection(_ship))
        # gui_screen_size returns a 1024x768 PLACEHOLDER (z==99) until the client
        # reports its size, which read as a small screen and cramped wide displays.
        # When unknown, assume the LARGER layout - it degrades better.
        if gui_screen_size_known(client_id) and ss.x < 1600:
            gui_row("row-height: 35px;col-width:25px;")
        else:
            gui_row("row-height: 35px;col-width:45px;")
        
        
        gui_row("row-height:20px;")
        gui_blank()
        gui_row()
        gui_layout_widget("science_sorted_list")

    on change follow_tag:
        ship = viewscreen_home_ship(client_id)
        _sel = get_science_selection(ship)
        set_inventory_value(client_id, "2d_follow", follow_tag)
        science_set_2dview_focus(client_id, _sel)
        
    yield idle

//focus/science if not has_role(SCIENCE_SELECTED_ID, 'admiral')
    ->END if SCIENCE_SELECTED is None
    #
    #
    # Something else selected get out of give orders
    #
    nav_focus_id = EVENT.client_id
    science_set_2dview_focus(EVENT.client_id, EVENT.selected_id)
    # If this console is driving the main screen, the shot follows the selection - the
    # crew picked a new contact, they did not ask to go back to a black screen.
    _vs_ship = viewscreen_home_ship(EVENT.client_id)
    if viewscreen_is_live(_vs_ship):
        viewscreen_set(_vs_ship, viewscreen_mode(_vs_ship), EVENT.selected_id)


