========= client_main ==========
    # Assure the tab enabled variables object_exists
    # But don't overwrite ones set
    for con_tab in TAB_CONSOLES:
        con_tab = con_tab.upper()
        v = get_variable(f"{con_tab}_TAB_ENABLED", False)
        set_variable(f"{con_tab}_TAB_ENABLED", v)

    consoles = gui_get_console_type_list()
    console_select_item = consoles[0]
    CONSOLE_SELECT = consoles[0].path


    # Assuming Id is in creation order
    PLAYER_LIST = sorted(to_object_list(role("__player__")), key=lambda p: p.id)
    player_list_all = PLAYER_LIST.copy()


    console_ready = False
    console_read_only = False

    ship_name = "No Player Ships"
    ship_type = "invisible"
    if len(PLAYER_LIST)>0:
        ship_name = PLAYER_LIST[0].name
        ship_type = PLAYER_LIST[0].art_id

    client_select_ship = ship_name.lower()
    ship_type_def = ship_type

    shared ship_list = ""
    client_selected_index = 0
    shared valid_interiors = set()

    for key in grid_data:
        if len(grid_data[key]["grid_objects"])>0:
            sd = ship_data_get_ship_data_for(key)
            continue if sd is  None
            roles = sd.get("roles")
            continue if roles is None
            continue if "ship" not in roles
            valid_interiors.add(key)


    mode = await gui_request_client_string(client_id, "console_mode")
    previous_console = await gui_request_client_string(client_id, "console_previous")
    crew_name = await gui_request_client_string(client_id, "crew_name")

    if mode is not None and len(mode) > 0:
        jump operator_admin_console if mode=='admin'
        mode=mode.strip().lower()
        sp = mode.split(";")
        _ship = client_select_ship
        #
        # 
        #
        if len(sp) >1:
            mode = sp[0].strip()
            _ship = sp[1].strip()

        for i in range(len(consoles)):
            continue if mode != consoles[i].path
            CONSOLE_SELECT = consoles[i].path
            console_select_item = consoles[i]
            console_ready = True
            console_read_only = True
            client_select_ship = _ship
            jump console_force_mode
            break
                
        #modes = mode.split(';')
        #mode = None
        #if len(modes)>=3:
        #    mode = modes[2]
        #    # CONSOLE_SELECT = mode
        #    jump operator_admin_console if mode=='admin'
    elif previous_console is not None and len(previous_console) > 0:
        for i in range(len(consoles)):
            continue if previous_console != consoles[i].path
            CONSOLE_SELECT = consoles[i].path
            console_select_item = consoles[i]

    # A console named on the ENGINE COMMAND LINE wins, and enters straight away:
    #     Artemis3-x64-release.exe autostartclient console=weapons
    # `console=` is not an engine flag - 1.3.5 passes unrecognized key=value arguments
    # through to command_line_dict(), so this needs nothing from the engine.
    #
    # It replaces what `sbs run` does today: rewriting data/client_string_set.txt inside the
    # game install before each launch to set console_previous, then restoring it afterwards.
    # That is a shared global being used to configure a per-process choice - two runs
    # corrupt each other and a crash leaves the file clobbered. A command-line argument is
    # per-process by nature, so there is nothing to share, restore, or clean up.
    #
    # Placed AFTER the mode/previous_console branches on purpose: `mode` jumps away when it
    # matches, so reaching here means nothing forced a console, and a preselected
    # `previous_console` is exactly what a launch argument should be allowed to override.
    cli_console = command_line_get("console")
    if cli_console is not None and len(cli_console) > 0:
        cli_console = cli_console.strip().lower()
        for cli_i in range(len(consoles)):
            continue if cli_console != consoles[cli_i].path
            CONSOLE_SELECT = consoles[cli_i].path
            console_select_item = consoles[cli_i]
            jump console_selected
        # Reached only when nothing matched - the loop jumps out on a hit. Say so rather
        # than silently showing the picker: a typo in a launch argument that quietly does
        # nothing is the failure mode that wasted the most time getting here.
        log(f"console='{cli_console}' matched no console - showing the picker", "console_select", "warning")

    if AUTO_START and console_select_item:
        jump(console_selected)
        





========== select_console ==========
    # default CONSOLE_SELECT = "helm"
    # default client_select_ship = "artemis"

### Bit of a hack, making sure a gui reset happens here
## So on change, and on signal etc. are cleared while setting up data
    ship_sec = gui_region(style="area: 10px,60px,400px,105px")

    PLAYER_LIST = sorted(to_object_list(role("__player__")), key=lambda p: p.id)
    player_list_all = PLAYER_LIST.copy()
    # if GAME_STARTED:
    #     PLAYER_COUNT = len(PLAYER_LIST)
    #
    # players_cleaned should set by spawn_players
    # It must occur after the 
    #
    default shared players_cleaned = False
    if players_cleaned:
        PLAYER_COUNT = len(PLAYER_LIST)

    # Clamp selected index
    client_selected_index = min(PLAYER_COUNT-1, client_selected_index )

    if len(PLAYER_LIST) >0:
        ship_type_def = PLAYER_LIST[client_selected_index].art_id
        ship_type = ship_type_def
        ship_name = PLAYER_LIST[client_selected_index].name
        client_select_ship = ship_name.lower()

    #gui_activate_console("select_console")

    ship_sec = gui_region(style="area: 10px,60px,400px,105px")
    with ship_sec:
        gui_row(style="row-height: 45px;")

        _input = gui_input("desc:Ship Name", var="ship_name")
        on gui_message(_input):
            if len(PLAYER_LIST)>0:
                PLAYER_LIST[client_selected_index].name = ship_name
            client_select_ship = ship_name
            # Refresh the ship list on EVERY console, not just this one. The local
            # `on change ...name` watcher only fires on a console that has the
            # renamed ship selected, so observers with a different ship selected
            # kept showing the stale name. A shared refresh re-renders each
            # console's list box (each preserves its own selection).
            gui_update_shared("sh_ship_list", None)

    ship_sec_not = gui_region(style="area: 10px,60px,400px,105px")
    with ship_sec_not:
        gui_row(style="row-height: 45px;")
        _display = gui_text(ship_name, style="tag:sh_ship_name")

    ship_sec2 = gui_region(style="area: 10px,110px,500px,520px")
    with ship_sec2:
        gui_row() #style="row-height: 300px;")

        #
        # Specify only ships with defined engineering grid
        #
        spick = ship_picker_control(f"Your Ship", ship_type_def, ship_keys=valid_interiors)
        gui_content(spick, style="tag:sh_ship_picker", var="ship_type")
        on change ship_type:
            #if not GAME_STARTED:
            if len(PLAYER_LIST)>0:
                PLAYER_LIST[client_selected_index].art_id = ship_type
            gui_update_shared("sh_ship_list", None)

    if sbs.is_demo() or console_select_item.path != "helm" or GAME_STARTED or SHIP_PICK_READ_ONLY:
        gui_hide(ship_sec)
        gui_show(ship_sec_not)
        spick.read_only = True
    elif console_select_item.path == "helm" and not GAME_STARTED:
        gui_show(ship_sec)
        gui_hide(ship_sec_not)
        spick.read_only = SHIP_PICK_READ_ONLY
        
    #
    # List of available ships
    # ship_sec2 = gui_region(style="area: 1,110px,500px,520px")
    gui_section( style="area: 10px,550px,500px,100-60px;")
    if len(player_list_all)>0:
        ship_list = player_list_all[:PLAYER_COUNT]
    else:
        ship_list = []
    # reveal keeps a restored selection on screen; hint keeps it in the same slot.
    #
    # With 8 player ships and a dozen-plus consoles BOTH lists overflow their boxes,
    # so both need this. They fail differently, which is why the two calls below read
    # differently:
    #   - the ship list restored with set_selected_index(i) and NO second argument,
    #     so set_cur was True: always visible, but slammed to the TOP every rebuild.
    #   - the console list restores with set_value(), which never touches `cur` at
    #     all: nothing moved the view, so the selected console sat below the fold.
    # Passing False hands the view to reveal/hint instead of the slam, so a restored
    # selection is shown with the SMALLEST move that makes it visible.
    default console_ship_hint = None
    ship_select_lb = gui_list_box(ship_list,"background:#1572;tag:sh_ship_list;", item_template=console_ship_select_template, title_template=console_ship_select_title_template, select=True, reveal=True, hint=console_ship_hint)

    if len(ship_list)>0:
        ship_select_lb.set_selected_index(client_selected_index, False)


    #
    # List of available consoles
    #
    gui_section( style="area: 510px, 2, 99,100-60px;")
    gui_row(style="row-height: 45px;")

    crew_input = gui_input("desc:Crew person Name", var="crew_name")
    gui_row(style="row-height: 45px;")
    gui_blank()
    gui_row()

    # Re-bind the selected item to the CURRENT consoles list. On game start every
    # client is rerouted through game_started_console, which rebuilds `consoles`
    # with fresh objects (gui_get_console_type_list mints new DictionaryToObjects
    # each call). The carried console_select_item is then stale, and the list box
    # highlights by identity (no __eq__), so the selection was lost on repaint.
    # CONSOLE_SELECT (the path string) survives, so match on it.
    for c in consoles:
        if c.path == CONSOLE_SELECT:
            console_select_item = c
            break

    # THIS is the one that could come back selected-but-invisible. set_value() sets
    # `selected` and never touches `cur`, so unlike the ship list above there is
    # nothing moving the view to the selection -- and a mission can register well
    # over a dozen consoles (helm, weapons, engineering, science, comms, mainscreen,
    # cinematic, hangar, director, gamemaster, display_panels, plus map-gated ones),
    # so the selected console is easily below the fold. `reveal` is the fix here;
    # the hint is what stops it moving on the rebuilds we can capture.
    default console_sel_hint = None
    console_select_lb = gui_list_box(consoles,"row-height: 0.5em; background:#1572;", item_template=console_select_template, title_template=console_select_title_template, select=True, read_only=console_read_only, reveal=True, hint=console_sel_hint)
    console_select_lb.set_value(console_select_item)

    #
    # Ready state
    #
    default cb_ready = None
    gui_section( style="area: 80,100-60px, 99,100;row-height: 50px;")
    if not GAME_STARTED:
        cb_ready = gui_checkbox("ready", var="console_ready")
    else:
        on gui_message(gui_button("ready")):
            console_ready = True
            jump console_selected

    gui_section(style="area: 0,100-50px, 35,100;")
    gui_layout_widget("text_waterfall")


    on change PLAYER_COUNT:
        if not GAME_STARTED:
            client_selected_index = min(client_selected_index, int(PLAYER_COUNT)-1)
            # Just refresh if reduce ship count for now
            # jump select_console if len(lb_ships.items)>PLAYER_COUNT
            # Otherwise can refresh faster if adding ships
            ship_list = player_list_all[:PLAYER_COUNT]
            ship_select_lb.items = ship_list
            # len(ship_list)-1, not len(ship_list): set_selected_index ignores an
            # index that is not < len, so the old clamp silently CLEARED the
            # selection whenever the count shrank past it. The line above already
            # clamps client_selected_index the right way.
            #
            # False so this in-place update does not jump to the top either. It
            # re-arms the reveal, so the next present scrolls the selection into
            # view -- and clamps `cur`, which matters here because the list just
            # got shorter.
            ship_select_lb.set_selected_index(min(client_selected_index, len(ship_list)-1), False)
        

    on change console_select_lb.get_value():
        #
        # Redo gui if change involves helm
        #
        console_select_item = console_select_lb.get_value()
        CONSOLE_SELECT = console_select_item.path
        if not GAME_STARTED:
            console_ready = False
            cb_ready.value = False
        if console_select_item.path == "helm" and not GAME_STARTED:
            gui_show(ship_sec)
            gui_hide(ship_sec_not)
            spick.read_only = SHIP_PICK_READ_ONLY
        elif OPERATOR_MODE_enabled and console_select_item.path == "admin":
            console_ready = True
            jump(console_select_item.label)
        else:
            gui_hide(ship_sec)
            gui_show(ship_sec_not)
            spick.read_only = True

    on signal player_ship_destroyed:
        await delay_app(0)
        # The only rebuild driven from this live page, so the only place a hint can
        # be taken. The others (select_console_clear_ready, game_started_console)
        # are entered from elsewhere with no presented widget to read -- there
        # `reveal` alone carries it, which is why reveal is the fix here and the
        # hint is the bonus.
        console_ship_hint = ship_select_lb.get_selection_hint()
        console_sel_hint = console_select_lb.get_selection_hint()
        jump select_console_clear_ship

    if len(ship_list) >0:
        on change ship_select_lb.get_value():
            client_select_ship_item = ship_select_lb.get_value()
            client_selected_index = ship_select_lb.get_selected_index()
            if client_select_ship_item is not None:
                client_select_ship = client_select_ship_item.name
                ship_name = client_select_ship
                ship_type = client_select_ship_item.art_id
                gui_update("sh_ship_picker", ship_type)
                _display.value = ship_name
                # Same absolute-region ghost as the rename path: re-present the
                # whole ship_sec_not region so its clear runs before the redraw.
                gui_represent(ship_sec_not)


        on change ship_select_lb.get_value().art_id:
            ship_type = ship_select_lb.get_value().art_id
            gui_update("sh_ship_picker", ship_type)
            gui_update("sh_ship_list", None)
                
        on change ship_select_lb.get_value().name:
            ship_name = ship_select_lb.get_value().name
            _input.value = ship_name
            _display.value = ship_name
            # _display lives in the ship_sec_not absolute gui_region. Setting its
            # .value only marks the child widget dirty, and the dirty pass re-sends
            # the text into the sub-region WITHOUT a clear - so the old name stays
            # painted under the new one (the ghost). Re-presenting the whole region
            # runs region_begin -> send_gui_clear first, giving a clean redraw.
            gui_represent(ship_sec_not)
            gui_update("sh_ship_list", None)
            
        
            
    await gui()

========== select_console_clear_ship
    client_selected_index = 0
    jump  select_console

# Multiple labels to call to get here
========== select_console_clear_ready
    console_ready = False
    jump  select_console


====== game_started_console ====
    #
    # Every client lands here the moment the server presses Start, which is
    # BEFORE the map task has run a single line. Two things are not ready yet:
    # the console-gating variables a map sets in its opening code (a map-gated
    # Navigation/Admiral console), and the player ships - spawn_players resets
    # art, position and roles on them, so console_selected can pick a ship that
    # is about to move, and its grid objects may not exist yet.
    #
    # This used to be two flat `delay_sim(1)`s - one for each of those - which
    # every client paid in full on every start whether or not anything was
    # actually pending. Poll the readiness flag instead: spawn_players sets
    # `players_cleaned` as its LAST act (fleets/map_common.mast), which is
    # exactly the moment both waits were guessing at.
    #
    # Capped at the 1 second the flat wait always cost, so the worst case is
    # unchanged. A map that never runs spawn_players (florbin_case) never sets
    # the flag and so still pays the cap - it can opt out by setting
    # `shared players_cleaned = True` itself, since its players are ready from
    # the moment the server made them.
    #
    default shared players_cleaned = False
    default console_ready = False
    _map_wait = 0
    for x while not players_cleaned and _map_wait < 5:
        await delay_sim(0.2)
        _map_wait += 1

    if not console_ready:
        # The console list was computed at connect time, BEFORE the map ran, so
        # map-gated @console labels were filtered out of it. The map has had its
        # say now, so rebuild the list and re-show the selection screen with the
        # full set.
        consoles = gui_get_console_type_list()
        jump select_console

====== console_selected ====
    jump show_console_selected if len(PLAYER_LIST) ==0

    if CONSOLE_SELECT is None or client_select_ship is None:
        jump select_console

    _ship_id= None
    for player_ship in to_object_list(role("__PLAYER__")):
        if player_ship.name.lower() == client_select_ship.lower():
            _ship_id = player_ship.id

## unlink previous ship
            old_ship_id = sbs.get_ship_of_client(client_id)
            unlink(old_ship_id, "consoles", client_id)

            sbs.assign_client_to_ship(client_id, _ship_id)
            assign_client_to_alt_ship(client_id, 0)
            #set_inventory_value(client_id, "assigned_ship", _ship_id)
            #
            # Clear any alt ship e.g. comms give orders
            #
            set_inventory_value(client_id, "2dview_alt_ship", 0)
            link(_ship_id, "consoles", client_id)
            


    jump select_console if _ship_id is None


    #
    # This should get a skybox with client overriding, shp, overriding shared
    #
    sky_box = get_shared_variable("skybox", "sky1")

    sky_box = get_inventory_value(_ship_id, "skybox", sky_box)
    sky_box = get_inventory_value(client_id, "skybox", sky_box)
    skybox_schedule(sky_box, client_id)

====== show_console_selected ====
    #
    # Make it so the console can be found if needed
    #
    #------------------------------------------------------------------------------------------------------------
    sbs.set_beam_damages(client_id, 7.0, DIFFICULTY)
    #------------------------------------------------------------------------------------------------------------



    set_inventory_value(client_id, "CONSOLE_TYPE", CONSOLE_SELECT)
    
    # Remove any console roles
    for k in consoles:
        remove_role(client_id, k.path)
    add_role(client_id, f"console, {CONSOLE_SELECT}")
    
    sbs.set_client_string(client_id, "console_previous", CONSOLE_SELECT)

    sbs.set_client_string(client_id, "crew_name", crew_name)
    set_inventory_value(client_id, "CREW_NAME", crew_name)

    #
    #
    #
    # gui_tab_clear_top()
    if ALLOW_CONSOLE_TABS:
        tab = CONSOLE_SELECT.upper()
        tabs = tab
        # Force the selected console to now be enabled
        set_variable(f"{tab}_TAB_ENABLED", True)
        rem_tabs = ""
        for con_tab in TAB_CONSOLES:
            con_tab = con_tab.upper()
            if get_variable(f"{con_tab}_TAB_ENABLED"):
                tabs = con_tab + "," + tabs
            else:
                rem_tabs = con_tab + "," + rem_tabs
        gui_tab_add_top(tabs)
        
        gui_tab_remove_top(rem_tabs)



    # Retrieve the item by string (because might have navigator here via tab)
    console = gui_get_console_type(CONSOLE_SELECT)
    if console is not None:
        jump(console.label)
    else:
        """ Invalid Console defined and selected"""
        await gui()

