import common_console_selection.py

# What THIS HUMAN chose. All four are tier 1 of the crew resolution and the only things
# written back to a client string - a client string persists per MACHINE, so a resolved
# roster name written there would follow this PC into every future mission and, being tier 1,
# could never be dislodged.
crew_name = ""
crew_face = ""
crew_portrait = ""
crew_pick = ""
default shared grid_data = grid_get_grid_data()
default SETTINGS = settings_get_defaults()

# The picker's Edit affordance. Off switches it back to the plain name box this screen has
# always had. `allow_portrait` stays False: pointing a console UI at an arbitrary file is a
# different conversation, and the group-photo case is served by a reviewable .amd.
settings_add_defaults({"CREW_EDIT": {"enable": True, "allow_face": True, "allow_portrait": False}})
shared CREW_EDIT = settings_get_defaults().get("CREW_EDIT", {"enable": True, "allow_face": True, "allow_portrait": False})

# Set by the avatar_editor addon's top level when it is loaded. SUGGESTS, never requires:
# a hard dependency on an addon most missions do not load is how LM's hangar took 22
# missions to zero labels. The Edit button is built only behind this.
default shared CREW_AVATAR_EDITOR = False
shared SHIP_PICK_READ_ONLY  = SETTINGS.get("SHIP_PICK_READ_ONLY", False)
shared CAN_CHANGE_CONSOLE  = SETTINGS.get("CAN_CHANGE_CONSOLE", True)

### TAB CONSOLES ARE A WORK IN PROGRESS
### NOT A RECOMMEND PATH AT THIS TIME
### IT WILL CHANGE BASED ON OTHER FEATURES PLANNED
shared TAB_CONSOLES = gui_tab_get_list() 
# Remember these also need a //gui/tab to work
shared ALLOW_CONSOLE_TABS = SETTINGS.get("ALLOW_CONSOLE_TABS", False)


if CAN_CHANGE_CONSOLE:
    route_change_console(on_change_console)

==== on_change_console
    jump select_console if not GAME_ENDED
    # Once the game has ended there is no console selection to go to - but ->END here
    # killed the client's ONE gui task, and that task was the results screen (parked in
    # `await gui()` in show_game_results_gui). With nothing presenting, the last frame
    # stayed up and every tab stopped responding: it read as a total GUI lockup, though
    # the engine, the sim and every other client were fine.
    # Go back to the results screen instead. The button does nothing visible, which is
    # what the guard intended, and the tabs keep working.
    jump show_game_results_gui

#
# Expects shared data 
#    the player ROSTER (player_roster_slots / _display / _resolve) - this screen
#    binds to SLOTS and never holds a ship object
#    PLAYER_COUNT the number of expected player ships
#    GAME_STARTED game state
#

========= client_main ==========
    # Assure the tab enabled variables object_exists
    # But don't overwrite ones set
    for con_tab in TAB_CONSOLES:
        con_tab = con_tab.upper()
        v = get_variable(f"{con_tab}_TAB_ENABLED", False)
        set_variable(f"{con_tab}_TAB_ENABLED", v)

    consoles = gui_get_console_type_list()
    console_select_item = consoles[0]
    CONSOLE_SELECT = consoles[0].path


    # SLOTS, not ships. A slot cannot dangle, so none of this needs re-resolving later.
    player_slots_all = player_roster_slots()

    console_ready = False
    console_read_only = False

    ship_name = "No Player Ships"
    ship_type = "invisible"
    client_select_slot = None
    if len(player_slots_all)>0:
        client_select_slot = player_slots_all[0]
        _row = player_roster_display(client_select_slot)
        ship_name = _row["name"]
        ship_type = _row["hull"]

    client_select_ship = ship_name.lower()
    # Kept ONLY for the launch-argument path (`helm;Artemis`), which carries a name and no
    # slot. The slot above is the binding - see #443, where matching on name alone put
    # crews on the wrong one of two same-named ships.
    client_select_ship_id = None
    ship_type_def = ship_type

    shared ship_list = ""
    client_selected_index = 0
    shared valid_interiors = set()

    # WHAT THE CREW MAY FLY, stated rather than inherited. Three tests, and the race one
    # is the one that was missing: the picker used to offer every hull with a floor plan,
    # which let a crew put themselves in a Kralien dreadnought or a luxury liner.
    #
    # "Has an interior" only LOOKED like "is playable" because LM's races addon is the one
    # thing merging floor plans and it already gates each race on this same setting. That
    # coincidence breaks the moment a mod merges a grid of its own, and it says nothing
    # here about what the picker's rule actually is.
    #
    # shipData `side` IS the race name - 'TSN', 'Ximni', 'Kralien' - the same vocabulary
    # PLAYABLE_RACES uses, so no key->race mapping is needed. A hull whose side is missing
    # or spelled differently from its PLAYABLE_RACES entry drops out silently; skipping it
    # is the right failure, since offering a hull the crew cannot fly is worse.
    for key in grid_data:
        if len(grid_data[key]["grid_objects"])>0:
            sd = ship_data_get_ship_data_for(key)
            continue if sd is  None
            roles = sd.get("roles")
            continue if roles is None
            continue if "ship" not in roles
            continue if not settings_race_is_playable(sd.get("side"))
            valid_interiors.add(key)


    mode = await gui_request_client_string(client_id, "console_mode")
    previous_console = await gui_request_client_string(client_id, "console_previous")
    crew_name = await gui_request_client_string(client_id, "crew_name")
    # ONE more round trip, not three. Every key costs a request the picker AWAITS before it
    # can draw, and these awaits carry no timeout, so each is somewhere the screen can stop.
    # The face, the portrait and the picked person travel packed in a single value.
    # Two statements, not one: `a, b, c = <something with an await>` is a COMPILE ERROR
    # ("'await' outside function"), and a compile error takes the whole story to zero labels.
    crew_self = await gui_request_client_string(client_id, "crew_self")
    crew_pick, crew_face, crew_portrait = crew_self_unpack(crew_self)

    if mode is not None and len(mode) > 0:
        jump operator_admin_console if mode=='admin'
        mode=mode.strip().lower()
        sp = mode.split(";")
        _ship = client_select_ship
        #
        # 
        #
        if len(sp) >1:
            mode = sp[0].strip()
            _ship = sp[1].strip()

        for i in range(len(consoles)):
            continue if mode != consoles[i].path
            CONSOLE_SELECT = consoles[i].path
            console_select_item = consoles[i]
            console_ready = True
            console_read_only = True
            client_select_ship = _ship
            # A launch argument names a ship and knows nothing about ids, so the id
            # captured from the picker must be dropped - otherwise it would win and the
            # argument would be silently ignored.
            client_select_ship_id = None
            jump console_force_mode
            break
                
        #modes = mode.split(';')
        #mode = None
        #if len(modes)>=3:
        #    mode = modes[2]
        #    # CONSOLE_SELECT = mode
        #    jump operator_admin_console if mode=='admin'
    elif previous_console is not None and len(previous_console) > 0:
        for i in range(len(consoles)):
            continue if previous_console != consoles[i].path
            CONSOLE_SELECT = consoles[i].path
            console_select_item = consoles[i]

    # A console named on the ENGINE COMMAND LINE wins, and enters straight away:
    #     Artemis3-x64-release.exe autostartclient console=weapons
    # `console=` is not an engine flag - 1.3.5 passes unrecognized key=value arguments
    # through to command_line_dict(), so this needs nothing from the engine.
    #
    # It replaces what `sbs run` does today: rewriting data/client_string_set.txt inside the
    # game install before each launch to set console_previous, then restoring it afterwards.
    # That is a shared global being used to configure a per-process choice - two runs
    # corrupt each other and a crash leaves the file clobbered. A command-line argument is
    # per-process by nature, so there is nothing to share, restore, or clean up.
    #
    # Placed AFTER the mode/previous_console branches on purpose: `mode` jumps away when it
    # matches, so reaching here means nothing forced a console, and a preselected
    # `previous_console` is exactly what a launch argument should be allowed to override.
    cli_console = command_line_get("console")
    if cli_console is not None and len(cli_console) > 0:
        cli_console = cli_console.strip().lower()
        for cli_i in range(len(consoles)):
            continue if cli_console != consoles[cli_i].path
            CONSOLE_SELECT = consoles[cli_i].path
            console_select_item = consoles[cli_i]
            jump console_selected
        # Reached only when nothing matched - the loop jumps out on a hit. Say so rather
        # than silently showing the picker: a typo in a launch argument that quietly does
        # nothing is the failure mode that wasted the most time getting here.
        log(f"console='{cli_console}' matched no console - showing the picker", "console_select", "warning")

    if AUTO_START and console_select_item:
        # READY. console_ready is the ONLY thing game_started_console tests, and every
        # client is rerouted into it when the server starts (server_console.mast, in
        # `start`). Entering a console here without it means that reroute finds
        # console_ready False and sends the client to select_console - the picker,
        # ready unticked - throwing away the console it was already on.
        #
        # It only shows on an in-game RESTART. On a first launch the clients are still
        # connecting while the server starts, so the reroute never reaches them and
        # nothing tests the flag. On a restart they are already connected, the server
        # is a delay_app(1) away from starting, and the reroute lands squarely on a
        # console that has not recorded its choice.
        #
        # AUTO_START is exactly as deliberate a choice as the picker's Ready checkbox -
        # it just has nobody to tick it - so record it the same way. The console_mode
        # branch above has always done this (line 105); this arm was missed.
        console_ready = True
        #
        # ...and then WAIT for the server, rather than walking into the console on our
        # own. On an in-game RESTART this task runs while start_server is still building
        # the roster (delay_app(0.1), create_sides, the torpedo prefabs, then
        # create_default_player_ships), and the three client-string round trips above
        # resolve on their own events, so they finish first. The roster is therefore
        # still EMPTY here - and console_selected takes its no-slots branch, skips
        # assign_client_to_ship entirely, and the
        # console label bounces straight back through select_console_clear_ready, which
        # clears the ready flag set one line above. The console shows as selected and
        # never starts.
        #
        # console_auto_start_wait is that wait - chosen console, no game yet, holding for
        # the server's start reroute. It is the same place a human with Ready ticked is
        # sitting.
        if len(player_roster_slots()) == 0:
            # The placeholder from the top of this label ("No Player Ships") would be
            # matched by name in console_selected and resolve to nothing. Clear it so the
            # roster-was-empty fallback there picks the ship once the ships exist.
            client_select_ship = ""
        jump console_auto_start_wait if not GAME_STARTED
        jump(console_selected)
        





========== select_console ==========
    # `console_select_item` IS SET IN client_main, WHICH IS A DIFFERENT LABEL.
    #
    # MAST variables are task-scoped, so that only reaches here when the task flowed
    # through client_main first. Entering select_console any other way left it undefined,
    # and line ~340 reads `console_select_item.path` unguarded - a NameError there does
    # not just skip a line: a failing expression ENDS THE COMMAND, so the console-select
    # page stops building half way and the guest is left with a partial screen.
    #
    # Seen with --exercise driving the console cycle after GAME_STARTED. Re-derive it
    # rather than assume: gui_get_console_type_list() is the same source client_main uses,
    # and an empty list is survivable here where an exception is not.
    default console_select_item = None
    if console_select_item is None:
        _cs_list = gui_get_console_type_list()
        if len(_cs_list) > 0:
            console_select_item = _cs_list[0]

    # AND THE REST OF WHAT client_main LEAVES BEHIND. Same reason, same failure: every
    # one of these is set in client_main and read here, so entering select_console any
    # other way ends the command at the first of them. The engine found the next one
    # along on client 0 (the SERVER, which never runs client_main):
    #
    #   NameError: name 'client_select_ship_id' is not defined
    #   crew_choices_for(client_select_ship_id, None, client_id)   line 406
    #
    # and behind it `consoles` (the list this page IS) and `console_read_only`. Guarded
    # as a set rather than one at a time, because fixing the first only moves the error
    # to the second - which is exactly how this one was found.
    #
    # `consoles` is re-derived rather than defaulted to empty: it is the whole content of
    # the picker, and gui_get_console_type_list() is the same source client_main reads.
    # CONSOLE_SELECT is in the same boat despite the CAPS - client_main sets it from
    # the console list, and the comment further down ("CONSOLE_SELECT survives, so match
    # on it") is true only of a task that came through there. An empty string matches no
    # console, which leaves the fallback above standing.
    default CONSOLE_SELECT = ""
    default client_select_ship_id = None
    default console_read_only = False
    default console_ready = False
    default crew_name = ""
    default consoles = gui_get_console_type_list()

    # default CONSOLE_SELECT = "helm"
    # default client_select_ship = "artemis"

### Bit of a hack, making sure a gui reset happens here
## So on change, and on signal etc. are cleared while setting up data
    ship_sec = gui_region(style="area: 10px,60px,400px,105px")

    player_slots_all = player_roster_slots()
    default shared players_cleaned = False
    if players_cleaned:
        PLAYER_COUNT = len(player_slots_all)

    # Clamp the selected SLOT to one that still exists. This is the last survivor of the
    # five guards that used to defend the old snapshot - and it is a different thing: it
    # keeps a selection in range, it is not protecting a pointer from being freed.
    default client_select_slot = None
    if client_select_slot not in player_slots_all:
        client_select_slot = player_slots_all[0] if len(player_slots_all)>0 else None

    ship_type_def = "invisible"
    if client_select_slot is not None:
        client_selected_index = player_slots_all.index(client_select_slot)
        _row = player_roster_display(client_select_slot)
        ship_type_def = _row["hull"]
        ship_type = ship_type_def
        ship_name = _row["name"]
        client_select_ship = ship_name.lower()

    #gui_activate_console("select_console")

    ship_sec = gui_region(style="area: 10px,60px,400px,105px")
    with ship_sec:
        gui_row(style="row-height: 45px;")

        _input = gui_input("desc:Ship Name", var="ship_name")
        on gui_message(_input):
            # THE RECORD, NOT THE SHIP. This used to run `picked_ship.name = ship_name`,
            # which lands in set_name -> blob.set("name_tag") - ObjectDataBlob::Set, the
            # function in every one of this build's server crash dumps, called on a live
            # ship while the sim ticks it. Per keystroke, per console.
            #
            # The roster carries it to the ship at Start. Every other console still sees
            # the new name immediately, because they render the same record - that is what
            # the shared refresh below is for.
            # Guarded, because a slot is not guaranteed: a mission that spawns its own
            # player ships late has no records yet, and this box is on screen anyway.
            # The roster refuses a slot of None on its own now; saying so here keeps the
            # rest of the handler from running on a write that did not happen.
            if client_select_slot is not None:
                player_roster_set_name(client_select_slot, ship_name)
            client_select_ship = ship_name
            # Refresh the ship list on EVERY console, not just this one. The local
            # `on change ...name` watcher only fires on a console that has the
            # renamed ship selected, so observers with a different ship selected
            # kept showing the stale name. A shared refresh re-renders each
            # console's list box (each preserves its own selection).
            gui_update_shared("sh_ship_list", None)

    ship_sec_not = gui_region(style="area: 10px,60px,400px,105px")
    with ship_sec_not:
        gui_row(style="row-height: 45px;")
        _display = gui_text(ship_name, style="tag:sh_ship_name")

    ship_sec2 = gui_region(style="area: 10px,110px,500px,520px")
    with ship_sec2:
        gui_row() #style="row-height: 300px;")

        #
        # Specify only ships with defined engineering grid
        #
        spick = ship_picker_control(f"Your Ship", ship_type_def, ship_keys=valid_interiors)
        gui_content(spick, style="tag:sh_ship_picker", var="ship_type")
        on change ship_type:
            # THE RECORD, NOT THE SHIP. Setting art_id on a live object also calls
            # sim.force_update_to_clients, so a crew flicking through hulls pushed an
            # engine update per flick, during the window a console is connecting.
            #
            # The pick beats every theater layer and loses to a game code - the roster
            # owns that precedence, not this screen.
            if client_select_slot is not None:
                player_roster_set_hull(client_select_slot, ship_type)
            gui_update_shared("sh_ship_list", None)

    if sbs.is_demo() or console_select_item is None or console_select_item.path != "helm" or GAME_STARTED or SHIP_PICK_READ_ONLY:
        gui_hide(ship_sec)
        gui_show(ship_sec_not)
        spick.read_only = True
    elif console_select_item.path == "helm" and not GAME_STARTED:
        gui_show(ship_sec)
        gui_hide(ship_sec_not)
        spick.read_only = SHIP_PICK_READ_ONLY
        
    #
    # List of available ships
    # ship_sec2 = gui_region(style="area: 1,110px,500px,520px")
    gui_section( style="area: 10px,550px,500px,100-60px;")
    # Slots, and no filtering. The old line filtered dead Agents out of a snapshot,
    # because ships were being deleted underneath a live screen. Slots do not die, and
    # player_roster_slots() already answers with the ACTIVE ones.
    ship_list = player_slots_all
    # reveal keeps a restored selection on screen; hint keeps it in the same slot.
    #
    # With 8 player ships and a dozen-plus consoles BOTH lists overflow their boxes,
    # so both need this. They fail differently, which is why the two calls below read
    # differently:
    #   - the ship list restored with set_selected_index(i) and NO second argument,
    #     so set_cur was True: always visible, but slammed to the TOP every rebuild.
    #   - the console list restores with set_value(), which never touches `cur` at
    #     all: nothing moved the view, so the selected console sat below the fold.
    # Passing False hands the view to reveal/hint instead of the slam, so a restored
    # selection is shown with the SMALLEST move that makes it visible.
    default console_ship_hint = None
    ship_select_lb = gui_list_box(ship_list,"background:#1572;tag:sh_ship_list;", item_template=console_ship_select_template, title_template=console_ship_select_title_template, select=True, reveal=True, hint=console_ship_hint)

    if len(ship_list)>0:
        ship_select_lb.set_selected_index(client_selected_index, False)


    #
    # List of available consoles
    #
    gui_section( style="area: 510px, 2, 99,100-60px;")
    gui_row(style="row-height: 45px;")

    crew_input = gui_input("desc:Crew person Name", var="crew_name")
    # BESIDE the name box, not under it - it edits the person that box names, and a button
    # on its own row reads as belonging to whatever follows it. Fixed width so the input
    # keeps the rest of the row rather than the two splitting it evenly.
    #
    # Guarded on CREW_AVATAR_EDITOR, which the avatar_editor addon sets at its own top
    # level - SUGGESTED, never required. A hard dependency on an addon most missions do not
    # load is how LM's hangar took twenty-two missions to zero labels. A jump to a label
    # nothing defines compiles clean, so the guard on the button is the whole guard needed.
    if CREW_EDIT.get("enable", True) and CREW_EDIT.get("allow_face", True) and CREW_AVATAR_EDITOR:
        on gui_message(gui_button("Edit Face", style="col-width: 7em;")):
            jump crew_edit_avatar

    #
    # WHO IS AT THIS CONSOLE
    #
    # The name box above is unchanged and still outranks everything: what a person typed
    # about themselves beats what a mission decided about them.
    #
    # CREW_EDIT.enable off puts this screen back to exactly the plain name box it has always
    # been. It does NOT stop a roster staffing consoles - that is not an edit, it is the
    # mission's own answer, and a game that wants no crew at all simply declares no roster.
    default crew_choice = ""
    crew_people = crew_choices_for(client_select_ship_id, None, client_id)
    crew_ui = CREW_EDIT.get("enable", True) and len(crew_people) > 0

    if crew_ui:
        # An OVERRIDE, not the normal path. A cast roster already fills consoles by itself,
        # so reaching for this list is reaching past the automatic answer - which is why it
        # offers everyone free rather than only the people who crew the selected station.
        # That also keeps it honest: this panel updates CONSOLE_SELECT in place without
        # repainting, so a console-narrowed list would go stale the moment somebody clicked
        # a different station.
        gui_row(style="row-height: 45px;")
        crew_list = ",".join([p.name for p in crew_people])
        crew_dd = gui_drop_down(f"$text: {crew_choice or 'auto'};list: auto,{crew_list}")

        # ONE text area for the likeness, because a text area already speaks both `face://`
        # and `image://` - so nothing has to swap widgets when a roster answers with a
        # photograph instead of a face string. Deliberately NOT inside a gui_region: a child
        # updated in place inside an absolute region ghosts in the real engine, and this very
        # file has already paid for that once with the ship name.
        #
        # No background on this row. gui_face takes the face string where every other widget
        # takes a style, so a face cannot carry a draw layer and an opaque raised backdrop
        # here would simply hide it.
        gui_row(style="row-height: 96px;")
        crew_pic = gui_text_area(crew_preview_markdown(crew_face, crew_portrait))

        on gui_message(crew_dd):
            crew_choice = crew_dd.value
            crew_pick = crew_pick_for(client_select_ship_id, crew_choice, client_id)
            crew_name, crew_face, crew_portrait = crew_preview(crew_pick)
            crew_input.value = crew_name
            crew_pic.value = crew_preview_markdown(crew_face, crew_portrait)

    gui_row(style="row-height: 45px;")
    gui_blank()
    gui_row()

    # Re-bind the selected item to the CURRENT consoles list. On game start every
    # client is rerouted through game_started_console, which rebuilds `consoles`
    # with fresh objects (gui_get_console_type_list mints new DictionaryToObjects
    # each call). The carried console_select_item is then stale, and the list box
    # highlights by identity (no __eq__), so the selection was lost on repaint.
    # CONSOLE_SELECT (the path string) survives, so match on it.
    for c in consoles:
        if c.path == CONSOLE_SELECT:
            console_select_item = c
            break

    # THIS is the one that could come back selected-but-invisible. set_value() sets
    # `selected` and never touches `cur`, so unlike the ship list above there is
    # nothing moving the view to the selection -- and a mission can register well
    # over a dozen consoles (helm, weapons, engineering, science, comms, mainscreen,
    # cinematic, hangar, director, gamemaster, display_panels, plus map-gated ones),
    # so the selected console is easily below the fold. `reveal` is the fix here;
    # the hint is what stops it moving on the rebuilds we can capture.
    default console_sel_hint = None
    console_select_lb = gui_list_box(consoles,"item-gap: 0.5em; background:#1572;", item_template=console_select_template, title_template=console_select_title_template, select=True, read_only=console_read_only, reveal=True, hint=console_sel_hint)
    console_select_lb.set_value(console_select_item)

    #
    # Ready state
    #
    default cb_ready = None
    gui_section( style="area: 80,100-60px, 99,100;row-height: 50px;")
    if not GAME_STARTED:
        cb_ready = gui_checkbox("ready", var="console_ready")
        # The game can start while this panel is up, and then this checkbox is a
        # dead control: console_ready is read ONCE, by game_started_console, at the
        # moment the server presses Start. Ticking it afterwards sets a flag nothing
        # reads again - the console looks like it can say ready and cannot. So after
        # the start the tick MEANS "join", exactly like the button below. This is the
        # last line of defence; the repaint below is what normally swaps the control.
        on gui_message(cb_ready):
            jump console_selected if GAME_STARTED and console_ready
            # PRE-GAME ENTRY, for a console that declares it wants one.
            #
            # Most consoles have nothing to do before the mission starts - a helm with no
            # world to fly through is just a screen - so Ready means "I am waiting" and the
            # server's Start is what walks everybody in. But some are SET UP rather than
            # crewed: the Director is a streaming tool, and a streamer opening four windows
            # wants to declare which is program, which is preview and which is the desk
            # BEFORE the mission is running, not while it is.
            #
            # OPT-IN, off the @console label's own metadata, so this file names no addon. A
            # console asks by declaring `pre_game: true`; anything that does not is unchanged.
            # `console_ready` stays True either way, which is what stops the server's start
            # reroute (game_started_console) reading it as False and sending the console back
            # to this picker with its choice thrown away.
            jump console_selected if console_ready and console_select_item is not None and console_select_item.label.get_inventory_value("pre_game")
    else:
        on gui_message(gui_button("ready")):
            console_ready = True
            jump console_selected

    #
    # This panel is BUILT from GAME_STARTED (checkbox before the start, Ready button
    # after), so it has to be rebuilt when GAME_STARTED flips. The server rerouting
    # every client through game_started_console is still the normal way that happens
    # and is unchanged - this is the same console driving the same handover for
    # itself, so a reroute that does not land cannot strand a console on a picker it
    # can no longer act on: checkbox on screen, no way to say ready.
    #
    # game_started_console, not select_console, deliberately: it is the one entry
    # point for "the game just started", so a console that HAS said ready still walks
    # straight into its console, and the console list is re-read there for map-gated
    # consoles. Registered on this build, so it fires at most once - the rebuild it
    # causes registers a fresh one already holding True.
    #
    on change GAME_STARTED:
        jump game_started_console

    # THE SERVER CAN CHANGE THE CREW WHILE THIS PANEL IS UP.
    #
    # The operator picks a roster from the server console's Crew dropdown, which writes
    # `shared CREW_SELECT`. Everything crew on this screen - who the dropdown offers, the
    # portrait, whether the block appears at all - was computed once when the panel was
    # painted, so without this a client that was already sitting on the picker keeps
    # offering the previous roster's people and shows the previous face. It looks like the
    # server's choice did not take.
    #
    # A full repaint rather than an in-place update: the crew block is BUILT conditionally
    # (no roster, no dropdown and no preview at all), so there is not always a widget to
    # update - and `select_console` is the repaint entry the rest of this file already uses.
    on change get_shared_variable("CREW_SELECT", ""):
        jump select_console

    gui_section(style="area: 0,100-50px, 35,100;")
    # The space the text waterfall used to occupy. Before a ship is picked there is
    # nothing to show and it renders empty, which is honest - the alternative was a
    # widget that could not be styled. See LOG_PANEL_PLAN.md.
    gui_log_tail()


    on change PLAYER_COUNT:
        if not GAME_STARTED:
            # The roster owns what the count MEANS - activate or park, never delete.
            player_roster_set_count(int(PLAYER_COUNT))
            ship_list = player_roster_slots()
            ship_select_lb.items = ship_list
            # Keep the selection on the same SLOT if it is still offered, rather than on
            # the same list position - the position moves when the list shortens.
            if client_select_slot in ship_list:
                client_selected_index = ship_list.index(client_select_slot)
            else:
                client_selected_index = min(client_selected_index, len(ship_list)-1)
            # len(ship_list)-1, not len(ship_list): set_selected_index ignores an
            # index that is not < len, so the old clamp silently CLEARED the
            # selection whenever the count shrank past it. The line above already
            # clamps client_selected_index the right way.
            #
            # False so this in-place update does not jump to the top either. It
            # re-arms the reveal, so the next present scrolls the selection into
            # view -- and clamps `cur`, which matters here because the list just
            # got shorter.
            ship_select_lb.set_selected_index(min(client_selected_index, len(ship_list)-1), False)
        

    on change console_select_lb.get_value():
        #
        # Redo gui if change involves helm
        #
        console_select_item = console_select_lb.get_value()
        CONSOLE_SELECT = console_select_item.path
        if not GAME_STARTED:
            console_ready = False
            cb_ready.value = False
        if console_select_item.path == "helm" and not GAME_STARTED:
            gui_show(ship_sec)
            gui_hide(ship_sec_not)
            spick.read_only = SHIP_PICK_READ_ONLY
        elif OPERATOR_MODE_enabled and console_select_item.path == "admin":
            console_ready = True
            jump(console_select_item.label)
        else:
            gui_hide(ship_sec)
            gui_show(ship_sec_not)
            spick.read_only = True

    on signal player_ship_destroyed:
        await delay_app(0)
        # The only rebuild driven from this live page, so the only place a hint can
        # be taken. The others (select_console_clear_ready, game_started_console)
        # are entered from elsewhere with no presented widget to read -- there
        # `reveal` alone carries it, which is why reveal is the fix here and the
        # hint is the bonus.
        console_ship_hint = ship_select_lb.get_selection_hint()
        console_sel_hint = console_select_lb.get_selection_hint()
        jump select_console_clear_ship

    if len(ship_list) >0:
        on change ship_select_lb.get_value():
            # The list hands back a SLOT NUMBER now, not a ship. A slot cannot dangle, so
            # the identity question #443 was about - which of two same-named ships was
            # clicked - is answered without holding anything.
            client_select_slot = ship_select_lb.get_value()
            client_selected_index = ship_select_lb.get_selected_index()
            if client_select_slot is not None:
                _row = player_roster_display(client_select_slot)
                client_select_ship = _row["name"]
                # Kept for the launch-argument path, which carries a name and no slot.
                client_select_ship_id = None
                ship_name = client_select_ship
                ship_type = _row["hull"]
                gui_update("sh_ship_picker", ship_type)
                _display.value = ship_name
                # #545: the editable box has to be told too. It is bound with var=
                # "ship_name", and setting the MAST variable stopped being enough in
                # Cosmos 1.2.7 - so switching ships left the OLD name in the box, and
                # typing one character renamed the NEW ship to it. `_display` beside it
                # was already being pushed this way; the input was simply missed.
                _input.value = ship_name
                # Same absolute-region ghost as the rename path: re-present the
                # whole ship_sec_not region so its clear runs before the redraw.
                gui_represent(ship_sec_not)


        # WAS TWO PER-FRAME ENGINE READS. These were `on change
        # ship_select_lb.get_value().art_id` and `.name` - `on change` evaluates its
        # expression every frame, so each connected console read two properties off a live
        # Agent, forever, on ships the roster may be reshaping underneath it.
        #
        # The roster says when something changed instead. It emits player_roster_changed
        # from apply(), which is the only thing that reshapes a slot.
        on signal player_roster_changed:
            _row = player_roster_display(client_select_slot)
            ship_type = _row["hull"]
            ship_name = _row["name"]
            _input.value = ship_name
            _display.value = ship_name
            gui_update("sh_ship_picker", ship_type)
            gui_update("sh_ship_list", None)
            # _display lives in the ship_sec_not absolute gui_region. Setting its
            # .value only marks the child widget dirty, and the dirty pass re-sends
            # the text into the sub-region WITHOUT a clear - so the old name stays
            # painted under the new one (the ghost). Re-presenting the whole region
            # runs region_begin -> send_gui_clear first, giving a clean redraw.
            gui_represent(ship_sec_not)
            gui_update("sh_ship_list", None)
            
        
            
    await gui()

========== select_console_clear_ship
    client_selected_index = 0
    jump  select_console

# Multiple labels to call to get here
========== select_console_clear_ready
    console_ready = False
    jump  select_console


#
# AUTO_START chose this console, but the server has not started the game yet - the
# in-game RESTART case, where this client was already connected and its client_main ran
# alongside start_server instead of long after it. There is no roster to join yet, so
# walking into the console now attaches to no ship and bounces straight back to the
# picker (see the note in client_main). Wait here for the server's start, which is the
# same position a human sitting at the picker with Ready ticked is in.
#
# NOT console_force_mode: that screen serves `console=<name>;<ship>` on the command line
# and waits indefinitely by design. This one is bounded, because a console that ends up
# here with a server that never starts still has to be recoverable by hand.
#
========== console_auto_start_wait
    _wait_ticks = 0

--- wait
    gui_section(style="area: 0, 40, 100, 60;")
    """
$t {CONSOLE_SELECT} ready

$t Waiting for the server to start the mission
"""
    # delay_app, not delay_sim: the sim is paused until the server starts.
    await gui(timeout = delay_app(1))
    jump game_started_console if GAME_STARTED
    _wait_ticks += 1
    # ~30s. With AUTO_START the server is about a second and a half away, so this is
    # never reached in a healthy launch - it exists so a server that never starts leaves
    # a screen someone can act on rather than a permanent placeholder.
    jump wait if _wait_ticks < 30
    log("auto-start: server never started the mission - showing the picker", "console_select", "warning")
    jump select_console_clear_ready


====== game_started_console ====
    #
    # Every client lands here the moment the server presses Start, and goes straight
    # on to its console. There is deliberately no wait in this label.
    #
    # There used to be one: first two flat `delay_sim(1)`s, then a poll on
    # `players_cleaned`, so that no console was on screen while spawn_players culled
    # the unused hulls and rebuilt the survivors. That was a delay every crew paid on
    # every start to hide something cosmetic - eight identical unused ships stacked on
    # the origin, blinking out. The stack is what got fixed instead: the roster now
    # spawns line abreast (create_default_player_ships in server_console.mast), so
    # there is nothing worth not looking at.
    #
    # What is left is not an ordering question at all. A console is displayable as soon
    # as it has a valid player ship, and it has had one since the server console opened -
    # `create_default_player_ships` builds the whole roster then. The roster is also
    # already FINAL here: `start` fires //shared/signal/reconcile_player_roster before it
    # schedules the map, and a //shared/signal route with no await completes inside the
    # emit. So the ship a console attaches to is the ship it keeps, and there is nothing
    # left to wait for. The map itself is deferred and builds the world from the next
    # frame on; none of it is a precondition for painting a console.
    #
    # `console_selected` still guards on the ship actually resolving
    # (`jump select_console if _ship_id is None`), which is the real check and was always
    # there - the old wait was belt-and-braces on top of it.
    #
    default console_ready = False

    if not console_ready:
        # PICKER path only - this console has not chosen yet, so it goes back to the
        # selection screen rather than to a console.
        #
        # One tick, and only here. The console list was computed at connect time, BEFORE
        # the map ran, so map-gated @console labels were filtered out of it - OU's
        # Navigation and Admiral consoles gate on UNIVERSE_ACTIVE, which its map body
        # sets. With the map deferred, that has not happened yet in this frame, so
        # rebuilding right now would drop those consoles from the list.
        #
        # The assumption, stated plainly: a map sets its console-gating variables in its
        # opening code, before its first yield (OU sets UNIVERSE_ACTIVE on the first line
        # of universe_map_begin), so one tick is enough. This costs nothing anyone
        # notices - it is a menu, not a crew station, and the consoles that DID choose
        # never reach this branch.
        # delay_app, not delay_sim: this is a one-TICK wait, and sim time is the one
        # clock that can be stopped. Everything else in this file that waits around
        # the start already learned that (game_code_reload, console_auto_start_wait,
        # `start` itself) - a sim delay that never fires here leaves the console on
        # the stale picker for good, which is indistinguishable from a hang.
        await delay_app(0)
        consoles = gui_get_console_type_list()
        jump select_console

====== console_selected ====
    # Ask the ROSTER, not a snapshot. Every route into this label - the picker,
    # game_started_console, the //gui/tab routes, console_force_mode - used to arrive
    # carrying whatever client_main captured at CONNECT time, and on an in-game restart
    # with AUTO_START that predates the ships, so a stale empty list silently skipped the
    # whole assignment below. The roster is a live question with no snapshot to go stale.
    _slots = player_roster_slots()
    jump show_console_selected if len(_slots) ==0

    if CONSOLE_SELECT is None or client_select_ship is None:
        jump select_console

    # WHICH ship this console joins. By ID where we have one (#443).
    #
    # This used to match on NAME, and the loop never broke - so with two ships called
    # "Artemis" it ran the whole assignment once per match and the LAST one won. You
    # selected ship 1 and woke up on ship 2. It cost a live event: clients joined ships
    # they had not chosen, and engineering showed one hull's shadows over another's nodes.
    default client_select_ship_id = None
    _ship_id = None
    #
    # BY SLOT FIRST. A slot is the one handle that survives the roster reshaping a ship:
    # a re-hull or a rename keeps the id, but a sim wipe or a respawn does NOT, and an id
    # captured on the picker is stale from that moment on. The slot resolves to whatever
    # ship holds it now.
    #
    # The id below is kept, not replaced - it is still right for everything that has not
    # been re-created, and it is what a console with no slot (a launch argument naming a
    # ship) has to use.
    #
    default client_select_slot = None
    if client_select_slot is not None:
        _slot_ship = player_roster_resolve(client_select_slot)
        if _slot_ship is not None:
            _ship_id = _slot_ship
    if _ship_id is None and client_select_ship_id is not None and object_exists(client_select_ship_id):
        _ship_id = client_select_ship_id
    elif _ship_id is None:
        # No id: a console launched by argument (`helm;Artemis`) carries only a name, and
        # a renamed or destroyed ship can outlive its id. Still by name, but the FIRST
        # match wins and the loop stops - deterministic, and one assignment rather than N.
        for player_ship in to_object_list(role("__PLAYER__")):
            if player_ship.name.lower() == client_select_ship.lower():
                _ship_id = player_ship.id
                break

    # Nothing resolved AND nothing was ever picked: this console never saw the picker,
    # so there is no choice to go back to. That is the AUTO_START restart case - the
    # name was captured before the roster existed - and bouncing to select_console
    # there is what left an auto-started console sitting on the picker. A ship the
    # crew DID pick and that has since gone still falls through to the picker below,
    # which is the right answer for a live player.
    default client_selected_index = 0
    if _ship_id is None and client_select_ship_id is None:
        client_select_slot = _slots[min(client_selected_index, len(_slots)-1)]
        _ship_id = player_roster_resolve(client_select_slot)
        client_select_ship = player_roster_display(client_select_slot)["name"].lower()

    jump select_console if _ship_id is None

    ## unlink previous ship
    old_ship_id = sbs.get_ship_of_client(client_id)
    unlink(old_ship_id, "consoles", client_id)
    # Give up whoever this console was crewing, so the person is free for the next client
    # in this same frame. Occupancy is self-healing anyway - a seat is believed only while
    # the client's CONSOLE_TYPE still agrees with it - so this is promptness, not correctness.
    crew_release(client_id)

    sbs.assign_client_to_ship(client_id, _ship_id)
    # Tell the roster who is aboard. Two things depend on it: release_inactive refuses to
    # delete a slot a console is crewing, and rebind re-runs this assignment if the engine
    # hands that slot a new ship. Bind by the ship's OWN slot rather than the picked one,
    # so a console that arrived by name or by launch argument is registered too.
    client_select_slot = player_roster_slot_of_ship(_ship_id)
    if client_select_slot is not None:
        player_roster_bind(client_select_slot, client_id)
    assign_client_to_alt_ship(client_id, 0)
    #
    # Clear any alt ship e.g. comms give orders
    #
    set_inventory_value(client_id, "2dview_alt_ship", 0)
    link(_ship_id, "consoles", client_id)


    #
    # This should get a skybox with client overriding, shp, overriding shared
    #
    sky_box = get_shared_variable("skybox", "sky1")

    sky_box = get_inventory_value(_ship_id, "skybox", sky_box)
    sky_box = get_inventory_value(client_id, "skybox", sky_box)
    skybox_schedule(sky_box, client_id)

====== show_console_selected ====
    #
    # Make it so the console can be found if needed
    #
    #------------------------------------------------------------------------------------------------------------
    sbs.set_beam_damages(client_id, 7.0, DIFFICULTY)
    #------------------------------------------------------------------------------------------------------------

    # THE FIRST LINE IS THE CLEAR. This is the door every console change in the game
    # comes through, and it used to hand the new station whatever the last one had
    # left on this client: a hero card, a hail band, the science data column. An
    # overlay belongs to the CONSOLE, and this is a jump on the SAME page - the page
    # object survives it, so present_all re-draws the stale card and the catch-up
    # ticker puts it back if anyone clears it by hand.
    #
    # It also gives back a main screen's camera assignment and any viewscreen claim
    # this console was holding, so an officer who walks away from Science mid-shot
    # does not keep the bridge's screen. The role/CONSOLE_TYPE work below is the same
    # work the library door does, left in place because the crew_assign underneath it
    # carries THIS player's own name and face, which the door cannot know about.
    #
    # Entering the console you already are is a no-op, so re-picking the same station
    # does not tear down its own screen.
    gui_console_enter(client_id, CONSOLE_SELECT)

    set_inventory_value(client_id, "CONSOLE_TYPE", CONSOLE_SELECT)
    
    # Remove any console roles
    for k in consoles:
        remove_role(client_id, k.path)
    add_role(client_id, f"console, {CONSOLE_SELECT}")
    
    sbs.set_client_string(client_id, "console_previous", CONSOLE_SELECT)

    # WHO IS AT THIS CONSOLE.
    #
    # crew_assign resolves the whole chain - what this person chose, then a roster bound to
    # this ship, selected for this game, or declared by a mod for this hull - and publishes
    # CREW_NAME with exactly the meaning it has always had, so the Director's <<crew_name>>
    # overlay and the Gamemaster's message list keep reading it unchanged. It also takes the
    # seat, so a second client opening this same station gets the NEXT person rather than
    # the same one.
    #
    # With no roster declared anywhere this resolves to what was typed, or to "" - which is
    # precisely what these two lines used to do on their own.
    # The ship the ENGINE says this client is on, not `_ship_id`: show_console_selected is
    # also entered by a direct jump (the headless exerciser does exactly that), and a task
    # variable set by the picker's own walk-through is not defined on that path.
    crew_ship_id = sbs.get_ship_of_client(client_id)
    crew_post = crew_assign(client_id, crew_ship_id, CONSOLE_SELECT, own_name=crew_name, own_face=crew_face, own_portrait=crew_portrait, own_pick=crew_pick)

    # ONLY WHAT THIS HUMAN CHOSE goes to a client string. They persist per MACHINE, in
    # client_string_set.txt, so writing a RESOLVED name here would follow this PC into every
    # future console of every future mission - and being tier 1 of the resolution, nothing
    # could ever dislodge it.
    sbs.set_client_string(client_id, "crew_name", crew_name)
    sbs.set_client_string(client_id, "crew_self", crew_self_pack(crew_pick, crew_face, crew_portrait))

    #
    #
    #
    # gui_tab_clear_top()
    if ALLOW_CONSOLE_TABS:
        tab = CONSOLE_SELECT.upper()
        tabs = tab
        # Force the selected console to now be enabled
        set_variable(f"{tab}_TAB_ENABLED", True)
        rem_tabs = ""
        for con_tab in TAB_CONSOLES:
            con_tab = con_tab.upper()
            if get_variable(f"{con_tab}_TAB_ENABLED"):
                tabs = con_tab + "," + tabs
            else:
                rem_tabs = con_tab + "," + rem_tabs
        gui_tab_add_top(tabs)
        
        gui_tab_remove_top(rem_tabs)



    # Retrieve the item by string (because might have navigator here via tab)
    console = gui_get_console_type(CONSOLE_SELECT)
    if console is not None:
        jump(console.label)
    else:
        """ Invalid Console defined and selected"""
        await gui()

=========== debug_mast =========

    task_count = 0
    for sch in mast.schedulers:
        for tsk in sch.tasks:
            task_count += 1

    gui_section( style="area: 0,50px, 100,100;")
    """""
    Task count {task_count}
    """"""
    await gui(timeout=timeout(4))

    jump debug_mast



======= console_force_mode

    jump game_started_console if GAME_STARTED

    # "media/helm/consoles0001"
    _images = console_get_images(CONSOLE_SELECT)
    _image = 0


--- loop
    gui_section( style=f"area: 0, 76, 100, 100;")
    """
$t Console assigned to {CONSOLE_SELECT}

$t on ship {client_select_ship}
"""
    jump no_images if len(_images)==0

    gui_section( style=f"area: 0, 0, 100, 76;")
    gui_image_keep_aspect_ratio_center(_images[_image])
    _image += 1 
    _image %= len(_images)

    # Remember delay_app is needed her because the sim
    # may not be running
    await gui(timeout = delay_app(10))

    # Leave under our OWN power once the game is up. The server's
    # gui_reroute_clients(game_started_console) is the normal exit and still is, but a
    # holding screen whose only door is opened from outside strands the console for the
    # whole mission if that reroute is ever missed - and with AUTO_START there is no
    # picker behind it to fall back to.
    jump game_started_console if GAME_STARTED
    jump loop

--- no_images
    # Same door, on a shorter clock: this branch has no image cycle to wake it, so it
    # polls rather than sitting in a bare await gui() that only an event can end.
    await gui(timeout = delay_app(1))
    jump game_started_console if GAME_STARTED
    jump no_images

#
# Allow the tabs to be available
#
//gui/tab/helm
    CONSOLE_SELECT= "helm"
    jump console_selected 

//gui/tab/comms
    CONSOLE_SELECT= "comms"
    jump console_selected 

//gui/tab/engineering
    CONSOLE_SELECT= "engineering"
    jump console_selected 

//gui/tab/science
    CONSOLE_SELECT= "science"
    jump console_selected 

//gui/tab/weapons
    CONSOLE_SELECT= "weapons"
    jump console_selected 

//gui/tab/hangar
    CONSOLE_SELECT= "hangar"
    jump console_selected 


# ---------------------------------------------------------------------------------------
# AT THE END OF THE FILE ON PURPOSE.
#
# A MAST label FALLS THROUGH into the next one. These two sat between `console_selected`
# and `show_console_selected`, so the ship-assignment block stopped falling into the
# console and fell into the avatar editor instead - every console selection, including the
# reroute when the server presses Start, opened the face builder.
#
# Here they follow `//` routes, which do not fall through, so the only way in is the jump
# from the Edit Face button. `test_console_select_fallthrough.py` pins the pair that broke.
# ---------------------------------------------------------------------------------------
===== crew_edit_avatar =====
    # Hand the GUI task to the avatar editor and ask for it back. The editor is built for
    # exactly this - `av_return` is its documented "run inline in an existing GUI task and
    # come back" form - so it repaints over this screen and jumps home on Done.
    #
    # Only reachable from a button that is only built when CREW_AVATAR_EDITOR says the addon
    # is loaded. A jump to a label nothing defines compiles clean and would only fail if it
    # ever RAN, so the guard on the button is the whole guard needed.
    # HAND IT THE FACE THEY ALREADY HAVE, so the editor opens on them rather than on a
    # stranger. `crew_face` first - that is what the preview beside the button is showing -
    # then whatever they were last actually assigned, which is where an automatic face lives
    # once they have opened a console. Empty is fine; the editor starts from its defaults.
    av_face = crew_face
    if not av_face:
        av_face = get_inventory_value(client_id, "CREW_FACE", "")
    # Only used when the face does not name its own race, which it does whenever there is one.
    av_race = crew_avatar_race(client_select_ship_id)
    av_title = "YOUR AVATAR"
    av_return = "crew_edit_done"
    jump avatar_editor_show

===== crew_edit_done =====
    # A face you BUILT replaces a picked person, explicitly and in both directions: the
    # portrait goes because a photograph and a built face are two answers to one question,
    # and the pick goes because you are now yourself rather than somebody off the roster.
    crew_face = AVATAR_FACE
    crew_portrait = ""
    crew_pick = ""
    crew_choice = ""
    jump select_console
