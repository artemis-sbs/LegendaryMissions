#
# ePADD - one console tab that holds the apps.
#
# The library owns the registry and the home screen; this is the route that reaches
# it, because sbs_utils ships no .mast of its own. Four lines of it are the stub every
# mission needs; the rest is the app registrations.
#
# ALWAYS ON. It used to be behind EPADD_ENABLED, defaulting off, and that setting went
# when apps became their own route kind. An app is a `//gui/app` route now, not a tab,
# so turning the PADD off no longer falls back to the classic strip - it leaves Cargo,
# Fabricate, Help, Library, Quests and Upgrades with no way in at all. Declaring the
# `//gui/app/epadd` route below IS the opt-in.
#
# Claim the app icon NAMES for our own sheet - 4 x 4 cells of 128px, white on
# transparent like the engine's own, so `color:` still does all the tinting. The
# built-in sheet was tried first and is game-icons.net art: Help is a pointing
# hand, Airwing an unreadable blob, and `wanted` has the word baked into the
# glyph. Nothing that DRAWS an icon knows where it came from, so a mod can
# re-point any of these names at its own art and every tile follows.
#
# NAMESPACED, deliberately. The icon registry is one flat namespace and these are
# claims on it: a bare `brain` would take over the built-in glyph (index 5) for
# everything else that draws it, and a bare `cargo`/`help`/`debug` would be an
# addon claiming a word every other addon might want. Dotted names are the
# convention the registry already uses for meanings (`quest.job`, `list.expand`).
gui_icon_add_atlas_grid(media_shared("epadd/icons"), 4, 5, cell=128, names=[
    "epadd.cargo", "epadd.fabricate", "epadd.upgrades", "epadd.quests",
    "epadd.library", "epadd.help", "epadd.airwing", "epadd.casino",
    "epadd.damage", "epadd.hangar", "epadd.comms_log", "epadd.standings",
    "epadd.debug", "epadd.mast", "epadd.brain", "epadd.coverage",
    "epadd.messages", "epadd.status", "epadd.away"])

# Presentation for the tabs LM ships. An unknown icon name draws nothing and says
# so once, so an app can be registered before anyone has drawn its glyph.
# The badge is what a crew reads WITHOUT opening anything - the whole reason the
# apps that carry live state do not each need a panel on the bridge.
# Load this addon's mail once. A top-level `shared` assignment runs once (the
# server runs the top level first), but the statements around it run for EVERY
# client - so the pump is guarded rather than merely placed here.
default shared EPADD_MAIL_LOADED = False
if not EPADD_MAIL_LOADED:
    shared EPADD_MAIL_LOADED = True
    message_load_amd(document_get_amd_file(None, "Messages", content=media_read_relative_file("messages.amd")))
    task_schedule(epadd_mail_pump)

# The board: the same badges the tiles show, gathered and larger. An app with
# nothing to report is left out, so this stays a board rather than a second
# launcher.
# The way down and the way back. An app rather than a console, which is what lets
# the PADD replace the away screen: the crew carry it with them, and whatever job
# apps a mission adds sit beside this one.
gui_app_register("away_team", title="Away Team", icon="epadd.away", group="Ship",
                 sort=1, description="Join a landing party, or come back",
                 status=lm_epadd_away, away=True)
# SHIP, not Mission. Status reports what the SHIP is telling you - its own description
# says so - and Messages is mostly the crew talking to each other. Mission is for the
# things that outlive this hull: the jobs, the lore, the help.
gui_app_register("status", title="Status", icon="epadd.status", group="Ship",
                 sort=2, description="What the ship is telling you",
                 status=lm_epadd_reporting)
gui_app_register("messages", title="Messages", icon="epadd.messages",
                 group="Ship", sort=3, description="From the crew, and from home",
                 status=lm_epadd_unread, away=True)
gui_app_register("help", title="Help", icon="epadd.help", group="Mission", sort=90,
                 description="How this console works", away=True)
gui_app_register("library", title="Library", icon="epadd.library", group="Mission",
                 sort=80, description="Codex, lore and ship records", away=True)
gui_app_register("quest", title="Quests", icon="epadd.quests", group="Mission", sort=10,
                 description="Jobs offered, taken and running", away=True)
gui_app_register("upgrade", title="Upgrades", icon="epadd.upgrades", group="Ship",
                 sort=30, description="Installed and available refits")
gui_app_register("cargo", title="Cargo", icon="epadd.cargo", group="Ship", sort=10,
                 consoles="engineering", description="Hold manifest")
gui_app_register("fabricate", title="Fabricate", icon="epadd.fabricate", group="Ship",
                 sort=20, consoles="engineering",
                 description="Beacons, parts, build queue")
# NO SECOND FABRICATION TILE. `//gui/app/fabrication` is the older screen, and it read
# item-def `craft_cost` metadata directly while Fabricate read the AMD recipe registry -
# two tiles for one idea, and in LegendaryMissions and the TNG missions the second was
# EMPTY, because nothing there declares craft_cost. StormsBeacon does, so the path could
# not just be deleted: `fabrication_recipes()` folds those item craftables into the list
# Fabricate already shows (`craft_cost: 8` is `Inputs: salvage x8`), and the route stays
# reachable for a mission that jumps to it by name.
gui_app_register("airwing", title="Airwing", icon="epadd.airwing", group="Ship", sort=40,
                 consoles="hangar", description="Craft, pilots, sortie board")
gui_app_register("casino", title="Casino", icon="epadd.casino", group="Ship", sort=50,
                 consoles="hangar", description="Table games and the bar tab")
# ONE TILE, AND IT KEEPS ITS DRILL-DOWN. `debug` is the app; `brain` and `mast`
# stay TABS that the debug screen enables for itself (debug.mast), and their
# `gui_tab_back("debug")` resolves because a back target may name an app. So the
# Systems tile opens Debug and Debug still carries its own two sub-tabs on the bar.
# Registering them as apps too would put three tiles on the PADD and lose the
# nesting - and, now that they are tabs, would warn about a missing //gui/app route.
#
# GATED HERE, because the ROUTES are not: `debug` carries no condition of its own,
# and the classic strip kept it out of a shipped build by putting
# gui_tab_add_top("debug") inside `if is_dev_build()`. A registration replaces that
# gating, so it has to carry it.
if is_dev_build():
    gui_app_register("debug", title="Debug", icon="epadd.debug", group="Systems",
                     sort=10, description="Dev build only")


== epadd_mail_pump ==
--- pump
    await delay_sim(15)
    lm_epadd_deliver_mail()
    jump pump


# The condition is the whole gating. A mission with no landing parties in it put a
# button reading "No landing party" on all six consoles, which a playtest called what
# it was - noise. A route's own `if` is what ePADD tests when it builds the app list,
# the same way casino and brain gate themselves, so no new mechanism is needed.
//gui/app/away_team if away_relevant()
    jump epadd_away_screen

=== epadd_away_screen
    # ONE GUI TAB, and it is the way back to the console. The PADD adds nothing to
    # the strip and changes nothing about it - it declares a back tab like any
    # other screen and the bar draws it the way it always has. Removing this line
    # is what forced the strip to synthesise a back entry, which is what kept
    # breaking the bar's own back button.
    gui_tab_back(CONSOLE_SELECT)
    gui_away_screen()
    # Beaming down or up changes who this console is, which changes every other app -
    # so the same polled counter the inbox uses drives this one.
    on change message_revision():
        jump epadd_away_screen
    await gui()
    ->END


//gui/app/status
    jump epadd_status_screen

=== epadd_status_screen
    # ONE GUI TAB, and it is the way back to the console. The PADD adds nothing to
    # the strip and changes nothing about it - it declares a back tab like any
    # other screen and the bar draws it the way it always has. Removing this line
    # is what forced the strip to synthesise a back entry, which is what kept
    # breaking the bar's own back button.
    gui_tab_back(CONSOLE_SELECT)
    gui_status_screen()
    # Same reason: a board of live readings that never repaints is a photograph.
    on change message_revision():
        jump epadd_status_screen
    await gui()
    ->END


//gui/app/messages
    jump epadd_messages_screen

=== epadd_messages_screen
    # ONE GUI TAB, and it is the way back to the console. The PADD adds nothing to
    # the strip and changes nothing about it - it declares a back tab like any
    # other screen and the bar draws it the way it always has. Removing this line
    # is what forced the strip to synthesise a back entry, which is what kept
    # breaking the bar's own back button.
    gui_tab_back(CONSOLE_SELECT)
    gui_messages_screen()
    # A SIGNAL DOES NOT WAKE `await gui()`. The inbox is a live panel - mail arrives
    # while it is open, and picking a different message has to redraw the pane beside
    # the list - so it watches a counter, exactly as the away console watches
    # away_seq(). message_revision() moves on new mail, an answer, a read mark and
    # this console's own selection.
    #
    # AND IT UPDATES, RATHER THAN REBUILDS. This used to `jump` back to this label,
    # which tears down and redraws the entire page - chrome, list, reading pane and
    # compose line - because one number moved. gui_messages_tick() touches only what
    # changed: the listbox re-renders its own rows from `items`, and the reading pane
    # is a sub-section refilled on its own.
    on change message_revision():
        gui_messages_tick()
    await gui()
    ->END


//gui/app/epadd
    jump epadd_home_screen

=== epadd_home_screen
    # The back button is how you leave the PADD, and the strip consumes the
    # declaration every build - so this is re-declared here, like every tab screen.
    # ONE GUI TAB, and it is the way back to the console. The PADD adds nothing to
    # the strip and changes nothing about it - it declares a back tab like any
    # other screen and the bar draws it the way it always has. Removing this line
    # is what forced the strip to synthesise a back entry, which is what kept
    # breaking the bar's own back button.
    gui_tab_back(CONSOLE_SELECT)
    # Held as an OBJECT, never as an intermediate string: a string assignment is
    # re-run through f-string formatting, so a brace in a name would raise here.
    _epadd_ship = to_object(sbs.get_ship_of_client(client_id))
    gui_app_home(ship_name=_epadd_ship.name if _epadd_ship is not None else "")
    # A signal does not wake await gui(). Without this the home screen was frozen at
    # whatever it said when it was opened: mail arriving never moved the Messages
    # badge, and an app whose route condition turned on never appeared.
    on change gui_app_revision():
        jump epadd_home_screen
    await gui()
    ->END
