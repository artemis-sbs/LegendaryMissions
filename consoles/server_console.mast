========== start_server ===============

    default shared SETTINGS = settings_get_defaults()
    shared WORLD_SELECT  = SETTINGS.get("WORLD_SELECT")
    shared MAP_SIZE  = SETTINGS.get("MAP_SIZE", "Medium")
    shared TERRAIN_SELECT  = SETTINGS.get("TERRAIN_SELECT")
    shared LETHAL_SELECT  = SETTINGS.get("LETHAL_SELECT")
    shared FRIENDLY_SELECT  = SETTINGS.get("FRIENDLY_SELECT")
    shared MONSTER_SELECT  = SETTINGS.get("MONSTER_SELECT")
    shared UPGRADE_SELECT  = SETTINGS.get("UPGRADE_SELECT")
    shared seed_value  = SETTINGS.get("seed_value")
    # Packed hull+name-per-slot loadout carried by a game code (empty = none).
    # spawn_players rehydrates it; the Save-preset icon captures the live crew.
    shared SHIP_LOADOUT  = SETTINGS.get("SHIP_LOADOUT", "")
    shared GAME_STARTED  = SETTINGS.get("GAME_STARTED")
    shared GAME_ENDED  = SETTINGS.get("GAME_ENDED")
    shared GAME_TIME_LIMIT  = str(SETTINGS.get("GAME_TIME_LIMIT", ""))
    shared WAR_TIME_DELAY  = str(SETTINGS.get("WAR_TIME_DELAY", ""))
    # Default in case story.mast set these?
    default shared DIFFICULTY=   SETTINGS.get("DIFFICULTY")
    default shared PLAYER_CREATE_DEFAULT  = SETTINGS.get("PLAYER_CREATE_DEFAULT")
    default shared PLAYER_COUNT  = SETTINGS.get("PLAYER_COUNT")
    default shared PLAYER_LIST  =  SETTINGS.get("PLAYER_LIST")

    default shared AUTO_START = SETTINGS.get("AUTO_START", False)

    shared OPERATOR_MODE = SETTINGS.get("OPERATOR_MODE", {"enable": False})
    shared OPERATOR_MODE_enabled = OPERATOR_MODE.get("enable", False)
    shared operator_show_logo_on_main = OPERATOR_MODE.get("show_logo_on_main", False)

    # This make it dependaent of Fleets
    #start_npc_cag()

    shared skybox = skybox_schedule_random()
    #
    # Music no longer rides the skybox label's body - a skybox sets the sky and nothing
    # else. This is the LOBBY pick; `start` re-resolves it if the map or the operator
    # asked for something specific.
    #
    # MUSIC_SELECT is deliberately NOT written to shared scope here. Leaving the shared
    # var absent is what lets a map's `Defaults: MUSIC_SELECT` (set-if-absent) and the
    # dropdown below claim it - seeding it from settings would lock both out.
    #
    shared music = music_schedule_select(SETTINGS.get("MUSIC_SELECT", "random"))

    shared mission_index = 0
    shared mission_list = maps_get_list()
    shared mission_overview = maps_get_init()
    shared WORLD_SELECT_path  = SETTINGS.get("WORLD_SELECT")

    # A map named on the ENGINE COMMAND LINE wins, and starts without the picker:
    #     Artemis3-x64-release.exe autostartserver defaultmission=LM_TestRange map=sandbox
    # `map=` is not an engine flag - engine 1.3.5 passes unrecognized key=value arguments
    # straight through to command_line_dict(), which is what makes this possible at all.
    # This is the engine-side twin of cosmos_dev's --map, so an automated run and a headless
    # one select a map the same way. maps_find accepts an index, a path, a display name or
    # an unambiguous substring, and returns None rather than guessing between two matches.
    cli_map = command_line_get("map")
    if cli_map is not None:
        cli_selected = maps_find(cli_map)
        if cli_selected is None:
            log(f"command line map '{cli_map}' matched no map - showing the picker", "server_console", "warning")
        else:
            WORLD_SELECT_path = cli_selected.path
            AUTO_START = True
    sim_create()
    #
    # Yield a frame before create_sides. sim_create() replaces the simulation, but
    # FrameContext.context.sim still holds the handle the engine passed in at the top of
    # THIS event and sbs exposes no module-level sim to re-read, so every sim.* write made
    # in this same frame - set_side_relationship / set_side_icon_color /
    # set_diplomacy_color, i.e. the whole engine-facing half of create_sides - is written
    # against the pre-sim_create simulation and lost SILENTLY. Nothing raises: spawns
    # survive because they go through module-level sbs.* functions, so the mission looks
    # fine except that contacts draw as UNKNOWN (grey) with no allied/hostile split.
    #
    # NOT delay_app(0): Delay(0) sets timeout = time.time() and done() is
    # `timeout < time.time()`, so if the system clock ticks over between the await node's
    # enter() and its first poll() the await resolves in the SAME tick and never yields
    # (measured ~4 in 5000). Any delay above the clock granularity yields unconditionally.
    #
    # Ordering is unchanged - player ships and the menu still come after create_sides
    # within this task, just one frame later.
    await delay_app(0.1)
    #
    # Create the sides + diplomacy BEFORE player ships and before any map runs,
    # so side keys like "tsn" resolve. The //signal/create_sides route is
    # synchronous (no await), so sides exist when this returns. (Was a
    # //shared/signal/game_started route that raced spawn_players.)
    signal_emit("create_sides")
    # Create standard missile types - NEW use prefab system
    # sbs.set_shared_string("Homing","gui_text:Homing;  speed:10; lifetime:25; flare_color:white; trail_color:white;warhead:standard;damage:35; explosion_size:10;explosion_color:fire; behavior:homing; energy_conversion_value:100")
    # sbs.set_shared_string("Nuke"  ,"gui_text:Nuke  ;  speed:10; lifetime:25; flare_color:white; trail_color:#99f;warhead:blast; blast_radius:1000; damage:5; explosion_size:20;explosion_color:fire; behavior:homing; energy_conversion_value:200")
    # sbs.set_shared_string("EMP"   , "gui_text:EMP  ;  speed:10; lifetime:25; flare_color:yellow; trail_color:#99f;warhead:blast,reduce_shields; blast_radius:1000; damage:50; explosion_size:20;explosion_color:#11F; behavior:homing; energy_conversion_value:50")
    # sbs.set_shared_string("Mine"  , "gui_text:Mine ;  speed:10; lifetime:25; flare_color:white; trail_color:white; warhead:blast; blast_radius:1000; damage:5; explosion_size:20; explosion_color:fire; behavior:mine; energy_conversion_value:200")
    prefab_spawn(prefab_homing_torpedo)
    prefab_spawn(prefab_mine_torpedo)
    prefab_spawn(prefab_emp_torpedo)
    prefab_spawn(prefab_nuclear_torpedo)
    # New Torpedo types. Tag shuts down Skaraan elite abilities for 180s. 
    # PShocks destroys unshielded ships.
    prefab_spawn(prefab_pshock_torpedo)
    prefab_spawn(prefab_tag_torpedo)
    # Beacon: general fabricate-only ordnance (no station build_times). Fires like a harmless
    # mine; the real broadcasting beacon is spawned aft on //launch/missile (see fabrication).
    prefab_spawn(prefab_beacon_torpedo)

    #
    # Create all the player ships
    # 

    await task_schedule(create_default_player_ships)
    #
    # Make sure the scan sources update system runs
    extra_scan_sources_schedule()

    # sim_pause()
    i = 0
    for m in mission_list:
        if m.path == WORLD_SELECT_path:
            mission_index = i
            break
        i += 1
    shared WORLD_SELECT = mission_list[mission_index]

    jump operator_main_screen if OPERATOR_MODE_enabled and operator_show_logo_on_main


#
# The Server GUI
#
====== show_server_menu =====
    #
    jump start if AUTO_START

    #
    # if there is a single mission or a map/__init__
    # Use it for the start text
    if mission_overview is not None:
        START_TEXT = """$t {mission_overview.display_name}:\n\n{mission_overview.desc}"""

    gui_section( style="area: 0, 50px, 100, 95;padding:10px,0;background:#1578;")
    
    gui_row("row-height: 160px")
    with gui_sub_section( style="padding:10px,0, 10px;background:#1578;"):
        gui_text_area(START_TEXT)

        # For using a seed value when randomly generating terrain, not currently implemented
        #row style="row-height:65px;"
        #"""justify:right;$text:Seed (Optional)"""
        #gui_input("""desc: Integer""", var="seed_value")

    rs= "row-height: 45px;margin:5px,5px,0,0;"
    ts= "row-height: 45px;col-width: 7em;margin:0,2px, 0,0;"
    gui_row(style="padding:10px,20px, 10px")
    with gui_sub_section():
        l = len(mission_list)
        if l >1:
            MISSIONS_TITLE = "Select a mission. {l} types."
        else:
            MISSIONS_TITLE = "Mission"
        mission_picker = gui_list_box(mission_list,"item-gap: 7em; background:#1578;", item_template=main_mission_select_template, title_template=MISSIONS_TITLE, select=True, carousel=True)
        # Initialize the selection to account for if we already have one
        mission_picker.set_selected_index(mission_index)

        WORLD_SELECT = mission_picker.get_value()

        on change mission_picker.get_selected_index():
            # This should be one thing, or None
            WORLD_SELECT = mission_picker.get_value()
            mission_index = mission_picker.get_selected_index()
            jump show_server_menu
        gui_blank(1, "col-width: 20px")
    #
    # Demo only has DIFFICULTY
    #
    #
    with gui_sub_section():
        # Game code controls, stacked above the options in the same column: pick
        # a saved preset to load it instantly; the Save / Copy / Load icon
        # buttons store the current setup as a per-map preset or move the code
        # to/from the clipboard to share. Presets persist (separated by map) in
        # game_code_presets.yaml. See procedural/maps.py game_code_*.
        # NOTE: icon_index values are placeholders - change them to the
        # save/copy/load glyphs you want from the icon atlas.
        default GAME_CODE_PRESET = ""
        default GAME_CODE_NAME = ""
        presets = game_code_presets_for_map(WORLD_SELECT.path)
        preset_labels = [p["name"] for p in presets]
        gui_row("row-height: 30px;")
        # Show the SELECTED preset, like every other dropdown in the mission
        # ($text: {VAR}). This was the literal string "Presets (N)", so whenever
        # GAME_CODE_PRESET did not resolve to a list entry the widget fell back to that
        # label - and players read it as an option that was not in the list ("Presets (3)"
        # with three named presets). Interpolated inline rather than via an intermediate
        # variable: a bare MAST string assignment is re-run through f-string formatting,
        # and a preset name is user-typed text that may contain a brace.
        preset_dd = gui_drop_down(f"$text: {GAME_CODE_PRESET or 'Presets'}; list: {','.join(preset_labels)}", var="GAME_CODE_PRESET")
        on gui_message(preset_dd):
            for p in presets:
                if p["name"] == preset_dd.value:
                    game_code_decode(p["code"])
                    jump game_code_reload

        # Optional name for the next saved preset; blank -> auto "Preset N".
        name_in = gui_input("desc: Preset name;", var="GAME_CODE_NAME")
        save_ic = gui_icon("icon_index: 94; color: white;", "click_tag: gc_save;")
        on gui_message(save_ic):
            # Capture the current crew's hulls + names into SHIP_LOADOUT so the
            # saved preset reproduces the same ships for the next crew.
            player_loadout_capture(to_object_list(role("default_player_ship")))
            game_code_presets_save_code(game_code_encode(WORLD_SELECT), GAME_CODE_NAME)
            jump game_code_reload
        # copy_ic = gui_icon("icon_index: 134; color: white;", "click_tag: gc_copy;")
        # on gui_message(copy_ic):
        #     gui_clipboard_put(game_code_encode(WORLD_SELECT))
        # load_ic = gui_icon("icon_index: 95; color: white;", "click_tag: gc_load;")
        # on gui_message(load_ic):
        #     loaded = game_code_decode(gui_clipboard_get())
        #     if loaded is not None and loaded in mission_list:
        #         mission_index = mission_list.index(loaded)
        #         jump show_server_menu

        # Seed the selected map's Defaults (set-if-absent shared vars) BEFORE the panel renders,
        # so a map-local property var (e.g. JOBS_SELECT) shows its starting value instead of
        # blank/0. Settings.yaml / story / game-code values already set are left untouched.
        map_apply_defaults(WORLD_SELECT)

        # Music. The list comes from music_get_list(), not a fixed one, so a mod that ships
        # its own banks shows up here without this file knowing about it. It sits AFTER
        # map_apply_defaults so a map's `Defaults: MUSIC_SELECT` is what reads as the
        # current pick.
        #
        # Interpolated inline, like the preset dropdown above and for the same reason: a
        # bare MAST string assignment is re-run through f-string formatting, and a display
        # name comes from whatever mod declared the label.
        gui_row("row-height: 30px;")
        music_choices = music_get_list()
        gui_blank(1, "col-width: 6em;")
        music_dd = gui_drop_down(f"$text: {get_shared_variable('MUSIC_SELECT', SETTINGS.get('MUSIC_SELECT', 'random'))}; list: {','.join(['random'] + [m.display_name for m in music_choices])}")
        on gui_message(music_dd):
            shared MUSIC_SELECT = music_dd.value

        gui_row()
        gui_property_list_box(name="Options")
        p = map_get_properties(WORLD_SELECT)
        if sbs.is_demo():
            p = """
Main:
    Difficulty: 'gui_int_slider("$text:int;low: 1.0;high:11.0", var="DIFFICULTY")'
"""
        gui_properties_set(p)


    
    


    await gui():
        + "Start Mission":
            -> start


#
# Rebuild the server menu one frame after applying/saving a game code. A
# same-frame rebuild (jump straight from the dropdown's on-message) can race
# the event and leave the property panel showing the old values; waiting a
# frame lets it repaint with the loaded values. delay_app (wall clock) is used
# because the start screen's sim may be paused, which would stall delay_sim.
#
===== game_code_reload =====
    await delay_app(1)
    jump show_server_menu


===== start ======
    # AUTO_START (headless / dev launch) can reach here BEFORE the story's top-level
    # `main` has finished: @map labels register at COMPILE time, so the console is ready
    # to launch while the `default shared` assignments in main have not run. Launching
    # then emits game_started against a story with no shared state, so any route whose
    # `if` reads one raises - autoplay's
    # `//signal/game_started if SETTINGS.get("AUTO_PLAY", ...)` died with
    # `name 'SETTINGS' is not defined`. A human never hits it: they click Start long
    # after main. So settle only on the automated path, and only here on the launch -
    # NOT in show_server_menu, where waiting stalls the server GUI task itself.
    #
    # delay_app (wall clock), not delay_sim: the start screen's sim is PAUSED, so a sim
    # delay never fires - the same reason game_code_reload above uses delay_app.
    if AUTO_START:
        await delay_app(1)
    # sim_create()
    sim_resume()
    #
    # Based on the game type call the right 
    # label to build the world
    #

    tl = safe_int(GAME_TIME_LIMIT)
    if tl >0:
        set_timer(SHARED, "time_limit", minutes=tl)

    #------------------------------------------------------------------------------------------------------------
    # Player = 7 points of damage, npc = a range 3.5 - 8.5 
    sbs.set_beam_damages(0, 7.0, (DIFFICULTY/2.0) + 3.0)


    if WORLD_SELECT is not None:
        # Re-apply the map's Defaults on the launch path: AUTO_START reaches `start` without
        # ever presenting the panel, so this guarantees the map body's vars exist (set-if-absent,
        # so anything the operator changed on the panel is preserved).
        map_apply_defaults(WORLD_SELECT)
        #
        # The operator's dropdown or the map's `Defaults: MUSIC_SELECT` outranks the lobby
        # pick. Absent both, the lobby's choice STANDS rather than re-rolling - re-rolling
        # here would change the track the moment the game started, every time.
        #
        music_pick = get_shared_variable("MUSIC_SELECT", "")
        if music_pick:
            shared music = music_schedule_select(music_pick)
        #
        # ROSTER BEFORE WORLD. //shared/signal/reconcile_player_roster (fleets/map_common.mast)
        # culls the roster to PLAYER_COUNT and applies any game-code loadout. It needs nothing
        # the map builds, and a //shared/signal route with no await runs synchronously inside
        # signal_emit - the same property the create_sides emit above relies on - so the roster
        # is final by the time this line returns. Must be AFTER map_apply_defaults, which is
        # what settles PLAYER_COUNT.
        #
        # This is what makes the deferred schedule below safe.
        signal_emit("reconcile_player_roster")
        #
        # DEFERRED on purpose, and this is the point of the whole exercise. The map body is the
        # mission's entire opening burst - stations, minefields, NPCs, terrain, fleets - and
        # scheduled inline it all ran inside the frame that handled this button, before a single
        # console repainted. Nothing down there is a precondition for showing a console: a
        # console needs a valid player ship, and it has had one since the server console opened.
        # So the map gets the next frame and the crew gets this one.
        #
        # The visible cost is that players are still in their staging formation for a frame or
        # two before the map moves them to a starbase.
        task_schedule(WORLD_SELECT, defer=True)

    #
    # Consoles are waiting to be started 
    #
    GAME_STARTED = True
    signal_emit("game_started", {})


    # Temp set this when first running
    shared SIM_STATE = "sim_unknown"

    PLAYER_LIST = sorted(to_object_list(role("__player__")), key=lambda p: p.id)
    if len(PLAYER_LIST)>0:
        sbs.assign_client_to_ship(0, PLAYER_LIST[0].id)
        
    gui_reroute_clients(game_started_console, exclude={client_id})
    #
    # This is very coupled to operator mode
    #
    # This is a remote
    if client_id != 0:
        gui_reroute_server(show_main_game_screen_server)
        gui_reroute_client(client_id, operator_stats)

=== show_main_game_screen_server
    ship_id = sbs.get_ship_of_client(client_id)
    link(ship_id,"consoles", client_id)
    add_role(client_id, "console, mainscreen")

=== show_main_game_screen === 

    # Just restate the console, it looks internally for the proper view
    # To override use gui_activate_console, and gui_widget_list
    # MAIN_SCREEN_VIEW variable has the view: 3d_view, info, data
    # MAIN_SCREEN_FACING has the facing right, left, front, back
    # MAIN_SCREEN_MODE is for 3d (first_person, chase, tracking) 2d (long, short)


    # This let the sim move the ships 
    # and avoid seeing some stuff be created 
    # at 0,0,0
    await delay_sim(0)
    # Find a valid ship. NOT sbs.get_ship_of_client: while science has this screen
    # showing something ("on screen"), the console is ASSIGNED to the subject - the
    # engine only honors a camera change when the console and the lens ride the same
    # object - so get_ship_of_client would answer with the ENEMY here, and this label
    # would then read the enemy's main-screen state and link it as a console owner.
    # viewscreen_home_ship answers with our own ship either way. VIEWSCREEN_PLAN.md
    ship_id = viewscreen_home_ship(client_id)

    gui_console("mainscreen")
    set_inventory_value(client_id, "CONSOLE_TYPE", "mainscreen")
    link(ship_id,"consoles", client_id)
    # The ROLE has to be set as well as CONSOLE_TYPE. Anything that addresses an
    # audience narrows with any_role(...) -- overlays (hero cards, lower thirds,
    # banners), announce(), comms targeting -- so a screen with CONSOLE_TYPE but no
    # role is invisible to all of them and the message is dropped in silence.
    # Safe: common_console_select removes every console role before adding the new
    # one, so this cannot leave a stale mainscreen on a console that moved away.
    add_role(client_id, "console, mainscreen")



    ######################################
    resume_controls = gui_region("area: 5, 75, 95, 90;")

    with resume_controls:
        gui_text("$text: Simulation paused;font:gui-6;justify:center;")
        gui_row()

        mission = get_mission_name()
        start_mission = get_startup_mission_name()
        if start_mission is not None:
            same = mission == start_mission

        if start_mission is None:
            same = True
            start_mission = mission

        # if same only two buttons
        if same:
            gui_blank()

        b = gui_button("$text:Resume;justify:center;", style="padding:0,0,5px;")
        on gui_message(b):
            sim_resume()
            

        mission = get_mission_name()

        # start_mission
        if mission:
            b2 = gui_button("$text:restart {mission};justify:center;", style="padding:0,0,5px;")
            on gui_message(b2):
                sbs.run_next_mission(mission)

        if start_mission is not None and start_mission != mission and len(start_mission)>0:
            b3 = gui_button("$text:mission_select;justify:center;") # , style="padding:0,0,5px;")
            on gui_message(b3):
                sbs.run_next_mission(start_mission)

        # if same only two buttons
        if same:
            gui_blank()

    if SIM_STATE == "sim_running":
        gui_hide(resume_controls)

    on change SIM_STATE:
        if SIM_STATE == "sim_running":
            gui_hide(resume_controls)
        else:
            gui_show(resume_controls)
    ######################
    # view = get_variable("MAIN_SCREEN_VIEW", "3d_view")
    # facing = get_variable("MAIN_SCREEN_FACING", "front")
    # mode = get_variable("MAIN_SCREEN_MODE", "chase")

    # Rework of mainscreen stuff:

    view = get_inventory_value(ship_id, "MAIN_SCREEN_VIEW", "3d_view")
    facing = get_inventory_value(ship_id, "MAIN_SCREEN_FACING", "front")
    mode = get_inventory_value(ship_id, "MAIN_SCREEN_MODE", "chase")
    ###
    ### TODO: This is a fix for 
    ### Clients sending THEIR mode, not 
    ### This client's mode
    ### So this will ignore cinematic

    default my_mode = "chase"

    if mode == "cinematic":
        mode = my_mode
    else:
        my_mode = mode

    sbs.set_main_view_modes(client_id, view, facing, mode)

    # A 2D shot reflows the radar to leave the data column's gutter free. Only the 2D
    # view can do this - the engine draws 3dview full-bleed, so there the column is an
    # overlay on top of it. Same rect either way, so the crew's eye does not move when
    # the mode changes.
    if viewscreen_mode(ship_id) == "tactical":
        gui_section(style="area:0,0,71,100;")
        gui_row()
        gui_layout_widget("2dview")

    # An incoming hail put on the main screen builds NOTHING here. Both forms are
    # overlays now - a full-screen one for a portrait or a still, a smaller band for an
    # orbit shot - so this console does not move a single engine widget. It used to push
    # the views offscreen, and gui_widget_offscreen parks a widget at 100,100 with
    # nothing to put it back: the 3D view never returned, and ship_data, which was never
    # moved, sat on top of the conversation.

    # Science changed what is on screen: repaint, because the widget list itself differs
    # between a 3D shot and a 2D one. Scoped to THIS ship - one bridge's viewer must not
    # repaint another's.
    on signal viewscreen:
        jump show_main_game_screen if VIEWSCREEN_SHIP == ship_id

    # A hail arriving, advancing or ending changes this screen the same way, and the
    # widget list differs too, so it is a full repaint rather than a value update.
    # Polled for the same reason the comms console polls it - see standard_consoles.mast.
    on change hail_console_revision(client_id):
        jump show_main_game_screen

    await gui()





====  pause_screen ====
    jump operator_stats if OPERATOR_MODE_enabled

    gui_section( style="area: 5, 10, 50, 90;")
    """""Simulation paused"""""

    await gui():
    + "Resume Mission":
        sim_resume()

    jump pause_screen
    ##############


#
# Create the default player ships from the settings roster when PLAYER_CREATE_DEFAULT
# is set. Extracted from server_start so it can be REUSED - e.g. re-established after a
# clean sim reset in a conformance test - rather than being inline-only in the server
# startup.
#
# Reads SETTINGS directly rather than the shared PLAYER_LIST. That shared name carries
# TWO unrelated things: the settings roster of dicts (seeded at the top of start_server)
# and, in common_console_select / start, the LIVE player objects from
# to_object_list(role("__player__")). A console-select screen that builds before the ships
# exist assigns [] over the roster, so this loop then iterates zero times and no player
# ships are ever created -- and because the seed is `default shared` (set-if-absent), a
# later start_server does NOT restore it, so the failure is STICKY for the whole engine
# process: every restart after the first stays broken.
#
# Diagnosed in-engine via debug.log: CREATE_DEFAULT=True but PLAYER_LIST_len=0 at this
# point, where a fresh session reports 8. The symptom is a mission where the game ends
# the instant it starts (destroyed_all(role("__player__")) is true immediately) and every
# console-select shows "No Player Ships" (the len(PLAYER_LIST)==0 branch).
#
# This was the only remaining consumer of the roster meaning, so reading SETTINGS here
# leaves the shared name meaning exactly one thing (live objects) everywhere it is used.
#
#
# Creation is keyed by SLOT (player_ensure), so running this twice re-uses the roster
# instead of doubling it. It used to spawn unconditionally, so a second run produced 16
# ships -- and a re-entered start_server was measured taking a live session from 8 to 33.
# Keying on the slot rather than a did-I-run flag is what keeps the deliberate re-runs
# working: after a sim wipe the ships are gone and this rebuilds them (the reuse case the
# comment above describes), and a run that died partway completes the set. Ships already
# present are returned untouched, so faces/respawn_time are re-applied but nothing moves.
#
=== create_default_player_ships
    # A new roster is by definition not reconciled yet. This clears the latch on
    # //shared/signal/reconcile_player_roster (fleets/map_common.mast), so a roster
    # rebuilt after a sim wipe gets culled again without needing a special case.
    shared players_cleaned = False
    if PLAYER_CREATE_DEFAULT:
        # (side creation is done synchronously before this via create_sides, so the
        # player_spawn side lookups resolve.)
        #
        # Line abreast, NOT a pile on the origin. The whole roster exists from the moment
        # the server console opens, because the crew picks among them - but only the first
        # PLAYER_COUNT survive spawn_players. So for the entire selection screen, and for
        # the first frames after Start, the unused hulls are real visible objects. Spawned
        # at 0,0,0 they were a stack of identical ships sitting exactly where the camera
        # starts, which is what made them conspicuous both while they sat there and at the
        # moment they winked out. Spread on a row they read as a staging formation, and one
        # of them disappearing is unremarkable.
        #
        # This is the fix for that; it is not a delay. Consoles used to wait out the purge
        # behind a `players_cleaned` poll (game_started_console) purely so nobody watched
        # it happen. Make the thing not worth hiding and the wait is not needed.
        #
        # Centred on the origin, so the group's centre of mass is where it has always been
        # and a mission that never repositions its players is unaffected. The half-step
        # that centring produces, plus the Z offset, means no slot ever lands exactly on
        # 0,0,0 for any roster size, odd or even. Maps move these near a friendly station
        # in spawn_players, so the formation only has to hold up until then.
        _roster = SETTINGS.get("PLAYER_LIST")
        _slot_gap = 2000
        _slot_mid = (len(_roster)-1)/2.0
        for slot, player_ship_data in enumerate(_roster):
            _slot_x = (slot - _slot_mid) * _slot_gap
            player_ship = player_ensure(slot, _slot_x, 0, 2000, player_ship_data["ship"], player_ship_data["name"], player_ship_data["side"])
            player_ship_data["id"] = player_ship
            add_role(player_ship, "default_player_ship")
            set_face(player_ship, random_face(player_ship_data["face"]))
            set_inventory_value(player_ship, "respawn_time", 5)
    # ONE emit, after the roster is complete. This used to sit inside the loop, so the
    # branches disagreed: 8 emits when creating defaults, 1 otherwise -- and every
    # handler ran 8 times, seeing a half-built roster on all but the last.
    signal_emit("create_player_ships", None)
    ->END


