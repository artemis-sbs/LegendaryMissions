==== elite_jump_drive_back
" Activate jump drive forward
metadata: ```
type: elite/jump/back
display_name: Teleport Back
distance: -5000
warm_up: 30
cool_down: 30
warm_up_text: Preparing to teleport backward
```
    jump elite_jump_drive


==== elite_jump_drive
    so = to_object(ELITE_ID)
    yield FAIL if so is None

# Execute the jump
    eo = to_engine_object(ELITE_ID)
    _pos_eo = eo.pos
    sbs.particle_at(_pos_eo, "align:False; offset:0,0,200;color:blue; lifespan:50; image_cell:9; size:10; speed: 2; count:1000")
    # Assumes the distance is set but if not use this default
    default distance = 5000

    _forward = Vec3(eo.forward_vector())
    _pos = Vec3(_pos_eo) + (_forward * distance)
    _pos.y = _pos_eo.y
    so.pos = _pos

    yield SUCCESS


=== elite_warp_start === 
" Activate warp drive forward
metadata: ```
type: elite/warp
display_name: Warp
warm_up: 25
cool_down: 30
warm_up_text: Preparing to engage warp drive
abort_if_target_within: 500
```
    so = to_object(ELITE_ID)
    yield FAIL if so is None

# get the warp multiplier and time
    warp_factor = get_inventory_value(ELITE_ID, "elite_warp_multiplier", 2)
    warp_time = get_inventory_value(ELITE_ID, "elite_warp_time", 60)
    # Temporary speed boost as a timed modifier: it auto-expires after warp_time,
    # restoring speed_coeff even if the ship is deleted mid-warp. (The old manual
    # save/restore skipped the restore on a null blob after the await, leaving a
    # permanently fast ship.) Additive value factor-1 gives x(factor).
    modifier_add(ELITE_ID, "speed_coeff", warp_factor - 1, "elite_warp", duration=warp_time)
    await delay_sim(warp_time)
    yield SUCCESS


=== elite_turn_start === 
" Activate highly efficient turn
metadata: ```
type: elite/eft
display_name: HET
cool_down: 10
```
    # No `warm_up:`, deliberately. A turn is a reflex, not a plan - one of the
    # spontaneous abilities, so there is nothing for Science to see coming.

--- ready
    # Triple turn rate via a timed modifier (additive 2.0 -> x3), auto-restored
    # after 30s. Matches items/item_defs.mast; no manual save/restore to leak.
    modifier_add(ELITE_ID, "turn_upgrade_coeff", 2.0, "elite_het", duration=30)
    await delay_sim(30)
    yield SUCCESS

==== elite_tractor_start ===
" Activate tractor - snare the nearest enemy so it cannot flee. Hauls the
" target in and holds it a couple of hull-lengths off for the active window,
" then releases and starts the cooldown. Matches the other abilities' timings.
metadata: ```
type: elite/tractor
display_name: Tractor
cool_down: 10
```
    yield FAIL if ELITE_ID is None or not object_exists(ELITE_ID)

    # Target the closest non-friendly ship in range.
    local = broad_test_around(ELITE_ID, 2500, 2500, 0xF0)
    # closest() returns a CloseData (or None), not an id - take its .id/.distance.
    tgt = closest(ELITE_ID, local - role(get_side(ELITE_ID)))
    yield FAIL if tgt is None
    target_id = tgt.id
    yield FAIL if not object_exists(target_id)

    # Haul the target in and park it a couple of hull-lengths off, rather than handing
    # the engine one connection and walking away - a tether left attached reels its
    # target all the way into the source hull whatever pull distance it was given, and
    # a target sitting inside the elite is what made the beam particle look wrong.
    # elite_tractor_pull() does one tick of that: hard pull outside the standoff, beam
    # cut inside it.
    hold = elite_tractor_hold_distance(ELITE_ID, target_id)

    # Visible tether particle on the held target for the duration.
    emittor_id = None
    target_eo = to_engine_object(target_id)
    if target_eo is not None:
        emittor_id = sbs.add_particle_emittor(target_eo, -1, "align:True; shape:hull; color:green,white; lifespan:4; image_cell:0,3; size:0.8; speed: 5; count:10")

    task_schedule(elite_update_science_status, {"ELITE_ID": ELITE_ID, "status": "Caught in a tractor beam"})

    # Hold for the active window, driving the beam as we go.
    set_timer(ELITE_ID, "tractor_hold", 30)
--- hold
    await delay_sim(0.25)
    jump clear if not elite_tractor_pull(ELITE_ID, target_id, hold)
    jump hold if not is_timer_finished(ELITE_ID, "tractor_hold")

--- clear
    # Release the tractor and tidy the particle.
    elite_tractor_release(ELITE_ID, target_id, emittor_id)

    # The catch is loose, so stop telling Science it is held. An ability that puts a
    # line on the status tab owns taking it down again.
    elite_charge_clear(ELITE_ID)
    yield SUCCESS

