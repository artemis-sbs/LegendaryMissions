# Ship interiors, migrated from data/grid_data.json.
#
# One ASCII floor plan per hull - see sbs_utils/GRID_ASCII_FORMAT.md. The hull
# outline in each file is the ENGINE's own is_grid_point_open, captured by the
# LM_TestRange 'PROBE hull map' map, so a room cannot sit outside the hull.
#
# Regenerate rather than hand-editing the outline; rooms are yours to move.
provides interiors_ximni

grid_merge_ascii(media_read_relative_file("xim_avenger.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_battleship.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_carrier.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_corsair.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_corvette.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_destroyer.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_dreadnought.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_escort.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_light_carrier.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_light_cruiser.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_missile_cruiser.grid"), "interiors_ximni")
grid_merge_ascii(media_read_relative_file("xim_scout.grid"), "interiors_ximni")
