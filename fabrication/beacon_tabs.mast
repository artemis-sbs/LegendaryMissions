# ==========================================================================
# Engineering tabs: FABRICATE (a general recipe fabricator) and CARGO (a general inventory
# manager). Two linked tabs sharing the ship inventory, each a list box + detail panel
# (item_gui.mast style). They only emit //shared/signal intents; the workflow lives in
# beacon_workflow.mast / fabrication.mast. Beacons are one KIND of recipe/cargo, not the
# whole story: Fabricate lists every recipe (beacon + material), Cargo lists everything the
# ship carries (beacons + items + materials). The Weapons officer simply tells the engineer
# which beacon to make -- there is no request signal. The generic salvage-crafting
# //gui/tab/fabrication is separate and unchanged.
# ==========================================================================
default CONSOLE_SELECT = ""

# The Fabricate/Cargo tabs are CONTENT only (the //gui/tab/fabricate and //gui/tab/cargo
# routes below); they are SCOPED by being ENABLED per console, not added globally. Do NOT
# call gui_tab_add_top("fabricate"/"cargo") -- that adds them to EVERY console. Enabling
# from the Engineering activation hook (//gui/normal_engi) is what limits them to
# Engineering, exactly like the Casino scopes itself from //gui/hangar. See GUI.md
# "Adding a console tab (the clean, per-console way)".
//gui/normal_engi
    gui_tab_enable("fabricate")
    gui_tab_enable("cargo")

# --- FABRICATE: list box of ALL recipes (left) + detail panel (right). Beacon recipes show
# the program selectors (monster + attract/repel) and build via beacon_build; other recipes
# just build their Output into inventory via fabricate_recipe. ---
//gui/tab/fabricate
--- fab_repaint
    gui_tab_back(CONSOLE_SELECT)
    gui_activate_console("fabricate")
    ship_id = sbs.get_ship_of_client(client_id)
    default fab_sel_key = None

    fab_items = fabrication_recipes()
    if fab_sel_key is None and len(fab_items) > 0:
        fab_sel_key = fab_items[0]["key"]
    # resolve the selected recipe (index for the highlight, dict for the detail)
    fab_idx = -1
    fab_sel = None
    fab_i = 0
    for fab_it in fab_items:
        if fab_it["key"] == fab_sel_key:
            fab_idx = fab_i
            fab_sel = fab_it
        fab_i = fab_i + 1
    if fab_sel is None and len(fab_items) > 0:
        fab_sel = fab_items[0]
        fab_idx = 0
        fab_sel_key = fab_sel["key"]

    # is the selected recipe a beacon? which build timer applies?
    fab_is_beacon = False
    fab_timer = "beacon_fab"
    if fab_sel is not None:
        fab_is_beacon = fab_sel["output"] == "Beacon"
        if not fab_is_beacon:
            fab_timer = "fab_" + fab_sel_key
    fab_building = False
    if fab_sel is not None:
        fab_building = not is_timer_finished(ship_id, fab_timer)

    # LEFT: recipe list box. reveal keeps a restored selection on screen; hint keeps
    # it in the same slot. Like the upgrades tab this one self-ticks ONCE A SECOND
    # while a build is running, so a scrolled recipe list snapped to the top every
    # second -- with a long recipe book that is the whole list moving under you.
    default fab_sel_hint = None
    gui_section(style="area: 5, 12, 45, 100; background:#1572;")
    fab_box = gui_list_box(fab_items, "item-gap: 0.1em;", item_template=recipe_row, title_template=recipe_title, select=True, reveal=True, hint=fab_sel_hint)
    if fab_idx >= 0:
        fab_box.set_selected_index(fab_idx, False)
    on change fab_box.get_value():
        fab_v = fab_box.get_value()
        fab_sel_key = fab_v["key"] if fab_v is not None else None
        # From THIS widget, before the jump -- it holds the view and never presents
        # again once the page is rebuilt.
        fab_sel_hint = fab_box.get_selection_hint()
        jump fab_repaint

    # RIGHT (top): selected recipe name
    gui_section(style="area: 47, 12, 95, 24;")
    if fab_sel is not None:
        fab_nm = fab_sel["name"]
        """color:#8cf; justify:center; font:gui-4; $text: {fab_nm}"""
    else:
        """color:#aaa; justify:center; $text: No recipes."""

    # RIGHT (middle): description + input cost
    gui_section(style="area: 47, 25, 95, 55; background:#1571;")
    if fab_sel is not None:
        fab_desc = fab_sel["desc"]
        fab_cost = recipe_inputs_text(fab_sel)
        gui_text_area("{fab_desc}")
        """color:#8a8; $text: Cost: {fab_cost}"""

    # RIGHT (program): a property grid built from the recipe's declared Properties -- the same
    # gui_property_list_box + gui_properties_set pattern a map's Properties panel uses. The grid
    # controls bind var= to the client TASK scope (per-client, not shared -- gui_drop_down uses
    # task.get_id()). Seed each property's default set-if-absent BEFORE the panel renders so the
    # controls have a starting value.
    gui_section(style="area: 47, 57, 95, 80;")
    fab_pnames = []
    fab_pdefs = {}
    if fab_sel is not None:
        fab_pnames = recipe_property_names(fab_sel)
        fab_pdefs = recipe_property_defaults(fab_sel)
    if len(fab_pnames) > 0:
        for fab_pn in fab_pnames:
            if get_variable(fab_pn) is None:
                set_variable(fab_pn, fab_pdefs[fab_pn])
        gui_property_list_box("Program")
        gui_properties_set(recipe_property_grid(fab_sel))

    # RIGHT (action band): Build / building countdown / need materials
    gui_section(style="area: 47, 82, 95, 92;")
    if fab_sel is not None and fab_building:
        fab_t = format_time_remaining(ship_id, fab_timer)
        """color:#ff0; justify:center; $text: building {fab_t}"""
    elif fab_sel is not None and fabrication_recipe_affordable(ship_id, fab_sel_key):
        fab_btn = gui_button("$text:Build;justify:center;", data={"rk": fab_sel_key, "rb": fab_is_beacon, "rnames": fab_pnames, "rdefs": fab_pdefs})
        on gui_message(fab_btn):
            if rb:
                fab_prog = {}
                for fab_rn in rnames:
                    fab_val = get_variable(fab_rn)
                    if fab_val is None:
                        fab_val = rdefs[fab_rn]
                    fab_prog[fab_rn] = fab_val
                signal_emit("beacon_build", {"ship_id": ship_id, "recipe": rk, "program": fab_prog})
            else:
                signal_emit("fabricate_recipe", {"ship_id": ship_id, "key": rk})
    elif fab_sel is not None:
        """color:#888; justify:center; $text: need materials"""

    on signal item_changed:
        fab_sel_hint = fab_box.get_selection_hint()
        jump fab_repaint
    if fab_building:
        await gui(timeout=delay_sim(1))
    else:
        await gui()
    # After await gui() returns, never before it: a listbox has no view until it has
    # presented, so a hint taken at build time carries nothing. This is also the
    # 1-second build tick, so it is the capture that matters most here.
    fab_sel_hint = fab_box.get_selection_hint()
    jump fab_repaint

# --- CARGO: list box of ALL carried cargo (left) + detail panel (right). Beacons offer
# Deliver to Weapons + Eject; items/materials offer Eject. ---
//gui/tab/cargo
--- cargo_repaint
    gui_tab_back(CONSOLE_SELECT)
    gui_activate_console("cargo")
    ship_id = sbs.get_ship_of_client(client_id)
    default cargo_sel_cid = None

    car_items = cargo_list(ship_id)
    if cargo_sel_cid is None and len(car_items) > 0:
        cargo_sel_cid = car_items[0]["cid"]
    # resolve the selected cargo entry
    car_idx = -1
    car_sel = None
    car_i = 0
    for car_it in car_items:
        if car_it["cid"] == cargo_sel_cid:
            car_idx = car_i
            car_sel = car_it
        car_i = car_i + 1
    if car_sel is None and len(car_items) > 0:
        car_sel = car_items[0]
        car_idx = 0
        cargo_sel_cid = car_sel["cid"]

    # LEFT: cargo list box
    gui_section(style="area: 5, 12, 45, 100; background:#1572;")
    if len(car_items) == 0:
        """color:#888; $text: Cargo hold empty."""
    default cargo_sel_hint = None
    car_box = gui_list_box(car_items, "item-gap: 0.1em;", item_template=cargo_row, title_template=cargo_title, select=True, reveal=True, hint=cargo_sel_hint)
    if car_idx >= 0:
        car_box.set_selected_index(car_idx, False)
    on change car_box.get_value():
        car_v = car_box.get_value()
        cargo_sel_cid = car_v["cid"] if car_v is not None else None
        cargo_sel_hint = car_box.get_selection_hint()
        jump cargo_repaint

    # RIGHT (top): selected cargo name
    gui_section(style="area: 47, 12, 95, 30;")
    if car_sel is not None:
        car_nm = car_sel["name"]
        """color:#8cf; justify:center; font:gui-4; $text: {car_nm}"""

    # RIGHT (actions): beacon -> Deliver + Eject; item/material -> Eject
    gui_section(style="area: 47, 40, 95, 68;")
    # Both act on the cargo INDEX, not on the beacon's (kind, monster, mode): two Sensor
    # Beacons differing only in beacon_range are indistinguishable to such a match, and the
    # workflow would deliver whichever came first. The list is rebuilt on item_changed, so
    # the index a click carries is the one the row was painted with.
    if car_sel is not None and car_sel["ckind"] == "beacon":
        car_dv = gui_button("$text:Deliver to Weapons;justify:center;", data={"bi": car_sel["cidx"]})
        on gui_message(car_dv):
            signal_emit("beacon_deliver", {"ship_id": ship_id, "bidx": bi})
        car_ej = gui_button("$text:Eject;justify:center;", data={"bi": car_sel["cidx"]})
        on gui_message(car_ej):
            signal_emit("beacon_eject", {"ship_id": ship_id, "bidx": bi})
    elif car_sel is not None:
        car_ejg = gui_button("$text:Eject;justify:center;", data={"gk": car_sel["key"]})
        on gui_message(car_ejg):
            signal_emit("cargo_eject", {"ship_id": ship_id, "key": gk})

    # A cargo hold changes from under the player constantly -- salvage picked up,
    # a beacon delivered, an eject. Every one of those rebuilds this list.
    on signal item_changed:
        cargo_sel_hint = car_box.get_selection_hint()
        jump cargo_repaint
    await gui()
    cargo_sel_hint = car_box.get_selection_hint()
    jump cargo_repaint
