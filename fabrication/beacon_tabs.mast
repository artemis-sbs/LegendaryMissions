# ==========================================================================
# Engineering tabs for the beacon/cargo workflow: FABRICATE (pick a recipe + program, build)
# and CARGO (deliver a built beacon to Weapons, or eject). Two linked tabs sharing the ship
# inventory, each a list box + detail panel (item_gui.mast style). They only emit the
# //shared/signal intents; beacon_workflow.mast does the work. The Weapons officer simply
# TELLS the engineer which beacon to make -- there is no request signal. The generic
# //gui/tab/fabrication (salvage crafting) is separate and unchanged.
# ==========================================================================
default CONSOLE_SELECT = ""
gui_tab_add_top("fabricate")
gui_tab_add_top("cargo")

# Show both tabs on the Engineering console.
//gui/normal_engi
    gui_tab_enable("fabricate")
    gui_tab_enable("cargo")

# --- FABRICATE: a list box of beacon recipes (left) + a detail panel with the program
# selectors (monster + attract/repel) and a Build action (right). ---
//gui/tab/fabricate
--- fab_repaint
    gui_tab_back(CONSOLE_SELECT)
    gui_activate_console("fabricate")
    ship_id = sbs.get_ship_of_client(client_id)
    default fab_monster = "shark"
    default fab_mode = "attract"
    default fab_sel_key = None
    fab_building = not is_timer_finished(ship_id, "beacon_fab")

    # the selectable items = beacon recipes (output "Beacon")
    fab_items = []
    for fab_r in fabrication_recipes():
        if fab_r["output"] == "Beacon":
            fab_items.append(fab_r)
    if fab_sel_key is None and len(fab_items) > 0:
        fab_sel_key = fab_items[0]["key"]
    # resolve the selected recipe (index for the highlight, dict for the detail)
    fab_idx = -1
    fab_sel = None
    fab_i = 0
    for fab_it in fab_items:
        if fab_it["key"] == fab_sel_key:
            fab_idx = fab_i
            fab_sel = fab_it
        fab_i = fab_i + 1
    if fab_sel is None and len(fab_items) > 0:
        fab_sel = fab_items[0]
        fab_idx = 0
        fab_sel_key = fab_sel["key"]

    # LEFT: recipe list box
    gui_section(style="area: 5, 12, 45, 100; background:#1572;")
    fab_box = gui_list_box(fab_items, "row-height: 0.1em;", item_template=recipe_row, title_template=recipe_title, select=True)
    if fab_idx >= 0:
        fab_box.set_selected_index(fab_idx, False)
    on change fab_box.get_value():
        fab_v = fab_box.get_value()
        fab_sel_key = fab_v["key"] if fab_v is not None else None
        jump fab_repaint

    # RIGHT (top): selected recipe name
    gui_section(style="area: 47, 12, 95, 24;")
    if fab_sel is not None:
        fab_nm = fab_sel["name"]
        """color:#8cf; justify:center; font:gui-4; $text: {fab_nm}"""
    else:
        """color:#aaa; justify:center; $text: No beacon recipes."""

    # RIGHT (middle): description + input cost
    gui_section(style="area: 47, 25, 95, 55; background:#1571;")
    if fab_sel is not None:
        fab_desc = fab_sel["desc"]
        fab_cost = recipe_inputs_text(fab_sel)
        gui_text_area("{fab_desc}")
        """color:#8a8; $text: Cost: {fab_cost}"""

    # RIGHT (program): monster + attract/repel the built beacon will carry
    gui_section(style="area: 47, 57, 95, 80;")
    gui_row()
    """col-width: 7em; $text: Monster"""
    fab_dd = gui_drop_down(f"$text:{fab_monster};list:shark,dragon,piranha,leech,charybdis,grazer,any", var="fab_monster")
    gui_row()
    """col-width: 7em; $text: Effect"""
    fab_rb = gui_radio("attract,repel", var="fab_mode")

    # RIGHT (action band): Build / building countdown / need materials
    gui_section(style="area: 47, 82, 95, 92;")
    if fab_sel is not None and fab_building:
        fab_t = format_time_remaining(ship_id, "beacon_fab")
        """color:#ff0; justify:center; $text: building {fab_t}"""
    elif fab_sel is not None and fabrication_recipe_affordable(ship_id, fab_sel_key):
        fab_btn = gui_button("$text:Build;justify:center;", data={"rk": fab_sel_key, "rm": fab_monster, "rd": fab_mode})
        on gui_message(fab_btn):
            signal_emit("beacon_build", {"ship_id": ship_id, "recipe": rk, "monster": rm, "mode": rd})
    elif fab_sel is not None:
        """color:#888; justify:center; $text: need materials"""

    on signal item_changed:
        jump fab_repaint
    if fab_building:
        await gui(timeout=delay_sim(1))
    else:
        await gui()
    jump fab_repaint

# --- CARGO: a list box of built beacons (left) + a detail panel with Deliver / Eject (right). ---
//gui/tab/cargo
--- cargo_repaint
    gui_tab_back(CONSOLE_SELECT)
    gui_activate_console("cargo")
    ship_id = sbs.get_ship_of_client(client_id)
    default cargo_sel = 0
    car_built = get_inventory_value(ship_id, "beacon_built", [])
    if cargo_sel >= len(car_built):
        cargo_sel = 0
    car_sel = None
    if len(car_built) > 0:
        car_sel = car_built[cargo_sel]

    # LEFT: built-beacon list box
    gui_section(style="area: 5, 12, 45, 100; background:#1572;")
    if len(car_built) == 0:
        """color:#888; $text: No built beacons. Fabricate one first."""
    car_box = gui_list_box(car_built, "row-height: 0.1em;", item_template=beacon_cargo_row, title_template=beacon_cargo_title, select=True)
    if len(car_built) > 0:
        car_box.set_selected_index(cargo_sel, False)
    on change car_box.get_value():
        car_v = car_box.get_value()
        car_j = 0
        for car_b in car_built:
            if car_b is car_v:
                cargo_sel = car_j
            car_j = car_j + 1
        jump cargo_repaint

    # RIGHT: selected beacon detail + actions
    gui_section(style="area: 47, 12, 95, 30;")
    if car_sel is not None:
        car_mon = car_sel["monster"]
        car_mode = car_sel["mode"]
        """color:#8cf; justify:center; font:gui-4; $text: {car_mode} beacon / {car_mon}"""
    gui_section(style="area: 47, 40, 95, 62;")
    if car_sel is not None:
        car_dv = gui_button("$text:Deliver to Weapons;justify:center;", data={"bk": car_sel["kind"], "bm": car_sel["monster"], "bd": car_sel["mode"]})
        on gui_message(car_dv):
            signal_emit("beacon_deliver", {"ship_id": ship_id, "kind": bk, "monster": bm, "mode": bd})
        car_ej = gui_button("$text:Eject;justify:center;", data={"ek": car_sel["kind"], "em": car_sel["monster"], "ed": car_sel["mode"]})
        on gui_message(car_ej):
            signal_emit("beacon_eject", {"ship_id": ship_id, "kind": ek, "monster": em, "mode": ed})

    on signal item_changed:
        jump cargo_repaint
    await gui()
    jump cargo_repaint
