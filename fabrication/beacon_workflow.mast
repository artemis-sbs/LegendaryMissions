# ==========================================================================
# Beacon acquisition workflow (in the fabrication addon).
# --------------------------------------------------------------------------
# Slow, comms-heavy by design -- the coordination is the two humans talking: the Weapons
# officer TELLS the engineer what to make; Engineering picks that spec on the Fabricate tab
# and BUILDS it via a data-driven recipe into a managed build inventory, then DELIVERS one to
# Weapons -- which is what puts a loadable round in the tube. The console tabs only emit these
# //shared/signal intents; the server-side state changes live here so they run once.
#
# Per-ship state (inventory unless noted):
#   beacon_built           : list of {kind, monster, mode} built-but-undelivered beacons
#   Beacon_NUM  (DATA_SET) : the loadable tube count -- ONLY delivery raises it
#   beacon_program_queue   : FIFO of {kind, monster, mode}, one per delivered-but-unfired round
# Recipes are data (recipes.py + beacon_recipes.amd): a recipe gives the input cost, build
# time, and the beacon KIND; the monster + attract/repel come from the Weapons request.
# ==========================================================================

# --- build: Engineering fabricates a beacon via its data-driven recipe ---
# (Weapons just tells the engineer what to make; there is no request signal.)
//shared/signal/beacon_build
    bw_recipe = fabrication_get_recipe(recipe)
    ->END if bw_recipe is None
    ->END if not is_timer_finished(ship_id, "beacon_fab")
    ->END if not fabrication_recipe_consume(ship_id, recipe)
    bw_time = bw_recipe["time"]
    bw_kind = bw_recipe["program"].get("kind", "bio")
    set_timer(ship_id, "beacon_fab", seconds=bw_time)
    task_schedule(beacon_build_done, {"ship_id": ship_id, "kind": bw_kind, "recipe": recipe, "monster": monster, "mode": mode, "btime": bw_time})
    ->END

== beacon_build_done
    await delay_sim(btime)
    ->END if to_object(ship_id) is None
    # credit the built beacon into the managed build inventory
    bw_built = get_inventory_value(ship_id, "beacon_built", [])
    bw_built.append({"kind": kind, "monster": monster, "mode": mode})
    set_inventory_value(ship_id, "beacon_built", bw_built)
    comms_broadcast(ship_id, f"Beacon built: {mode} {monster} (ready to deliver)", "#0f8")
    signal_emit("item_changed", {"holder_id": ship_id})
    ->END

# --- deliver: hand ONE built beacon to Weapons -> loadable round + queued program ---
//shared/signal/beacon_deliver
    bw_built = get_inventory_value(ship_id, "beacon_built", [])
    bw_keep = []
    bw_prog = None
    for bw_b in bw_built:
        if bw_prog is None and bw_b["kind"] == kind and bw_b["monster"] == monster and bw_b["mode"] == mode:
            bw_prog = bw_b
        else:
            bw_keep.append(bw_b)
    ->END if bw_prog is None
    set_inventory_value(ship_id, "beacon_built", bw_keep)
    # raise the ship's loadable tube count (DATA_SET), capped at Beacon_MAX
    bw_num = get_data_set_value(ship_id, "Beacon_NUM")
    if bw_num is None:
        bw_num = 0
    bw_max = get_data_set_value(ship_id, "Beacon_MAX")
    if bw_max is None:
        bw_max = 99
    if bw_num < bw_max:
        set_data_set_value(ship_id, "Beacon_NUM", bw_num + 1)
    # queue the program so the fired round carries this behaviour (FIFO, matches fire order)
    bw_q = get_inventory_value(ship_id, "beacon_program_queue", [])
    bw_q.append(bw_prog)
    set_inventory_value(ship_id, "beacon_program_queue", bw_q)
    comms_broadcast(ship_id, f"Beacon delivered to tube: {mode} {monster}", "#0cf")
    signal_emit("item_changed", {"holder_id": ship_id})
    ->END

# --- eject: jettison a built beacon into space (inert, but recoverable by fly-over) ---
//shared/signal/beacon_eject
    bw_built = get_inventory_value(ship_id, "beacon_built", [])
    bw_keep = []
    bw_found = None
    for bw_b in bw_built:
        if bw_found is None and bw_b["kind"] == kind and bw_b["monster"] == monster and bw_b["mode"] == mode:
            bw_found = bw_b
        else:
            bw_keep.append(bw_b)
    ->END if bw_found is None
    set_inventory_value(ship_id, "beacon_built", bw_keep)
    task_schedule(beacon_spawn_aft, {"sp_ship": ship_id, "sp_kind": kind, "sp_monster": monster, "sp_mode": mode, "sp_live": False})
    comms_broadcast(ship_id, "Cargo ejected", "#888")
    signal_emit("item_changed", {"holder_id": ship_id})
    ->END
