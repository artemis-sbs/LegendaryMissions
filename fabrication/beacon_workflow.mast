# ==========================================================================
# Beacon acquisition workflow (in the fabrication addon).
# --------------------------------------------------------------------------
# Slow, comms-heavy by design -- the coordination is the two humans talking: the Weapons
# officer TELLS the engineer what to make; Engineering picks that spec on the Fabricate tab
# and BUILDS it via a data-driven recipe into a managed build inventory, then DELIVERS one to
# Weapons -- which is what puts a loadable round in the tube. The console tabs only emit these
# //shared/signal intents; the server-side state changes live here so they run once.
#
# Per-ship state (inventory unless noted):
#   beacon_built           : list of program dicts, the built-but-undelivered beacons
#   Beacon_NUM  (DATA_SET) : the loadable tube count -- ONLY delivery raises it
#   beacon_program_queue   : one program per delivered-but-unfired round
# The stock Beacon tube holds ONE round (default_max_count: 1 on prefab_beacon_torpedo), so
# the count IS the program. Delivery is the queue's only writer and launch its only reader,
# and delivery refuses when the tube is full, so len(queue) == Beacon_NUM by construction --
# no cap to re-check anywhere else. Recovery deliberately pays in MATERIALS rather than a
# round (see beacon.mast), which is what keeps that true.
# Recipes are data (recipes.py + recipes.amd): a recipe gives the input cost, build time, and
# its own Program fence (kind, beacon_range); the monster + attract/repel come from the
# Weapons request via the Fabricate tab's property grid.
# ==========================================================================

# --- build: Engineering fabricates a beacon via its data-driven recipe ---
# (Weapons just tells the engineer what to make; there is no request signal.)
//shared/signal/beacon_build
    bw_recipe = fabrication_get_recipe(recipe)
    ->END if bw_recipe is None
    ->END if not is_timer_finished(ship_id, "beacon_fab")
    ->END if not fabrication_recipe_consume(ship_id, recipe)
    bw_time = bw_recipe["time"]
    bw_kind = bw_recipe["program"].get("kind", "bio")
    set_timer(ship_id, "beacon_fab", seconds=bw_time)
    task_schedule(beacon_build_done, {"ship_id": ship_id, "kind": bw_kind, "prog": program, "rprog": bw_recipe["program"], "rkey": recipe, "btime": bw_time})
    ->END

== beacon_build_done
    await delay_sim(btime)
    ->END if to_object(ship_id) is None
    # A built beacon = the RECIPE's own Program fence (kind, beacon_range, ...) with the
    # player's build-time choices from the property grid overlaid on top, flattened so
    # deliver/effect read them directly. The recipe KEY rides along so a recovered beacon
    # can be scrapped back into exactly what it cost.
    # Seeding from rprog is what carries beacon_range: the grid only ever yields the vars a
    # recipe declares in Properties, and the sensor recipes declare none -- so before this
    # a Long Range build produced a plain {"kind": "sensor"} and 16 salvage bought nothing.
    bw_entry = {}
    for bw_rk in rprog:
        bw_entry[bw_rk] = rprog[bw_rk]
    for bw_pk in prog:
        bw_entry[bw_pk] = prog[bw_pk]
    bw_entry["kind"] = kind
    bw_entry["recipe"] = rkey
    bw_built = get_inventory_value(ship_id, "beacon_built", [])
    bw_built.append(bw_entry)
    set_inventory_value(ship_id, "beacon_built", bw_built)
    bw_mon = prog.get("monster", kind)
    bw_mode = prog.get("mode", "")
    overlay_toast(f"Beacon built: {bw_mode} {bw_mon} (ready to deliver)", to=ship_id)
    signal_emit("item_changed", {"holder_id": ship_id})
    ->END

# --- deliver: hand ONE built beacon to Weapons -> loadable round + queued program ---
# Refuse a full tube BEFORE touching cargo. This used to drop through: the beacon left cargo
# and its program was queued whatever the count did, so a second Deliver click destroyed a
# built beacon and left the queue one deeper than the tube -- after which every round fired
# carried the previous round's program and the queue never drained. At a capacity of ONE that
# was the second click, not the ninth.
//shared/signal/beacon_deliver
    bw_max = get_data_set_value(ship_id, "Beacon_MAX", default=0) or 0
    if bw_max < 1:
        overlay_toast("No beacon tube on this ship", to=ship_id)
        ->END
    bw_num = get_data_set_value(ship_id, "Beacon_NUM", default=0) or 0
    if bw_num >= bw_max:
        overlay_toast("Beacon tube full - fire it first", to=ship_id)
        ->END
    # Act on the cargo INDEX the Cargo tab selected, not on a (kind, monster, mode) match:
    # two Sensor Beacons differing only in beacon_range are identical to such a match.
    bw_built = get_inventory_value(ship_id, "beacon_built", [])
    ->END if bidx is None or bidx < 0 or bidx >= len(bw_built)
    bw_prog = bw_built[bidx]
    set_inventory_value(ship_id, "beacon_built", bw_built[:bidx] + bw_built[bidx+1:])
    # count, queue and cargo move together -- that is the whole invariant
    set_data_set_value(ship_id, "Beacon_NUM", bw_num + 1)
    bw_q = get_inventory_value(ship_id, "beacon_program_queue", [])
    bw_q.append(bw_prog)
    set_inventory_value(ship_id, "beacon_program_queue", bw_q)
    bw_dmon = bw_prog.get("monster", bw_prog.get("kind", "beacon"))
    bw_dmode = bw_prog.get("mode", "")
    overlay_toast(f"Beacon delivered to tube: {bw_dmode} {bw_dmon}", to=ship_id)
    signal_emit("item_changed", {"holder_id": ship_id})
    ->END

# --- eject: jettison a built beacon into space (inert, but recoverable by fly-over) ---
# By cargo index, for the same reason deliver is.
//shared/signal/beacon_eject
    bw_built = get_inventory_value(ship_id, "beacon_built", [])
    ->END if bidx is None or bidx < 0 or bidx >= len(bw_built)
    bw_found = bw_built[bidx]
    set_inventory_value(ship_id, "beacon_built", bw_built[:bidx] + bw_built[bidx+1:])
    # The whole program goes with it, recipe key included, so flying back over it scraps
    # out what it cost rather than a guess.
    task_schedule(beacon_spawn_aft, {"sp_ship": ship_id, "sp_prog": bw_found, "sp_live": False})
    overlay_toast("Cargo ejected", to=ship_id)
    signal_emit("item_changed", {"holder_id": ship_id})
    ->END

# --- general cargo eject: jettison one of a held item/material (beacons use beacon_eject) ---
# Decrement the inventory key and drop a recoverable pickup aft (item_spawn stamps item_key,
# so the generic items/item_collect fly-over route credits it back).
//shared/signal/cargo_eject
    ce_have = get_inventory_value(ship_id, key, 0)
    ->END if ce_have < 1
    set_inventory_value(ship_id, key, ce_have - 1)
    task_schedule(cargo_eject_drop, {"ship_id": ship_id, "key": key})
    overlay_toast(f"Ejected {key}", to=ship_id)
    signal_emit("item_changed", {"holder_id": ship_id})
    ->END

== cargo_eject_drop
    ce_eo = to_engine_object(ship_id)
    ->END if ce_eo is None
    ce_fwd = ce_eo.forward_vector()
    ce_x = ce_eo.pos.x + ce_fwd.x * -400
    ce_y = ce_eo.pos.y + ce_fwd.y * -400
    ce_z = ce_eo.pos.z + ce_fwd.z * -400
    item_spawn(key, ce_x, ce_y, ce_z)
    ->END
