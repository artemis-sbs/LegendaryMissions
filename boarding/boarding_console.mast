# The boarding party's consoles - THE LEGACY PATH.
#
# RETIRED FOR ePADD MISSIONS. The PADD is the away UI now: you carry it down with you,
# the Boarding Party app is the way there and back, and the beat plus its replies arrive in
# Messages.
#
# GATED ON `BOARDING_LEGACY_CONSOLE`, default off. This used to read
# `if not gui_app_mode_is_on()` - "run only when ePADD is off" - and there is no such
# state any more: apps are `//gui/app` routes, so the PADD is always on and that
# condition would be permanently false. A switch of its own keeps the path REACHABLE
# for a mission that wants the old away play, instead of leaving dead code behind a
# condition nothing can satisfy.
#
# STILL OPEN, and worth knowing: this file is the only implementation of the shared
# main-screen away view (`boarding_ui_main_screen`), and the PADD model has no answer for
# it - the main screen is the room's, not one person's, so a personal device cannot
# replace it. It is reached only from the `boarding_begin` route below, so in an ePADD
# mission the main screen has no away view at all. That gap predates this change; the
# change only makes it permanent unless a mission turns the legacy path back on.
#
# What replaced what:
#
#     boarding_ui_screen        -> the ePADD Boarding Party app + Messages
#     boarding_ui_beam_up       -> boarding_go_up (library)
#     //shared/signal/boarding_begin -> boarding_invite / boarding_invite_crew
#     boarding_ui_watch         -> not needed: a late console opens Boarding Party and joins
#
#
# Beaming down turns the bridge into a landing party: every console except the main
# screen becomes ONE character, with that character's face, job and - the whole point -
# that character's own menu. The main screen carries the shared view and takes nobody,
# because one person's menu on everybody's screen is not a shared view.
#
# WHAT THIS ADDON OWNS: the screens, the morph, and the way home. Nothing else.
#
# WHAT IT DOES NOT OWN: the story. The mission decides which beats play and when, opens
# one with `boarding_scene_begin(scenes, key, speaker=...)`, and then says:
#
#     signal_emit("boarding_begin", {"BOARDING_SHIP": ship_id, "BOARDING_ROSTER": roster})
#
# where `roster` is the list of lifeforms to hand out (`lifeforms_spawn` of an
# `## Boarding Party` section), and an optional `BOARDING_TITLE` names the place on the shared
# view. Everything the consoles need after that is read from
# `sbs_utils.procedural.boarding`, so a console that repaints for its own reasons lands on
# the same beat as everyone else.
#
# Labels are `boarding_ui_*` on purpose. `boarding_*` without the ui is the LIBRARY's namespace
# (boarding_scene_begin, boarding_choices, boarding_answer...), and a MAST label name is reserved
# mission-wide - naming one `boarding_screen` would be a collision waiting for the first
# mission that also wanted that name.


#############################################################################
# One console, one character.
#############################################################################
=== boarding_ui_screen
    jump boarding_ui_beam_up if not boarding_is_open()

    # THE ONE DOOR. Overlays, the viewscreen claim, the camera, every console role,
    # CONSOLE_TYPE, the crew seat and the engine widget list - in the order that works.
    # Idempotent on an unchanged type, so it costs nothing on the repaint this label does
    # on every scene change.
    gui_console_enter(client_id, "crew")


    # WHO THIS CONSOLE IS SHOWING. One at a time, even when it speaks for several: four
    # characters' readings side by side is a dozen buttons and no sense of who is doing
    # what. The roster listbox picks; this is the detail panel acting on that selection.
    boarding_ui_held = boarding_held(client_id)
    boarding_ui_active = get_inventory_value(client_id, "BOARDING_ACTIVE", None)
    if boarding_ui_active is None or boarding_ui_active not in boarding_ui_held:
        # No pick yet, or the pick went stale - somebody else took that body over.
        boarding_ui_active = boarding_me(client_id)
        set_inventory_value(client_id, "BOARDING_ACTIVE", boarding_ui_active)

    boarding_ui_who = to_object(boarding_ui_active)
    boarding_ui_name = "Observer"
    boarding_ui_face = None
    boarding_ui_job = "watching"
    if boarding_ui_who is not None:
        boarding_ui_name = boarding_ui_who.name
        boarding_ui_face = get_face(boarding_ui_who.id)
        # What this character is FOR - the scene guards read exactly these words. The
        # filtering and sorting live in the library because every boarding mission needs
        # them, and getting it wrong prints `medical, ultra_beam, amd_lifeform:sorel`.
        boarding_ui_job = boarding_job_text(boarding_ui_who, default="watching")

    # THE ROSTER, only when there is a choice to make. A console holding one character
    # gets the whole width for that character - a one-row listbox is furniture that says
    # nothing, and this screen is read at a glance across a room.
    if len(boarding_ui_held) > 1:
        gui_section("area:5,6,30,94;")
        # `hint=` as well as `reveal=`, because this page repaints BECAUSE of its own
        # selection. Reveal alone scrolls the pick into view but a rebuild starts at the
        # top, so the row the crew clicked lands somewhere else under the mouse; the hint
        # keeps it in the same slot. A stale hint is clamped, not an error.
        boarding_ui_hint = get_inventory_value(client_id, "BOARDING_ROSTER_HINT", None)
        boarding_ui_roster_lb = gui_list_box(to_object_list(boarding_ui_held), "row-height: 3.2em;", item_template=boarding_ui_roster_row, title_template=boarding_ui_roster_title, select=True, reveal=True, hint=boarding_ui_hint)
        boarding_ui_roster_lb.set_selected_index(boarding_ui_held.index(boarding_ui_active), False)
        on change boarding_ui_roster_lb.value:
            boarding_ui_picked = boarding_ui_roster_lb.get_value()
            if boarding_ui_picked is not None:
                set_inventory_value(client_id, "BOARDING_ACTIVE", to_id(boarding_ui_picked))
                set_inventory_value(client_id, "BOARDING_ROSTER_HINT", boarding_ui_roster_lb.get_selection_hint())
                jump boarding_ui_screen
        gui_section("area:32,6,95,94;")
    else:
        gui_section("area:8,6,92,94;")

    if boarding_ui_face is not None:
        gui_row("row-height: 6em;")
        gui_face(boarding_ui_face)

    gui_row("row-height: 2.6em;")
    gui_text("$text:`{boarding_ui_name}`;justify:center;font:gui-4")

    gui_row("row-height: 1.6em;")
    gui_text("$text:`{boarding_ui_job}`;justify:center;font:gui-2;color:#8cf")

    gui_row("row-height: content;")
    boarding_ui_said = boarding_line()
    gui_text_area("{boarding_ui_said}")

    gui_row("row-height: 1em;")
    gui_blank()

    # on_press= + data=, never an inline `on gui_message` block: a handler registered
    # inside a for loop captures the loop variable at its LAST value, so every button
    # would answer with the last index.
    #
    # `boarding_choices_for`, not a filter over `boarding_choices`: the shared choices are deduped
    # onto the primary there, so filtering by tag would leave a second character with no
    # way to say "beam back up".
    boarding_ui_seq = boarding_seq()
    for boarding_ui_i, boarding_ui_ch in enumerate(boarding_choices_for(client_id, boarding_ui_active)):
        gui_row("row-height: 2.4em;")
        boarding_ui_label = boarding_ui_ch.label
        # The LABEL, plainly. Wrapped in a `$text:`...`;` style string the engine drew the
        # BACKTICKS - they are a style-value quote, not a markup the renderer strips, so
        # every choice on screen read `Ask her plainly what is in the shed` with the
        # marks around it.
        gui_button(boarding_ui_label, data={"pick_index": boarding_ui_i, "pick_seq": boarding_ui_seq, "pick_agent": boarding_ui_active}, on_press=boarding_ui_pick)

    # The polled revision counter. A signal does NOT wake a task sitting in await gui(),
    # and the symptom of getting this wrong is a choice that only appears when something
    # else happens to rebuild the page.
    on change boarding_seq():
        jump boarding_ui_screen

    await gui()


# One console's pick. `boarding_answer` arbitrates: the seq this console RENDERED with comes
# back with the press, so a second press in the same frame is already stale and refused.
=== boarding_ui_pick
    # `pick_agent`: the index is into the list this console RENDERED, which for a
    # doubled-up console is one character's list, not the console's whole one. Without
    # it the same index reads against a different list and presses the wrong thing.
    boarding_answer(client_id, pick_index, pick_seq, agent=pick_agent)
    ->END


#############################################################################
# The shared view. Where the team is, what was just said, and who is down there -
# but no choices, because a choice belongs to one character.
#############################################################################
=== boarding_ui_main_screen
    jump boarding_ui_beam_up if not boarding_is_open()

    # FIRST: record where this main screen belongs, before anything assigns it away. A
    # shot assigns the console to whatever the lens rides, and there is exactly one
    # moment when its own ship is still knowable.
    viewscreen_console_enter(client_id)
    gui_console_enter(client_id, "mainscreen")
    add_role(client_id, "boarding_watch")

    gui_section("area:6,6,94,94;")

    gui_row("row-height: 3em;")
    boarding_ui_where = boarding_scene()
    boarding_ui_title = get_inventory_value(client_id, "BOARDING_TITLE", "BOARDING PARTY")
    gui_text("$text:`{boarding_ui_title} - {boarding_ui_where}`;justify:center;font:gui-5")

    gui_row("row-height: content;")
    boarding_ui_shared_said = boarding_line()
    gui_text_area("{boarding_ui_shared_said}")

    gui_row("row-height: 1em;")
    gui_blank()

    for boarding_ui_member in to_object_list(boarding_team()):
        gui_row("row-height: 2em;")
        boarding_ui_member_name = boarding_ui_member.name
        gui_text("$text:`{boarding_ui_member_name}`;justify:center;font:gui-3")

    on change boarding_seq():
        jump boarding_ui_main_screen

    await gui()


#############################################################################
# Back to the bridge. The console this client came from was recorded on the way down.
#############################################################################
=== boarding_ui_beam_up
    boarding_ui_back = get_inventory_value(client_id, "BOARDING_RETURN", "helm")
    boarding_assign(client_id, None)
    # The same door on the way back. It re-asserts the crew seat too - a seat is believed
    # only while the client's CONSOLE_TYPE agrees with it, so the morph freed this
    # person's post and their name and face would otherwise not come back.
    gui_console_enter(client_id, boarding_ui_back)
    # Not a console type, so the door does not know about it.
    remove_role(client_id, "boarding_watch")
    CONSOLE_SELECT = boarding_ui_back

    # NOT everyone goes home through the ship console path. `common_console_show` opens
    # with `jump select_console_clear_ready if _ship_id == 0 or not has_role(...)`, and
    # the main screen is usually client 0 - the SERVER console, which has no ship. That
    # drops it into the CLIENT console picker, whose `select_console` reads
    # `console_select_item`, a task variable set in `client_main` that the server's GUI
    # task never ran: a NameError and a dead screen, reported against this addon for a
    # mistake in the caller.
    jump show_main_game_screen if boarding_ui_back == "mainscreen"
    boarding_ui_home_ship = sbs.get_ship_of_client(client_id)
    jump show_main_game_screen if boarding_ui_home_ship == 0 or not has_role(boarding_ui_home_ship, "__player__")
    jump common_console_show


#############################################################################
# Routes.
#############################################################################

# //shared/signal, not //signal: this hands out characters and morphs consoles, and with
# six consoles a //signal body would do every bit of it six times over.
#
# The mission opens the beat FIRST (`boarding_scene_begin`) and then emits this, so the very
# first build already has a line to draw.
//shared/signal/boarding_begin if SETTINGS.get("BOARDING_LEGACY_CONSOLE", False)
    # `default`, because these arrive as task variables from the caller's data dict and
    # the optional ones are simply ABSENT when nobody passed them - not None. Reading an
    # absent name is a NameError, and a failing expression stops the command, so the
    # whole hand-over died on the title line and no console morphed at all.
    default BOARDING_TITLE = None
    default BOARDING_SHIP = None
    default BOARDING_ROSTER = None
    ->END if not boarding_is_open()
    boarding_ui_ship = BOARDING_SHIP if BOARDING_SHIP is not None else next(iter(role("__player__")), None)
    ->END if boarding_ui_ship is None
    boarding_ui_roster = BOARDING_ROSTER
    ->END if boarding_ui_roster is None or len(boarding_ui_roster) == 0

    # TWO PASSES, and the order is the point. `gui_reroute_client` ticks that client's
    # GUI task in THIS frame, so a screen that draws the whole team must be built AFTER
    # the team exists - rerouting as we assign meant the main screen (client 0, which
    # sorts first) drew an empty roster and only filled in on the next beat.
    # What the shared view calls this place. Carried in the hand-over data because the
    # addon has no idea where the crew is - only the mission does.
    boarding_ui_title = BOARDING_TITLE if BOARDING_TITLE is not None else "BOARDING PARTY"
    boarding_ui_seats = []
    for boarding_ui_cid in sorted(linked_to(boarding_ui_ship, "consoles")):
        set_inventory_value(boarding_ui_cid, "BOARDING_RETURN", get_inventory_value(boarding_ui_cid, "CONSOLE_TYPE", "helm"))
        set_inventory_value(boarding_ui_cid, "BOARDING_TITLE", boarding_ui_title)
        # The main screen is the whole room's view, so it takes no character.
        continue if has_role(boarding_ui_cid, "mainscreen")
        boarding_ui_seats.append(boarding_ui_cid)

    # DEAL THE WHOLE ROSTER, rather than giving each console the character at its own
    # index. Indexing by console left every character past the last console unplayed -
    # standing on the surface, in nobody's boarding_team(), with the readings only they could
    # take unreachable - and the modulo that wrapped it handed TWO consoles the same
    # person once there were more consoles than characters. Dealing fixes both ends: a
    # short party doubles up, a large one leaves the surplus consoles to the watcher.
    boarding_ui_slot = 0
    for boarding_ui_member in boarding_ui_roster:
        break if len(boarding_ui_seats) == 0
        boarding_ui_seat = boarding_ui_seats[boarding_ui_slot % len(boarding_ui_seats)]
        if boarding_ui_slot < len(boarding_ui_seats):
            boarding_assign(boarding_ui_seat, boarding_ui_member)
        else:
            boarding_assign_also(boarding_ui_seat, boarding_ui_member)
        boarding_ui_slot += 1

    for boarding_ui_cid in sorted(linked_to(boarding_ui_ship, "consoles")):
        if has_role(boarding_ui_cid, "mainscreen"):
            # The orbit shot is the SHIP's claim, not this console's, so the door leaves
            # it alone - a bare owner ("docking") outlives one console moving. Deciding
            # the orbit is over is the boarding mission's call.
            viewscreen_restore(boarding_ui_ship)
            gui_reroute_client(boarding_ui_cid, boarding_ui_main_screen)
            continue
        gui_reroute_client(boarding_ui_cid, boarding_ui_screen)
    # Remembered so a console that connects LATE can still be given somebody.
    set_inventory_value(boarding_ui_ship, "BOARDING_ROSTER", boarding_ui_roster)
    set_inventory_value(boarding_ui_ship, "BOARDING_TITLE", boarding_ui_title)
    task_schedule(boarding_ui_watch, {"BOARDING_SHIP": boarding_ui_ship})
    log(f"boarding: scene={boarding_scene()} seats={len(boarding_ui_seats)} characters={boarding_ui_slot}", "boarding")
    ->END


#############################################################################
# Late arrivals.
#
# A console that connects, or changes station, AFTER the team has beamed down was
# never in the loop above - it lands on its ordinary bridge console while the rest of
# the ship is on the ground, and there is no way for it to join. Polled once a second
# rather than hung off a hook because there is no hook that fits: `//console/change` is
# the change-console BUTTON and LegendaryMissions already owns it.
#
# Self-terminating: the watcher ends with the scene.
#############################################################################
=== boarding_ui_watch
--- boarding_ui_watch_loop
    await delay_sim(1)
    ->END if not boarding_is_open()
    ->END if not object_exists(BOARDING_SHIP)
    boarding_ui_late_roster = get_inventory_value(BOARDING_SHIP, "BOARDING_ROSTER", None)
    for boarding_ui_late in sorted(linked_to(BOARDING_SHIP, "consoles")):
        # Already somebody, or already watching. Nothing owed.
        continue if boarding_me(boarding_ui_late) is not None
        continue if has_role(boarding_ui_late, "boarding_watch")
        set_inventory_value(boarding_ui_late, "BOARDING_RETURN", get_inventory_value(boarding_ui_late, "CONSOLE_TYPE", "helm"))
        set_inventory_value(boarding_ui_late, "BOARDING_TITLE", get_inventory_value(BOARDING_SHIP, "BOARDING_TITLE", "BOARDING PARTY"))
        # A free character if there is one; otherwise TAKE ONE OVER from a console that
        # is doubled up. A latecomer should relieve a short-handed crew, not sit and
        # watch while somebody else speaks for three people. The shared view is the
        # fallback only when nobody has a spare - and it is never a second copy of
        # somebody: two consoles answering as one person is worse than a console with
        # nothing to answer.
        boarding_ui_free = None
        if boarding_ui_late_roster is not None and not has_role(boarding_ui_late, "mainscreen"):
            for boarding_ui_cand in boarding_ui_late_roster:
                if to_id(boarding_ui_cand) not in boarding_team():
                    boarding_ui_free = boarding_ui_cand
                    break
            if boarding_ui_free is None:
                for boarding_ui_busy in sorted(boarding_clients()):
                    boarding_ui_holds = boarding_held(boarding_ui_busy)
                    if len(boarding_ui_holds) > 1:
                        # The LAST one it picked up, so a console keeps the character
                        # whose face it has been showing all along.
                        boarding_ui_free = boarding_ui_holds[-1]
                        boarding_ui_keep = boarding_ui_holds[:-1]
                        boarding_assign(boarding_ui_busy, boarding_ui_keep[0])
                        for boarding_ui_extra in boarding_ui_keep[1:]:
                            boarding_assign_also(boarding_ui_busy, boarding_ui_extra)
                        gui_reroute_client(boarding_ui_busy, boarding_ui_screen)
                        break
        if boarding_ui_free is None:
            gui_reroute_client(boarding_ui_late, boarding_ui_main_screen)
        else:
            boarding_assign(boarding_ui_late, boarding_ui_free)
            gui_reroute_client(boarding_ui_late, boarding_ui_screen)
        log(f"boarding: console {boarding_ui_late} joined late", "boarding")
    jump boarding_ui_watch_loop


#############################################################################
# The legacy crew console as a tab. Gone in ePADD mode - the PADD is the away
# UI there, and leaving this registered put a second, competing away screen one
# button away from the one the crew are actually using.
#
# Not an @console/crew either way: it must not appear in the console picker - a
# player does not choose to be on the surface, a mission puts them there.
#############################################################################
//gui/tab/crew if SETTINGS.get("BOARDING_LEGACY_CONSOLE", False)
    jump boarding_ui_screen
