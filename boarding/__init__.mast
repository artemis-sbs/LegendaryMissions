provides boarding

# THE EVA SUIT HULL, declared once for every mission that loads boarding.
#
# `ship_data_add_extra` searches the mission folder and then each pinned media pack, and
# prefers the unpacked `__lib__/media` copy - the only one the engine can open. An addon
# cannot hand the engine a file itself (a mastlib is a zip), so the hull rides in the media
# pack and is merely NAMED here.
#
# `EXTRA_SHIP_DATA` is on by default (sbs_utils, 2026-10-09), so this needs no setting. A
# mission that turns it off - one that has to run on a v1.3.4 engine - gets one log line
# and the suit simply falls back to whatever `eva_suit_hull()` says.
ship_data_add_extra("lm_eva_ships")

import boarding_ui.py
import boarding_console.mast
import boarding_crew_console.mast
import eva_console.mast
# LAST, and routes only: a ruin offers itself to the crew, and taking its piece is a beat.
import eva_wiring.mast
# Routes only: a surrendered ship with a deck plan can be boarded (when the `station`
# tile art is installed), and three signals end it.
import deck_wiring.mast
