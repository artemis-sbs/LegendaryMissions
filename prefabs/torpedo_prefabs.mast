=== prefab_torpedo_type
"        key (str): The key by which the torpodo is identified.
"        gui_text (str, optional): The name of the torpedo as seen by the players. If None, then will be the same as the key.
"        speed (int, optional): The speed at which the torpedo moves. Default is 10.
"        lifetime (int, optional): How long (in seconds) the torpedo continues to move. Default is 25.
"        flare_color (str, optional): The color of the torpedo's exhuast flare. Default is white.
"        trail_color (str, optional): The color of the torpedo's exhaust trail. Default is white.
"        warhead (str, optional): A comma-separated string defining the behavior of the warhead upon contact. Default is standard.
"            * standard - the default behavior of damaging a single target upon hit.
"            * blast - creates an area of effect with diminishing effects as the distance from the blast epicenter increases.
"            * reduce_shields - reduces the shields of the target(s). (EMP)
"
"        blast_radius (int, optional): How large the area of effect should be, if `warhead` has the type "blast". Default is 1000.
"        damage (int, optional): The base damage dealt to the target. If `warhead` has the type "blast", damage decreases depending on the distance from the blast's epicenter. Default is 35.
"        explosion_size (int, optional): The size of the explosion visual effect on the 3d view. Default is 10.
"        explosion_color (str, optional): The color of the explosion visual effect on the 3d view. Default is "fire".
"        behaviour (str, optional): The behavior of the torpedo guidance system. Default is homing.
"            * homing - the torpedo will home in on its target, compensating for movement.
"            * mine - the torpedo will not move after it has been placed and will detonate when a ship gets close.
"
"        player_ship_roles (str, optional): A comma-separated string of roles that should get this torpedo. The `__player__` role is always necessary.
"        fill_on_spawn (bool, optional): Whether a ship that gains this type also gets its tubes FILLED to `default_max_count`. Default is True (the stock behavior). Set False for a fabricate-only type - the ship gets the CAPACITY (`{key}_MAX`) but 0 loaded rounds, so the only way to a round is to build one. The Beacon uses this.
"        energy_conversion_value (int, optional): The amount of energy to provide to the ship by disassembling the torpedo. Default is 100.
"        build_times (dict, optional): A dictionary of (str, int) representing the station type and the rate of production.
"        sort_order (int, optional): Where this type sits in every ordinance list - the Build Weapons menu, the station hail readout, the order tubes are made available. Lower comes first. The stock types follow the engine ship-data widget (Homing 0, Nuke 1, EMP 2, Mine 3, PShock 4, Tag 5). Default is 100, so a mod-added type lands after the stock ones.
metadata: ```
key: Homing
gui_name: Homing
sort_order: 100
speed: 10
lifetime: 25
flare_color: white
trail_color: white
warhead: standard
blast_radius: 1000 # only applicable if warhead == 'blast'
damage: 35
explosion_size: 10
explosion_color: fire
behavior: homing
energy_conversion_value: 100
default_max_count: 10
fill_on_spawn: true
player_ship_roles: __player__
build_times:
    industry: 1
    default: 3
```
    # Technically the metadata for this label is unnecessary, but I'm leaving it in place for use by the extension.
    if key is None:
        yield fail
    if gui_name is None:
        gui_name = key
    if len(role(key) & role("torpedo_definition")) > 0: # if torp already exists
        yield fail
    default speed = 10
    default lifetime = 25
    default flare_color = "white"
    default trail_color = "white"
    default warhead = "standard"
    default blast_radius = 1000
    default damage = 35
    default explosion_size = 10
    default explosion_color = "fire"
    default behavior = "homing"
    default energy_conversion_value = 100
    default default_max_count = 10
    default fill_on_spawn = True
    default player_ship_roles = "__player__"
    default sort_order = 100
    default build_times = {"default": 3, "industry": 1}

    ~~ torpedo_type(key=key, 
        gui_text=gui_name, 
        speed=speed, 
        lifetime=lifetime, 
        flare_color=flare_color, 
        trail_color=trail_color, 
        warhead=warhead, 
        blast_radius=blast_radius, 
        damage=damage, 
        explosion_size=explosion_size, 
        explosion_color=explosion_color, 
        behavior=behavior, 
        energy_conversion_value=energy_conversion_value) ~~
    id = prefab.get_id()
    add_role(id, "torpedo_definition")
    add_role(id, key)

    roles = player_ship_roles.split(",")
    for r in roles:
        ships = role(r) & role("__player__") # should only apply to existing player ships
        # print(f"Ships: {len(ships)}")
        for ship in ships:
            count,_max = torpedo_get_count_for_ship(ship, key)
            if _max == 0: # Only add if not already defined in shipData
                _max = default_max_count
            # fill_on_spawn False = give the CAPACITY but no loaded rounds (fabricate-only).
            torpedo_make_available(ship, key, _max, fill_on_spawn)

    yield result id


#region Station Spawn and Production Time Assignment
//spawn if has_role(SPAWNED_ID, "station")
    await delay_sim(1)
    s = SPAWNED_ID
    jump set_station_torpedo_production_speeds

=== set_station_torpedo_production_speeds
    if s is None:
        ->END
    so = to_object(s)
    if so is None:
        ->END
    # TODO: instead of using art_id, might be better to use roles? The applicable roles would need added to shipData.yaml
    artid = so.art_id
    # role() hands back a SET, so iterating it walks the definitions in id-hash order.
    # Every ordinance list built from that order came out shuffled - the Build Weapons
    # comms menu listed Homing/Mine/EMP/Nuke where the ship-data widget says
    # Homing/Nuke/EMP/Mine (issue #693). Sort by each definition's sort_order first, so
    # the keys - and the menu, the hail readout and torpedo_types_available with them -
    # come out in one fixed engine-matching order.
    torp_defs = []
    for tr in role("torpedo_definition"):
        torp_defs.append((get_inventory_value(tr, "sort_order", 100), get_inventory_value(tr, "key"), tr))
    torp_keys = []
    for torp_sort, key, tr in sorted(torp_defs):
        torp_keys.append(key)
        times = get_inventory_value(tr, "build_times")
        # THE MATCH IS A SUBSTRING OF THE ART ID, and that only ever worked for stock art.
        # `starbase_command` contains "command"; a mod's `tng_fed_ds9` contains none of
        # these class names, so NOTHING matched and the station was left with no
        # {key}_BUILD_SPEED at all - which station_torp_building.py reads as its 1000
        # MINUTE default - and no seed stock, while torpedo_types_available below is set
        # regardless. The station then looks stocked, advertises every type, and transfers
        # nothing, forever. Reported from the Gamma with a Q playtest, 2026-09-01.
        #
        # Every prefab already declares a `default:` time for exactly this case and it has
        # never once been reachable: no art id contains the word "default", so the loop
        # walked past it like any other class. Honor it when no class matched, and skip it
        # while matching so an art id that happens to contain "default" is not read as one.
        time = None
        for station_type in times:
            if station_type != "default" and station_type in artid:
                time = times[station_type]
                break
        if time is None:
            time = times.get("default")
        if time is not None:
            set_inventory_value(s, f"{key}_BUILD_SPEED", time)
            if get_data_set_value(s, f"{key}_NUM") is None: # If it's not already set, set it.
                set_data_set_value(s, f"{key}_NUM", random.randrange(0,3))
    # @inventory torpedo_production_keys A list of all the keys of torpedoes this station could produce
    set_inventory_value(s, "torpedo_production_keys", torp_keys)
    set_data_set_value(s, "torpedo_types_available", ",".join(torp_keys))
    ->END

#endregion

# Here we handle spawning of ships, and giving them torps as determined by the torpedo's definitions.
#region Player Ship Torp Assignment
//spawn if has_role(SPAWNED_ID, "__player__")
    await delay_sim(1) # Wait until all torp definitions are loaded
    ship = SPAWNED_ID
    jump give_custom_torps_to_players


==== give_custom_torps_to_players
" When player ships spawn, add custom torpedo types according to the `player_ship_roles` of the torpedoes.
    if ship is None:
        # print("`ship` not defined for `give_custom_torps_to_players` label.")
        ->END
    if to_object(ship) is None:
        # print("Object for `ship` not found.") # This fires multiple times on startup, not sure why.
        ->END
    # Sorted for the same reason as the station loop above: the order torpedo_make_available
    # is called in is the order the tubes show up in, so it has to be fixed too.
    torp_defs = []
    for tr in role("torpedo_definition"):
        torp_defs.append((get_inventory_value(tr, "sort_order", 100), get_inventory_value(tr, "key"), tr))
    #
    # A HULL THAT DECLARES ITS LOADOUT IS BELIEVED.
    #
    # `torpedostart` in shipData is a per-hull declaration and the stock data means it
    # precisely - a tsn_fighter is Homing 5 and zero of everything else, a tsn_shuttle is
    # zero of everything - and `ship_data.py` writes the available-types list from exactly
    # that. So a non-empty list here means the hull has already answered the question this
    # loop is about to ask, and adding to it overrules the answer.
    #
    # Reported from the TNG playtest: a Galaxy declaring `{Photon: 16}` spawned correctly
    # and then, a second later, came back carrying PShock 10/10 and Tag 5/5 - rounds no
    # TNG hull lists. This route is the "second later". The ship's SIDE was tsn, every
    # stock type is gated `tsn`, and a hull that simply does not mention PShock was read
    # as one that had not been given it yet rather than one that does not carry it.
    #
    # AN EMPTY LIST STILL GETS EVERYTHING, which is the back-compatible half: a hull with
    # no `torpedostart` at all has declared nothing, so there is nothing to overrule and
    # the old behaviour is exactly right.
    _declared = get_data_set_value(ship, "torpedo_types_available")
    if _declared is None:
        _declared = ""
    _declared = [t.strip() for t in _declared.split(",") if t.strip()]
    for torp_sort, key, tr in sorted(torp_defs):
        player_ship_roles = get_inventory_value(tr, "player_ship_roles")
        count = get_inventory_value(tr, "default_max_count")
        # A fabricate-only type (fill_on_spawn False, e.g. the Beacon) gets its CAPACITY
        # here but no loaded rounds - the only way to a round is to build one.
        fill_on_spawn = get_inventory_value(tr, "fill_on_spawn", True)
        # A FABRICATE-ONLY TYPE IS THE ONE EXCEPTION, and the flag that marks it already
        # exists. No stock hull declares a Beacon - it is a LegendaryMissions type and
        # this route is what gives every ship its tube - so a blanket "the hull is
        # complete" rule would quietly remove it and take fabrication with it.
        # `fill_on_spawn: false` means "capacity, no rounds", which is exactly the shape of
        # a type a hull is not expected to list. Tag and PShock are both `true`.
        _hull_spoke = len(_declared) > 0 and key not in _declared
        if _hull_spoke and fill_on_spawn:
            continue
        if player_ship_roles is not None:
            roles = player_ship_roles.split(",")
            for r in roles:
                if has_role(ship, r):
                    counts = torpedo_get_count_for_ship(ship, key)
                    if counts[1] == 0: # Only add if the torp isn't added already
                        # print(f"Making {key} available: {count}")
                        torpedo_make_available(ship, key, count, fill_on_spawn)
    ->END
#endregion

