
# Example defining a color theme
# Which is just a list of colors
=$xmas green,red


# WHO CAN BE GIVEN ORDERS.
#
# It used to be one role, `prefab_npc_defender`, added in exactly two places - the
# defender prefab and the enemy-surrender route. So a SURRENDERED ENEMY got the orders
# menu and a genuine ally did not: a fleet ship, an allied-faction escort, anything not
# spawned by that one prefab got nothing, whatever the diplomacy said. Reported as
# "Comms cannot give orders to allied NPCs. It should be able to."
#
# Now it is: that role, OR an NPC your side is allied with. `side_are_allies` was already
# being used INSIDE the popup to decide which orders to offer, so the gate and the
# contents finally agree with each other.
#
# AND AN OPT-OUT, because a story ship is not a unit. A mission marks anything that has
# somewhere to be with `no_orders` and it stays out of the menu - the Enterprise-C flying
# for the rift in Gamma with a Q is exactly that: allied, orderable by this rule, and a
# crew sending her to attack something would break the trial she is the subject of.
# Hailing a civilian means you have IDENTIFIED it, the same rule the right-click order
# menu follows below (issue #694). Enable and body are gated together on purpose - an
# //enable/comms without a matching //comms body opens an empty comms panel.
//enable/comms if has_any_role(COMMS_ORIGIN_ID, "__player__,admiral") and has_roles(COMMS_SELECTED_ID, "civ, friendly") and not science_is_unknown(COMMS_ORIGIN_ID, COMMS_SELECTED_ID)

#
# This is an example of how to create an overridable button, but it is not used
# By setting the weight to 0
# 
# //comms
#     + !0 "Hail":
#         comms_receive("Default hail")



//comms if has_any_role(COMMS_ORIGIN_ID, "__player__,admiral") and is_space_object_id(COMMS_SELECTED_ID) and has_roles(COMMS_SELECTED_ID, "civ, friendly") and not science_is_unknown(COMMS_ORIGIN_ID, COMMS_SELECTED_ID)
    + "Hail":
        obj_ids = linked_to(COMMS_SELECTED_ID, "OBJECTIVE")
        yield success if len(obj_ids) == 0
        msg = "Current objective status\n"
        for obj_id in obj_ids:
            obj = to_object(obj_id)
            continue if obj is None
            detail = obj.get_inventory_value("desc")
            continue if detail is None
            if detail == "":
                detail = "Receiving new orders"
            msg += "    {detail}\n"
        comms_receive(msg)



//enable/comms if has_any_role(COMMS_ORIGIN_ID, "__player__,admiral") and lm_can_take_orders(COMMS_ORIGIN_ID, COMMS_SELECTED_ID)


//comms if has_any_role(COMMS_ORIGIN_ID, "__player__,admiral") and lm_can_take_orders(COMMS_ORIGIN_ID, COMMS_SELECTED_ID) 
    + "Hail":
        obj_ids = linked_to(COMMS_SELECTED_ID, "OBJECTIVE")
        yield success if len(obj_ids) == 0
        msg = "Current objective status\n"
        for obj_id in obj_ids:
            obj = to_object(obj_id)
            continue if obj is None
            detail = obj.get_inventory_value("desc")
            continue if detail is None
            if detail == "":
                detail = "Receiving new orders"
            msg += "    {detail}\n"
        comms_receive(msg)



//popup/comms if has_any_role(COMMS_ORIGIN_ID, "__player__,admiral") and lm_can_take_orders(COMMS_ORIGIN_ID, COMMS_SELECTED_ID) and COMMS_POPUP_ID == COMMS_SELECTED_ID
    # The orders it gives ITSELF (Full Stop, Hold Fire...) - lm_orders_for filters by
    # valid_for AND by what this unit can do (sbs_utils procedural/orders.py).
    # One entry per order - or per INSTANCE of one, e.g. each of a station's wings.
    for order, order_instance, display_name in lm_order_items(COMMS_ORIGIN_ID, COMMS_SELECTED_ID, 0):
        set_inventory_value(COMMS_SELECTED_ID, "ORDERS_SELECTED_POINT", COMMS_POPUP_POINT)
        set_inventory_value(COMMS_SELECTED_ID, "ORDERS_SELECTED_OBJECT", COMMS_POPUP_ID)
        + "Have {COMMS_SELECTED.name} {display_name}" carry_out_orders {"cur_objective": order, "order_instance": order_instance}
     



//popup/comms if has_any_role(COMMS_ORIGIN_ID, "__player__,admiral") and lm_can_take_orders(COMMS_ORIGIN_ID, COMMS_SELECTED_ID) and COMMS_POPUP_ID != COMMS_SELECTED_ID
    # Orders aimed at what was clicked: an ally, a hostile, a marker - or an empty spot,
    # which only `point`/`any` orders accept. Filtered by what this unit can do, so a
    # turret is never offered "Head to location".
    for order, order_instance, display_name in lm_order_items(COMMS_ORIGIN_ID, COMMS_SELECTED_ID, COMMS_POPUP_ID, COMMS_POPUP_ID == 0):
        set_inventory_value(COMMS_SELECTED_ID, "ORDERS_SELECTED_POINT", COMMS_POPUP_POINT)
        set_inventory_value(COMMS_SELECTED_ID, "ORDERS_SELECTED_OBJECT", COMMS_POPUP_ID)
        + "Have {COMMS_SELECTED.name} {display_name}" carry_out_orders {"cur_objective": order, "order_instance": order_instance}


# Ordering a civilian around means you have IDENTIFIED it. An unscanned contact is just a
# blip on the radar, so the right-click order menu stays off until science has scanned it
# (issue #694 - peacetime civilians spawn far from any station, so a crew could hand orders
# to a ship it had never looked at). science_is_unknown reads the scan slot for the ORIGIN's
# SIDE, so one scan by any ship on the side opens the menu for the whole side. Deliberately
# NOT applied to the prefab_npc_defender routes above: those are your own side's escorts,
# spawned under your command, and there is nothing to identify.
//popup/comms if has_any_role(COMMS_ORIGIN_ID, "__player__,admiral") and has_roles(COMMS_SELECTED_ID, "civilian") and not science_is_unknown(COMMS_ORIGIN_ID, COMMS_SELECTED_ID)
    current = set(linked_to(COMMS_SELECTED_ID, "OBJECTIVE"))
    original = get_inventory_value(COMMS_SELECTED_ID, "ORIGINAL_OBJECTIVE")
    if original is None:
        set_inventory_value(COMMS_SELECTED_ID, "ORIGINAL_OBJECTIVE", current)
        brain = get_inventory_value(COMMS_SELECTED_ID, "__BRAIN__")
        set_inventory_value(COMMS_SELECTED_ID, "ORIGINAL_BRAIN", brain)
        old_target = get_inventory_value(COMMS_SELECTED_ID,"blackboard:target")
        set_inventory_value(COMMS_SELECTED_ID,"ORIGINAL_TARGET", old_target)
        original = current

    
    is_default_objective = current == original
    popup = COMMS_POPUP.name if COMMS_POPUP is not None else "Location"
    sel = COMMS_SELECTED.name if COMMS_SELECTED is not None else ""
    are_same = COMMS_SELECTED_ID == COMMS_POPUP_ID
    

    + "{sel} head to location" if COMMS_POPUP_ID == 0:
        objective_clear(COMMS_SELECTED_ID)
        target_point = Vec3(COMMS_POPUP_POINT)
        comms_receive("Heading to assigned location", "On our way", color="white", title_color="cyan")

        objective_add(COMMS_SELECTED_ID, objective_goto_location, {"objective_target_point": target_point, "objective_target": None})
    + "{sel} head to {popup}" if COMMS_POPUP is not None and not are_same:
        objective_clear(COMMS_SELECTED_ID)
        ->END if not object_exists(COMMS_POPUP_ID)
        target_point = Vec3(COMMS_POPUP.pos)
        objective_add(COMMS_SELECTED_ID, objective_goto_location, {"objective_target_point": target_point, "objective_target": COMMS_POPUP_ID})
        
        comms_receive(f"Rendezvousing with {COMMS_POPUP.name}", "On our way", color="white", title_color="cyan")

    + "{sel} return to work"  {"restore": original, "sel_id": COMMS_SELECTED_ID} if not is_default_objective and are_same:
        # This is a bit complicated 
        # And not flexible, assumes brain
        # And what data the brain needs saved
        # TODO: Add support functions to library
        og_brain = get_inventory_value(COMMS_SELECTED_ID, "ORIGINAL_BRAIN")
        set_inventory_value(COMMS_SELECTED_ID, "__BRAIN__", og_brain)
        old_target = get_inventory_value(COMMS_SELECTED_ID, "ORIGINAL_TARGET")
        set_inventory_value(COMMS_SELECTED_ID, "blackboard:target", old_target)
        set_inventory_value(COMMS_SELECTED_ID, "blackboard:target_position", None)

        comms_receive("Getting back to doing to what I do best", "returning to work", color="white", title_color="cyan")


   
        objective_clear(COMMS_SELECTED_ID)
        for oid in restore:
            add_role(oid, "OBJECTIVE")
            add_role(oid, "OBJECTIVE_RUN")
            link(sel_id, "OBJECTIVE", oid)
            link(sel_id, "OBJECTIVE_RUN", oid)

    + "{sel} full Stop" if are_same:
        objective_clear(COMMS_SELECTED_ID)
        objective_add(COMMS_SELECTED_ID, objective_full_stop)
        comms_receive("Stopped awaiting new orders", "Full Stop", color="white", title_color="cyan")


=== carry_out_orders 
    # Which instance of the order was picked (a wing), when the order has instances.
    default order_instance = None
    ->END if COMMS_SELECTED_ID == 0
    ->END if to_object(COMMS_SELECTED_ID) is None

    target_point = get_inventory_value(COMMS_SELECTED_ID, "ORDERS_SELECTED_POINT", None)
    target_object = to_object(get_inventory_value(COMMS_SELECTED_ID, "ORDERS_SELECTED_OBJECT", None))
    if target_object is not None:
        target_point = None

    message = "Your order were unclear {COMMS_ORIGIN.name} - please confirm. I didn't get the area for the order."
    title = "Orders unclear"

    # Clear things
    
    # For now only one order
    set_inventory_value(COMMS_SELECTED_ID, "ORDERS_SELECTED_POINT", None)
    set_inventory_value(COMMS_SELECTED_ID, "ORDERS_SELECTED_OBJECT", None)

    # A STANCE order (Hold fire / Weapons free) changes how the unit fights, not what it
    # is doing - so it keeps its current objective.
    order_stance = cur_objective.get_inventory_value("stance", None)
    if order_stance is not None:
        orders_stance_set(COMMS_SELECTED_ID, order_stance)
        order_title = cur_objective.get_inventory_value("display_name", cur_objective.name)
        comms_receive("Understood, " + order_title.lower(), order_title, color="white", title_color="cyan")
        yield success

    # set_inventory_value(COMMS_SELECTED_ID, "ORDERS_SELECTED_POINT", None)
    # `keeps_objective:` - an order that is not a new job (delegating a station) leaves the
    # unit's current objective running.
    if not cur_objective.get_inventory_value("keeps_objective", False):
        objective_clear(COMMS_SELECTED_ID)
    
    #print("give orders on alt ship {cur_objective}")
    objective_add(COMMS_SELECTED_ID, cur_objective, {"objective_target_point": target_point, "objective_target": to_id(target_object), "order_instance": order_instance})
    
    ######## The rest of this should be in the cur_objective
    ORDER = cur_objective.get_inventory_value("display_name", cur_objective.name)
    ORDER_COLOR = "#040"
    if target_point is not None:
        message = "Heading to designated waypoint to {ORDER}"
        title = "Orders accepted"
    elif target_object is not None:
        message = "Heading to {target_object.name}"
        title = "Orders accepted"
    elif ORDER == "Full Stop":
        message = "awaiting further orders"
        title = ORDER
    # An order can say what the unit answers (`ack:`) - a station launching its wing is
    # not "heading to" anything.
    order_ack = cur_objective.get_inventory_value("ack", None)
    if order_ack is not None:
        title = "Orders accepted"
        message = order_ack
        if target_object is not None:
            message = order_ack + " " + target_object.name
    
        
    if message is not None:
        comms_receive(message, title, color="white", title_color="cyan")

    yield success


