    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target", None)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target_point", None)
    brain_add(OBJECTIVE_AGENT_ID, ai_chase_npc, {"SIZE_X": line_of_sight, "enemies_only": True})
    brain_add(OBJECTIVE_AGENT_ID, goto_object_or_location, {"force_target_point": guard_point, "clear_when_reached": False})
    brain_add(OBJECTIVE_AGENT_ID, ai_full_stop)

+++ test
    OBJECTIVE.set_inventory_value("desc", "Guarding this position")
    yield idle


=== objective_return_to_base
metadata: ```
display_name: Return to base
type: objective/orders/move/return_to_base
valid_for: self
requires: move
dock_distance: 1200
```
    " Head to the nearest friendly station and recharge there
+++ enter
    base_id = lm_orders_nearest_base(OBJECTIVE_AGENT_ID)
    OBJECTIVE.set_inventory_value("base_id", base_id)
    brain_clear(OBJECTIVE_AGENT_ID)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target", None)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target_point", None)
    if base_id is not None:
        brain_add(OBJECTIVE_AGENT_ID, goto_object_or_location, {"force_target": base_id, "clear_when_reached": False, "stop_dist": dock_distance})
    brain_add(OBJECTIVE_AGENT_ID, ai_full_stop)

+++ test
    base_id = OBJECTIVE.get_inventory_value("base_id", None)
    if base_id is None or not object_exists(base_id):
        OBJECTIVE.set_inventory_value("desc", "No friendly base in range")
        yield idle
    b_name = to_object(base_id).name
    if sbs.distance_id(OBJECTIVE_AGENT_ID, base_id) > dock_distance * 1.5:
        OBJECTIVE.set_inventory_value("desc", f"Returning to {b_name}")
        yield idle
    if lm_orders_repair_step(OBJECTIVE_AGENT_ID):
        OBJECTIVE.set_inventory_value("desc", f"At {b_name}, fully recharged")
    else:
        OBJECTIVE.set_inventory_value("desc", f"Recharging at {b_name}")
    yield idle


=== objective_retreat
metadata: ```
display_name: Retreat
type: objective/orders/move/retreat
valid_for: self
requires: move
retreat_distance: 8000
```
    " Break off, hold fire and get clear of the nearest threats
+++ enter
    OBJECTIVE.set_inventory_value("retreat_stance", orders_stance(OBJECTIVE_AGENT_ID))
    orders_stance_set(OBJECTIVE_AGENT_ID, "hold")
    retreat_point = lm_orders_retreat_point(OBJECTIVE_AGENT_ID, retreat_distance)
    brain_clear(OBJECTIVE_AGENT_ID)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target", None)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target_point", None)
    if retreat_point is not None:
        brain_add(OBJECTIVE_AGENT_ID, goto_object_or_location, {"force_target_point": retreat_point, "clear_when_reached": False})
    brain_add(OBJECTIVE_AGENT_ID, ai_full_stop)

+++ test
    OBJECTIVE.set_inventory_value("desc", "Retreating")
    yield idle

+++ leave
    # Whatever ends the retreat - a new order, or the objective being cleared - puts the
    # guns back the way they were.
    orders_stance_set(OBJECTIVE_AGENT_ID, OBJECTIVE.get_inventory_value("retreat_stance", "free"))


=== objective_investigate
metadata: ```
display_name: Investigate
type: objective/orders/move/investigate
objective_target: null
objective_target_point: null
valid_for: allies, hostile
requires: move
scan_distance: 3000
```
    " Fly out to a contact and scan it for the side
+++ enter
    brain_clear(OBJECTIVE_AGENT_ID)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target", None)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target_point", None)
    brain_add(OBJECTIVE_AGENT_ID, goto_object_or_location, {"force_target": objective_target, "clear_when_reached": False, "stop_dist": scan_distance * 0.8})
    brain_add(OBJECTIVE_AGENT_ID, ai_full_stop)

+++ test
    yield success if objective_target is None or not object_exists(objective_target)
    if sbs.distance_id(OBJECTIVE_AGENT_ID, objective_target) > scan_distance:
        OBJECTIVE.set_inventory_value("desc", "Closing to scan")
        yield idle
    scan_line = lm_orders_scan_report(OBJECTIVE_AGENT_ID, objective_target)
    OBJECTIVE.set_inventory_value("desc", scan_line)
    brain_clear(OBJECTIVE_AGENT_ID)
    brain_add(OBJECTIVE_AGENT_ID, ai_full_stop)
    yield success
