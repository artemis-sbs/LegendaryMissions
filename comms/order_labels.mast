# ORDERS BY CAPABILITY.
#
# Every order is an objective label under `objective/orders/`. The comms popup and drag
# build their buttons from lm_orders_for (orders.py), which keeps a label only when:
#
#   requires:   every capability listed is one the unit has (sbs_utils procedural/orders.py:
#               move / weapons / launch)
#   valid_for:  the target fits - self, allies, hostile, marker, point, any
#
# So a turret is offered Fire On and Hold Fire and nothing that moves, a freighter is never
# offered Attack, and a stock station (no engine, no working guns) is offered nothing at all
# and drops out of the Can order chip.
#
# `stance:` marks an order that changes how a unit fights rather than what it does -
# carry_out_orders sets it and leaves the current objective running.
#
# The first four orders (goto, attack, guard, full stop) live in prefabs/defender.mast.


=== objective_fire_on
metadata: ```
display_name: Fire on
type: objective/orders/weapons/fire_on
objective_target: null
objective_target_point: null
valid_for: hostile
requires: weapons
```
    " Hold position and fire on one target
+++ enter
    # Fixed guns (a turret, a station's turret mounts) take a designation, which beats
    # anything they would pick for themselves - hold fire included.
    fire_on_guns = lm_orders_designate(OBJECTIVE_AGENT_ID, objective_target)
    # Each block (enter / test / leave) runs as its own task, so state is kept on the
    # objective, not in a variable.
    OBJECTIVE.set_inventory_value("fire_on_guns", fire_on_guns)
    if fire_on_guns == 0:
        # A ship: stop where it is and let the engine's weapons work the target.
        brain_clear(OBJECTIVE_AGENT_ID)
        brain_add(OBJECTIVE_AGENT_ID, ai_full_stop)

+++ test
    yield success if objective_target is None or not object_exists(objective_target)
    if OBJECTIVE.get_inventory_value("fire_on_guns", 0) == 0:
        target_shoot(OBJECTIVE_AGENT_ID, objective_target)
    t_name = to_object(objective_target).name
    OBJECTIVE.set_inventory_value("desc", f"Firing on {t_name}")
    yield idle

+++ leave
    lm_orders_designate(OBJECTIVE_AGENT_ID, 0)


