=== objective_escort
metadata: ```
display_name: Escort
type: objective/orders/move/escort
objective_target: null
objective_target_point: null
valid_for: allies
requires: move
escort_distance: 800
defend_radius: 4000
```
    " Stay with a ship and fight off anything that comes near it
+++ enter
    brain_clear(OBJECTIVE_AGENT_ID)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target_point", None)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target", None)
    # Fight only what is close; otherwise fall back into formation on the escortee.
    brain_add(OBJECTIVE_AGENT_ID, ai_chase_npc, {"SIZE_X": defend_radius, "enemies_only": True})
    brain_add(OBJECTIVE_AGENT_ID, goto_object_or_location, {"force_target": objective_target, "clear_when_reached": False, "stop_dist": escort_distance})
    brain_add(OBJECTIVE_AGENT_ID, ai_full_stop)

+++ test
    yield success if objective_target is None or not object_exists(objective_target)
    e_name = to_object(objective_target).name
    OBJECTIVE.set_inventory_value("desc", f"Escorting {e_name}")
    yield idle


=== objective_patrol
metadata: ```
display_name: Patrol
type: objective/orders/move/patrol
objective_target: null
objective_target_point: null
valid_for: marker
requires: move
line_of_sight: 6000
```
    " Fly between here and a marker, engaging hostiles on the way
+++ enter
    patrol_home = to_object(OBJECTIVE_AGENT_ID).pos
    patrol_far = to_object(objective_target).pos if object_exists(objective_target) else patrol_home
    OBJECTIVE.set_inventory_value("patrol_home", patrol_home)
    OBJECTIVE.set_inventory_value("patrol_far", patrol_far)
    OBJECTIVE.set_inventory_value("patrol_out", True)
    brain_clear(OBJECTIVE_AGENT_ID)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target", None)
    set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target_point", patrol_far)
    set_inventory_value(OBJECTIVE_AGENT_ID, "patrol_arrived", False)
    brain_add(OBJECTIVE_AGENT_ID, ai_chase_npc, {"SIZE_X": line_of_sight, "enemies_only": True})
    brain_add(OBJECTIVE_AGENT_ID, goto_object_or_location, {"clear_when_reached": False, "set_when_reached": "patrol_arrived"})
    brain_add(OBJECTIVE_AGENT_ID, ai_full_stop)

+++ test
    if get_inventory_value(OBJECTIVE_AGENT_ID, "patrol_arrived", False):
        # Turn around: swap to the other end of the leg.
        patrol_out = not OBJECTIVE.get_inventory_value("patrol_out", True)
        OBJECTIVE.set_inventory_value("patrol_out", patrol_out)
        patrol_next = OBJECTIVE.get_inventory_value("patrol_far") if patrol_out else OBJECTIVE.get_inventory_value("patrol_home")
        set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target", None)
        set_inventory_value(OBJECTIVE_AGENT_ID, "blackboard:target_point", patrol_next)
        set_inventory_value(OBJECTIVE_AGENT_ID, "patrol_arrived", False)
    # The marker can be removed mid-patrol; the leg it gave stays valid.
    OBJECTIVE.set_inventory_value("desc", "Patrolling")
    yield idle


=== objective_guard_here
