=== gm_add_or_remove_torp
    print("Adding or removing torp")
    if __ITEM__ is not None:
        torp = __ITEM__.data.get("torp_item")
        yield fail if torp is None
        key = torp.get("key",0)
        ship = torp.get("ship",None)
        add = __ITEM__.data.get("add", True)
        if ship is None:
            yield fail
        print("Item not none")
        cur = get_data_set_value(ship, "{key}_NUM",0)
        if add:
            cur += 1
            _max = get_data_set_value(ship, "{key}_MAX",0)
            if cur > _max:
                cur = _max
        else:
            cur -= 1
            if cur < 0:
                cur = 0
        set_data_set_value(ship, "{key}_NUM", cur)
        yield success
    yield fail

=== gm_change_torp_capacity
" Change the max capacity of the specified torpedo for the selected ship.
" Uses a modifier to be compatible with other sources of capacity increases/decreases.
    print("Changing torp cap")
    if __ITEM__ is not None:
        data = __ITEM__.data
        key = data.get("key")
        yield fail if key is None
        ship = data.get("ship")
        if ship is None:
            yield fail
        print("Item not none")
        add = data.get("add",True)
        count = 1 if add else -1
        exists = modifier_exists(ship, "GM")
        cur_mods = modifiers_get_for_object(ship, "{key}_MAX")
        for c in cur_mods:
            if c.source == "GM":
                count = c.value + count
        modifier_add(ship, "{key}_MAX", count, "GM", 0, replace_if_exists=True)
        yield success
    yield fail

#endregion


