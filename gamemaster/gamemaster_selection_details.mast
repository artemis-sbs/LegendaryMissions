    gui_row("row-height: 90;")
    side_manager_gss = gui_sub_section()
    with side_manager_gss:
        gm = get_inventory_value(client_id, "GAMEMASTER_COMBOT", None)
        side_ids = sides_set()
        side_names = set()
        for s in side_ids:
            side_names.add(side_display_name(s))
        sides = sorted(list(side_names))
        relations = list(("Allies", "Neutral", "Enemies"))
        relations_value = list((sbs.DIPLOMACY.ALLIED, sbs.DIPLOMACY.NEUTRAL, sbs.DIPLOMACY.HOSTILE, sbs.DIPLOMACY.UNKNOWN))
        # TODO Add sbs_utils capability for GETTING diplomacy colors
        neutral_color = "#077"
        text_height = "row-height:1.3em;"
        diplomacy = gui_row(f"click_text:;{text_height}")
        dip_text = gui_text(" - Diplomacy","color:#0fc;")
        dip_content_row = gui_row()
        dip_content = gui_sub_section()
        with dip_content:
            gui_text("Select a side:")

            gui_spacer_row()
            gui_row()
            gui_spacer_col()
            side_lb = gui_list_box(sides,"row-height: 1.3em;",select=True)
            side_lb.set_selected_index(0)
            # gui_spacer_row()

            # gui_row("row-height: 1.3em;")
            # gui_text("Select a side:")

            # gui_spacer_row()
            # gui_row()
            gui_spacer_col()
            o_side_lb = gui_list_box(sides,"row-height: 1.3em;",select=True)
            o_side_lb.set_selected_index(0)
            gui_spacer_col()
            gui_spacer_row()

            gui_row("row-height: content;")
            gui_text("Current diplomacy status:","col-width: content;")
            gui_blank()
            cur = gui_text("Allied","color:green;background-color: #131c26;col-width:content;")
            gui_spacer_row()
            gui_set_variable("current_diplo_status_text",cur)
            data={"s1_glb":side_lb,"s2_glb":o_side_lb,"cur_dip":cur}

            gui_row(text_height)
            allies = gui_button("Set as Allies")
            gui_spacer_row()
            allies.data= data
            gui_row(text_height)
            neutral = gui_button("Set as Neutral")
            gui_spacer_row()
            neutral.data=data
            gui_row(text_height)
            hostile = gui_button("Set as Hostile")
            gui_spacer_row()
            hostile.data=data
            gui_row(text_height)
            unknown = gui_button("Set as Unknown")
            gui_spacer_row()
            unknown.data=data
            on gui_message(allies):
                s1 = __ITEM__.data["s1_glb"].value
                s2 = __ITEM__.data["s2_glb"].value
                cur = __ITEM__.data["cur_dip"]
                if s1==s2:
                    cur.value = "$text: N/A"
                    cur.color="green"
                    ->END
                cur.update("$text:Allied;")
                cur.color="blue"
                side_set_relations(s1,s2,sbs.DIPLOMACY.ALLIED)
            on gui_message(neutral):
                s1 = __ITEM__.data["s1_glb"].value
                s2 = __ITEM__.data["s2_glb"].value
                cur = __ITEM__.data["cur_dip"]
                if s1==s2:
                    cur.value = "$text: N/A"
                    cur.color="green"
                    ->END
                cur.update("$text:Neutral;")
                cur.color=f"{neutral_color}"
                side_set_relations(s1,s2,sbs.DIPLOMACY.NEUTRAL)
            on gui_message(hostile):
                s1 = __ITEM__.data["s1_glb"].value
                s2 = __ITEM__.data["s2_glb"].value
                cur = __ITEM__.data["cur_dip"]
                if s1==s2:
                    cur.value = "$text: N/A"
                    cur.color="green"
                    ->END
                cur.update("$text:Hostile;")
                cur.color="red"
                side_set_relations(s1,s2,sbs.DIPLOMACY.HOSTILE)
            on gui_message(unknown):
                s1 = __ITEM__.data["s1_glb"].value
                s2 = __ITEM__.data["s2_glb"].value
                cur = __ITEM__.data["cur_dip"]
                if s1==s2:
                    cur.value = "$text: N/A"
                    cur.color="green"
                    ->END
                cur.update("$text:Unknown;color:grey;")
                cur.color="grey"
                side_set_relations(s1,s2,sbs.DIPLOMACY.UNKNOWN)
            on change side_lb.value:
                s1 = to_side_id(side_lb.value)
                s2 = to_side_id(o_side_lb.value)
                cur = gui_get_variable("current_diplo_status_text")
                if s1 == s2:
                    cur.value = " N/A"
                    cur.color="green"
                    ->END
                rel = side_get_relations(s1,s2)
                if rel == sbs.DIPLOMACY.ALLIED:
                    cur.value = "Allied"
                    cur.color="green"
                elif rel == sbs.DIPLOMACY.HOSTILE:
                    cur.value = "Hostile"
                    cur.color="red"
                elif rel == sbs.DIPLOMACY.NEUTRAL:
                    cur.value = "Neutral"
                    cur.color=f"{neutral_color}"
                else:
                    cur.value = "Unknown"
                    cur.color="grey"
            on change o_side_lb.value:
                s1 = to_side_id(side_lb.value)
                s2 = to_side_id(o_side_lb.value)
                cur = gui_get_variable("current_diplo_status_text")
                if s1 == s2:
                    cur.value = " N/A"
                    cur.color="green"
                    ->END
                rel = side_get_relations(s1,s2)
                if rel == sbs.DIPLOMACY.ALLIED:
                    cur.value = "Allied"
                    cur.color="green"
                elif rel == sbs.DIPLOMACY.HOSTILE:
                    cur.value = "Hostile"
                    cur.color="red"
                elif rel == sbs.DIPLOMACY.NEUTRAL:
                    cur.value = "Neutral"
                    cur.color=f"{neutral_color}"
                else:
                    cur.value = "Unknown"
                    cur.color="grey"

            on change len(sides_set()):
            # on signal side_added:
                side_ids = sides_set()
                side_names = set()
                for s in side_ids:
                    side_names.add(side_display_name(s))
                sides = sorted(list(side_names))
                side_lb.items = sides
                o_side_lb.items = sides
                gui_represent(side_manager_gss)
        dip_list = list()
        dip_list.append(" - Diplomacy")
        dip_list.append(" + Diplomacy")
        diplomacy.data = {"content":dip_content_row,"txt":dip_text,"show_panel":True}
        on gui_message(diplomacy):
            content = __ITEM__.data["content"]
            show = not __ITEM__.data["show_panel"]
            content.show(show)
            dt = __ITEM__.data["txt"]
            if show:
                dt.update(f"$text: - Diplomacy;")
            else:
                dt.update(f"$text: + Diplomacy;")
            __ITEM__.data["show_panel"] = show
            gui_represent(side_manager_gss)


        new_side_row = gui_row(f"click_text:;{text_height}")
        nst = gui_text(" - New Side", "color:#0fc;")
        side_content_row = gui_row("row-height: content; background-color: #012345;")
        input_height = "row-height: 1.3em;"
        side_content = gui_sub_section()
        with side_content:
            gui_row("Name")
            gui_row(input_height)
            key_in = gui_input("desc:Key")
            gui_spacer_row()
            gui_row(input_height)
            name_in = gui_input("desc:Name")
            gui_spacer_row()
            gui_row(input_height)
            desc_in = gui_input("desc:Description;")
            gui_spacer_row()
            gui_row(input_height)
            create = gui_button("Create Side")
            gui_spacer_row()
            create.data = {"key_in":key_in,"name_in":name_in,"desc_in":desc_in}
            on gui_message(create):
                key_in = __ITEM__.data["key_in"]
                name_in = __ITEM__.data["name_in"]
                desc_in = __ITEM__.data["desc_in"]
                key_val = key_in.value
                name_val = name_in.value
                desc_val = desc_in.value
                if key_val is None:
                    sbs.send_message_to_client(client_id, "red", "Side Data Incomplete")
                    ->END
                # TODO: modify create_side() to account for this, dunno why it doesn't - the prefab originally did.
                if name_val is None or name_val == "":
                    name_val = key_val
                new_side = side_create(key_val,name_val,desc_val)
                
                # new_side = await prefab_spawn(prefab_side_generic,data={"key":key_val,"name":name_val,"desc":desc_val})
                # print(f"{to_side_object(new_side).name}")
                # signal_emit("side_added")
                key_in.value = ""
                key_in.value = ""
                desc_in.value = ""
                gui_represent(side_manager_gss)
        new_side_row.data = {"content":side_content_row,"txt":nst,"show_panel":True}
        on gui_message(new_side_row):
            content = __ITEM__.data["content"]
            show = not __ITEM__.data["show_panel"]
            content.show(show)
            dt = __ITEM__.data["txt"]
            if show:
                dt.update(f"$text: - New Side;")
            else:
                dt.update(f"$text: + New Side;")
            __ITEM__.data["show_panel"] = show
            gui_represent(side_manager_gss)


    yield success


