=== gm_show_all_torp_types
" Build a layout with all possible torpedo types.
" Allows the user to modify the torpedo types available to the selected ship.
" Must be a player ship, a cargo ship, or station. NPC ships do not currently support torpedoes.
" Cargo ships and stations can have torpedoes in inventory but cannot use them, but player ships can take them to use.

    sec = gui_sub_section()
    gm = get_inventory_value(client_id, "GAMEMASTER_COMBOT", None)
    selected = get_inventory_value(gm, "gamemaster_prev_selection")

    all_torps_list = []
    current_torps_list = []

    current_torps = None
    available_torps = None
    with sec:
        gui_row("row-height: 1em;")
        gui_text("Current")
        gui_row()
        current_torps = gui_list_box([],"")
    
    sec2 = gui_sub_section()
    with sec2:
        gui_row("row-height: 1em;")
        gui_text("Available")
        gui_row()
        available_torps = gui_list_box([],"")
    
    on change current_torps.value:
        all_torps_list.append(current_torps.value)
        current_torps_list.remove(current_torps.value)
        available_torps.items = all_torps_list
        current_torps.items = current_torps_list
        # TODO: Remove the torp type from the ship
    
    on change available_torps.value:
        current_torps_list.append(available_torps.value)
        all_torps_list.remove(available_torps.value)
        available_torps.items = all_torps_list
        current_torps.items = current_torps_list
        # TODO: Add the torp type to the ship

    on change get_inventory_value(gm, "gamemaster_prev_selection"):
        available_torps = []
        # TODO: Finish this


    yield success



