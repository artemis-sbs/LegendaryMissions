    gm = get_inventory_value(client_id, "GAMEMASTER_COMBOT", None)
    selected = get_inventory_value(gm, "gamemaster_prev_selection", None)
    default fleet_name = None
    default fleet_ships = []
    fleet_name, fleet_ships = gm_selected_fleet_data(selected)

    gui_row("row-height: 1.5em;")
    fleet_title = gui_text("$text:No fleet for the selected ship.;font:gui-2;")
    gui_row("row-height: content;")
    fleet_list = gui_list_box(fleet_ships, "background:#1572;", item_template=gm_selected_fleet_ship_template, select=True)
    gui_set_variable("gm_selected_fleet_list", fleet_list)
    on change get_inventory_value(gm, "gamemaster_prev_selection", None):
        selected = get_inventory_value(gm, "gamemaster_prev_selection", None)
        fleet_name, fleet_ships = gm_selected_fleet_data(selected)
        fleet_list = gui_get_variable("gm_selected_fleet_list")
        if fleet_name is None:
            fleet_title.update("text:No fleet for the selected ship.;font:gui-2;")
        else:
            fleet_title.update("text:Fleet: " + gui_text_escape(fleet_name) + ";font:gui-2;")
        if fleet_list is None:
            print("WARNING: gm selection details - fleet_list is None")
        else:
            fleet_list.items = fleet_ships


    yield success

