//shared/signal/gui_update_interval_signal
    gms = role("gamemaster")

    clients = sbs.get_client_ID_list()

    # We iterate over all the clients, find any who are on a ship with the "gamemaster" role, and get the gui task for that client. Once we have the gui task, we get the details handler and call refresh_data().
    for c in clients:
        if sbs.get_ship_of_client(c) in gms:
            client_id = c
            # If it's not the right menu, don't do the updates
            # It'll still update if the selection changes.
            if "selected" in get_inventory_value(client_id, "gm_current_menu",""):
                task = gui_task_for_client(client_id)
                if task is not None:
                    gm_dh = task.get_inventory_value("gm_details_handler")
                    if gm_dh is not None:
                        gm_dh.refresh_data()
    ->END

=== gm_toggle_detail_section
" Collapse or expand a section of the selected-object details.
    default __ITEM__ = None
    yield fail if __ITEM__ is None
    section = __ITEM__.data.get("section")
    yield fail if section is None
    section.toggle()
    parent = __ITEM__.data.get("parent")
    if parent is not None:
        gui_represent(parent)
    yield success

