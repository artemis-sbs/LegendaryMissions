    #     deets = gm_selected_object_details(gm)
    #     deets_area.update(deets)
    # yield success
    # The handler owns every details widget and fills them in refresh().
    handler = gm_selection_details_build(gm)
    section_row_height = "row-height: content;"
    gauge_row_height = "row-height: 1.3em;"

    gui_row("row-height: 200;") # Here we trick the layout to overflow to prevent it from squeezing. This is not as preferable as having a dedicated "scroll area", but it does the job I guess. For now.
    with gui_sub_section() as selected_gss:
        # --- General (always shown) ---
        gui_row("row-height: 1.5em;")
        gui_text("$text:Selected Object: ;","col-width: content; justify: left;")
        gui_blank()
        handler.add_text("name", gui_text("$text:Select an object in science or weapons to view details.;font:gui-2;","col-width: content; justify: right;"))
        gen_hdr_row = gui_row("row-height: 1.3em;")
        gen_header = gui_text("$text:General  ;font:gui-1;color:#0fc;", "click_background:#0fc2;click_text:;")
        general_body = gui_row(section_row_height)
        with gui_sub_section():
            gui_row("row-height: 1.2em;")
            handler.add_text("id", gui_text("$text:ID: -;"))
            gui_row("row-height: 1.2em;")
            handler.add_text("type", gui_text("$text:Type: -;"))
            gui_row("row-height: 1.2em;")
            handler.add_text("origin", gui_text("$text:Origin: -;"))
            gui_row("row-height: 1.2em;")
            handler.add_text("side", gui_text("$text:Side: -;"))
            # gui_row("row-height: 3.2em;")
            # handler.add_text("roles", gui_text("$text:Roles: -;"))
            gui_row("row-height: 1.2em;")
            gui_text(" ")
        general = handler.add_section("general", gen_hdr_row, general_body)
        gen_header.data = {"section": general, "parent": selected_gss}
        gui_message(gen_header, "gm_toggle_detail_section")

        # --- Energy status - player ships only
        energy_row = gui_row(gauge_row_height)
        energy_gauge = gui_gauge(0,1, "Energy", show="frac")
        handler.add_auto_gauge("energy",1000,energy_gauge,is_blob=True)
        gui_spacer_row()

        # --- Defense: shields, armor, hull ---
        def_hdr_row = gui_row("row-height: 1.3em;")
        def_header = gui_text("$text:Defense  ;font:gui-1;color:#0fc;", "click_background:#0fc2;click_text:;")
        defense_body = gui_row(section_row_height)
        defense_body_ss = gui_sub_section()
        with defense_body_ss:
            for i in range(4):
                gui_row(gauge_row_height)
                shield_gauge = gui_gauge(0, 1, "", show="frac")
                handler.add_gauge("shield", shield_gauge)

            # gui_row(gauge_row_height)
            # handler.add_gauge("hull", gui_gauge(0, 1, "Hull", show="frac"))
            gui_row(gauge_row_height)
            gui_text(" ")

        defense = handler.add_section("defense", def_hdr_row, defense_body)
        def_header.data = {"section": defense, "parent": selected_gss}
        gui_message(def_header, "gm_toggle_detail_section")

        # --- Systems (player ships): bar shows the health left in each system ---
        sys_hdr_row = gui_row("row-height: 1.3em;")
        sys_header = gui_text("$text:Hull and Systems  ;font:gui-1;color:#0fc;", "click_background:#0fc2; click_text:;")
        systems_body = gui_row(section_row_height)
        with gui_sub_section():
            gui_row(f"border-color: #123456;border:1px,1px,1px,1px;background: #203d5aa0;{gauge_row_height};")
            handler.add_gauge("hull", gui_gauge(0, 1, "Hull", show="frac"))
            for i in range(8):
                gui_row(gauge_row_height)
                handler.add_gauge("system", gui_gauge(0, 1, "", show="frac"))


            gui_row(gauge_row_height)
            gui_text(" ")
        
        systems = handler.add_section("systems", sys_hdr_row, systems_body)
        sys_header.data = {"section": systems, "parent": selected_gss}
        gui_message(sys_header, "gm_toggle_detail_section")

        # --- Fleet (NPC ships) ---
        fleet_hdr_row = gui_row("row-height: 1.3em;")
        fleet_header = gui_text("$text:Fleet  ;font:gui-1;color:#0fc;", "click_background:#0fc2;click_text:;")
        fleet_body = gui_row(section_row_height)
        with gui_sub_section():
            gui_row("row-height: 1.2em;")
            handler.add_text("fleet", gui_text("$text:Fleet: none;"))
            gui_row("row-height: 1.2em;")
            handler.add_text("flagship", gui_text("$text:Flagship: none;"))
            gui_row("row-height: 1.2em;")
            gui_text(" ")
        fleet = handler.add_section("fleet", fleet_hdr_row, fleet_body)
        fleet_header.data = {"section": fleet, "parent": selected_gss}
        gui_message(fleet_header, "gm_toggle_detail_section")
        gui_row("row-height:1px;")
        # --- Abilities and upgrades ---
        extras_hdr_row = gui_row("row-height: 1.3em;")
        extras_header = gui_text("$text:Abilities and Upgrades  ;font:gui-1;color:#0fc;", "click_background:#0fc2;click_text:;")
        extras_body = gui_row(section_row_height)
        with gui_sub_section():
            gui_row("row-height: 2.4em;")
            handler.add_text("abilities", gui_text("$text:Abilities: n/a;"))
            gui_row("row-height: 2.4em;")
            handler.add_text("upgrades", gui_text("$text:Upgrades: n/a;"))
            gui_row("row-height: 1.2em;")
            gui_text(" ")
        extras = handler.add_section("extras", extras_hdr_row, extras_body)
        extras_header.data = {"section": extras, "parent": selected_gss}
        gui_message(extras_header, "gm_toggle_detail_section")

        handler.refresh_data()
        gui_set_variable("gm_details_handler", handler)

    # Refresh right away on a new selection; the sub task keeps values live every second.
    on change get_inventory_value(gm, "gamemaster_prev_selection"):
        # Handler locals can be shadowed by widgets, so re-fetch the handler.
        gui_get_variable("gm_details_handler").refresh_data()
    
    # gui_sub_task_schedule(gm_selected_details_update)
