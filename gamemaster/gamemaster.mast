--- gm_nav_area_slider
    with gui_section(f"area:{info_panel_width},95,100,100;"):
        cur = get_inventory_value(cambot, f"GAMEMASTER_lmb_SIZE", 5000)
        s = gui_slider("low: 2000; high: 50000;", var="GM_NAV_AREA_SLIDER")
        s.value = cur
        on change s.value:
            cambot = sbs.get_ship_of_client(client_id)
            cur = get_inventory_value(cambot, f"GAMEMASTER_lmb_SIZE", 5000)
            delta=1
            set_inventory_value(cambot, "GAMEMASTER_lmb_SIZE", s.value)
            pos = gamemaster_get_pos(cambot, "lmb")
            gamemaster_show_nav_area(cambot, pos, delta, "Game Master", "lmb", "#040")

--- gm_finalize_gui
    # Can add temp code here for testing purposes
    await gui()

--- gm_sidebar_select_submenu
    default menu_type = ""
    default submenu_index = 0
    if __ITEM__ is not None:
        menu_type = __ITEM__.data.get("menu_type", "")
        submenu_index = __ITEM__.data.get("submenu_index", 0)

    panels = GM_SIDEBAR_SUBMENU_PANELS.get(menu_type)
    if panels is not None and len(panels) > 0:
        current_index = GM_SIDEBAR_SELECTED_SUBMENU_INDEX.get(menu_type, 0)
        if current_index >= 0 and current_index < len(panels):
            gui_hide(panels[current_index])
        if submenu_index >= 0 and submenu_index < len(panels):
            gui_show(panels[submenu_index])
            GM_SIDEBAR_SELECTED_SUBMENU_INDEX[menu_type] = submenu_index
            set_inventory_value(client_id, "gm_current_menu",menu_type)
    ->END


