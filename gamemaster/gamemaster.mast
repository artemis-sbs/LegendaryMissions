#
#
#
dolly = 50
orbit = 180.0
do_move = 0
property_pane = None
info_panel_width = "30"

default SETTINGS = settings_get_defaults()
default shared GAMEMASTER_CONSOLE = SETTINGS.get("GAMEMASTER", {"enable": True})
default shared GAMEMASTER_CONSOLE_ENABLED = GAMEMASTER_CONSOLE.get("enable", True)
default shared GAMEMASTER_CONSOLE_PIN = GAMEMASTER_CONSOLE.get("pin", None)
default shared GAMEMASTER_CONSOLE_BETA = GAMEMASTER_CONSOLE.get("beta", False)
default shared GAMEMASTER_CONSOLE_ICON_SIZE = GAMEMASTER_CONSOLE.get("menu_icon_size", 45)
# Remember the last open submenu per main menu so tab switches restore the same pane.
default GM_SIDEBAR_SUBMENU_PANELS = {}
default GM_SIDEBAR_SELECTED_SUBMENU_INDEX = {}

@console/gamemaster !0 ^100 "Game Master" if GAMEMASTER_CONSOLE_ENABLED
" Affect the overall battle

    # This is a bit of a work around s the operator doesn't need the pin twice
    default GAMEMASTER_SKIP_PIN = False

    jump full_console if GAMEMASTER_SKIP_PIN
    jump full_console if GAMEMASTER_CONSOLE_PIN is None or GAMEMASTER_CONSOLE_PIN == ""

--- login_screen
    gui_section( style=f"area: 20, 40, 80, 40+40px;")
    pin = ""
    """Gamemaster pin"""
    _in = gui_input("""desc: Enter pin;password:True;""", var="pin")
    on gui_message(_in):
        jump full_console if pin == GAMEMASTER_CONSOLE_PIN

    await gui():
        + "cancel":
            jump select_console


    jump login_screen

--- full_console

    GAMEMASTER_SKIP_PIN = False

    # Need Sci in the name for science selection
    gui_activate_console("gamemaster_sci")

    _ship_id = sbs.get_ship_of_client(client_id) 
    side_ship = to_object(_ship_id)
    cambot_id = get_inventory_value(client_id, "GAMEMASTER_COMBOT", None)
    camera_id = cambot_id
    cambot = to_object(cambot_id)


    if cambot_id is None or cambot is None:
        #
        # has_science_scan enables friendly eyes processing
        # while not being a player
        #
        cambot = to_object(player_spawn(0,0,10, "", "#,gamemaster,has_science_scan", "invisible")) 
        remove_role(cambot, "__player__")
        camera_id = to_id(cambot)
        set_inventory_value(client_id, "GAMEMASTER_COMBOT", camera_id)
        cambot_id = camera_id

        # Set up scan sources
        stations_friendly = any_role("__npc__,__player__")
        #@link extra_scan_source: All the sources which provide scan information to this object
        link(cambot_id,"extra_scan_source" ,stations_friendly)

    set_data_set_value(cambot,"selectable",0)
    
    last_sci = cambot_id
    #
    # Should have a way to get all sides - now we do!
    #
    side = "tsn"
    if side_ship is not None:
        side = side_ship.side
    sel = get_inventory_value(cambot_id, "gm_last_selected_side")
    if sel is not None:
        side = sel
    cambot.side = side
    cambot.data_set.set("ship_base_scan_range", 15000,0)
    
    await delay_sim(1)    
    #
    # Assign before setting comms up
    #

    sbs.assign_client_to_ship(client_id, camera_id)
    science_set_scan_data(camera_id, camera_id, {"scan": "Game Master"})
    set_comms_selection(camera_id, camera_id)
    follow_route_select_comms(camera_id, camera_id)

    widget_list = "3dview^science_data^comms_waterfall^comms_control"
    # if not GAMEMASTER_CONSOLE_BETA:
    #     widget_list += "^comms_control"
    gui_update_widgets(widget_list,"")

# TODO: None of these work
    # await task_all(gm_sidebar, gm_map_widget, gm_nav_area_slider, data={"gm_ship":cambot, "client_id": client_id}, sub_tasks=True)
    # await sub_task_schedule(gm_sidebar)
    # await sub_task_schedule(gm_map_widget)
    # await sub_task_schedule(gm_nav_area_slider)
    # jump gm_finalize_gui

--- gm_sidebar

    # Build the left bar
    # This is for the menu buttons
    parent = gui_section(f"area:0,40px,{info_panel_width},100; background-color: #11315018;")
    main_menu_list_box = None
    menu_labels = gm_get_menu_items_tree()
    # Fail-safe for if no gm_menu labels are present...
    if not len(menu_labels):
        jump gm_test_restart_button
    sorted_menu_labels = sorted(list(menu_labels.values()), key=lambda item: item.get_inventory_value("priority", 100))

    # This is the actual list box section
    with gui_sub_section():
        gui_row()
        with gui_sub_section(f"col-width: {GAMEMASTER_CONSOLE_ICON_SIZE}px"):
        # with gui_sub_section():
            main_menu_list_box = gui_list_box(sorted_menu_labels, "", item_template=gm_build_menu_icons, select=True)
            main_menu_list_box.value = sorted_menu_labels[0]

    # Now we set up the contents section.
    # We need to build sub sections for each menu, but hide all but the current one.
    contents = gui_section(f"area: {GAMEMASTER_CONSOLE_ICON_SIZE}px, 40px,{info_panel_width}, 100; background-color: #203d5a47;")

    content_panels = list()

    # This is a dictionary that lets us figure out which panel to present based on which button is pressed.
    menu_panel = None

    # gss = gui_sub_section(f"background-color: #3139af;")

    for m in sorted_menu_labels:

        m_type = m.get_inventory_value("type")
        subs = gm_get_menu_items_tree(m_type)

        if len(subs) == 1:
            # No submenus, so run the current menu label.
            gss_row = gui_row()
            gss = gui_sub_section()
            with gss:
                data = m.inventory.collections
                if m.get_inventory_value("display_text") is None:
                    data["display_text"] = m.name
                await gui_sub_task_schedule(m,data)
            if menu_panel is not None:
                gss_row.show(False)
            else:
                menu_panel = gss_row
            content_panels.append(gss_row)
            continue


        # This is the whole menu area if there's submenus
        gss_row = gui_row()
        gss = gui_sub_section()
        with gss:

            # Now we handle submenus.
            # First we will make a new sub section to handle the tabs.
            tab_row = gui_row(f"row-height: {GAMEMASTER_CONSOLE_ICON_SIZE}px;")
            # tab_section = gui_sub_section()
            sorted_subs = sorted(list(subs.values()), key=lambda item: item.get_inventory_value("priority", 1000))

            # Build the submenu buttons
            buttons = list()
            sub_menu_sections = list()
            selected_submenu_index = GM_SIDEBAR_SELECTED_SUBMENU_INDEX.get(m_type, 0)
            if selected_submenu_index < 0 or selected_submenu_index >= len(sorted_subs):
                selected_submenu_index = 0

            for sub_index, sub in enumerate(sorted_subs):
                icon = sub.get_inventory_value("icon_index")
                if icon is None:
                    icon = 0
                icon_color = sub.get_inventory_value("icon_color")
                if icon_color is None:
                    icon_color = "#404ad8"
                if isinstance(icon, int) or icon.isdigit():
                    button = gui_icon_button(f"icon_index: {icon};color: {icon_color};", "color: #01234567; col-width: square;", data={"menu_type": m_type, "submenu_index": sub_index}, on_press="gm_sidebar_select_submenu")
                else:
                    button = gui_button(f"$text: {icon}; color: {icon_color};", " col-width: content;", data={"menu_type": m_type, "submenu_index": sub_index}, on_press="gm_sidebar_select_submenu")
                buttons.append(button)

            for sub_index, sub in enumerate(sorted_subs):
                # Now we build the section for the actual contents.
                sub_section_row = gui_row()
                content_section = gui_sub_section()
                with content_section:
                    # and we build the contents here by runnning the label.
                    data = sub.inventory.collections
                    await gui_sub_task_schedule(sub,data)

                # Now we handle showing/hiding the applicable rows (the row contains the sub section, which contains the layout)
                if sub_index == selected_submenu_index:
                    gui_show(sub_section_row)
                else:
                    gui_hide(sub_section_row)
                sub_menu_sections.append(sub_section_row)

            GM_SIDEBAR_SUBMENU_PANELS[m_type] = sub_menu_sections
            GM_SIDEBAR_SELECTED_SUBMENU_INDEX[m_type] = selected_submenu_index
            set_inventory_value(client_id, "gm_current_menu",m_type)
        if menu_panel is not None:
            gss_row.show(False)
        else:
            menu_panel = gss_row
        content_panels.append(gss_row)

    # menu.cur is the NOT the index of the menu
    on change main_menu_list_box.value:
        index = sorted_menu_labels.index(main_menu_list_box.value)
        p = content_panels[index]
        if p is not None:
            p.show(True)
            menu_panel.show(False)
            menu_panel = p

        gui_represent(contents)

