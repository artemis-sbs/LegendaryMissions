```
    gui_row()
    sec = gui_sub_section()
    t = None
    remaining = None
    with sec:
        gui_row("row-height: 2em; background: #1234566b;")
        timer = get_counter_elapsed_seconds(0, "Mission_Elapsed_Time")
        if timer is None:
            print("Counter is NONE")
        # test_gui_text_escape = gui_text_escape("{format_time(timer)}")
        elapsed_time_format = "hh:mm:ss"
        test_gui_text_escape = format_counter_elapsed_seconds(0, "Mission_Elapsed_Time", elapsed_time_format)
        elapsed_time = gui_text("$text:Mission Elapsed Time:; justify: left;")
        t = gui_text(f"$text:{test_gui_text_escape};justify: right;")
        # The counter only exists once game_started has been emitted; a console opened
        # before that (or in a mission that never emits it) reads None.
        on change int(get_counter_elapsed_seconds(0, "Mission_Elapsed_Time") or 0):
            timer = get_counter_elapsed_seconds(0, "Mission_Elapsed_Time")
            # test_gui_text_escape = gui_text_escape("{format_time(timer)}")
            test_gui_text_escape = format_counter_elapsed_seconds(0, "Mission_Elapsed_Time", elapsed_time_format)
            t.update(f"$text:{test_gui_text_escape};justify: right;")
        gui_row("row-height: 2em;")
        time_remaining_sub_section = gui_sub_section()
        # if is_timer_set(SHARED, "time_limit"):
        with time_remaining_sub_section:
            time = format_time_remaining(SHARED, "time_limit")
            gui_row("row-height: 2em; background: #1234566b;")
            gui_text("$text: Time Remaining:; justify: left;")
            remaining = gui_text(f"$text:{time};justify: right;")
            on change get_time_remaining(SHARED, "time_limit"):
                time = format_time_remaining(SHARED, "time_limit")
                remaining.update(f"$text:{time};justify: right;")
            gui_row("row-height: 2em;")
            m1 = gui_button(f"$text:-1 min", data={"minutes":-1})
            p1 = gui_button(f"$text:+1 min", data={"minutes":1})
            gui_row("row-height: 2em;")
            m5 = gui_button(f"$text:-5 min", data={"minutes":-5})
            p5 = gui_button(f"$text:+5 min", data={"minutes":5})

            gui_message(m1, gm_add_remaining_time)
            gui_message(p1, gm_add_remaining_time)
            gui_message(m5, gm_add_remaining_time)
            gui_message(p5, gm_add_remaining_time)

        # Spacer row
        gui_row("row-height: 2em;")
        gui_blank()

        # Allow GM to enforce a time limit
        gui_row("row-height: 1em;")
        gui_text("$text:Set Time Limit: ;","col-width: content;")
        time = gui_input("msg: Time Limit;", "", var="gm_set_time_limit")
        gui_row("row-height: 1em;")
        limit = gui_button("Time limit")
        on gui_message(limit):
            time_limit = gui_get_variable("gm_set_time_limit", 30)
            if isinstance(time_limit, str):
                time_limit = int(time_limit)
            set_timer(SHARED, "time_limit", minutes=time_limit)
            gui_show(time_remaining_sub_section)

        gui_row("row-height: 1em;")
        rtl = gui_button("Remove Time Limit")
        on gui_message(rtl):
            clear_timer(SHARED, "time_limit")
            gui_hide(time_remaining_sub_section)
        gui_row("row-height: 1em;")
        eb = gui_button(" End Game","background-color:red;")
        on gui_message(eb):
            # clear_timer(SHARED, "time_limit")
            # jump task_end_game
            START_TEXT = "Mission time has run out!"
            GAME_STARTED = False
            GAME_ENDED = True
            music_play_sting("victory")
            signal_emit("show_game_results", None)


        # task_schedule(gm_elapsed_time_update, data={"t": t, "sec": sec, "remaining":remaining})
    yield success

=== gm_add_remaining_time
" Executes the gm add/remove remaining time functionality.
    if __ITEM__ is None:
        ->END
    minutes = __ITEM__.data.get("minutes",0)
    seconds = __ITEM__.data.get("seconds",0)
    timer_add_time(SHARED, "time_limit", seconds, minutes)
    ->END

