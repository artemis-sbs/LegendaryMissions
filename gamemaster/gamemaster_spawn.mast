=== gm_spawn_button_pressed
    lb = __ITEM__.data.get("lb")
    spawn_side_dropdown = __ITEM__.data.get("spawn_side_dropdown")
    if lb is None or spawn_side_dropdown is None:
        yield fail
    print("Spawning test")
    selection = lb.value
    side_option = spawn_side_dropdown.value
    if side_option == "Origin":
        spawn_side = selection.get("origin","")
    elif side_option == "Allied":
        spawn_side = "tsn" # For now
    elif side_option == "Hostile":
        spawn_side = "raider" # For now
    else:
        spawn_side = "civ"
    spawn_roles = selection.get("roles","")
    # art = selection.get("artfileroot")
    art = selection.get("key")
    cambot = sbs.get_ship_of_client(client_id)
    pos = gamemaster_get_pos(cambot, "lmb")

    prefab_spawn(prefab_single_ship, data={"ship_role":spawn_roles,"ship_art": art, "side_value": spawn_side}, OFFSET_X=pos.x, OFFSET_Y=pos.y, OFFSET_Z=pos.z)
    ->END

