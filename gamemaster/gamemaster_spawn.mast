    with gui_sub_section():

        # From
        gui_row("row-height: 1.5em;")
        gui_text("$text: Send Message to Player Ship(s)")
        gui_row("row-height: 1.2em;")
        gui_text("$text:Specify Origin:;")
        gui_row("row-height: 1.5em;")
        from_search_bar = gui_input("")
        from_list_box_row = gui_row()

        from_options = to_object_list(any_role("lifeform,__npc__,station,fighter"))
        from_list_box = gui_list(from_options,select=True)

        gm = sbs.get_ship_of_client(client_id)

        # print(from_options)
        with from_list_box as id:
            obj = to_object(id)
            if obj is not None:
                # gui_row("row-height: 1em;")
                if has_role(obj, "station"):
                    gui_icon("icon_index: 114;color: #555555")
                elif has_role(obj, "lifeform"):
                    gui_icon("icon_index: 83; color: green;")
                else:
                    gui_icon("icon_index: 140; color: blue;")
                gui_text(f"{obj.name}")
        
        on change from_search_bar.value:
            from_options = to_object_list(any_role("lifeform,__npc__,station,fighter"))
            val = from_search_bar.value
            # items = ~~[item for item in from_options if item.name in val]~~
            # print(val)
            # items = list(filter(lambda item: item.name in val, from_options))
            items = list()
            for item in from_options:
                if val.lower().strip() in item.name.lower():
                    items.append(item)
            # print(len(items))
            from_list_box.listbox.items = items
            if len(items) == 1:
                # auto-select the default option if there's only one
                from_list_box.listbox.set_value(items[0])

        on change gui_get_variable("gm_selection"):
            new_id = gui_get_variable("gm_selection")
            obj = to_object(new_id)
            if obj is not None:
                from_search_bar.value = obj.name
            else:
                from_search_bar.value = ""
        

        on change from_list_box.listbox.value:
            sel = from_list_box.listbox.value
            if sel is not None:
                from_search_bar.value = sel.name
                sel_id = to_id(sel)
                follow_route_select_science(gm, sel_id)
            else:
                print("item is None\nOn Change from_list_box.get_selected()")

        # Message

        # Load
        gui_row("row-height: 1.5em;background: #123456;")
        gui_text("$text: Input message here:","col-width: content;")
        gui_blank()
        load_button = gui_icon_button("icon_index: 92;")
        save_button = gui_icon_button("icon_index: 94;")
        # save_button = gui_button("$text:Save For Later")
        
        # Message entry

        message_input_section = gui_row("")
        # message_input_section = gui_sub_section()
        gm_in = None
        # with message_input_section:
        with gui_sub_section():
            gm_in = gui_input("")
        
        
        message_load_section = gui_row()
        gm_load_messsage_lb = None
        with gui_sub_section():
            items = gui_get_variable("gm_saved_messages",list())
            gm_load_message_lb = gui_list_box(items,"",select=True)
            gui_row("row-height: 1.2em;")
            cancel_msg_select_button = gui_button("Cancel")
            on gui_message(cancel_msg_select_button):
                gui_hide(message_load_section)
                gui_show(message_input_section)

        gui_hide(message_load_section)

        on gui_message(load_button):
            print("Load button pressed")
            message_list = gui_get_variable("gm_saved_messages",list())
            print(message_list)
            gm_load_message_lb.items = message_list
            gui_hide(message_input_section)
            gui_show(message_load_section)

        on gui_message(save_button):
            print("Save button pressed")
            msg = gm_in.value
            print(msg)
            message_list = gui_get_variable("gm_saved_messages",list())
            print(message_list)
            message_list.append(msg)
            print(message_list)
            gui_set_variable("gm_saved_messages", message_list)

        on change gm_load_message_lb.value:
            selection = gm_load_message_lb.value
            if selection is None:
                yield fail
            gm_in.value = selection
            gm_load_message_lb.value = None
            gui_hide(message_load_section)
            gui_show(message_input_section)

        gui_row("row-height: 1.2em;background: #123456;")
        gui_text("Select Target Ships")
        gui_row()
        player_ships = list(role("__player__"))
        # player_ship_select = gui_list_box(player_ships,"",select=True,multi=True)

        player_ship_select_ = gui_list(player_ships, select=True,multi=True)
        with player_ship_select_ as id:
            ship = to_object(id)
            # gui_row("row-height: 1.5em;")
            gui_text(f"$text:{to_object(ship).name}")

        on change len(role("__player__")):
            player_ships = list(role("__player__"))
            player_ship_select_.items = player_ships
        
        gui_row("row-height: 1.2em;background: #123456;")
        send_to_selected = gui_button("$text:Send to Selected;")
        
        gui_row("row-height: 1.2em;background: #123456;")
        send_to_players = gui_button("$text: Send to All Ships")

        on gui_message(send_to_selected):
            # print(len(player_ship_select_.get_selected()))
            _from = from_list_box.listbox.value
            if _from is None:
                yield fail
            # send_comms_message_to_player_ship(player_ship_select_.value, _from, "",title,"blue",message,"blue") 
            msg = gm_in.value
            to = player_ship_select_.get_selected()
            print(f"Sending msg to: {to}")
            comms_message(msg, _from, to)

        on gui_message(send_to_players):
            print("Sending to all players")
            _from = from_list_box.listbox.value
            if _from is None:
                yield fail
            msg = gm_in.value
            to = role("__player__")
            comms_message(msg, _from, to)

    yield success


