
# Here we just throw in default values for sliders, to avoid having them always start at 0. 
# Better to give the user and idea of what the default value is. 
MONSTER_SCALE = 1.0
NEB_DENSITY = 1.0
BH_RADIUS = 5000
BH_GRAV_STR = 4.0
BH_TURB_STR = 2.0
BH_DAMAGE = 200
//gui/normal_gamemaster
    # This shoudn't actually do anything. It's mostly here to prevent `gm_menu_spawn` from running immediately on startup without being attached to a gui.
    ->END


