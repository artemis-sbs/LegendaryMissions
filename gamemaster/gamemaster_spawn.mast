#region Reusable Spawn Logic

=== gm_menu_reusable_spawn_logic
" Use this to set up spawn menus in an extensible manner. 
" The `settings` and `variables` values are critical. 
" `settings` defines a property_list_box that incorporates gui layout items into the UI. 
" `variables` tells the spawn logic which layout item should be used for required metadata keys in the prefab (e.g. radius for planets)
" `extra_roles` is a comma-separated list of roles that should be added to any object spawned using this logic. This can be used to do other, custom stuff when these objects are spawned. 
" Position (START_X, etc) and size (SIZE_X, etc) are included by default, even if they are not used.
" All other metadata keys must be specified in `variables`. It's up to the user to determine what keys are required for any given label type. 
    # metadata: ```
    # # prefab_type: prefab/terrain/asteroid # you'll want to change this of course
    # # type_name: Asteroid
    # # settings:
    # #     Main:
    # #         Name: 'gui_input("$text:;desc:Object Name",var="OBJ_NAME")'
    # # variables:
    # #     NAME: OBJ_NAME
    # extra_roles:
    # ```
        # gui_set_variable(f"settings_{prefab_type}", settings)
        # settings = gui_get_variable("settings_{prefab_type}")

    default type_name = "Name Not Provided"

    if mast_task.get_inventory_value("prefab_type") is None:
        print("Could not find prefab type")
        print(type_name)
        yield fail
    else:
        # TODO: Not sure why, but `prefab_type` wasn't being converted to a variable as expected. This resolves that issue, though it really shouldn't be necessary. 
        prefab_type = mast_task.get_inventory_value("prefab_type")

    with gui_sub_section():

        gui_row("row-height: content;")
        listbox_tag = f"GM_GLB_SPAWN_{prefab_type}"
        # print(listbox_tag)
        # Not `lb`: that name is shared with the ships panel, whose `on change` handlers still target it.
        gm_menu_reusable_spawn_logic_lb = gui_property_list_box_stacked(f"{type_name} Settings", listbox_tag)
        gui_properties_set(settings, listbox_tag)
        mast_task.set_inventory_value(f"{listbox_tag}_settings",settings)
        mast_task.set_inventory_value(f"{listbox_tag}_lb",gm_menu_reusable_spawn_logic_lb)
        print(f"{listbox_tag}")
        # on signal side_added:
        on change len(sides_set()):
            listbox_tag = f"GM_GLB_SPAWN_{prefab_type}"
            print(f"{listbox_tag}")
            settings = mast_task.get_inventory_value(f"{listbox_tag}_settings")
            lb = mast_task.get_inventory_value(f"{listbox_tag}_lb")
            if settings is not None and settings.get("Main") is not None and settings.get("Main").get("Side") is not None:
                side_list = list(side_keys_set())
                side_str = ",".join(side_list)
                settings["Main"]["Side"] = f"gui_drop_down('$text:{side_list[0]};list:{side_str};',var='FLEET_SIDE')"
                update_property_set(lb, settings)
                

        gui_row("row-height: 1.5em;")
        gui_text("$text:Prefab:;","col-width: content;")

        generic_prefabs = labels_get_type(prefab_type)

        gui_row()
        prefab_list = gui_list(generic_prefabs, select=True)
        with prefab_list as prefab:
            display_text = prefab.get_inventory_value("display_text")
            if display_text is None:
                if prefab_type is None:
                    print("Fail")
                    yield fail
                if f"{prefab_type}/" in prefab.get_inventory_value("type"):
                    display_text = prefab.get_inventory_value("type","").replace(f"{prefab_type}/","")
                if display_text is None:
                    display_text = prefab.name
            gui_text(f"$text:{display_text}")
        prefab_list.set_selected_index(0)

        # obj_name_input = gui_input(f"$text:;desc:{type_name} Name;")

        gui_row("row-height: 1.5em;")

        # We have to pass explicit "variables" values to the button, or it all gets messed up
        # with other panels' spawn logic
        # Same for the listbox and prefab type/name
        spawn_obj_button = gui_button(f"$text:Spawn {type_name}", data={"variables": variables, "listbox":prefab_list.listbox, "prefab_type":prefab_type})

        on gui_message(spawn_obj_button):
            gm = sbs.get_ship_of_client(client_id)
            pos = gamemaster_get_pos(gm)
            size = int(gamemaster_get_size(gm))
            # lbl = prefab_list.listbox.value
            button_variables = __ITEM__.data.get("variables",dict())
            lbl = __ITEM__.data.get("listbox").value
            data={"START_X":pos.x,"START_Y":pos.y,"START_Z":pos.z}
            if button_variables.get("use_gm_size"):
                data["SIZE_X"] = size
                data["SIZE_Z"] = size
            name = ""
            # Now we USE the variables saved on the button
            for prefab_var in button_variables.keys():
                # use_gm_size is specifically excluded, since it's only used to set the size variables, which is already done at this point. 
                if prefab_var in "use_gm_size":
                    continue
                layout_item_var = button_variables.get(prefab_var)

                # Give the writer a warning without a MAST crash if you set up variables wrong
                if not isinstance(layout_item_var, str):
                    prefab_type = __ITEM__.data.get("prefab_type","")
                    print(f"\nERROR in GM Menu: values for `variables` must be a string\n    Trying to spawn {prefab_type}")
                    print(f"Key: {prefab_var}")
                    print(f"Value (should be a string!): {layout_item_var}")
                    continue

                # Add the variables to the data
                liv = gui_get_variable(layout_item_var)
                if liv is not None:
                    data[prefab_var] = liv
                if prefab_var == "name":
                    name = liv
                
            # Finally, we actually spawn the prefab
            spawned = await prefab_spawn(lbl, data=data)

    yield success
#endregion

