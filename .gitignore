# Legacy location for saved game codes. They now live outside the mission, in
# data/missions/common_data/game_codes/<mission>.yaml, so nothing writes this any
# more - but every existing install still has one, and un-ignoring it would show
# every host an untracked file the moment they update.
game_code_presets.yaml
# Generated by sbs_utils before sim_create() whenever an addon declares ships with
# ship_data_merge_mod (the turrets addon does). Rewritten every run, so it is output, not
# source. If a mission ever HAND-AUTHORS entries in it, un-ignore it - the reader keeps
# hand-authored entries and they win any key collision with a generated one.
extraShipData.json
extraShipData.json.bak
# Rendered documents from `sbs docs` - build output, not source. An embedded
# edition can run to several MB because it inlines the face atlases.
/__docs__/
