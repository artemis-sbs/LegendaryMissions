#
#  Avatar Editor  (LegendaryMissions addon, opt-in)
#
#  A reusable, WYSIWYG face customizer built over sbs_utils.faces:
#      faces.FACE_FEATURES  - per-race feature list (label / max / optional)
#      faces.build_face()   - assembles the layered face string from indices
#
#  Unlike the extension's blind builder, this runs in the engine, so it shows a
#  live gui_face preview that updates as you move the sliders.
#
#  Use it from a mission (after adding "avatar_editor" to story.json mastlib):
#
#      # fire-and-forget as its own GUI page, then read the result:
#      await task_schedule(avatar_editor_show, {"av_race": "terran"})
#      chosen = AVATAR_FACE                      # shared, set on Done
#
#      # or react to the done signal (data = the face string):
#      //signal/avatar_editor_done
#          set_face(SOME_ID, EVENT... )          # etc.
#
#      # or run it inline in an existing GUI task and come back:
#      jump avatar_editor_show   (with av_return="my_label" in scope)
#
#  Inputs (task vars / metadata defaults):
#      av_race         starting race            (default "terran")
#      av_title        title-bar text           (default "AVATAR EDITOR")
#      av_done_signal  signal emitted on Done    (default "avatar_editor_done")
#      av_return       label to return to on Done ("" -> ->END)
#
#  Output:
#      shared AVATAR_FACE   the built face string (updated live + on Done)
#      the chosen face is also copied to the clipboard on every change
#

default shared AVATAR_FACE = ""

=== avatar_editor_show
metadata: ``` yaml
av_race: terran
av_title: AVATAR EDITOR
av_done_signal: avatar_editor_done
av_return: ""
av_face: ""
av_required: ""
```
    # START FROM THE FACE THEY ALREADY HAVE, when they have one. `parse_face` is the inverse
    # of `build_face` and round-trips exactly, so the sliders open where the person is rather
    # than at the feature minimums - opening on a stranger and making the editor a
    # start-from-scratch tool was the whole complaint.
    #
    # It answers None for an empty spec, for anything malformed, and for a MOD face (whose
    # atlas is whole drawn busts with no features to take apart). All three fall back to the
    # defaults, which is the right answer for each: there is nothing to resume.
    av_start = faces.parse_face(av_face)
    if av_start is not None:
        # The face names its own race - the caller's guess does not get to disagree with it.
        av_race = av_start["race"]
    av_race = str(av_race).lower()
    av_features = faces.FACE_FEATURES.get(av_race)
    jump avatar_editor_bad_race if av_features is None
    if av_start is not None:
        av_values = av_start["values"]
        av_enables = av_start["enables"]
    else:
        av_values = avatar_editor_defaults(av_features, av_race)
        av_enables = [True] * len(av_features)

--- avatar_editor_required
    # FEATURES THE CALLER SAYS ARE NOT OPTIONAL HERE, by label: `av_required: Clothes`.
    #
    # `FACE_FEATURES` is the general recipe and is right to call clothing optional - the
    # game is full of civilians, and the modding tool this was ported from builds them. But
    # a BRIDGE OFFICER out of uniform is not a variation on a crew member, it is a stranger
    # at the helm, so the screen that edits one must not offer to take it off.
    #
    # Turned on rather than hidden: a required feature keeps its slider (which uniform you
    # wear is still a choice) and loses only the checkbox that could switch it off.
    #
    # An inline label rather than two copies, because the race picker rebuilds the whole
    # feature list and has to re-apply this before it paints.
    av_required_list = [str(x).strip().lower() for x in str(av_required).split(",") if str(x).strip()]
    for i, widget in enumerate(av_features):
        if str(widget["label"]).lower() in av_required_list:
            av_enables[i] = True

--- avatar_editor_paint
    face = faces.build_face(av_race, av_values, av_enables)
    shared AVATAR_FACE = face
    gui_clipboard_copy(face)

    gui_section("area:0,0,100,100;")
    gui_row("row-height:2em;background: #1573")
    gui_text("text:{av_title}; font:gui-3;justify: center;")
    close_ib = gui_icon("icon_index:137;color:white;", style="click_color:white;click_tag:done;click_background:#6666")
    on gui_click(close_ib):
        jump avatar_editor_done

    # Live preview (left of the controls)
    gui_section(style="area: 0, 12, 100-400px, 100;")
    the_face = gui_face(face)

    # Race picker
    gui_section(style="area: 100-400px, 12, 100, 20;row-height:2em;")
    race_pick = gui_drop_down("text:{av_race.capitalize()};list: Arvonian, Kralien, Skaraan, Terran, Torgoth, Ximni", var="av_race")
    on gui_message(race_pick):
        av_race = str(av_race).lower()
        av_features = faces.FACE_FEATURES.get(av_race)
        av_values = avatar_editor_defaults(av_features, av_race)
        av_enables = [True] * len(av_features)
        jump avatar_editor_required

    # Per-feature controls
    gui_section(style="area: 100-400px, 20, 100, 92;row-height:2em;")
    ctrl_style = "padding:10px,5px,5px,10px;"
    # A feature with NAMES gets a real control rather than a bare 0..N slider: the
    # redrawn sheets carry actual choices - "Worried", "Blue", "Gritted", "Respirator".
    # SHORT list -> dropdown. LONG list -> slider with the name written beside it,
    # because a dropdown stops being usable in the engine somewhere around ten entries
    # and the skin palette is 39 tones. avatar_editor_use_slider() owns the threshold.
    for i, widget in enumerate(av_features):
        gui_row(style="padding: 1px;")
        label = widget["label"]
        wmax = widget["max"]
        wmin = widget.get("min", 0)
        wnames = widget.get("names")
        if "optional" in widget and str(label).lower() not in av_required_list:
            cb = gui_checkbox("text: {label};state:{av_enables[i]}", ctrl_style, data={"windex": i})
            cb.value = av_enables[i]
            on gui_message(cb):
                av_enables[windex] = not av_enables[windex]
                the_face.value = faces.build_face(av_race, av_values, av_enables)
                gui_clipboard_copy(the_face.value)
            if wnames:
                dd = gui_drop_down(avatar_editor_choice_style(wnames, av_values[i]), ctrl_style, data={"windex": i, "wpick": wnames})
                on gui_message(dd):
                    av_values[windex] = avatar_editor_choice_index(wpick, __ITEM__.value)
                    the_face.value = faces.build_face(av_race, av_values, av_enables)
                    gui_clipboard_copy(the_face.value)
            elif wmax > 0:
                sl = gui_int_slider("low: {wmin}; high: {wmax};", ctrl_style, data={"windex": i})
                sl.value = av_values[i]
                on gui_message(sl):
                    av_values[windex] = __ITEM__.value
                    the_face.value = faces.build_face(av_race, av_values, av_enables)
                    gui_clipboard_copy(the_face.value)
        else:
            # A LONG named list is a slider with its name written beside it, not a
            # dropdown - 39 skin tones in a dropdown is unusable in the engine. The label
            # widget carries "Feature: Name" so the row still has only two controls, and
            # it is passed through `data` rather than referenced directly: every row's
            # handler is compiled in the same loop, so a bare `nm` would resolve to the
            # LAST row's widget and every slider would rename the bottom one.
            if wnames and avatar_editor_use_slider(wnames):
                nm = gui_text(avatar_editor_choice_label(label, wnames, av_values[i]))
                sl = gui_int_slider("low: {wmin}; high: {wmax}; show_number: no", ctrl_style, data={"windex": i, "wpick": wnames, "wlabel": nm, "wtitle": label})
                sl.value = av_values[i]
                on gui_message(sl):
                    av_values[windex] = __ITEM__.value
                    wlabel.value = avatar_editor_choice_label(wtitle, wpick, __ITEM__.value)
                    the_face.value = faces.build_face(av_race, av_values, av_enables)
                    gui_clipboard_copy(the_face.value)
            else:
                """text:{label}"""
                if wnames:
                    dd = gui_drop_down(avatar_editor_choice_style(wnames, av_values[i]), ctrl_style, data={"windex": i, "wpick": wnames})
                    on gui_message(dd):
                        av_values[windex] = avatar_editor_choice_index(wpick, __ITEM__.value)
                        the_face.value = faces.build_face(av_race, av_values, av_enables)
                        gui_clipboard_copy(the_face.value)
                else:
                    sl = gui_int_slider("low: {wmin}; high: {wmax}; show_number: no", ctrl_style, data={"windex": i})
                    sl.value = av_values[i]
                    on gui_message(sl):
                        av_values[windex] = __ITEM__.value
                        the_face.value = faces.build_face(av_race, av_values, av_enables)
                        gui_clipboard_copy(the_face.value)

    # Randomize and Done, sharing the bottom row.
    gui_section(style="area: 100-400px, 92, 100, 100;row-height:2em;")
    gui_row()
    # RANDOMIZE KEEPS THE RACE and rolls everything else. It goes through the library's
    # own randomizer rather than picking a number per control, so it inherits what that
    # already knows: no closed eyes or mid-word mouths on a resting face, no green humans,
    # and sensible odds on a hat. Then it jumps back through avatar_editor_required, the
    # same path the race picker takes, so a feature the CALLER marked required cannot be
    # switched off by a roll.
    on gui_message(gui_button("Randomize")):
        av_values, av_enables = avatar_editor_randomize(av_features, av_race, av_required_list)
        jump avatar_editor_required
    on gui_message(gui_button("Done")):
        jump avatar_editor_done

    await gui()

--- avatar_editor_done
    face = faces.build_face(av_race, av_values, av_enables)
    shared AVATAR_FACE = face
    gui_clipboard_copy(face)
    if av_done_signal:
        signal_emit(av_done_signal, face)
    if av_return:
        mast_task.jump(av_return)
        ->END
    ->END

=== avatar_editor_bad_race
    gui_section(style="area: 20, 40, 80, 60;")
    gui_text("text:Avatar editor: unknown race '{av_race}'.;justify:center;")
    on gui_message(gui_button("Close")):
        jump avatar_editor_done
    await gui()
