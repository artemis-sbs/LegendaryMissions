# Presentation pickers (map options). These are declared HERE, not hardcoded into the
# server console, so a mission gets a control because its map asked for one - a mission
# with no music banks, no crew rosters or no theaters shows nothing.
#
# Each seed reads the SHARED value first and the setting second, so this `default` cannot
# overwrite a choice a profile already made with the fallback.
default shared MUSIC_SELECT = music_selected_name()
default shared MUSIC_LIST = music_name_list()
default shared CREW_SELECT = crew_selected_name()
default shared CREW_LIST = crew_name_list()
default shared THEATER = theater_selected_name()
default shared THEATER_LIST = theater_name_list()

@map/border_war "Border War"
"Both friendly and enemy bases appear in this scenario.
" A 'neutral zone' exists between the two sides, which
" the player ship cannot enter until a declaration of
" war is received by the Comms console. An additional
" control will allow you to set how many minutes will
" pass before war is declared. Obviously, this should be
"  less than the Time Limit.
metadata:``` yaml
Properties:
  Main:
    Player Ships: 'gui_int_slider("$text:int;low: 1.0;high:8.0;", var= "PLAYER_COUNT")'
    Difficulty: 'gui_int_slider("$text:int;low: 1.0;high:11.0;", var= "DIFFICULTY")'
    Music: 'gui_drop_down("$text: {MUSIC_SELECT};list: {MUSIC_LIST}", var="MUSIC_SELECT")'
    Crew: 'gui_drop_down("$text: {CREW_SELECT};list: {CREW_LIST}", var="CREW_SELECT")'
    Theater: 'gui_drop_down("$text: {THEATER};list: {THEATER_LIST}", var="THEATER")'
  Map:
    Terrain: 'gui_drop_down("$text: {TERRAIN_SELECT};list: none, few, some, lots, max",var="TERRAIN_SELECT")'
    Lethal Terrain: 'gui_drop_down("$text: {LETHAL_SELECT};list: none, few, some, lots, max", var="LETHAL_SELECT")'
    Friendly Ships: 'gui_drop_down("$text: {FRIENDLY_SELECT};list: none, few, some, lots, max", var="FRIENDLY_SELECT")'
    Monsters: 'gui_drop_down("$text: {MONSTER_SELECT};list: none, few, some, lots, max", var="MONSTER_SELECT")'
    Upgrades: 'gui_drop_down("$text: {UPGRADE_SELECT};list: none, few, some, lots, max", var= "UPGRADE_SELECT")'
    Minutes to War: 'gui_input("desc: Minutes;", var="WAR_TIME_DELAY")'
    Time Limit: 'gui_input("desc: Minutes;", var="GAME_TIME_LIMIT")'
    Seed: 'gui_input("desc: Integer (0 = random);", var="seed_value")'
```


    terrain_value = terrain_to_value(TERRAIN_SELECT)
    lethal_value =  terrain_to_value(LETHAL_SELECT)
    friendly_value = terrain_to_value(FRIENDLY_SELECT)
    monster_value = terrain_to_value(MONSTER_SELECT)
    upgrade_value = terrain_to_value(UPGRADE_SELECT)
    # Seed arrives from a gui_input typein / loaded game code, so it can be a
    # string; normalize to int before any comparison or arithmetic.
    seed_value = safe_int(seed_value)

    if seed_value != 0:
        random.seed(seed_value)
        print(f"Seed Value: {seed_value}")

    num_upgrade = 0
    if upgrade_value != "none":
        if upgrade_value == 1:
            num_upgrade = random.randint(1,3)
        elif upgrade_value == 2:
            num_upgrade = random.randint(3,5)
        elif upgrade_value == 3:
            num_upgrade = random.randint(5,10)
        elif upgrade_value == 4:
            num_upgrade = random.randint(10,15)
    print("Number of Upgrades: {num_upgrade}")

    if seed_value != 0:
        random.seed(seed_value)
        print(f"Seed Value: {seed_value}")
    else:
        seed_value = random.randint(1,99999)
        random.seed(seed_value)
        print(f"Random Seed Value: {seed_value}")

    #------------------------------------------------------------------------------------------------------------
    # Add the "Neutral Zone" 

    sim.add_navarea(0, 500000, 20000, 500000, 0, -500000, 20000, -500000, "Neutral Zone", "#004")


    #------------------------------------------------------------------------------------------------------------
    # Determine Enemy Antagonists

    # WHO turns up is the THEATER's ladder now, not a literal here. This used to be a
    # three-name list zipped against a (50,25,25) curve by position - and the list was three
    # long, where the other maps are four, because this map builds enemy STATIONS and the
    # ximni have no starbase hull. `race_has_station` is that constraint, derived from the
    # ship table, so it is stated once instead of encoded as a shortened list.
    enemy1 = fleet_pick_enemy_race(difficulty=DIFFICULTY, eligible=race_has_station)

    #------------------------------------------------------------------------------------------------------------
    # Build friendly stations
    terrain_spawn_stations(DIFFICULTY, lethal_value, 25000, 65000)

    #------------------------------------------------------------------------------------------------------------
    # wait for the creation of the player ships
    # spawn_players FIRST, ahead of everything else this map builds. The map body runs
    # inline in the frame that handled the Start button, and this label is the last
    # thing that has to finish before the consoles can leave the selection screen - so
    # whatever sits ahead of it is charged straight to the crew's wait. The friendly
    # NPCs need the stations, not the players, so they cost nothing by moving behind it.
    await task_schedule(spawn_players)
    await task_schedule(spawn_friendly_npc)
    await task_schedule(default_player_friendly_eyes)
    await task_schedule(docking_standard_player_station)


    # Sow the field instead of creating it all in one frame: ~280 ms of
    # engine work becomes a few ms a tick, spread nearest-first.
    terrain_sow_begin(over=6)
    terrain_asteroid_clusters(terrain_value)
    terrain_spawn_nebula_clusters(terrain_value)
    terrain_sow_end()
    terrain_spawn_pickups(upgrade_value)
    terrain_spawn_monsters(monster_value)
    terrain_spawn_black_holes(lethal_value)
    


    #------------------------------------------------------------------------------------------------------------
    # Build enemy stations, generate fleets

    enemy_station_list = []
    navpoint_list = []
    enemy_station_dict = {}

    pos = Vec3()
    startZ = -50000

    fleet_index = int(DIFFICULTY) - 1

    num_enemy_stations = int(DIFFICULTY)
    if num_enemy_stations < 3:
        num_enemy_stations = 3
    station_step = 100000/num_enemy_stations

    # Both of these were if-chains over the three race literals. The hull is DERIVED - it is
    # the entry whose origin is this race and whose roles carry `station` - and the prefix is
    # the one thing the ship table cannot say, so it is declared in races/races.amd.
    station_prefix = race_station_prefix(enemy1)
    station_type = race_station_hull(enemy1)

    # ART ONLY - resolve the stock station key through ART_KEYS once, here, so both the
    # spawn and the navproxy below draw the same hull. No-op unless a mission or profile
    # sets it. The roles string keeps naming the mission's own faction, so diplomacy is
    # unchanged; only the art moves.
    station_type = ship_data_art_key_for(station_type)

    # for each station
    for index in range(num_enemy_stations):

        pos.x = -(random.random()*25000+25000)
        pos.y = random.random()*2000-1000
        pos.z = startZ + random.random()*station_step/3  -   station_step/6
    #    _spawned_pos.append(pos)
        startZ += station_step

        #make the station ----------------------------------
        name = "{station_prefix} {index+1}"

        # The roles string only ever differed by the race name, so it composes.
        station_roles = f"raider, {enemy1.lower()}, delprox, enemy, station"
        enemy_station_object = npc_spawn(*pos, name, station_roles, station_type, "behav_station")
        eso_id = to_id(enemy_station_object)
        nav_obj = sim.add_navproxy(eso_id, name, station_type, "#A44")
        set_inventory_value(eso_id, "navprox_id", to_id(nav_obj))

        # random_face already dispatches by race, and honors both a mod's registered faces
        # and the theater's Faces: map - which the three hardcoded calls could not.
        set_face(to_id(enemy_station_object), random_face(race_faces(enemy1)))

        print(f"{enemy1} Station created: {int(pos.x)}, {int(pos.y)}, {int(pos.z)}")

        apos = Vec3()
        apos.x = pos.x + 50.0
        apos.z = pos.z + 50.0

        prefab_spawn(prefab_fleet_raider, {"race": enemy1, "fleet_difficulty": DIFFICULTY,"START_X": apos.x, "START_Y": apos.y, "START_Z": apos.z})



    #------------------------------------------------------------------------------------------------------------

    players = role('__player__')
    # WAR_TIME_DELAY is a gui_input typein / loaded game code -> a string (or empty);
    # safe_int avoids int("") ValueError and keeps the compares below numeric.
    war_delay = safe_int(WAR_TIME_DELAY)

    if war_delay == 0:
        overlay_banner("WAR HAS BEEN DECLARED", color="#f44", to=players, seconds=12)
        for p in players:
            comms_receive_internal(f"""WAR HAS BEEN DECLARED!""", p, "TSN Command", title="WAR DECLARED", title_color="yellow")
        war_declared = 1
        ->END

    shared war_declared = 0
    task_schedule(war_timer_loop)
    task_schedule(check_neutral_zone)
    task_schedule(task_borderwar_end_game)
    ->END

======= war_timer_loop =========
    if war_declared >= 1:
        ->END

    if war_delay == safe_int(WAR_TIME_DELAY):
        # A countdown is the textbook banner: re-showing the slot updates it in
        # place. comms_receive_internal below stays as the durable record.
        overlay_banner(f"""WAR STARTS IN {war_delay} MINUTES""", to=players, seconds=15)
        for p in players:
            comms_receive_internal(f"""WAR STARTS IN {war_delay} MINUTES!""", p, "TSN Command", title="PREPARE FOR WAR", title_color="yellow")

    if war_delay == 5:
        # Send 5-minute warning.
        overlay_banner("WAR STARTS IN 5 MINUTES", to=players, seconds=20)
        for p in players:
            comms_receive_internal(f"""WAR STARTS IN 5 MINUTES!""", p, "TSN Command", title="WAR 5 MIN", title_color="yellow")

    if war_delay == 1:
        # Send 1-minute warning.
        overlay_banner("WAR IMMINENT", color="#f44", to=players, seconds=30)
        for p in players:
            comms_receive_internal(f"""WAR STARTS IN 1 MINUTE!""", p, "TSN Command", title="WAR IMMINENT", title_color="yellow")

    war_delay -= 1
    await delay_sim(seconds=60)

    if war_delay == 0:
        overlay_banner("WAR DECLARED", color="#f44", to=players, seconds=15)
        for p in players:
            comms_receive_internal(f"""WAR HAS BEEN DECLARED!""", p, "TSN Command", title="WAR DECLARED", title_color="yellow")
        war_declared = 1
        ->END
    else:   
        jump war_timer_loop

====== check_neutral_zone =======
    if war_declared == 1:
        ->END
    for p in players:
        eo = to_engine_object(p)
        print(f"Player Position: {int(eo.pos.x)}, {int(eo.pos.y)}, {int(eo.pos.z)}")
        if eo.pos.x <= 20000:
            war_declared = 2

    if war_declared == 2:
        overlay_flash("#f006", to=players)
        overlay_banner("NEUTRAL ZONE VIOLATION", color="#f44", to=players, seconds=10)
        for p in players:
            comms_receive_internal(f"""NEUTRAL ZONE VIOLATION - Mission Failed!""", p, "TSN Command", title="NETURAL ZONE VIOLATION", title_color="red")
        await delay_sim(seconds=6)
        war_declared = 3
    #    task_schedule(task_end_game)
        ->END

    await delay_sim(seconds=5)
    jump check_neutral_zone







