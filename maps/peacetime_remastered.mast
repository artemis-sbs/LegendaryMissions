# Peacetime Remastered - a peacekeeping patrol shift.
#
# Reimagines maps/peacetime.mast. It REUSES that map's proven "Ambassador Florbin
# kidnapping" investigation (the kidnap_caper label + its comms/science routes, all
# gated on kidnap_status >= 1), but:
#   * surfaces the case as a proper QUEST TREE in the quest log (florbin_quest_watch
#     bridges the old kidnap_status flag to quest_signal), instead of a hidden flag, and
#   * adds a board of peacetime side-jobs that keep the whole crew busy - Weapons
#     especially. The peacetime Weapons doctrine here is "enforcer & hazard-clearer,
#     not destroyer": qualify on target drones, demolish hazard rocks, and DISABLE
#     (don't destroy) a poacher.
#
# The original Peacetime map is untouched and still selectable; this is a new @map.

@map/peacetime_remastered "Peacetime Remastered"
" A quiet border patrol shift. Work the quest board: run down the Florbin
" kidnapping, qualify the gunnery crew, clear hazards, and police the lanes.
" Weapons stays busy - just not at war.
metadata:``` yaml
Properties:
  Main:
    Player Ships: 'gui_int_slider("$text:int;low: 1.0;high:8.0;", var= "PLAYER_COUNT")'
    Difficulty: 'gui_int_slider("$text:int;low: 1.0;high:11.0;", var= "DIFFICULTY")'
  Map:
    Terrain: 'gui_drop_down("$text: {TERRAIN_SELECT};list: none, few, some, lots, max",var="TERRAIN_SELECT")'
    Lethal Terrain: 'gui_drop_down("$text: {LETHAL_SELECT};list: none, few, some, lots, max", var="LETHAL_SELECT")'
    Friendly Ships: 'gui_drop_down("$text: {FRIENDLY_SELECT};list: none, few, some, lots, max", var="FRIENDLY_SELECT")'
    Monsters: 'gui_drop_down("$text: {MONSTER_SELECT};list: none, few, some, lots, max", var="MONSTER_SELECT")'
    Upgrades: 'gui_drop_down("$text: {UPGRADE_SELECT};list: none, few, some, lots, max", var= "UPGRADE_SELECT")'
    Jobs: 'gui_drop_down("$text: {JOBS_SELECT};list: none, few, some, lots, max", var= "JOBS_SELECT")'
    Quest Mode: 'gui_drop_down("$text: {QUEST_MODE};list: Co-op, Protected, Claim-jump", var="QUEST_MODE")'
    Time Limit: 'gui_input("desc: Minutes;", var="GAME_TIME_LIMIT")'
    Seed: 'gui_input("desc: Integer (0 = random);", var="seed_value")'
Defaults:
  JOBS_SELECT: some
  QUEST_MODE: Protected
```

    terrain_value = terrain_to_value(TERRAIN_SELECT)
    lethal_value =  terrain_to_value(LETHAL_SELECT)
    friendly_value = terrain_to_value(FRIENDLY_SELECT)
    monster_value = terrain_to_value(MONSTER_SELECT)
    upgrade_value = terrain_to_value(UPGRADE_SELECT)
    # Seed arrives from a gui_input typein / loaded game code, so it can be a
    # string; normalize to int before any comparison or arithmetic.
    seed_value = safe_int(seed_value)

    if seed_value != 0:
        random.seed(seed_value)
        print(f"Seed Value: {seed_value}")

    # Same sandbox world as Peacetime.
    terrain_spawn_stations(DIFFICULTY, lethal_value, min_num=5)
    # spawn_players FIRST, ahead of everything else this map builds. The map body runs
    # inline in the frame that handled the Start button, and this label is the last
    # thing that has to finish before the consoles can leave the selection screen - so
    # whatever sits ahead of it is charged straight to the crew's wait. The friendly
    # NPCs need the stations, not the players, so they cost nothing by moving behind it.
    await task_schedule(spawn_players)
    await task_schedule(spawn_friendly_npc)
    await task_schedule(default_player_friendly_eyes)
    await task_schedule(docking_standard_player_station)

    # Capture the crew's starting credits (banked per side) so the end screen can show
    # Credits Earned = end total - this baseline. CREDIT_SIDE_IDS persists even if ships die.
    _cids = []
    for cp in to_object_list(role("__player__")):
        _sid = to_side_id(cp.side)
        if _sid not in _cids:
            _cids.append(_sid)
    _cc0 = 0
    for _s in _cids:
        _cc0 = _cc0 + get_inventory_value(_s, "credits", 0)
    shared CREDIT_SIDE_IDS = _cids
    shared CREDITS_START = _cc0

    # Multiplayer quest ownership (PEACETIME_PVP_PLAN). Three modes:
    #  Co-op      - fully shared: no claiming, no veto. Targets stay unclaimed so the job watchers
    #               broadcast (every holder credited), and the multi-step arcs advance for all
    #               holders together. Friendly group play (the legacy shared behaviour).
    #  Protected  - a claimed target is hard-locked to its owner: install the grav-tether veto so
    #               non-owners can't tether it, and run pr_claim_watch to assign ownership (first
    #               tetherer) + eject non-owner tethers. Owner-only credit, no grief. Default.
    #  Claim-jump - claimed but stealable: no veto; ownership follows the current tetherer.
    if QUEST_MODE == "Protected":
        grav_tether_set_attach_policy(pr_tether_ownership_policy)
    else:
        grav_tether_set_attach_policy(None)
    # Co-op does no claiming (targets stay unclaimed -> watchers broadcast to every holder).
    if QUEST_MODE != "Co-op":
        task_schedule(pr_claim_watch)
    task_schedule(pr_standings_ticker)

    # Sow the field instead of creating it all in one frame: ~280 ms of
    # engine work becomes a few ms a tick, spread nearest-first.
    terrain_sow_begin(over=6)
    terrain_asteroid_clusters(terrain_value)
    terrain_spawn_nebula_clusters(terrain_value)
    terrain_sow_end()
    terrain_spawn_pickups(upgrade_value)
    terrain_spawn_monsters(monster_value)
    terrain_spawn_black_holes(lethal_value)

    # ALL of this map's declarative content (the Florbin quest tree, the job board, the
    # object scans, and the fixed landmarks) lives in ONE file, parsed once here with the
    # combined mission vocabulary; each section is handed to its own loader (here + in
    # pr_jobs_setup, which reads this shared doc).
    shared PR_DOC = document_get_amd_file(get_mission_dir_filename("maps/peacetime_remastered.amd"), data_parser=amd_mission_data)

    # Who speaks when a timed job has no Speaker: of its own. Harkin is the task-force
    # commander and already has a face in the Cast, so a deadline reminder arrives from
    # someone the crew has met rather than from nobody. The library never names a voice
    # itself - it has no business knowing which faction is in charge - so a mission that
    # skips this simply gets no reminders.
    quest_dispatch_voice("admiral")

    # What a kill leaves behind, keyed by role (the drops section of PR_DOC). Registered
    # before anything can be destroyed. Without a table the library default applies - a
    # random trade good - which is how condemned hulks came to drop contraband.
    amd_drops(amd_section(PR_DOC, "drops"))

    # The peacekeeping side-jobs (the quest board) and the all-ships-lost loss watch.
    task_schedule(pr_jobs_setup)
    task_schedule(pr_lose_watch)

    # No enemy fleets in Peacetime. The headline case is the Florbin kidnapping, which
    # only runs if there are friendly ships to investigate.
    if friendly_value >= 1:
        # The Florbin case as a shared quest tree (the florbin_case section of PR_DOC),
        # layered over the original investigation. florbin_quest_watch translates the
        # kidnap_status flag that kidnap_caper drives into the quest_signal events its steps
        # listen for.
        quest_grant_amd(SHARED, amd_section(PR_DOC, "florbin_case"))
        task_schedule(florbin_quest_watch)
        # The investigation is now NATIVE to the remaster (fb_investigation in florbin_case.mast),
        # not a jump into the original peacetime map - its own FB_STATUS state + fb_ routes.
        jump fb_investigation
    else:
        task_schedule(task_peacetime_end_game)
        ->END


#-----------------------------------------------------------------------------------------------------------------------------
# Quest bridge: map the original kidnap_status flag (0..5) to the Florbin quest tree.
# fb_investigation / fb_kidnapper_discovered / fb_handle_kidnapper_surrender /
# fb_check_ambassador_rescued all drive FB_STATUS; we translate the transitions into quest_signal.

===== florbin_quest_watch =====
    prev_status = 0
    seen_kidnapper = False
--- fqw_loop
    await delay_sim(1)
    cur = FB_STATUS
    # NOTE: `case_opened` is NOT bridged from FB_STATUS. FB_STATUS = 1 is the first line
    # of fb_investigation, which runs during map setup - so bridging it here completed
    # "Take the Case" about a second into the shift, before the crew could do anything,
    # while its text still read "Contact DS 1 to open the investigation". FB_STATUS >= 1
    # means "the investigation machinery is initialized" (stations tagged, records
    # seeded), not "someone contacted DS 1". The signal is emitted from the comms route
    # the player actually uses (//comms/fb_investigate_kidnapping in florbin_case.mast).
    if cur >= 2 and prev_status < 2:
        signal_emit("quest_signal", {"SIGNAL_NAME": "suspect_identified"})
    if cur >= 3 and prev_status < 3:
        signal_emit("quest_signal", {"SIGNAL_NAME": "kidnapper_subdued"})
    if cur >= 5 and prev_status < 5:
        signal_emit("quest_signal", {"SIGNAL_NAME": "florbin_delivered"})
        ->END
    # Killed-before-rescue: the kidnapper role only vanishes when that ship is destroyed.
    kcount = len(to_list(role("kidnapper")))
    if kcount > 0:
        seen_kidnapper = True
    if seen_kidnapper and kcount == 0 and cur < 3:
        signal_emit("quest_signal", {"SIGNAL_NAME": "florbin_killed"})
        ->END
    prev_status = cur
    jump fqw_loop


#-----------------------------------------------------------------------------------------------------------------------------
# The peacetime job board. Weapons doctrine: enforce and clear hazards, don't wage war.
#   * Gunnery Qualification - destroy inert practice drones (simulated hostiles).
#   * Rock Breakers        - demolish hazard asteroids clogging a shipping lane.
#   * Board the Poacher    - DISABLE (shields < 50%) and board a neutral trawler;
#                            destroying it FAILS the job (it is a civilian ship).
# Each is a per-ship quest so its credit reward pays to the side.

===== pr_jobs_setup =====
    # JOBS_SELECT is seeded by the map's Defaults metadata (set-if-absent shared) at panel
    # present + map-task start, so it is always defined here - no local default needed.
    jobs_value = terrain_to_value(JOBS_SELECT)
    ->END if jobs_value < 1

    # Job target counts come straight from the granted quest Goals (the jobs section of
    # PR_DOC), so the spawn loops below can never drift from the quest completion targets -
    # the AMD is the single source of truth. Each Goal parses to on_signal/on_scan with a
    # count; index them by signal name (and scan role) so a spawn loop reads its own target.
    # (Defaults guard a renamed/removed goal.)
    jobs_section = amd_section(PR_DOC, "jobs")
    job_counts = {}
    for jn in jobs_section.get("children", []):
        jd = jn.get("data") or {}
        jsig = jd.get("on_signal")
        if jsig is not None:
            job_counts[jsig.get("name")] = jsig.get("count", 1)
        jscan = jd.get("on_scan")
        if jscan is not None:
            job_counts["scan:" + str(jscan.get("role"))] = jscan.get("count", 1)
    # The Jobs density SCALES the board: few = 0.5x, some = 1x (base), lots = 1.5x, max = 2x
    # of the AMD Goal counts (jobs_value is 1..4 here). The SAME factor scales the spawn counts
    # below AND the granted quest Goals (count_scale on the grant), so the two can never
    # diverge. Singleton jobs (one poacher, one shuttle) carry no authored count, so they never
    # scale. int(x + 0.5) rounds (round() is not in the MAST eval globals); min 1.
    job_scale = jobs_value * 0.5
    drone_n = max(1, int(job_counts.get("drone_down", 5) * job_scale + 0.5))
    rock_n = max(1, int(job_counts.get("rock_cleared", 4) * job_scale + 0.5))
    traffic_n = max(1, int(job_counts.get("customs_cleared", 4) * job_scale + 0.5))
    survey_n = max(1, int(job_counts.get("scan:anomaly", 3) * job_scale + 0.5))
    # Beacon jobs: probes recovered (goal count) and the grazer pod size (fixed 4, scaled).
    probe_n = max(1, int(job_counts.get("probe_recovered", 3) * job_scale + 0.5))
    herd_n = max(2, int(4 * job_scale + 0.5))
    salvage_n = max(1, int(job_counts.get("salvage_delivered", 3) * job_scale + 0.5))
    # Picket Line: one turret kit per turret the picket needs. Read out of the AMD goal
    # like every other counted job, so the crates dropped and the completion target are
    # the same number by construction and cannot drift apart at another density.
    picket_n = max(1, int(job_counts.get("picket_placed", 3) * job_scale + 0.5))

    # Declarative object scans (the scans section of PR_DOC), rendered by the generic science
    # route - no //science route here. (target_drone is raider-side, so the standard enemy scan
    # covers it; the anomaly uses the quest reveal_scan path.)
    science_define_scan_amd(amd_section(PR_DOC, "scans"))

    # Targets are SPAWNED ON ACCEPT, not at shift start (see pr_job_dispatch): stash the scaled
    # counts + the landmark records so the spawner reads them when a job is taken on. This keeps
    # counted jobs from being spoiled by pre-accept kills, and makes the stranded shuttle arrive on
    # the mayday (when the Mercy Run is accepted) instead of sitting adrift from the first second.
    shared PR_JOB_COUNTS = {"drone": drone_n, "rock": rock_n, "traffic": traffic_n, "survey": survey_n, "probe": probe_n, "herd": herd_n, "salvage": salvage_n, "picket": picket_n}
    shared PR_LANDMARKS = landmarks_from_section(amd_section(PR_DOC, "landmarks"))
    # The jobs that spawn targets on accept, checked each dispatch tick.
    shared PR_JOB_KEYS = ["job_gunnery", "job_rocks", "job_customs", "job_survey", "job_poacher", "job_mercy", "job_sensor_net", "job_probes", "job_herd", "job_ravener", "job_barge", "job_salvage", "job_lifepod", "job_relay", "job_picket", "job_ghost", "job_sweep", "job_cache", "job_herd_arc"]

    # The job board is the jobs section of PR_DOC (parsed above). Grant it PER PLAYER SHIP so
    # credit rewards pay to the side (a Scope: shared quest gets no credit). Anomaly Survey uses
    # Goal: scan + Reveals: (the declarative quest-scan path), so this map needs no //science route.
    # Every job is authored State: idle, so it lands on the quest tab as "Available"; the player
    # ACCEPTS the ones they want (quest_tab_accept -> ACTIVE), which is also when any Fail after
    # clock starts and when pr_job_dispatch spawns that job's targets. Nothing completes (or fails,
    # or clutters space) before a job is taken on.
    for p in to_object_list(role("__player__")):
        quest_grant_amd(p.id, jobs_section, count_scale=job_scale)

    # Headless / attract hook. A job only goes ACTIVE when a human presses Accept on the
    # quest tab, so a --test run can never reach any job's spawn case or its watcher -
    # the whole board is untestable without a person. Naming keys here accepts them at
    # setup instead. Off unless settings.yaml says otherwise, and it works for EVERY job,
    # not just the one it was added for.
    for auto_key in SETTINGS.get("AUTO_ACCEPT_JOBS", []):
        for ap in to_object_list(role("__player__")):
            quest_mark_active(ap.id, auto_key)

    # Server watcher that credits the Sensor Net job as Sensor Beacons are deployed.
    task_schedule(pr_beacon_watch)
    task_schedule(pr_job_dispatch)
    ->END


#-----------------------------------------------------------------------------------------------------------------------------
# Spawn-on-accept dispatcher. A server watcher spawns each job's targets the first tick that job
# goes ACTIVE (a player accepted it from the quest tab). Server-side + guarded, so targets spawn
# exactly once no matter how many players accept, and never before acceptance.
===== pr_job_dispatch =====
    default GAME_ENDED = False
    spawned = []
--- pjd_loop
    await delay_sim(1)
    ->END if GAME_ENDED
    for job_key in PR_JOB_KEYS:
        if job_key not in spawned and pr_job_active(job_key):
            spawned.append(job_key)
            task_schedule(pr_job_spawn, {"PR_SPAWN_KEY": job_key})
    ->END if len(spawned) >= len(PR_JOB_KEYS)
    jump pjd_loop


# Spawn one job's targets, dispatched by PR_SPAWN_KEY (the accepted job's key). Counts come from
# PR_JOB_COUNTS (already Jobs-density scaled); the two fixed objects come from PR_LANDMARKS. The
# poacher/mercy cases also drop an info-panel alert so the job's objects arrive with context.
===== pr_job_spawn =====
    match PR_SPAWN_KEY:
        case "job_gunnery":
            # Condemned hulks squawking hostile IFF for a live-fire drill: no brain (they
            # neither maneuver nor shoot back), raider side so Weapons can lock and fire.
            # NAMED for what actually spawns - an outdated freighter hull being shot up.
            # They were "Target Drone", which collides with the engine's DRONE weapon:
            # the playtest expected torpedoes and took a long time to notice the ships.
            # (Not "derelict" - this map already has one, the Ghost Freighter.)
            #
            # Placed in FRONT OF THE CREW that accepted the job rather than at fixed
            # coordinates halfway across the map. Also the right shape for multiplayer:
            # each crew's range arrives near them instead of every job stacking up in one
            # corner. Falls back to the old fixed point if the holder cannot be resolved.
            gun_at = pr_job_spawn_center("job_gunnery", 10000, 9000, 0, 9000)
            for v in scatter.box(PR_JOB_COUNTS.get("drone", 5), gun_at.x, gun_at.y, gun_at.z, 2500, 400, 2500, centered=True):
                npc_spawn(v.x, v.y, v.z, "Condemned Hulk", "raider, target_drone", "cargo_ship", "behav_npcship")
        case "job_rocks":
            rock_types = ship_data_plain_asteroid_keys()
            # WHERE. "I have no idea what asteroids this refers to" (PRM-10) - the rocks
            # are scattered at runtime, so no description written at authoring time can
            # say. A navarea over the same box they scatter into names the field on the
            # map, and a selectable marker at its centre gives Science something to click.
            marker_area(-11000, 0, 12000, 3500, 3500, "Hazard Rock Field", "#fa04")
            marker_object(-11000, 0, 12000, "Hazard Rock Field", roles="pr_job_marker")
            for v in scatter.box(PR_JOB_COUNTS.get("rock", 4), -11000, 0, 12000, 3500, 400, 3500, centered=True):
                rock = terrain_spawn(v.x, v.y, v.z, "Hazard Rock", "#, hazard_rock", random.choice(rock_types), "behav_asteroid")
                # Raw terrain spawns default to unselectable; clear it so Weapons can lock and fire.
                rock.data_set.set("unselectable", 0)
        case "job_customs":
            # "...or where the shipping lane is" - same fix, the region rather than a spot.
            marker_area(-6000, 0, -6000, 3000, 3000, "Shipping Lane", "#0cf4")
            for v in scatter.box(PR_JOB_COUNTS.get("traffic", 4), -6000, 0, -6000, 3000, 400, 3000, centered=True):
                npc_spawn(v.x, v.y, v.z, "Civilian Trader", "civ, civilian, traffic", "cargo_ship", "behav_npcship")
        case "job_survey":
            anomaly_types = ship_data_plain_asteroid_keys()
            for v in scatter.box(PR_JOB_COUNTS.get("survey", 3), 14000, 0, 14000, 3000, 400, 3000, centered=True):
                anomaly = terrain_spawn(v.x, v.y, v.z, "Sensor Anomaly", "#, anomaly", random.choice(anomaly_types), "behav_asteroid")
                # Selectable so Science can pick it on the 2D view to scan it.
                anomaly.data_set.set("unselectable", 0)
        case "job_poacher":
            comms_info_card(all_roles("console, comms"), "Sensors flag an unregistered trawler running dark in the outer lane. Intercept and board - do not destroy.", title="Enforcement Dispatch", color="orange", notify=True)
            poacher_rec = pr_landmark_by_key(PR_LANDMARKS, "poacher_lm")
            if poacher_rec is not None:
                landmark_spawn(poacher_rec)
        case "job_mercy":
            # Build-up: the mayday lands first, then the shuttle arrives a few seconds later, so
            # the rescue reads as responding to a distress call rather than a target blinking in.
            comms_info_card(all_roles("console, comms"), "Automated distress beacon: civilian shuttle adrift, life support failing. Last position logged - respond immediately.", title="Mayday", color="red", notify=True)
            await delay_sim(4)
            mercy_rec = pr_landmark_by_key(PR_LANDMARKS, "mercy_lm")
            if mercy_rec is not None:
                landmark_spawn(mercy_rec)
            task_schedule(pr_mercy_watch)
        case "job_sensor_net":
            # No targets to spawn - the crew fabricates and deploys the beacons themselves.
            # pr_beacon_watch credits each Sensor Beacon as it is deployed.
            comms_info_card(all_roles("console, comms"), "Fleet wants a sensor picket. Engineering: fabricate Sensor Beacons on the Fabricate tab and deliver them to Weapons. Weapons: deploy three across the lanes.", title="Survey Order", color="#0cf", notify=True)
        case "job_probes":
            # Scatter inert survey probes (old sensor beacons) for the crew to recover by fly-over.
            comms_info_card(all_roles("console, comms"), "Three survey probes have gone adrift. Recover them - fly your ship over each to bring it aboard.", title="Recovery Order", color="#0cf", notify=True)
            for v in scatter.box(PR_JOB_COUNTS.get("probe", 3), -14000, 0, -2000, 4000, 400, 4000, centered=True):
                probe = terrain_spawn(v.x, v.y, v.z, "Survey Probe", "#, beacon, lost_probe", "danger_4a", "behav_pickup")
                set_inventory_value(probe.id, "beacon_kind", "sensor")
                # Empty mode so a recovered-then-refired probe stays a passive sensor (the
                # fabrication recover route defaults an unset mode to "attract").
                set_inventory_value(probe.id, "beacon_mode", "")
                probe.data_set.set("unselectable", 0)
        case "job_herd":
            comms_info_card(all_roles("console, comms"), "Grazers have drifted into the lane. Do NOT fire on them - they retaliate if provoked. Fabricate a Bio Beacon set to REPEL grazers and deploy it among the pod to clear them.", title="Wildlife Advisory", color="#fa0", notify=True)
            for v in scatter.box(PR_JOB_COUNTS.get("herd", 4), 12000, 0, -9000, 2000, 300, 2000, centered=True):
                herd_id = await prefab_spawn(prefab_grazer, {"START_X": v.x, "START_Y": v.y, "START_Z": v.z})
                add_role(herd_id, "herd_grazer")
            task_schedule(pr_herd_watch, {"herd_x": 12000, "herd_y": 0, "herd_z": -9000})
        case "job_ravener":
            comms_info_card(all_roles("console, comms"), "A Ravener is loose. It FEEDS on weapon fire - do NOT shoot. Fabricate a Bio Beacon set to ATTRACT the ravener and deploy it beside the black hole.", title="Predator Alert", color="#f44", notify=True)
            terrain_spawn_black_hole(-20000, 0, 16000)
            ravener_id = await prefab_spawn(prefab_ravener, {"START_X": -6000, "START_Y": 0, "START_Z": 12000})
            add_role(ravener_id, "lure_predator")
            task_schedule(pr_ravener_watch, {"rv_id": ravener_id, "hole_x": -20000, "hole_y": 0, "hole_z": 16000})
        case "job_barge":
            # A dead-in-space barge (behav_npcship, no orders -> it just idles); the crew
            # grav-tethers it and tows it home. pr_barge_watch credits arrival at DS 1.
            comms_info_card(all_roles("console, comms"), "A power-dead ore barge is adrift in the lane. Grav-tether it and tow it back to DS 1.", title="Haul Order", color="#0cf", notify=True)
            npc_spawn(-13000, 0, 7000, "Ore Barge", "civ, civilian, tow_barge, claimable", "cargo_ship", "behav_npcship")
            task_schedule(pr_barge_watch)
        case "job_salvage":
            # Scatter idle salvage hulks + a stationary Refinery Platform as the drop-off; the
            # crew tows each hulk to the refinery. pr_salvage_watch credits each delivery.
            comms_info_card(all_roles("console, comms"), "Salvage hulks are cluttering the lane. Grav-tether each one and tow it to the Refinery Platform.", title="Salvage Order", color="#0cf", notify=True)
            npc_spawn(-18000, 0, -6000, "Refinery Platform", "tsn, station, refinery", "starbase_command", "behav_station")
            for v in scatter.box(PR_JOB_COUNTS.get("salvage", 3), -9000, 0, -12000, 3000, 400, 3000, centered=True):
                npc_spawn(v.x, v.y, v.z, "Salvage Hulk", "civ, salvage_hulk, claimable", "cargo_ship", "behav_npcship")
            task_schedule(pr_salvage_watch)
        case "job_lifepod":
            # A drifting lifepod - tow it to DS 1 before the Fail after clock (anchored on accept).
            comms_info_card(all_roles("console, comms"), "A lifepod is tumbling from a wreck field, beacon failing. Grav-tether it and tow it to DS 1 - fast.", title="Life Support Critical", color="red", notify=True)
            npc_spawn(-10000, 0, -14000, "Lifepod", "civ, civilian, tow_lifepod, claimable", "cargo_ship", "behav_npcship")
            task_schedule(pr_lifepod_watch)
        case "job_relay":
            # A drifted comms relay towed back to a marked POINT (a navpoint shows where) - the one
            # job that delivers to a position, not a station.
            comms_info_card(all_roles("console, comms"), "A comms relay drifted off station. Grav-tether it and tow it to the marked position in the lane.", title="Comms Order", color="#0cf", notify=True)
            npc_spawn(6000, 0, 9000, "Comms Relay", "tsn, relay, tow_relay, claimable", "cargo_ship", "behav_npcship")
            sim.add_navpoint(4000, 0, -10000, "Relay Position", "#0cf")
            task_schedule(pr_relay_watch)
        case "job_picket":
            # Automated guns on a lane junction. The zone is an AUTHORED POINT (the
            # picket_lm landmark), not coordinates typed in here: the ring the crew is
            # shown, the ring the watcher counts, and the ring a future edit moves are all
            # the one AMD record.
            picket_rec = pr_landmark_by_key(PR_LANDMARKS, "picket_lm")
            ->END if picket_rec is None
            # landmark_pos returns a plain [x, y, z] list, not a Vec3.
            picket_at = landmark_pos(picket_rec)
            shared PR_PICKET_X = picket_at[0]
            shared PR_PICKET_Y = picket_at[1]
            shared PR_PICKET_Z = picket_at[2]
            shared PR_PICKET_R = pr_landmark_field(PR_LANDMARKS, "picket_lm", "radius", 2500)

            # Show the ZONE, not just a dot - the job is "inside this ring", and a bare
            # navpoint would tell the crew a position while the goal tests an area.
            marker_area(PR_PICKET_X, PR_PICKET_Y, PR_PICKET_Z, PR_PICKET_R * 2, PR_PICKET_R * 2, "Picket Line", "#f804")
            sim.add_navpoint(PR_PICKET_X, PR_PICKET_Y, PR_PICKET_Z, "Picket Line", "#f80")

            # RESERVE the turret slots this job needs. The per-side ceiling is 8 live
            # towers; a crew at max density needs 6 for the picket alone, and two crews on
            # one side would hit the cap mid-job - failing on a balance rule the job never
            # mentioned. Raising the shared the addon already reads is the whole fix, and
            # pr_job_spawn runs once per key so it cannot compound.
            shared LM_TURRET_CAP = lm_turret_cap() + PR_JOB_COUNTS.get("picket", 3)

            comms_info_card(all_roles("console, comms"), "Fleet has dropped turret kits alongside you. Weapons: grav-tether each crate, tow it into the marked Picket Line zone, release it, then deploy it. Kits unfolded outside the ring do not count.", title="Emplacement Order", color="#0cf", notify=True)

            # The kits arrive next to WHOEVER TOOK THE JOB, so the first act is a tow
            # rather than a cross-map flight to fetch the crates.
            pk_at = pr_job_spawn_center("job_picket", 1200, 2000, 0, 14000)
            for pk_v in scatter.box(PR_JOB_COUNTS.get("picket", 3), pk_at.x, pk_at.y, pk_at.z, 1400, 200, 1400, centered=True):
                pk_crate = lm_turret_spawn_crate(pk_v.x, pk_v.y, pk_v.z, "tsn", "prefab_lm_turret_tower", "Turret Kit")
                # `claimable` puts the kits on the same claim machinery as every other tow
                # target: unclaimed until somebody tethers one. Deliberately NOT
                # pre-assigned - with one pool of crates, who gets them is the contest.
                add_role(pk_crate, "claimable")
            task_schedule(pr_picket_watch)
        case "job_ghost":
            # Multi-step: a silent derelict drifting toward a black hole. pr_ghost_seq guides the
            # crew hail -> scan -> tow-clear -> tow-home.
            terrain_spawn_black_hole(-16000, 0, -16000)
            derelict = npc_spawn(-13000, 0, -13000, "SS Meridian", "civ, civilian, derelict, claimable", "cargo_ship", "behav_npcship")
            derelict.data_set.set("unselectable", 0)
            task_schedule(pr_ghost_seq)
        case "job_sweep":
            # Multi-step: fabricate/deploy a sensor beacon, scan the flagged contact, tow it home.
            find = npc_spawn(15000, 0, -13000, "Stranded Pod", "civ, civilian, sweep_find, claimable", "cargo_ship", "behav_npcship")
            find.data_set.set("unselectable", 0)
            task_schedule(pr_sweep_seq)
        case "job_cache":
            # Multi-step: hail a tipster (Comms), scan the cluster to find the loaded rock
            # (Science), then tether the shielded pod out and tow it to DS 1.
            npc_spawn(11000, 0, -3000, "Loitering Freighter", "civ, tipster", "cargo_ship", "behav_npcship")
            cache_rocks = ship_data_plain_asteroid_keys()
            for v in scatter.box(6, 13000, 0, 3000, 2500, 400, 2500, centered=True):
                rk = terrain_spawn(v.x, v.y, v.z, "Asteroid", "#, asteroid", random.choice(cache_rocks), "behav_asteroid")
                rk.data_set.set("unselectable", 0)
            cache = npc_spawn(13000, 0, 3000, "Shielded Pod", "civ, cache_find, claimable", "cargo_ship", "behav_npcship")
            cache.data_set.set("unselectable", 0)
            task_schedule(pr_cache_seq)
        case "job_herd_arc":
            # Multi-step wildlife: scan (Science) -> warn convoy (Comms) -> bio REPEL beacon
            # (Engineering/Weapons) -> reel the drift netting off a snared grazer (Weapons/Helm).
            npc_spawn(8000, 0, 12000, "Civilian Convoy", "civ, convoy", "cargo_ship", "behav_npcship")
            for v in scatter.box(3, 6000, 0, 14000, 1500, 300, 1500, centered=True):
                gz = await prefab_spawn(prefab_grazer, {"START_X": v.x, "START_Y": v.y, "START_Z": v.z})
                add_role(gz, "arc_grazer")
            # The SNARED grazer is STUCK - a stationary npc (not a wandering prefab), so only
            # reeling the netting away increases their separation and frees it.
            npc_spawn(5000, 0, 16000, "Snared Grazer", "civ, arc_grazer, snared_grazer", "cargo_ship", "behav_npcship")
            npc_spawn(5150, 0, 16000, "Drift Netting", "civ, snag_debris, claimable", "cargo_ship", "behav_npcship")
            task_schedule(pr_herd_arc_seq)
    ->END


# Weapons-job events -> quest credit. Using //damage/destroy (reliable for both npc
# drones and terrain asteroids) keeps every job on the same event path. Credit the KILLER
# (parent = firing/owning ship, else source/origin) so in a competitive board one ship's
# kills don't pay every holder; fall back to a broadcast when there is no player attacker
# (script/lifetime destroy) so co-op/unattributed kills still count (no regression).
//damage/destroy if has_role(DESTROYED_ID, "target_drone")
    default DAMAGE_PARENT_ID = 0
    default DAMAGE_SOURCE_ID = 0
    pr_killer = DAMAGE_PARENT_ID if DAMAGE_PARENT_ID else DAMAGE_SOURCE_ID
    if has_role(pr_killer, "__player__"):
        quest_credit_signal(pr_killer, "drone_down")
    else:
        signal_emit("quest_signal", {"SIGNAL_NAME": "drone_down"})

//damage/destroy if has_role(DESTROYED_ID, "hazard_rock")
    default DAMAGE_PARENT_ID = 0
    default DAMAGE_SOURCE_ID = 0
    pr_killer = DAMAGE_PARENT_ID if DAMAGE_PARENT_ID else DAMAGE_SOURCE_ID
    if has_role(pr_killer, "__player__"):
        quest_credit_signal(pr_killer, "rock_cleared")
    else:
        signal_emit("quest_signal", {"SIGNAL_NAME": "rock_cleared"})

//damage/destroy if has_role(DESTROYED_ID, "poacher")
    default QUEST_MODE = "Protected"
    if QUEST_MODE == "Protected":
        # Multiplayer no-grief: a destroyed trawler is REPLACED by a fresh runner instead of
        # failing everyone's job. Destroying it just wastes the shot (at most one exists at a
        # time). Other modes keep the original "don't destroy or you fail" tension.
        poacher_rec2 = pr_landmark_by_key(PR_LANDMARKS, "poacher_lm")
        if poacher_rec2 is not None:
            landmark_spawn(poacher_rec2)
        comms_info_card(all_roles("console, comms"), "The trawler was destroyed - but another unregistered runner has slipped into the lane. Intercept and BOARD it; do not destroy.", title="Enforcement Dispatch", color="orange", notify=True)
    else:
        signal_emit("quest_signal", {"SIGNAL_NAME": "poacher_killed"})


# Poacher comms: the enforcement surface. The surrender check mirrors the kidnapper's -
# shields below 50% forces the boarding. This is the "disable, don't destroy" mechanic.
//enable/comms if has_roles(COMMS_SELECTED_ID, "poacher")
//comms if has_roles(COMMS_SELECTED_ID, "poacher")
    + "Demand Surrender" pr_poacher_surrender

===== pr_poacher_surrender =====
    blob = to_blob(COMMS_SELECTED_ID)
    ->END if blob is None
    shield_count = blob.get("shield_count", 0) or 0
    s_ratio = 100
    for s in range(shield_count):
        s_max = blob.get("shield_max_val", s) or 0
        s_cur = blob.get("shield_val", s) or 0
        if s_max > 0:
            s_ratio = min(s_cur/s_max, s_ratio)
    if s_ratio < 0.5:
        # Credit the boarding ship (the comms origin), not every holder.
        quest_credit_signal(COMMS_ORIGIN_ID, "poacher_boarded")
        pr_award(COMMS_ORIGIN_ID, 300)
        remove_role(COMMS_SELECTED_ID, "poacher")
        e_obj = to_engine_object(COMMS_SELECTED_ID)
        _pos = e_obj.pos
        target_pos(COMMS_SELECTED_ID, _pos.x, _pos.y, _pos.z, throttle=0.0, target_id=0, stop_dist=200)
        comms_receive(f"""All right, all right! We surrender. Cutting engines - your boarding party is clear to dock.""", title="Poacher Surrenders", title_color="green")
    else:
        comms_receive(f"""You have no authority out here! Back off.""", title="Refused", title_color="red")
    yield success


#-----------------------------------------------------------------------------------------------------------------------------
# Customs Patrol (Comms): hail civilian traffic and clear it for transit.
//enable/comms if has_roles(COMMS_SELECTED_ID, "traffic")
//comms if has_roles(COMMS_SELECTED_ID, "traffic")
    + "Request Manifest" pr_customs_manifest
    + "Clear for Transit" pr_customs_clear

===== pr_customs_manifest =====
    comms_receive(f"""Routine haul, officer - machine parts and foodstuffs, all logged. Happy to hold for inspection.""", title="Manifest", title_color="green")
    yield success

===== pr_customs_clear =====
    # Credit the clearing ship (comms origin) so each patroller banks its own clears.
    quest_credit_signal(COMMS_ORIGIN_ID, "customs_cleared")
    pr_award(COMMS_ORIGIN_ID, 30)
    remove_role(COMMS_SELECTED_ID, "traffic")
    comms_receive(f"""Transit cleared. Safe travels, and thank you for keeping the lanes tidy.""", title="Customs", title_color="green")
    yield success


#-----------------------------------------------------------------------------------------------------------------------------
# Anomaly Survey (Science) is fully declarative now: the job_survey quest carries
# on_scan {role: anomaly} + reveal_scan, and the quest driver makes the anomalies
# scannable and renders the scan text. No //science route needed here.


#-----------------------------------------------------------------------------------------------------------------------------
# Mercy Run (Helm): a patrol ship reaching the stranded shuttle relieves it. Proximity, not
# docking, so it needs no per-station docking wiring. The job starts IDLE like the rest of the
# board; accepting it anchors the 6-minute fail_after clock AND triggers pr_job_spawn's mercy case
# (the mayday card, then the shuttle). This watcher is scheduled by that spawn - so on its first
# tick the shuttle already exists, and `->END if no mercy_target` now means "rescued -> stop".
===== pr_mercy_watch =====
    default GAME_ENDED = False
--- mw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    m_list = to_list(role("mercy_target"))
    ->END if len(m_list) < 1
    m_id = m_list[0]
    for p in role("__player__"):
        if sbs.distance_id(p, m_id) <= 900:
            # Quest completion auto-broadcasts "Mission complete: Mercy Run"; no comms
            # context here (background task), so don't call comms_receive.
            signal_emit("quest_signal", {"SIGNAL_NAME": "mercy_reached"})
            remove_role(m_id, "mercy_target")
            ->END
    jump mw_loop


# Tow the Barge (grav-tether): the barge is dead-in-space; towing it within docking range of
# DS 1 completes the job. Proximity, so it needs no docking wiring. (Refinery also has role
# "station" but a different name, so the DS 1 name filter skips it.)
===== pr_barge_watch =====
    default GAME_ENDED = False
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
--- pbargew_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    b_list = to_list(role("tow_barge"))
    ->END if len(b_list) < 1
    if sbs.distance_id(b_list[0], ds1) <= 1800:
        # Credit the OWNER (whoever claimed + towed it); fall back to broadcast if unclaimed.
        barge_owner = pr_quest_owner(b_list[0])
        if barge_owner != 0:
            quest_mark_complete(barge_owner, "job_barge")
            pr_award(barge_owner, 300)
        else:
            signal_emit("quest_signal", {"SIGNAL_NAME": "barge_delivered"})
        remove_role(b_list[0], "tow_barge")
        ->END
    jump pbargew_loop


# Claim watcher (PEACETIME_PVP_PLAN): assign an unclaimed CLAIMABLE quest target to whoever
# first tethers it. Protected -> eject any non-owner tether so a claimed target is fully locked
# to its owner (paired with the grav-tether veto). Claim-jump -> ownership follows the current
# tetherer (stealing allowed; there's no veto, so a rival takes over by tethering).
===== pr_claim_watch =====
    default GAME_ENDED = False
--- pcw_loop
    await delay_sim(1)
    ->END if GAME_ENDED
    for ct in to_list(role("claimable")):
        ct_owner = pr_quest_owner(ct)
        ct_towers = []
        for tw in grav_tether_sources_of(ct):
            if has_role(tw, "__player__"):
                ct_towers.append(tw)
        if ct_owner == 0:
            if len(ct_towers) > 0:
                pr_quest_claim(ct, ct_towers[0])
        else:
            if QUEST_MODE == "Protected":
                for tw in ct_towers:
                    if tw != ct_owner:
                        grav_tether_release(tw, ct)
                        pr_claim_notify(tw, ct, "locked")
            else:
                if len(ct_towers) > 0 and ct_towers[0] != ct_owner:
                    pr_quest_claim(ct, ct_towers[0])
                    pr_claim_notify(ct_owner, ct, "lost")
                    pr_claim_notify(ct_towers[0], ct, "stole")
    jump pcw_loop


# Live standings: post the per-ship earnings race to the info panel periodically, but only
# when there's actually a multi-ship competition with someone on the board.
===== pr_standings_ticker =====
    default GAME_ENDED = False
--- pst_loop
    await delay_sim(90)
    ->END if GAME_ENDED
    board = pr_standings()
    if len(board) > 1:
        std_msg = ""
        std_any = False
        for std_row in board:
            if std_row[1] > 0:
                std_any = True
            std_msg = std_msg + std_row[0] + ": " + str(std_row[1]) + "   "
        if std_any:
            comms_info_card(all_roles("console, comms"), std_msg, title="Patrol Standings", color="#0cf", notify=True)
    jump pst_loop


# Salvage Sweep (grav-tether): tow each salvage hulk to the Refinery Platform; each arrival
# credits one delivery (Goal: signal 3 salvage_delivered). to_list snapshots, so removing the
# role mid-iteration is safe.
===== pr_salvage_watch =====
    default GAME_ENDED = False
--- psw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    ref_list = to_list(role("refinery"))
    ->END if len(ref_list) < 1
    ref = ref_list[0]
    for h in to_list(role("salvage_hulk")):
        if sbs.distance_id(h, ref) <= 1800:
            salvage_owner = pr_quest_owner(h)
            if salvage_owner != 0:
                quest_credit_signal(salvage_owner, "salvage_delivered")
                pr_award(salvage_owner, 80)
                # The refinery PROCESSES the hulk - so it pays in material as well as
                # credits. This is the mission's main salvage source, and it is the one
                # the job names in its description: three hulks fund a full sensor picket
                # (8 per beacon, 24 for the job) with a little over.
                pr_salvage_award(salvage_owner, 10)
            else:
                signal_emit("quest_signal", {"SIGNAL_NAME": "salvage_delivered"})
            remove_role(h, "salvage_hulk")
    ->END if len(to_list(role("salvage_hulk"))) < 1
    jump psw_loop


# Rescue the Lifepod (grav-tether, TIMED): tow the pod to DS 1 before the Fail after clock
# (anchored on accept). Same proximity-to-DS-1 delivery as the barge.
===== pr_lifepod_watch =====
    default GAME_ENDED = False
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
--- plpw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    p_list = to_list(role("tow_lifepod"))
    ->END if len(p_list) < 1
    if sbs.distance_id(p_list[0], ds1) <= 1800:
        lifepod_owner = pr_quest_owner(p_list[0])
        if lifepod_owner != 0:
            quest_mark_complete(lifepod_owner, "job_lifepod")
            pr_award(lifepod_owner, 320)
        else:
            signal_emit("quest_signal", {"SIGNAL_NAME": "lifepod_delivered"})
        remove_role(p_list[0], "tow_lifepod")
        ->END
    jump plpw_loop


# Reposition the Relay (grav-tether): tow the relay to its marked position - a fixed POINT shown
# by a navpoint, not a station. Distance-to-point delivery.
===== pr_relay_watch =====
    default GAME_ENDED = False
    relay_target = Vec3(4000, 0, -10000)
--- prw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    r_list = to_object_list(role("tow_relay"))
    ->END if len(r_list) < 1
    r = r_list[0]
    if (Vec3(r.pos) - relay_target).length() <= 1500:
        relay_owner = pr_quest_owner(r.id)
        if relay_owner != 0:
            quest_mark_complete(relay_owner, "job_relay")
            pr_award(relay_owner, 200)
        else:
            signal_emit("quest_signal", {"SIGNAL_NAME": "relay_placed"})
        remove_role(r.id, "tow_relay")
        ->END
    jump prw_loop


# Picket Line (grav-tether + deploy): turret kits towed into the picket zone and unfolded.
#
# A POLLING RECOUNT, not a credit at the moment of deploy, and that is the design. Towers
# here are ephemeral by construction - a 20 minute lifetime, and they are destructible
# objects standing in a traffic lane - so a one-shot credit would leave the job reading
# "3 of 3" over an empty junction, and would pay the moment three crates were unfolded
# side by side and abandoned. The goal is N guns STANDING AT ONCE, which only a recount
# can ask.
#
# Progress moves BOTH ways from the live count: up through quest_credit_signal (so the
# library's own advance path runs - reward, On complete: toast, announcement - exactly as
# if a signal had fired), and DOWN with a direct write when a tower is lost, which is what
# makes the quest log read "2 of 3" again instead of lying.
===== pr_picket_watch =====
    default GAME_ENDED = False
    default QUEST_MODE = "Protected"
    pk_coop = QUEST_MODE == "Co-op"
    pk_need = PR_JOB_COUNTS.get("picket", 3)
    pk_seen = False
--- ppw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    # ACTIVE holders only: a ship that finished or abandoned drops out of the list, so the
    # credit below cannot fire twice for one ship.
    pk_holders = pr_job_holders("job_picket")
    if len(pk_holders) > 0:
        pk_seen = True
    ->END if pk_seen and len(pk_holders) < 1
    for pk_p in pk_holders:
        pk_live = pr_picket_count(PR_PICKET_X, PR_PICKET_Y, PR_PICKET_Z, PR_PICKET_R, pk_p, pk_coop)
        pk_prog = quest_get_key(pk_p, "job_picket", "progress", 0)
        if pk_live < pk_prog:
            quest_set_key(pk_p, "job_picket", "progress", pk_live)
            comms_info_card(pk_p, f"Picket down to {pk_live} of {pk_need} - a turret is off the board. Deploy another inside the ring.", title="Picket Line", color="orange", notify=True)
        for pk_i in range(pk_live - pk_prog):
            quest_credit_signal(pk_p, "picket_placed")
        if pk_live >= pk_need:
            pr_award(pk_p, 320)
    jump ppw_loop


# Placed short. The watcher can say "you have 2 of 3"; only the deploy event knows a crew
# just unfolded a kit well outside the ring and is about to wonder why nothing happened.
# FEEDBACK ONLY - it never credits anything, because a deploy-time credit cannot be taken
# back when the turret dies. //shared so it runs once on the server, not once per console.
//shared/signal/lm_turret_deployed
    default PR_PICKET_R = 0
    default TURRET_ID = 0
    default TURRET_OWNER_ID = 0
    ->END if PR_PICKET_R <= 0
    ->END if not has_role(TURRET_OWNER_ID, "__player__")
    pk_d = (Vec3(get_pos(TURRET_ID)) - Vec3(PR_PICKET_X, PR_PICKET_Y, PR_PICKET_Z)).length()
    ->END if pk_d <= PR_PICKET_R
    comms_info_card(TURRET_OWNER_ID, f"Turret deployed {int(pk_d)}u from the Picket Line - outside the {int(PR_PICKET_R)}u ring, so it does not count. Tow the next kit inside the marker.", title="Picket Line", color="orange", notify=True)


# The Ghost Freighter (multi-console guided sequence): hail (Comms) -> scan (Science) -> tow clear
# of the black hole (Weapons/Helm) -> tow home to DS 1. The //comms and //science routes below emit
# the hail/scan step signals (awaited via signal_next); the two tether legs are proximity.
===== pr_ghost_seq =====
    default GAME_ENDED = False
    default QUEST_MODE = "Protected"
    coop = QUEST_MODE == "Co-op"
    ghost_owner = 0
    ghost_hole = Vec3(-16000, 0, -16000)
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
    # Step 1 - Hail (Comms). Reveal the first child for everyone holding the arc.
    for gpid in pr_arc_holders("job_ghost"):
        quest_mark_active(gpid, "job_ghost/hail")
    overlay_hero("SILENT RUNNING", subtitle="The SS Meridian has gone dark", to=all_roles("console"), seconds=5)
    comms_info_card(all_roles("console, comms"), "The SS Meridian has gone silent, drifting toward a black hole. COMMS: hail her.", title="Silent Running", color="#0cf", notify=True)
    ghost_hail_data = await signal_next("ghost_hailed")
    ->END if GAME_ENDED
    # Owned modes: the first hailer CLAIMS the arc + its derelict (veto-protects the tow legs;
    # other accepters can no longer advance it). Co-op leaves owner 0 -> all holders advance.
    if not coop and ghost_owner == 0:
        ghost_owner = pr_signal_who(ghost_hail_data)
        if ghost_owner != 0:
            for gd in to_list(role("derelict")):
                pr_quest_claim(gd, ghost_owner)
    # Step 2 - Scan (Science).
    for gpid in pr_arc_recipients("job_ghost", ghost_owner, coop):
        quest_mark_complete(gpid, "job_ghost/hail")
        quest_mark_active(gpid, "job_ghost/scan")
    comms_info_card(all_roles("console, comms"), "No live response - just an automated loop. SCIENCE: scan the derelict.", title="Silent Running", color="#0cf", notify=True)
    await signal_next("ghost_scanned")
    ->END if GAME_ENDED
    # Step 3 - Tow clear of the hole (proximity).
    for gpid in pr_arc_recipients("job_ghost", ghost_owner, coop):
        quest_mark_complete(gpid, "job_ghost/scan")
        quest_mark_active(gpid, "job_ghost/clear")
    comms_info_card(all_roles("console, comms"), "Crew in cryo, reactor critical. WEAPONS/HELM: grav-tether her and tow her CLEAR of the black hole - now.", title="Silent Running", color="orange", notify=True)
--- ghost_clear
    await delay_sim(2)
    ->END if GAME_ENDED
    g_list = to_object_list(role("derelict"))
    ->END if len(g_list) < 1
    if (Vec3(g_list[0].pos) - ghost_hole).length() < 6000:
        jump ghost_clear
    # Step 4 - Tow home (proximity).
    for gpid in pr_arc_recipients("job_ghost", ghost_owner, coop):
        quest_mark_complete(gpid, "job_ghost/clear")
        quest_mark_active(gpid, "job_ghost/home")
    comms_info_card(all_roles("console, comms"), "Clear of the well. Now tow her home to DS 1.", title="Silent Running", color="#0cf", notify=True)
--- ghost_home
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    g_list = to_object_list(role("derelict"))
    ->END if len(g_list) < 1
    if sbs.distance_id(g_list[0].id, ds1) > 1800:
        jump ghost_home
    # Completing the last child auto-completes the container parent -> the arc pays out.
    for gpid in pr_arc_recipients("job_ghost", ghost_owner, coop):
        quest_mark_complete(gpid, "job_ghost/home")
    ->END


# Ghost Freighter step signals: hailing the derelict (Comms) and scanning it (Science).
//comms if has_roles(COMMS_SELECTED_ID, "derelict")
    comms_receive("SS Meridian automated distress: reactor breach imminent, crew in emergency cryo, no conscious crew aboard. Tow to safety requested.", title="SS Meridian", title_color="orange")
    signal_emit("ghost_hailed", {"who": COMMS_ORIGIN_ID})

//science if has_roles(SCIENCE_SELECTED_ID, "derelict")
    ->END if sbs.distance_id(SCIENCE_ORIGIN_ID, SCIENCE_SELECTED_ID) > 900
    signal_emit("ghost_scanned")


# Sweep and Recover (multi-console guided sequence): fabricate + deploy a Sensor Beacon
# (Engineering/Weapons) -> scan the flagged contact (Science) -> tow it home (Weapons/Helm).
===== pr_sweep_seq =====
    default GAME_ENDED = False
    default QUEST_MODE = "Protected"
    coop = QUEST_MODE == "Co-op"
    sweep_owner = 0
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
    # Step 1 - Deploy the picket (Engineering/Weapons). Shared prep - the SCAN is the claim point.
    for spid in pr_arc_holders("job_sweep"):
        quest_mark_active(spid, "job_sweep/deploy")
    overlay_hero("SWEEP ORDER", subtitle="Picket the outer lane", to=all_roles("console"), seconds=5)
    comms_info_card(all_roles("console, comms"), "Fleet wants a sensor sweep of the outer lane. ENGINEERING/WEAPONS: fabricate a Sensor Beacon on the Fabricate tab and deploy it.", title="Sweep Order", color="#0cf", notify=True)
--- sweep_beacon
    await delay_sim(1)
    ->END if GAME_ENDED
    have_sensor = False
    for b in to_object_list(role("beacon")):
        if get_inventory_value(b.id, "beacon_kind", "bio") == "sensor" and not has_role(b.id, "lost_probe"):
            have_sensor = True
    if not have_sensor:
        jump sweep_beacon
    # Step 2 - Scan the flagged contact (Science).
    for spid in pr_arc_holders("job_sweep"):
        quest_mark_complete(spid, "job_sweep/deploy")
        quest_mark_active(spid, "job_sweep/scan")
    comms_info_card(all_roles("console, comms"), "Picket up - it flags a drifting contact in the outer lane. SCIENCE: scan it.", title="Sweep Order", color="#0cf", notify=True)
    sweep_scan_data = await signal_next("sweep_scanned")
    ->END if GAME_ENDED
    # Owned modes: the first scanner CLAIMS the arc + its find (veto-protects the tow leg).
    if not coop and sweep_owner == 0:
        sweep_owner = pr_signal_who(sweep_scan_data)
        if sweep_owner != 0:
            for sf in to_list(role("sweep_find")):
                pr_quest_claim(sf, sweep_owner)
    # Step 3 - Recover the find (Weapons/Helm).
    for spid in pr_arc_recipients("job_sweep", sweep_owner, coop):
        quest_mark_complete(spid, "job_sweep/scan")
        quest_mark_active(spid, "job_sweep/recover")
    comms_info_card(all_roles("console, comms"), "It's a stranded cargo pod. Grav-tether it and tow it home to DS 1.", title="Sweep Order", color="#0cf", notify=True)
--- sweep_home
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    f_list = to_object_list(role("sweep_find"))
    ->END if len(f_list) < 1
    if sbs.distance_id(f_list[0].id, ds1) > 1800:
        jump sweep_home
    for spid in pr_arc_recipients("job_sweep", sweep_owner, coop):
        quest_mark_complete(spid, "job_sweep/recover")
    ->END


# Sweep step signal: scanning the flagged contact (Science).
//science if has_roles(SCIENCE_SELECTED_ID, "sweep_find")
    ->END if sbs.distance_id(SCIENCE_ORIGIN_ID, SCIENCE_SELECTED_ID) > 900
    signal_emit("sweep_scanned", {"who": SCIENCE_ORIGIN_ID})


# Cache in the Rocks (multi-console): hail the tipster (Comms) -> scan the cluster to find the
# loaded rock (Science) -> tether the pod out and tow it to DS 1 (Weapons/Helm).
===== pr_cache_seq =====
    default GAME_ENDED = False
    default QUEST_MODE = "Protected"
    coop = QUEST_MODE == "Co-op"
    cache_owner = 0
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
    # Step 1 - Get the tip (Comms).
    for cpid in pr_arc_holders("job_cache"):
        quest_mark_active(cpid, "job_cache/tip")
    overlay_hero("COLD TIP", subtitle="Someone wants to talk", to=all_roles("console"), seconds=5)
    comms_info_card(all_roles("console, comms"), "A tipster is loitering near the lane. COMMS: hail them for the drop location.", title="Cold Tip", color="#0cf", notify=True)
    cache_tip_data = await signal_next("cache_tip")
    ->END if GAME_ENDED
    # Owned modes: the first to get the tip CLAIMS the arc + its pod (veto-protects the tow leg).
    if not coop and cache_owner == 0:
        cache_owner = pr_signal_who(cache_tip_data)
        if cache_owner != 0:
            for cf in to_list(role("cache_find")):
                pr_quest_claim(cf, cache_owner)
    # Step 2 - Find the cache (Science).
    for cpid in pr_arc_recipients("job_cache", cache_owner, coop):
        quest_mark_complete(cpid, "job_cache/tip")
        quest_mark_active(cpid, "job_cache/find")
    comms_info_card(all_roles("console, comms"), "The cache is hidden in the rock cluster. SCIENCE: scan the cluster to find the loaded one.", title="Cold Tip", color="#0cf", notify=True)
    await signal_next("cache_found")
    ->END if GAME_ENDED
    # Step 3 - Recover the pod (Weapons/Helm).
    for cpid in pr_arc_recipients("job_cache", cache_owner, coop):
        quest_mark_complete(cpid, "job_cache/find")
        quest_mark_active(cpid, "job_cache/recover")
    comms_info_card(all_roles("console, comms"), "Found it - a shielded cargo pod. Grav-tether it out of the rocks and tow it to DS 1.", title="Cold Tip", color="#0cf", notify=True)
--- cache_home
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    c_list = to_object_list(role("cache_find"))
    ->END if len(c_list) < 1
    if sbs.distance_id(c_list[0].id, ds1) > 1800:
        jump cache_home
    for cpid in pr_arc_recipients("job_cache", cache_owner, coop):
        quest_mark_complete(cpid, "job_cache/recover")
    ->END


# Cache step signals: hailing the tipster (Comms) and scanning the loaded rock (Science).
//comms if has_roles(COMMS_SELECTED_ID, "tipster")
    comms_receive("Alright - the drop's in the rock cluster off the lane. Shielded pod, reads like just another boulder. You didn't hear it from me.", title="Tipster", title_color="#0cf")
    signal_emit("cache_tip", {"who": COMMS_ORIGIN_ID})

//science if has_roles(SCIENCE_SELECTED_ID, "cache_find")
    ->END if sbs.distance_id(SCIENCE_ORIGIN_ID, SCIENCE_SELECTED_ID) > 900
    signal_emit("cache_found")


# Herd on the Lane (multi-console wildlife): scan (Science) -> warn convoy (Comms) -> bio REPEL
# beacon (Engineering/Weapons) -> reel the drift netting off a snared grazer (Weapons/Helm).
===== pr_herd_arc_seq =====
    default GAME_ENDED = False
    default QUEST_MODE = "Protected"
    coop = QUEST_MODE == "Co-op"
    herd_owner = 0
    # Step 1 - Scan the pod (Science).
    for hpid in pr_arc_holders("job_herd_arc"):
        quest_mark_active(hpid, "job_herd_arc/scan")
    overlay_hero("WILDLIFE ON THE LANE", subtitle="Do not fire on them", to=all_roles("console"), seconds=5)
    comms_info_card(all_roles("console, comms"), "A grazer pod has drifted into the lane. SCIENCE: scan the pod.", title="Wildlife on the Lane", color="#fa0", notify=True)
    herd_scan_data = await signal_next("herd_scanned")
    ->END if GAME_ENDED
    # Owned modes: the first scanner CLAIMS the arc + the snared netting (veto-protects the reel).
    if not coop and herd_owner == 0:
        herd_owner = pr_signal_who(herd_scan_data)
        if herd_owner != 0:
            for sd in to_list(role("snag_debris")):
                pr_quest_claim(sd, herd_owner)
    # Step 2 - Warn the convoy (Comms).
    for hpid in pr_arc_recipients("job_herd_arc", herd_owner, coop):
        quest_mark_complete(hpid, "job_herd_arc/scan")
        quest_mark_active(hpid, "job_herd_arc/warn")
    comms_info_card(all_roles("console, comms"), "They're spooked and drifting into traffic. COMMS: warn the civilian convoy to hold.", title="Wildlife on the Lane", color="#fa0", notify=True)
    await signal_next("herd_warned")
    ->END if GAME_ENDED
    # Step 3 - Deploy a bio REPEL beacon (Engineering/Weapons).
    for hpid in pr_arc_recipients("job_herd_arc", herd_owner, coop):
        quest_mark_complete(hpid, "job_herd_arc/warn")
        quest_mark_active(hpid, "job_herd_arc/repel")
    comms_info_card(all_roles("console, comms"), "ENGINEERING/WEAPONS: fabricate a Bio Beacon set to REPEL and deploy it among the pod to drive them clear. Do NOT fire.", title="Wildlife on the Lane", color="#fa0", notify=True)
--- herd_repel
    await delay_sim(1)
    ->END if GAME_ENDED
    got_bio = False
    for b in to_object_list(role("beacon")):
        if get_inventory_value(b.id, "beacon_kind", "sensor") == "bio":
            got_bio = True
    if not got_bio:
        jump herd_repel
    # Step 4 - Free the snared grazer (Weapons/Helm).
    for hpid in pr_arc_recipients("job_herd_arc", herd_owner, coop):
        quest_mark_complete(hpid, "job_herd_arc/repel")
        quest_mark_active(hpid, "job_herd_arc/free")
    comms_info_card(all_roles("console, comms"), "Pod's moving off. One grazer is snared in drifting netting - grav-tether the netting clear to free it.", title="Wildlife on the Lane", color="#fa0", notify=True)
--- herd_free
    await delay_sim(2)
    ->END if GAME_ENDED
    s_list = to_object_list(role("snared_grazer"))
    d_list = to_object_list(role("snag_debris"))
    ->END if len(s_list) < 1 or len(d_list) < 1
    if sbs.distance_id(s_list[0].id, d_list[0].id) < 2500:
        jump herd_free
    for hpid in pr_arc_recipients("job_herd_arc", herd_owner, coop):
        quest_mark_complete(hpid, "job_herd_arc/free")
    ->END


# Herd step signals: scanning a grazer (Science) and warning the convoy (Comms).
//science if has_roles(SCIENCE_SELECTED_ID, "arc_grazer")
    ->END if sbs.distance_id(SCIENCE_ORIGIN_ID, SCIENCE_SELECTED_ID) > 900
    signal_emit("herd_scanned", {"who": SCIENCE_ORIGIN_ID})

//comms if has_roles(COMMS_SELECTED_ID, "convoy")
    comms_receive("Convoy copies - holding station until the lane is clear. Thanks for the heads-up, patrol.", title="Civilian Convoy", title_color="#0cf")
    signal_emit("herd_warned")


#-----------------------------------------------------------------------------------------------------------------------------
# Beacon jobs plumbing. These lean on the fabrication addon: the crew builds a beacon on the
# Engineering Fabricate tab, delivers it to Weapons, and fires it. Each job emits quest_signal,
# credited to whichever players hold the matching job.

# Sensor Net: credit the job as each Sensor Beacon is deployed (a role "beacon" object whose
# beacon_kind is "sensor"). The adrift lost probes carry role "lost_probe" and are skipped.
===== pr_beacon_watch =====
    default GAME_ENDED = False
    seen_beacons = []
--- pbw_loop
    await delay_sim(1)
    ->END if GAME_ENDED
    for b in to_object_list(role("beacon")):
        if b.id not in seen_beacons:
            seen_beacons.append(b.id)
            if get_inventory_value(b.id, "beacon_kind", "bio") == "sensor" and not has_role(b.id, "lost_probe"):
                signal_emit("quest_signal", {"SIGNAL_NAME": "sensor_deployed"})
    jump pbw_loop


# Recover Lost Probes: flying a ship over an adrift probe credits the job. The fabrication addon's
# own beacon-recover route also fires on the same collision (scrapping the probe into materials --
# a probe carries no beacon_recipe stamp, so it pays out by its KIND), so this only emits the
# signal. It does NOT put a beacon round in the tube; only Engineering's deliver does that.
//collision/interactive if has_role(COLLISION_ORIGIN_ID, "lost_probe") and has_any_role(COLLISION_SELECTED_ID, "__player__,cockpit")
    signal_emit("quest_signal", {"SIGNAL_NAME": "probe_recovered"})


# Clear the Grazing Herd: complete once no living herd grazer remains near the lane center - a
# repel Bio Beacon drives them out. (Killing a provoked grazer also removes it, but that risks a
# fight; the beacon is the clean solution.)
===== pr_herd_watch =====
    default GAME_ENDED = False
--- hw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    still_here = 0
    for g in to_object_list(role("herd_grazer")):
        gp = get_pos(g.id)
        dxg = gp.x - herd_x
        dyg = gp.y - herd_y
        dzg = gp.z - herd_z
        if (dxg * dxg + dyg * dyg + dzg * dzg) <= 6000 * 6000:
            still_here = still_here + 1
    if still_here == 0:
        signal_emit("quest_signal", {"SIGNAL_NAME": "herd_cleared"})
        ->END
    jump hw_loop


# Bait the Ravener: it heals on any weapon hit, so only the black hole can remove it. When an
# attract Bio Beacon has pulled it within the hole's reach, consume it and credit the job. A real
# engine black-hole kill (//damage/destroy below) also credits it, as a fallback.
===== pr_ravener_watch =====
    default GAME_ENDED = False
--- rvw_loop
    await delay_sim(1)
    ->END if GAME_ENDED
    ->END if not object_exists(rv_id)
    rvp = get_pos(rv_id)
    dxr = rvp.x - hole_x
    dyr = rvp.y - hole_y
    dzr = rvp.z - hole_z
    if (dxr * dxr + dyr * dyr + dzr * dzr) <= 1400 * 1400:
        delete_object(rv_id)
        signal_emit("quest_signal", {"SIGNAL_NAME": "predator_baited"})
        ->END
    jump rvw_loop

//damage/destroy if has_role(DESTROYED_ID, "lure_predator")
    signal_emit("quest_signal", {"SIGNAL_NAME": "predator_baited"})


#-----------------------------------------------------------------------------------------------------------------------------
# Shift end: an all-patrol-ships-lost loss. The shift-timer win is handled by
# task_peacetime_end_game (scheduled by kidnap_caper, or above when there is no case).

===== pr_lose_watch =====
    default GAME_ENDED = False
    seen_players = False
--- plw_loop
    await delay_sim(4)
    ->END if GAME_ENDED
    pc = len(to_list(role("__player__")))
    if pc > 0:
        seen_players = True
    if seen_players and pc == 0:
        START_TEXT = "All patrol ships were lost."
        GAME_STARTED = False
        GAME_ENDED = True
        music_play_sting("failure")
        signal_emit("show_game_results", None)
        ->END
    jump plw_loop

