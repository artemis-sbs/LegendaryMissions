    terrain_value = terrain_to_value(TERRAIN_SELECT)
    lethal_value =  terrain_to_value(LETHAL_SELECT)
    friendly_value = terrain_to_value(FRIENDLY_SELECT)
    monster_value = terrain_to_value(MONSTER_SELECT)
    upgrade_value = terrain_to_value(UPGRADE_SELECT)
    # Seed arrives from a gui_input typein / loaded game code, so it can be a
    # string; normalize to int before any comparison or arithmetic.
    seed_value = safe_int(seed_value)

    if seed_value != 0:
        random.seed(seed_value)
        print(f"Seed Value: {seed_value}")

    # Same sandbox world as Peacetime.
    terrain_spawn_stations(DIFFICULTY, lethal_value, min_num=5)
    await task_schedule(spawn_friendly_npc)
    await task_schedule(spawn_players)
    await task_schedule(default_player_friendly_eyes)
    await task_schedule(docking_standard_player_station)

    terrain_asteroid_clusters(terrain_value)
    terrain_spawn_nebula_clusters(terrain_value)
    terrain_spawn_pickups(upgrade_value)
    terrain_spawn_monsters(monster_value)
    terrain_spawn_black_holes(lethal_value)

    # ALL of this map's declarative content (the Florbin quest tree, the job board, the
    # object scans, and the fixed landmarks) lives in ONE file, parsed once here with the
    # combined mission vocabulary; each section is handed to its own loader (here + in
    # pr_jobs_setup, which reads this shared doc).
    shared PR_DOC = document_get_amd_file(get_mission_dir_filename("maps/peacetime_remastered.amd"), data_parser=amd_mission_data)

    # The peacekeeping side-jobs (the quest board) and the all-ships-lost loss watch.
    task_schedule(pr_jobs_setup)
    task_schedule(pr_lose_watch)

    # No enemy fleets in Peacetime. The headline case is the Florbin kidnapping, which
    # only runs if there are friendly ships to investigate.
    if friendly_value >= 1:
        # The Florbin case as a shared quest tree (the florbin_case section of PR_DOC),
        # layered over the original investigation. florbin_quest_watch translates the
        # kidnap_status flag that kidnap_caper drives into the quest_signal events its steps
        # listen for.
        quest_grant_amd(SHARED, amd_section(PR_DOC, "florbin_case"))
        task_schedule(florbin_quest_watch)
        # The investigation is now NATIVE to the remaster (fb_investigation in florbin_case.mast),
        # not a jump into the original peacetime map - its own FB_STATUS state + fb_ routes.
        jump fb_investigation
    else:
        task_schedule(task_peacetime_end_game)
        ->END


#-----------------------------------------------------------------------------------------------------------------------------
# Quest bridge: map the original kidnap_status flag (0..5) to the Florbin quest tree.
# fb_investigation / fb_kidnapper_discovered / fb_handle_kidnapper_surrender /
# fb_check_ambassador_rescued all drive FB_STATUS; we translate the transitions into quest_signal.

===== florbin_quest_watch =====
    prev_status = 0
    seen_kidnapper = False
--- fqw_loop
    await delay_sim(1)
    cur = FB_STATUS
    if cur >= 1 and prev_status < 1:
        signal_emit("quest_signal", {"SIGNAL_NAME": "case_opened"})
    if cur >= 2 and prev_status < 2:
        signal_emit("quest_signal", {"SIGNAL_NAME": "suspect_identified"})
    if cur >= 3 and prev_status < 3:
        signal_emit("quest_signal", {"SIGNAL_NAME": "kidnapper_subdued"})
    if cur >= 5 and prev_status < 5:
        signal_emit("quest_signal", {"SIGNAL_NAME": "florbin_delivered"})
        ->END
    # Killed-before-rescue: the kidnapper role only vanishes when that ship is destroyed.
    kcount = len(to_list(role("kidnapper")))
    if kcount > 0:
        seen_kidnapper = True
    if seen_kidnapper and kcount == 0 and cur < 3:
        signal_emit("quest_signal", {"SIGNAL_NAME": "florbin_killed"})
        ->END
    prev_status = cur
    jump fqw_loop


#-----------------------------------------------------------------------------------------------------------------------------
# The peacetime job board. Weapons doctrine: enforce and clear hazards, don't wage war.
#   * Gunnery Qualification - destroy inert practice drones (simulated hostiles).
#   * Rock Breakers        - demolish hazard asteroids clogging a shipping lane.
#   * Board the Poacher    - DISABLE (shields < 50%) and board a neutral trawler;
#                            destroying it FAILS the job (it is a civilian ship).
# Each is a per-ship quest so its credit reward pays to the side.

===== pr_jobs_setup =====
    # JOBS_SELECT is seeded by the map's Defaults metadata (set-if-absent shared) at panel
    # present + map-task start, so it is always defined here - no local default needed.
    jobs_value = terrain_to_value(JOBS_SELECT)
    ->END if jobs_value < 1

    # Job target counts come straight from the granted quest Goals (the jobs section of
    # PR_DOC), so the spawn loops below can never drift from the quest completion targets -
    # the AMD is the single source of truth. Each Goal parses to on_signal/on_scan with a
    # count; index them by signal name (and scan role) so a spawn loop reads its own target.
    # (Defaults guard a renamed/removed goal.)
    jobs_section = amd_section(PR_DOC, "jobs")
    job_counts = {}
    for jn in jobs_section.get("children", []):
        jd = jn.get("data") or {}
        jsig = jd.get("on_signal")
        if jsig is not None:
            job_counts[jsig.get("name")] = jsig.get("count", 1)
        jscan = jd.get("on_scan")
        if jscan is not None:
            job_counts["scan:" + str(jscan.get("role"))] = jscan.get("count", 1)
    # The Jobs density SCALES the board: few = 0.5x, some = 1x (base), lots = 1.5x, max = 2x
    # of the AMD Goal counts (jobs_value is 1..4 here). The SAME factor scales the spawn counts
    # below AND the granted quest Goals (count_scale on the grant), so the two can never
    # diverge. Singleton jobs (one poacher, one shuttle) carry no authored count, so they never
    # scale. int(x + 0.5) rounds (round() is not in the MAST eval globals); min 1.
    job_scale = jobs_value * 0.5
    drone_n = max(1, int(job_counts.get("drone_down", 5) * job_scale + 0.5))
    rock_n = max(1, int(job_counts.get("rock_cleared", 4) * job_scale + 0.5))
    traffic_n = max(1, int(job_counts.get("customs_cleared", 4) * job_scale + 0.5))
    survey_n = max(1, int(job_counts.get("scan:anomaly", 3) * job_scale + 0.5))
    # Beacon jobs: probes recovered (goal count) and the grazer pod size (fixed 4, scaled).
    probe_n = max(1, int(job_counts.get("probe_recovered", 3) * job_scale + 0.5))
    herd_n = max(2, int(4 * job_scale + 0.5))
    salvage_n = max(1, int(job_counts.get("salvage_delivered", 3) * job_scale + 0.5))

    # Declarative object scans (the scans section of PR_DOC), rendered by the generic science
    # route - no //science route here. (target_drone is raider-side, so the standard enemy scan
    # covers it; the anomaly uses the quest reveal_scan path.)
    science_define_scan_amd(amd_section(PR_DOC, "scans"))

    # Targets are SPAWNED ON ACCEPT, not at shift start (see pr_job_dispatch): stash the scaled
    # counts + the landmark records so the spawner reads them when a job is taken on. This keeps
    # counted jobs from being spoiled by pre-accept kills, and makes the stranded shuttle arrive on
    # the mayday (when the Mercy Run is accepted) instead of sitting adrift from the first second.
    shared PR_JOB_COUNTS = {"drone": drone_n, "rock": rock_n, "traffic": traffic_n, "survey": survey_n, "probe": probe_n, "herd": herd_n, "salvage": salvage_n}
    shared PR_LANDMARKS = landmarks_from_section(amd_section(PR_DOC, "landmarks"))
    # The jobs that spawn targets on accept, checked each dispatch tick.
    shared PR_JOB_KEYS = ["job_gunnery", "job_rocks", "job_customs", "job_survey", "job_poacher", "job_mercy", "job_sensor_net", "job_probes", "job_herd", "job_ravener", "job_barge", "job_salvage", "job_lifepod", "job_relay", "job_ghost", "job_sweep", "job_cache", "job_herd_arc"]

    # The job board is the jobs section of PR_DOC (parsed above). Grant it PER PLAYER SHIP so
    # credit rewards pay to the side (a Scope: shared quest gets no credit). Anomaly Survey uses
    # Goal: scan + Reveals: (the declarative quest-scan path), so this map needs no //science route.
    # Every job is authored State: idle, so it lands on the quest tab as "Available"; the player
    # ACCEPTS the ones they want (quest_tab_accept -> ACTIVE), which is also when any Fail after
    # clock starts and when pr_job_dispatch spawns that job's targets. Nothing completes (or fails,
    # or clutters space) before a job is taken on.
    for p in to_object_list(role("__player__")):
        quest_grant_amd(p.id, jobs_section, count_scale=job_scale)

    # Server watcher that credits the Sensor Net job as Sensor Beacons are deployed.
    task_schedule(pr_beacon_watch)
    task_schedule(pr_job_dispatch)
    ->END


#-----------------------------------------------------------------------------------------------------------------------------
# Spawn-on-accept dispatcher. A server watcher spawns each job's targets the first tick that job
# goes ACTIVE (a player accepted it from the quest tab). Server-side + guarded, so targets spawn
# exactly once no matter how many players accept, and never before acceptance.
===== pr_job_dispatch =====
    default GAME_ENDED = False
    spawned = []
--- pjd_loop
    await delay_sim(1)
    ->END if GAME_ENDED
    for job_key in PR_JOB_KEYS:
        if job_key not in spawned and pr_job_active(job_key):
            spawned.append(job_key)
            task_schedule(pr_job_spawn, {"PR_SPAWN_KEY": job_key})
    ->END if len(spawned) >= len(PR_JOB_KEYS)
    jump pjd_loop


# Spawn one job's targets, dispatched by PR_SPAWN_KEY (the accepted job's key). Counts come from
# PR_JOB_COUNTS (already Jobs-density scaled); the two fixed objects come from PR_LANDMARKS. The
# poacher/mercy cases also drop an info-panel alert so the job's objects arrive with context.
===== pr_job_spawn =====
    match PR_SPAWN_KEY:
        case "job_gunnery":
            # Inert drones squawking hostile IFF for a live-fire drill: no brain (they neither
            # maneuver nor shoot back), raider side so Weapons can lock and fire.
            for v in scatter.box(PR_JOB_COUNTS.get("drone", 5), 9000, 0, 9000, 2500, 400, 2500, centered=True):
                npc_spawn(v.x, v.y, v.z, "Target Drone", "raider, target_drone", "cargo_ship", "behav_npcship")
        case "job_rocks":
            rock_types = ship_data_plain_asteroid_keys()
            for v in scatter.box(PR_JOB_COUNTS.get("rock", 4), -11000, 0, 12000, 3500, 400, 3500, centered=True):
                rock = terrain_spawn(v.x, v.y, v.z, "Hazard Rock", "#, hazard_rock", random.choice(rock_types), "behav_asteroid")
                # Raw terrain spawns default to unselectable; clear it so Weapons can lock and fire.
                rock.data_set.set("unselectable", 0)
        case "job_customs":
            for v in scatter.box(PR_JOB_COUNTS.get("traffic", 4), -6000, 0, -6000, 3000, 400, 3000, centered=True):
                npc_spawn(v.x, v.y, v.z, "Civilian Trader", "civ, civilian, traffic", "cargo_ship", "behav_npcship")
        case "job_survey":
            anomaly_types = ship_data_plain_asteroid_keys()
            for v in scatter.box(PR_JOB_COUNTS.get("survey", 3), 14000, 0, 14000, 3000, 400, 3000, centered=True):
                anomaly = terrain_spawn(v.x, v.y, v.z, "Sensor Anomaly", "#, anomaly", random.choice(anomaly_types), "behav_asteroid")
                # Selectable so Science can pick it on the 2D view to scan it.
                anomaly.data_set.set("unselectable", 0)
        case "job_poacher":
            comms_info_card(all_roles("console, comms"), "Sensors flag an unregistered trawler running dark in the outer lane. Intercept and board - do not destroy.", title="Enforcement Dispatch", color="orange")
            poacher_rec = pr_landmark_by_key(PR_LANDMARKS, "poacher_lm")
            if poacher_rec is not None:
                landmark_spawn(poacher_rec)
        case "job_mercy":
            # Build-up: the mayday lands first, then the shuttle arrives a few seconds later, so
            # the rescue reads as responding to a distress call rather than a target blinking in.
            comms_info_card(all_roles("console, comms"), "Automated distress beacon: civilian shuttle adrift, life support failing. Last position logged - respond immediately.", title="Mayday", color="red")
            await delay_sim(4)
            mercy_rec = pr_landmark_by_key(PR_LANDMARKS, "mercy_lm")
            if mercy_rec is not None:
                landmark_spawn(mercy_rec)
            task_schedule(pr_mercy_watch)
        case "job_sensor_net":
            # No targets to spawn - the crew fabricates and deploys the beacons themselves.
            # pr_beacon_watch credits each Sensor Beacon as it is deployed.
            comms_info_card(all_roles("console, comms"), "Fleet wants a sensor picket. Engineering: fabricate Sensor Beacons on the Fabricate tab and deliver them to Weapons. Weapons: deploy three across the lanes.", title="Survey Order", color="#0cf")
        case "job_probes":
            # Scatter inert survey probes (old sensor beacons) for the crew to recover by fly-over.
            comms_info_card(all_roles("console, comms"), "Three survey probes have gone adrift. Recover them - fly your ship over each to bring it aboard.", title="Recovery Order", color="#0cf")
            for v in scatter.box(PR_JOB_COUNTS.get("probe", 3), -14000, 0, -2000, 4000, 400, 4000, centered=True):
                probe = terrain_spawn(v.x, v.y, v.z, "Survey Probe", "#, beacon, lost_probe", "danger_4a", "behav_pickup")
                set_inventory_value(probe.id, "beacon_kind", "sensor")
                # Empty mode so a recovered-then-refired probe stays a passive sensor (the
                # fabrication recover route defaults an unset mode to "attract").
                set_inventory_value(probe.id, "beacon_mode", "")
                probe.data_set.set("unselectable", 0)
        case "job_herd":
            comms_info_card(all_roles("console, comms"), "Grazers have drifted into the lane. Do NOT fire on them - they retaliate if provoked. Fabricate a Bio Beacon set to REPEL grazers and deploy it among the pod to clear them.", title="Wildlife Advisory", color="#fa0")
            for v in scatter.box(PR_JOB_COUNTS.get("herd", 4), 12000, 0, -9000, 2000, 300, 2000, centered=True):
                herd_id = await prefab_spawn(prefab_grazer, {"START_X": v.x, "START_Y": v.y, "START_Z": v.z})
                add_role(herd_id, "herd_grazer")
            task_schedule(pr_herd_watch, {"herd_x": 12000, "herd_y": 0, "herd_z": -9000})
        case "job_ravener":
            comms_info_card(all_roles("console, comms"), "A Ravener is loose. It FEEDS on weapon fire - do NOT shoot. Fabricate a Bio Beacon set to ATTRACT the ravener and deploy it beside the black hole.", title="Predator Alert", color="#f44")
            terrain_spawn_black_hole(-20000, 0, 16000)
            ravener_id = await prefab_spawn(prefab_ravener, {"START_X": -6000, "START_Y": 0, "START_Z": 12000})
            add_role(ravener_id, "lure_predator")
            task_schedule(pr_ravener_watch, {"rv_id": ravener_id, "hole_x": -20000, "hole_y": 0, "hole_z": 16000})
        case "job_barge":
            # A dead-in-space barge (behav_npcship, no orders -> it just idles); the crew
            # grav-tethers it and tows it home. pr_barge_watch credits arrival at DS 1.
            comms_info_card(all_roles("console, comms"), "A power-dead ore barge is adrift in the lane. Grav-tether it and tow it back to DS 1.", title="Haul Order", color="#0cf")
            npc_spawn(-13000, 0, 7000, "Ore Barge", "civ, civilian, tow_barge", "cargo_ship", "behav_npcship")
            task_schedule(pr_barge_watch)
        case "job_salvage":
            # Scatter idle salvage hulks + a stationary Refinery Platform as the drop-off; the
            # crew tows each hulk to the refinery. pr_salvage_watch credits each delivery.
            comms_info_card(all_roles("console, comms"), "Salvage hulks are cluttering the lane. Grav-tether each one and tow it to the Refinery Platform.", title="Salvage Order", color="#0cf")
            npc_spawn(-18000, 0, -6000, "Refinery Platform", "tsn, station, refinery", "starbase_command", "behav_station")
            for v in scatter.box(PR_JOB_COUNTS.get("salvage", 3), -9000, 0, -12000, 3000, 400, 3000, centered=True):
                npc_spawn(v.x, v.y, v.z, "Salvage Hulk", "civ, salvage_hulk", "cargo_ship", "behav_npcship")
            task_schedule(pr_salvage_watch)
        case "job_lifepod":
            # A drifting lifepod - tow it to DS 1 before the Fail after clock (anchored on accept).
            comms_info_card(all_roles("console, comms"), "A lifepod is tumbling from a wreck field, beacon failing. Grav-tether it and tow it to DS 1 - fast.", title="Life Support Critical", color="red")
            npc_spawn(-10000, 0, -14000, "Lifepod", "civ, civilian, tow_lifepod", "cargo_ship", "behav_npcship")
            task_schedule(pr_lifepod_watch)
        case "job_relay":
            # A drifted comms relay towed back to a marked POINT (a navpoint shows where) - the one
            # job that delivers to a position, not a station.
            comms_info_card(all_roles("console, comms"), "A comms relay drifted off station. Grav-tether it and tow it to the marked position in the lane.", title="Comms Order", color="#0cf")
            npc_spawn(6000, 0, 9000, "Comms Relay", "tsn, relay, tow_relay", "cargo_ship", "behav_npcship")
            sim.add_navpoint(4000, 0, -10000, "Relay Position", "#0cf")
            task_schedule(pr_relay_watch)
        case "job_ghost":
            # Multi-step: a silent derelict drifting toward a black hole. pr_ghost_seq guides the
            # crew hail -> scan -> tow-clear -> tow-home.
            terrain_spawn_black_hole(-16000, 0, -16000)
            derelict = npc_spawn(-13000, 0, -13000, "SS Meridian", "civ, civilian, derelict", "cargo_ship", "behav_npcship")
            derelict.data_set.set("unselectable", 0)
            task_schedule(pr_ghost_seq)
        case "job_sweep":
            # Multi-step: fabricate/deploy a sensor beacon, scan the flagged contact, tow it home.
            find = npc_spawn(15000, 0, -13000, "Stranded Pod", "civ, civilian, sweep_find", "cargo_ship", "behav_npcship")
            find.data_set.set("unselectable", 0)
            task_schedule(pr_sweep_seq)
        case "job_cache":
            # Multi-step: hail a tipster (Comms), scan the cluster to find the loaded rock
            # (Science), then tether the shielded pod out and tow it to DS 1.
            npc_spawn(11000, 0, -3000, "Loitering Freighter", "civ, tipster", "cargo_ship", "behav_npcship")
            cache_rocks = ship_data_plain_asteroid_keys()
            for v in scatter.box(6, 13000, 0, 3000, 2500, 400, 2500, centered=True):
                rk = terrain_spawn(v.x, v.y, v.z, "Asteroid", "#, asteroid", random.choice(cache_rocks), "behav_asteroid")
                rk.data_set.set("unselectable", 0)
            cache = npc_spawn(13000, 0, 3000, "Shielded Pod", "civ, cache_find", "cargo_ship", "behav_npcship")
            cache.data_set.set("unselectable", 0)
            task_schedule(pr_cache_seq)
        case "job_herd_arc":
            # Multi-step wildlife: scan (Science) -> warn convoy (Comms) -> bio REPEL beacon
            # (Engineering/Weapons) -> reel the drift netting off a snared grazer (Weapons/Helm).
            npc_spawn(8000, 0, 12000, "Civilian Convoy", "civ, convoy", "cargo_ship", "behav_npcship")
            for v in scatter.box(3, 6000, 0, 14000, 1500, 300, 1500, centered=True):
                gz = await prefab_spawn(prefab_grazer, {"START_X": v.x, "START_Y": v.y, "START_Z": v.z})
                add_role(gz, "arc_grazer")
            # The SNARED grazer is STUCK - a stationary npc (not a wandering prefab), so only
            # reeling the netting away increases their separation and frees it.
            npc_spawn(5000, 0, 16000, "Snared Grazer", "civ, arc_grazer, snared_grazer", "cargo_ship", "behav_npcship")
            npc_spawn(5150, 0, 16000, "Drift Netting", "civ, snag_debris", "cargo_ship", "behav_npcship")
            task_schedule(pr_herd_arc_seq)
    ->END


# Weapons-job events -> quest_signal. Using //damage/destroy (reliable for both npc
# drones and terrain asteroids) keeps every job on the same event path.
//damage/destroy if has_role(DESTROYED_ID, "target_drone")
    signal_emit("quest_signal", {"SIGNAL_NAME": "drone_down"})

//damage/destroy if has_role(DESTROYED_ID, "hazard_rock")
    signal_emit("quest_signal", {"SIGNAL_NAME": "rock_cleared"})

//damage/destroy if has_role(DESTROYED_ID, "poacher")
    signal_emit("quest_signal", {"SIGNAL_NAME": "poacher_killed"})


# Poacher comms: the enforcement surface. The surrender check mirrors the kidnapper's -
# shields below 50% forces the boarding. This is the "disable, don't destroy" mechanic.
//enable/comms if has_roles(COMMS_SELECTED_ID, "poacher")
//comms if has_roles(COMMS_SELECTED_ID, "poacher")
    + "Demand Surrender" pr_poacher_surrender

===== pr_poacher_surrender =====
    blob = to_blob(COMMS_SELECTED_ID)
    ->END if blob is None
    shield_count = blob.get("shield_count", 0)
    s_ratio = 100
    for s in range(shield_count):
        s_max = blob.get("shield_max_val", s)
        s_cur = blob.get("shield_val", s)
        if s_max > 0:
            s_ratio = min(s_cur/s_max, s_ratio)
    if s_ratio < 0.5:
        signal_emit("quest_signal", {"SIGNAL_NAME": "poacher_boarded"})
        remove_role(COMMS_SELECTED_ID, "poacher")
        e_obj = to_engine_object(COMMS_SELECTED_ID)
        _pos = e_obj.pos
        target_pos(COMMS_SELECTED_ID, _pos.x, _pos.y, _pos.z, throttle=0.0, target_id=0, stop_dist=200)
        comms_receive(f"""All right, all right! We surrender. Cutting engines - your boarding party is clear to dock.""", title="Poacher Surrenders", title_color="green")
    else:
        comms_receive(f"""You have no authority out here! Back off.""", title="Refused", title_color="red")
    yield success


#-----------------------------------------------------------------------------------------------------------------------------
# Customs Patrol (Comms): hail civilian traffic and clear it for transit.
//enable/comms if has_roles(COMMS_SELECTED_ID, "traffic")
//comms if has_roles(COMMS_SELECTED_ID, "traffic")
    + "Request Manifest" pr_customs_manifest
    + "Clear for Transit" pr_customs_clear

===== pr_customs_manifest =====
    comms_receive(f"""Routine haul, officer - machine parts and foodstuffs, all logged. Happy to hold for inspection.""", title="Manifest", title_color="green")
    yield success

===== pr_customs_clear =====
    signal_emit("quest_signal", {"SIGNAL_NAME": "customs_cleared"})
    remove_role(COMMS_SELECTED_ID, "traffic")
    comms_receive(f"""Transit cleared. Safe travels, and thank you for keeping the lanes tidy.""", title="Customs", title_color="green")
    yield success


#-----------------------------------------------------------------------------------------------------------------------------
# Anomaly Survey (Science) is fully declarative now: the job_survey quest carries
# on_scan {role: anomaly} + reveal_scan, and the quest driver makes the anomalies
# scannable and renders the scan text. No //science route needed here.


#-----------------------------------------------------------------------------------------------------------------------------
# Mercy Run (Helm): a patrol ship reaching the stranded shuttle relieves it. Proximity, not
# docking, so it needs no per-station docking wiring. The job starts IDLE like the rest of the
# board; accepting it anchors the 6-minute fail_after clock AND triggers pr_job_spawn's mercy case
# (the mayday card, then the shuttle). This watcher is scheduled by that spawn - so on its first
# tick the shuttle already exists, and `->END if no mercy_target` now means "rescued -> stop".
===== pr_mercy_watch =====
    default GAME_ENDED = False
--- mw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    m_list = to_list(role("mercy_target"))
    ->END if len(m_list) < 1
    m_id = m_list[0]
    for p in role("__player__"):
        if sbs.distance_id(p, m_id) <= 900:
            # Quest completion auto-broadcasts "Mission complete: Mercy Run"; no comms
            # context here (background task), so don't call comms_receive.
            signal_emit("quest_signal", {"SIGNAL_NAME": "mercy_reached"})
            remove_role(m_id, "mercy_target")
            ->END
    jump mw_loop


# Tow the Barge (grav-tether): the barge is dead-in-space; towing it within docking range of
# DS 1 completes the job. Proximity, so it needs no docking wiring. (Refinery also has role
# "station" but a different name, so the DS 1 name filter skips it.)
===== pr_barge_watch =====
    default GAME_ENDED = False
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
--- pbargew_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    b_list = to_list(role("tow_barge"))
    ->END if len(b_list) < 1
    if sbs.distance_id(b_list[0], ds1) <= 1800:
        signal_emit("quest_signal", {"SIGNAL_NAME": "barge_delivered"})
        remove_role(b_list[0], "tow_barge")
        ->END
    jump pbargew_loop


# Salvage Sweep (grav-tether): tow each salvage hulk to the Refinery Platform; each arrival
# credits one delivery (Goal: signal 3 salvage_delivered). to_list snapshots, so removing the
# role mid-iteration is safe.
===== pr_salvage_watch =====
    default GAME_ENDED = False
--- psw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    ref_list = to_list(role("refinery"))
    ->END if len(ref_list) < 1
    ref = ref_list[0]
    for h in to_list(role("salvage_hulk")):
        if sbs.distance_id(h, ref) <= 1800:
            signal_emit("quest_signal", {"SIGNAL_NAME": "salvage_delivered"})
            remove_role(h, "salvage_hulk")
    ->END if len(to_list(role("salvage_hulk"))) < 1
    jump psw_loop


# Rescue the Lifepod (grav-tether, TIMED): tow the pod to DS 1 before the Fail after clock
# (anchored on accept). Same proximity-to-DS-1 delivery as the barge.
===== pr_lifepod_watch =====
    default GAME_ENDED = False
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
--- plpw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    p_list = to_list(role("tow_lifepod"))
    ->END if len(p_list) < 1
    if sbs.distance_id(p_list[0], ds1) <= 1800:
        signal_emit("quest_signal", {"SIGNAL_NAME": "lifepod_delivered"})
        remove_role(p_list[0], "tow_lifepod")
        ->END
    jump plpw_loop


# Reposition the Relay (grav-tether): tow the relay to its marked position - a fixed POINT shown
# by a navpoint, not a station. Distance-to-point delivery.
===== pr_relay_watch =====
    default GAME_ENDED = False
    relay_target = Vec3(4000, 0, -10000)
--- prw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    r_list = to_object_list(role("tow_relay"))
    ->END if len(r_list) < 1
    r = r_list[0]
    if (Vec3(r.pos) - relay_target).length() <= 1500:
        signal_emit("quest_signal", {"SIGNAL_NAME": "relay_placed"})
        remove_role(r.id, "tow_relay")
        ->END
    jump prw_loop


# The Ghost Freighter (multi-console guided sequence): hail (Comms) -> scan (Science) -> tow clear
# of the black hole (Weapons/Helm) -> tow home to DS 1. The //comms and //science routes below emit
# the hail/scan step signals (awaited via signal_next); the two tether legs are proximity.
===== pr_ghost_seq =====
    default GAME_ENDED = False
    ghost_hole = Vec3(-16000, 0, -16000)
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
    # Step 1 - Hail (Comms). Reveal the first child for everyone holding the arc.
    for gpid in pr_arc_holders("job_ghost"):
        quest_mark_active(gpid, "job_ghost/hail")
    comms_info_card(all_roles("console, comms"), "The SS Meridian has gone silent, drifting toward a black hole. COMMS: hail her.", title="Silent Running", color="#0cf")
    await signal_next("ghost_hailed")
    ->END if GAME_ENDED
    # Step 2 - Scan (Science).
    for gpid in pr_arc_holders("job_ghost"):
        quest_mark_complete(gpid, "job_ghost/hail")
        quest_mark_active(gpid, "job_ghost/scan")
    comms_info_card(all_roles("console, comms"), "No live response - just an automated loop. SCIENCE: scan the derelict.", title="Silent Running", color="#0cf")
    await signal_next("ghost_scanned")
    ->END if GAME_ENDED
    # Step 3 - Tow clear of the hole (proximity).
    for gpid in pr_arc_holders("job_ghost"):
        quest_mark_complete(gpid, "job_ghost/scan")
        quest_mark_active(gpid, "job_ghost/clear")
    comms_info_card(all_roles("console, comms"), "Crew in cryo, reactor critical. WEAPONS/HELM: grav-tether her and tow her CLEAR of the black hole - now.", title="Silent Running", color="orange")
--- ghost_clear
    await delay_sim(2)
    ->END if GAME_ENDED
    g_list = to_object_list(role("derelict"))
    ->END if len(g_list) < 1
    if (Vec3(g_list[0].pos) - ghost_hole).length() < 6000:
        jump ghost_clear
    # Step 4 - Tow home (proximity).
    for gpid in pr_arc_holders("job_ghost"):
        quest_mark_complete(gpid, "job_ghost/clear")
        quest_mark_active(gpid, "job_ghost/home")
    comms_info_card(all_roles("console, comms"), "Clear of the well. Now tow her home to DS 1.", title="Silent Running", color="#0cf")
--- ghost_home
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    g_list = to_object_list(role("derelict"))
    ->END if len(g_list) < 1
    if sbs.distance_id(g_list[0].id, ds1) > 1800:
        jump ghost_home
    # Completing the last child auto-completes the container parent -> the arc pays out.
    for gpid in pr_arc_holders("job_ghost"):
        quest_mark_complete(gpid, "job_ghost/home")
    ->END


# Ghost Freighter step signals: hailing the derelict (Comms) and scanning it (Science).
//comms if has_roles(COMMS_SELECTED_ID, "derelict")
    comms_receive("SS Meridian automated distress: reactor breach imminent, crew in emergency cryo, no conscious crew aboard. Tow to safety requested.", title="SS Meridian", title_color="orange")
    signal_emit("ghost_hailed")

//science if has_roles(SCIENCE_SELECTED_ID, "derelict")
    ->END if sbs.distance_id(SCIENCE_ORIGIN_ID, SCIENCE_SELECTED_ID) > 900
    signal_emit("ghost_scanned")


# Sweep and Recover (multi-console guided sequence): fabricate + deploy a Sensor Beacon
# (Engineering/Weapons) -> scan the flagged contact (Science) -> tow it home (Weapons/Helm).
===== pr_sweep_seq =====
    default GAME_ENDED = False
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
    # Step 1 - Deploy the picket (Engineering/Weapons).
    for spid in pr_arc_holders("job_sweep"):
        quest_mark_active(spid, "job_sweep/deploy")
    comms_info_card(all_roles("console, comms"), "Fleet wants a sensor sweep of the outer lane. ENGINEERING/WEAPONS: fabricate a Sensor Beacon on the Fabricate tab and deploy it.", title="Sweep Order", color="#0cf")
--- sweep_beacon
    await delay_sim(1)
    ->END if GAME_ENDED
    have_sensor = False
    for b in to_object_list(role("beacon")):
        if get_inventory_value(b.id, "beacon_kind", "bio") == "sensor" and not has_role(b.id, "lost_probe"):
            have_sensor = True
    if not have_sensor:
        jump sweep_beacon
    # Step 2 - Scan the flagged contact (Science).
    for spid in pr_arc_holders("job_sweep"):
        quest_mark_complete(spid, "job_sweep/deploy")
        quest_mark_active(spid, "job_sweep/scan")
    comms_info_card(all_roles("console, comms"), "Picket up - it flags a drifting contact in the outer lane. SCIENCE: scan it.", title="Sweep Order", color="#0cf")
    await signal_next("sweep_scanned")
    ->END if GAME_ENDED
    # Step 3 - Recover the find (Weapons/Helm).
    for spid in pr_arc_holders("job_sweep"):
        quest_mark_complete(spid, "job_sweep/scan")
        quest_mark_active(spid, "job_sweep/recover")
    comms_info_card(all_roles("console, comms"), "It's a stranded cargo pod. Grav-tether it and tow it home to DS 1.", title="Sweep Order", color="#0cf")
--- sweep_home
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    f_list = to_object_list(role("sweep_find"))
    ->END if len(f_list) < 1
    if sbs.distance_id(f_list[0].id, ds1) > 1800:
        jump sweep_home
    for spid in pr_arc_holders("job_sweep"):
        quest_mark_complete(spid, "job_sweep/recover")
    ->END


# Sweep step signal: scanning the flagged contact (Science).
//science if has_roles(SCIENCE_SELECTED_ID, "sweep_find")
    ->END if sbs.distance_id(SCIENCE_ORIGIN_ID, SCIENCE_SELECTED_ID) > 900
    signal_emit("sweep_scanned")


# Cache in the Rocks (multi-console): hail the tipster (Comms) -> scan the cluster to find the
# loaded rock (Science) -> tether the pod out and tow it to DS 1 (Weapons/Helm).
===== pr_cache_seq =====
    default GAME_ENDED = False
    ds1 = None
    for s in to_object_list(role("station")):
        if s.name == "DS 1":
            ds1 = s.id
    # Step 1 - Get the tip (Comms).
    for cpid in pr_arc_holders("job_cache"):
        quest_mark_active(cpid, "job_cache/tip")
    comms_info_card(all_roles("console, comms"), "A tipster is loitering near the lane. COMMS: hail them for the drop location.", title="Cold Tip", color="#0cf")
    await signal_next("cache_tip")
    ->END if GAME_ENDED
    # Step 2 - Find the cache (Science).
    for cpid in pr_arc_holders("job_cache"):
        quest_mark_complete(cpid, "job_cache/tip")
        quest_mark_active(cpid, "job_cache/find")
    comms_info_card(all_roles("console, comms"), "The cache is hidden in the rock cluster. SCIENCE: scan the cluster to find the loaded one.", title="Cold Tip", color="#0cf")
    await signal_next("cache_found")
    ->END if GAME_ENDED
    # Step 3 - Recover the pod (Weapons/Helm).
    for cpid in pr_arc_holders("job_cache"):
        quest_mark_complete(cpid, "job_cache/find")
        quest_mark_active(cpid, "job_cache/recover")
    comms_info_card(all_roles("console, comms"), "Found it - a shielded cargo pod. Grav-tether it out of the rocks and tow it to DS 1.", title="Cold Tip", color="#0cf")
--- cache_home
    await delay_sim(2)
    ->END if GAME_ENDED
    ->END if ds1 is None
    c_list = to_object_list(role("cache_find"))
    ->END if len(c_list) < 1
    if sbs.distance_id(c_list[0].id, ds1) > 1800:
        jump cache_home
    for cpid in pr_arc_holders("job_cache"):
        quest_mark_complete(cpid, "job_cache/recover")
    ->END


# Cache step signals: hailing the tipster (Comms) and scanning the loaded rock (Science).
//comms if has_roles(COMMS_SELECTED_ID, "tipster")
    comms_receive("Alright - the drop's in the rock cluster off the lane. Shielded pod, reads like just another boulder. You didn't hear it from me.", title="Tipster", title_color="#0cf")
    signal_emit("cache_tip")

//science if has_roles(SCIENCE_SELECTED_ID, "cache_find")
    ->END if sbs.distance_id(SCIENCE_ORIGIN_ID, SCIENCE_SELECTED_ID) > 900
    signal_emit("cache_found")


# Herd on the Lane (multi-console wildlife): scan (Science) -> warn convoy (Comms) -> bio REPEL
# beacon (Engineering/Weapons) -> reel the drift netting off a snared grazer (Weapons/Helm).
===== pr_herd_arc_seq =====
    default GAME_ENDED = False
    # Step 1 - Scan the pod (Science).
    for hpid in pr_arc_holders("job_herd_arc"):
        quest_mark_active(hpid, "job_herd_arc/scan")
    comms_info_card(all_roles("console, comms"), "A grazer pod has drifted into the lane. SCIENCE: scan the pod.", title="Wildlife on the Lane", color="#fa0")
    await signal_next("herd_scanned")
    ->END if GAME_ENDED
    # Step 2 - Warn the convoy (Comms).
    for hpid in pr_arc_holders("job_herd_arc"):
        quest_mark_complete(hpid, "job_herd_arc/scan")
        quest_mark_active(hpid, "job_herd_arc/warn")
    comms_info_card(all_roles("console, comms"), "They're spooked and drifting into traffic. COMMS: warn the civilian convoy to hold.", title="Wildlife on the Lane", color="#fa0")
    await signal_next("herd_warned")
    ->END if GAME_ENDED
    # Step 3 - Deploy a bio REPEL beacon (Engineering/Weapons).
    for hpid in pr_arc_holders("job_herd_arc"):
        quest_mark_complete(hpid, "job_herd_arc/warn")
        quest_mark_active(hpid, "job_herd_arc/repel")
    comms_info_card(all_roles("console, comms"), "ENGINEERING/WEAPONS: fabricate a Bio Beacon set to REPEL and deploy it among the pod to drive them clear. Do NOT fire.", title="Wildlife on the Lane", color="#fa0")
--- herd_repel
    await delay_sim(1)
    ->END if GAME_ENDED
    got_bio = False
    for b in to_object_list(role("beacon")):
        if get_inventory_value(b.id, "beacon_kind", "sensor") == "bio":
            got_bio = True
    if not got_bio:
        jump herd_repel
    # Step 4 - Free the snared grazer (Weapons/Helm).
    for hpid in pr_arc_holders("job_herd_arc"):
        quest_mark_complete(hpid, "job_herd_arc/repel")
        quest_mark_active(hpid, "job_herd_arc/free")
    comms_info_card(all_roles("console, comms"), "Pod's moving off. One grazer is snared in drifting netting - grav-tether the netting clear to free it.", title="Wildlife on the Lane", color="#fa0")
--- herd_free
    await delay_sim(2)
    ->END if GAME_ENDED
    s_list = to_object_list(role("snared_grazer"))
    d_list = to_object_list(role("snag_debris"))
    ->END if len(s_list) < 1 or len(d_list) < 1
    if sbs.distance_id(s_list[0].id, d_list[0].id) < 2500:
        jump herd_free
    for hpid in pr_arc_holders("job_herd_arc"):
        quest_mark_complete(hpid, "job_herd_arc/free")
    ->END


# Herd step signals: scanning a grazer (Science) and warning the convoy (Comms).
//science if has_roles(SCIENCE_SELECTED_ID, "arc_grazer")
    ->END if sbs.distance_id(SCIENCE_ORIGIN_ID, SCIENCE_SELECTED_ID) > 900
    signal_emit("herd_scanned")

//comms if has_roles(COMMS_SELECTED_ID, "convoy")
    comms_receive("Convoy copies - holding station until the lane is clear. Thanks for the heads-up, patrol.", title="Civilian Convoy", title_color="#0cf")
    signal_emit("herd_warned")


#-----------------------------------------------------------------------------------------------------------------------------
# Beacon jobs plumbing. These lean on the fabrication addon: the crew builds a beacon on the
# Engineering Fabricate tab, delivers it to Weapons, and fires it. Each job emits quest_signal,
# credited to whichever players hold the matching job.

# Sensor Net: credit the job as each Sensor Beacon is deployed (a role "beacon" object whose
# beacon_kind is "sensor"). The adrift lost probes carry role "lost_probe" and are skipped.
===== pr_beacon_watch =====
    default GAME_ENDED = False
    seen_beacons = []
--- pbw_loop
    await delay_sim(1)
    ->END if GAME_ENDED
    for b in to_object_list(role("beacon")):
        if b.id not in seen_beacons:
            seen_beacons.append(b.id)
            if get_inventory_value(b.id, "beacon_kind", "bio") == "sensor" and not has_role(b.id, "lost_probe"):
                signal_emit("quest_signal", {"SIGNAL_NAME": "sensor_deployed"})
    jump pbw_loop


# Recover Lost Probes: flying a ship over an adrift probe credits the job. The fabrication addon's
# own beacon-recover route also fires (adding a beacon round back), so this only emits the signal.
//collision/interactive if has_role(COLLISION_ORIGIN_ID, "lost_probe") and has_any_role(COLLISION_SELECTED_ID, "__player__,cockpit")
    signal_emit("quest_signal", {"SIGNAL_NAME": "probe_recovered"})


# Clear the Grazing Herd: complete once no living herd grazer remains near the lane center - a
# repel Bio Beacon drives them out. (Killing a provoked grazer also removes it, but that risks a
# fight; the beacon is the clean solution.)
===== pr_herd_watch =====
    default GAME_ENDED = False
--- hw_loop
    await delay_sim(2)
    ->END if GAME_ENDED
    still_here = 0
    for g in to_object_list(role("herd_grazer")):
        gp = get_pos(g.id)
        dxg = gp.x - herd_x
        dyg = gp.y - herd_y
        dzg = gp.z - herd_z
        if (dxg * dxg + dyg * dyg + dzg * dzg) <= 6000 * 6000:
            still_here = still_here + 1
    if still_here == 0:
        signal_emit("quest_signal", {"SIGNAL_NAME": "herd_cleared"})
        ->END
    jump hw_loop


# Bait the Ravener: it heals on any weapon hit, so only the black hole can remove it. When an
# attract Bio Beacon has pulled it within the hole's reach, consume it and credit the job. A real
# engine black-hole kill (//damage/destroy below) also credits it, as a fallback.
===== pr_ravener_watch =====
    default GAME_ENDED = False
--- rvw_loop
    await delay_sim(1)
    ->END if GAME_ENDED
    ->END if not object_exists(rv_id)
    rvp = get_pos(rv_id)
    dxr = rvp.x - hole_x
    dyr = rvp.y - hole_y
    dzr = rvp.z - hole_z
    if (dxr * dxr + dyr * dyr + dzr * dzr) <= 1400 * 1400:
        delete_object(rv_id)
        signal_emit("quest_signal", {"SIGNAL_NAME": "predator_baited"})
        ->END
    jump rvw_loop

//damage/destroy if has_role(DESTROYED_ID, "lure_predator")
    signal_emit("quest_signal", {"SIGNAL_NAME": "predator_baited"})


#-----------------------------------------------------------------------------------------------------------------------------
# Shift end: an all-patrol-ships-lost loss. The shift-timer win is handled by
# task_peacetime_end_game (scheduled by kidnap_caper, or above when there is no case).

===== pr_lose_watch =====
    default GAME_ENDED = False
    seen_players = False
--- plw_loop
    await delay_sim(4)
    ->END if GAME_ENDED
    pc = len(to_list(role("__player__")))
    if pc > 0:
        seen_players = True
    if seen_players and pc == 0:
        START_TEXT = "All patrol ships were lost."
        GAME_STARTED = False
        GAME_ENDED = True
        sbs.play_music_file(0, "music/default/failure")
        signal_emit("show_game_results", None)
        ->END
    jump plw_loop
