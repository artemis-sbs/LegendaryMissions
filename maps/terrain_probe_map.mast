# TEMPORARY - Phase 0 of the terrain-sower plan.
#
# Mirrors the terrain block of maps/peacetime_remastered.mast exactly, but with a
# probe mark around each call, so a REAL Cosmos session answers three things the
# mock cannot: how long each terrain call takes, how much of that is the Pybind
# spawn vs the property setters, and whether there is a client-sync TAIL of long
# frames after the burst. The answer sets the sower's default drip window and
# decides whether its budget counts clusters or bytes.
#
# Writes terrain_burst.log into the mission folder. DELETE this file and its
# import line in maps/__init__.mast once the numbers are in.

@map/terrain_probe "TEMP: terrain burst probe"
" Measures the terrain creation burst in-engine and writes terrain_burst.log
" into the mission folder. Pick Terrain: max for the worst case, play for ~20
" seconds, then read the log. Not a playable map.
metadata:``` yaml
Properties:
  Main:
    Player Ships: 'gui_int_slider("$text:int;low: 1.0;high:8.0;", var= "PLAYER_COUNT")'
    Difficulty: 'gui_int_slider("$text:int;low: 1.0;high:11.0;", var= "DIFFICULTY")'
  Map:
    Terrain: 'gui_drop_down("$text: {TERRAIN_SELECT};list: none, few, some, lots, max",var="TERRAIN_SELECT")'
    Lethal Terrain: 'gui_drop_down("$text: {LETHAL_SELECT};list: none, few, some, lots, max", var="LETHAL_SELECT")'
    Monsters: 'gui_drop_down("$text: {MONSTER_SELECT};list: none, few, some, lots, max", var="MONSTER_SELECT")'
    Upgrades: 'gui_drop_down("$text: {UPGRADE_SELECT};list: none, few, some, lots, max", var= "UPGRADE_SELECT")'
    Sow: 'gui_drop_down("$text: {SOW_SELECT};list: off, on", var="SOW_SELECT")'
    Sow Seconds: 'gui_int_slider("$text:int;low: 2.0;high:20.0;", var="SOW_OVER")'
    Seed: 'gui_input("desc: Integer (0 = random);", var="seed_value")'
Defaults:
  SOW_SELECT: 'off'
  SOW_OVER: 6
  TERRAIN_SELECT: max
  LETHAL_SELECT: some
  MONSTER_SELECT: some
  UPGRADE_SELECT: some
```

    terrain_value = terrain_to_value(TERRAIN_SELECT)
    lethal_value =  terrain_to_value(LETHAL_SELECT)
    monster_value = terrain_to_value(MONSTER_SELECT)
    upgrade_value = terrain_to_value(UPGRADE_SELECT)
    seed_value = safe_int(seed_value)

    # A fixed seed makes two runs comparable (same field, same object count).
    if seed_value == 0:
        seed_value = 20260804
    random.seed(seed_value)

    probe_path = terrain_probe_start()
    log(f"terrain probe -> {probe_path} (seed {seed_value})", "terrain")

    # Same order as peacetime_remastered, so the numbers describe a real map.
    terrain_probe_mark("stations")
    terrain_spawn_stations(DIFFICULTY, lethal_value, min_num=5)

    # A waiting section, not a cost - the ticks column shows it spans frames.
    # Players must exist before the big fields so the sync tail is real.
    terrain_probe_mark("await players", wait=True)
    await task_schedule(spawn_players)
    await task_schedule(default_player_friendly_eyes)
    await task_schedule(docking_standard_player_station)

    # Sow: off measures the burst, on measures the drip. Run it both ways with the
    # same seed and compare the worst frame in the "during burst" line. Sow Seconds
    # sweeps the drip window without editing anything.
    if SOW_SELECT == "on":
        terrain_sow_begin(over=safe_int(SOW_OVER))
    terrain_probe_mark("asteroid_clusters")
    terrain_asteroid_clusters(terrain_value)
    terrain_probe_mark("nebula_clusters")
    terrain_spawn_nebula_clusters(terrain_value)
    terrain_sow_end()
    terrain_probe_mark("pickups")
    terrain_spawn_pickups(upgrade_value)
    terrain_probe_mark("monsters")
    terrain_spawn_monsters(monster_value)
    terrain_probe_mark("black_holes")
    terrain_spawn_black_holes(lethal_value)

    # The tail. Everything above has returned; any long frames from here are the
    # engine still paying for the burst.
    terrain_probe_mark("tail", wait=True)
    await delay_sim(15)
    terrain_probe_stop()
    log(f"terrain probe done - read {probe_path}", "terrain")
    ->END
