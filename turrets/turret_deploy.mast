# --- tow and deploy -----------------------------------------------------------------
# The grav_tether addon already raises a Weapons hold-click menu keyed on the TARGET'S
# ROLE, so a kit only has to add its own entries. Tow rather than Lock: a rigid lock
# reels the load right in, while the rope-toggle Tow holds it at a distance (measured
# 798/801/801 at rope_len 800).

//popup/weapons if has_any_role(WEAPONS_ORIGIN_ID, "__player__") and has_role(WEAPONS_SELECTED_ID, "turret_crate")
    # grav_tether_involves, NOT grav_tether_get. A Tow is a rope-TOGGLE: it deletes the
    # engine connection whenever the load is inside the rope length and re-engages when it
    # drifts out, so grav_tether_get reads None for most of a normal tow. Gating on it
    # would offer "Deploy Turret" mid-tow and unfold the turret wherever the ship was.
    lmtk_towed = grav_tether_involves(WEAPONS_SELECTED_ID)
    if not lmtk_towed:
        + "Grav Tow Kit":
            grav_tether_tow(WEAPONS_ORIGIN_ID, WEAPONS_SELECTED_ID, 500)
    if lmtk_towed:
        + "Release Kit":
            grav_tether_release(WEAPONS_ORIGIN_ID, WEAPONS_SELECTED_ID)
    # Deploy only once it is NOT under tow - otherwise a turret unfolds while still
    # being dragged and ends up wherever the ship happened to be.
    if not lmtk_towed:
        + "Deploy Turret":
            lmtk_data = ~~{"lmtd_crate": WEAPONS_SELECTED_ID}~~
            signal_emit("lm_turret_deploy_kit", lmtk_data)


//shared/signal/lm_turret_deploy_kit
    # `lmtd_crate` arrives as a task variable: signal data is a dict and its keys become
    # variables in every route that handles the signal.
    default lmtd_crate = None
    ->END if lmtd_crate is None
    ->END if not object_exists(lmtd_crate)
    lmtd_prefab = lm_turret_crate_prefab(lmtd_crate)
    ->END if lmtd_prefab is None
    lmtd_side = to_object(lmtd_crate).side
    # The crate knows who was issued it; the TOWER is what everything scores. Read the
    # owner BEFORE the crate is deleted and carry it through, or a player-deployed turret
    # belongs to nobody and no per-ship objective can credit it.
    lmtd_owner = lm_turret_owner(lmtd_crate)

    # The cap is checked HERE, on the server, not in the popup: the popup is per console
    # and two consoles could pass the same check at the same moment.
    if lm_turret_at_cap(lmtd_side):
        comms_broadcast(role(lmtd_side), f"Turret grid at capacity ({lm_turret_cap()}). Wait for one to power down, or have a Game Master clear one.")
        ->END

    lmtd_pos = get_pos(lmtd_crate)
    lmtd_data = ~~{"START_X": lmtd_pos.x, "START_Y": lmtd_pos.y, "START_Z": lmtd_pos.z, "side_value": lmtd_side, "owner": lmtd_owner}~~
    lmtd_id = await prefab_spawn(lmtd_prefab, lmtd_data)
    ->END if lmtd_id is None
    delete_object(lmtd_crate)
    comms_broadcast(role(lmtd_side), "Defense turret deployed and active.")
    ->END


# --- upkeep and decay ---------------------------------------------------------------
# Per-SHOT upkeep, which is only possible because //damage/object carries the shooter in
# DAMAGE_ORIGIN_ID for beam damage (engine-measured). A timer-based drain would punish a
# turret nothing ever flew past; a magazine only empties when the turret is doing its job.

//damage/object if has_role(DAMAGE_ORIGIN_ID, "turret")
    lm_turret_spend_charge(DAMAGE_ORIGIN_ID, 1)
