#
# Quest log - ONE screen, two apps.
#
#   Quests            the quests the crew has TAKEN ON (ship + client + shared/game),
#                     state-ordered (active -> complete -> failed) with the AMD narrative.
#   Available Quests  the SAME screen listing the quests that could be taken on - plus
#                     Open Universe station work, which is priced when you hail and only
#                     becomes a quest then. The route (app key "offers") lives in
#                     consoles/offers.mast and jumps into quest_tab_screen below.
#
# ONE WORD FOR PLAYERS: quest. A job, a sortie and a story beat are KINDS of quest (the
# row's icon), not separate things. A quest is read and accepted under Available Quests;
# once accepted it moves to Quests. Gated by the QUEST_TAB_ENABLED setting.
#
# The screen DISPLAYS on any console in quest_console_enable(...) below, but the action
# controls are gated per CONSOLE: Accept (Available Quests) and Abandon (Quests) show only on
# the consoles in QUEST_ACCEPT_CONSOLES (default comms + admiral), Engage only on those in
# QUEST_ENGAGE_CONSOLES (default helm) and only once the job is accepted. A quest can
# override either list for itself via the AMD `Accept On:` / `Engage On:` labels (a
# station-specific job). On a console that can't act, the buttons are replaced with text
# naming the console(s) that can. quest_tab_controls_gate resolves all of this.
#
default CONSOLE_SELECT = ""              # exists at startup
default shared QUEST_TAB_ENABLED = True  # missions may set this False
default shared QUEST_ENGAGE_ENABLED = False  # missions WITH travel set True -> Engage button
# WHICH consoles may act. "" = any console showing the tab (the pre-gating behavior).
default shared QUEST_ACCEPT_CONSOLES = "comms,admiral"  # who may Accept/Abandon
default shared QUEST_ENGAGE_CONSOLES = "helm"           # who may Engage (when enabled)

if QUEST_TAB_ENABLED:
    gui_tab_add_top("quest")
    # Show the quest log on the standard bridge consoles.
    # HANGAR AND COCKPIT TOO. The app is REGISTERED for every ship console, but
    # `gui_app_list` honours a route's own `if` above the registration - so this list was
    # the real gate, and a pilot on the flight deck or in the seat had no Quests tile at
    # all. That is the one place a sortie is taken, which made it the one place the
    # Quests app was missing. Nothing else about the gating changes: WHO may accept is
    # still QUEST_ACCEPT_CONSOLES, and that is a separate question from who may LOOK.
    quest_console_enable("helm,weapons,science,engineering,comms,mainscreen,"
                         "hangar,cockpit")
    if is_dev_build():
        # Dev-only sample art for the quest test data.
        gui_image_add_atlas("test", media_shared("operator"))
        gui_image_add_atlas("test2", media_shared("operator"), 645, 570, 950, 820)


//gui/app/quest if QUEST_TAB_ENABLED and quest_is_console_enabled(CONSOLE_SELECT)
    # A fresh view: the selection belongs to whichever list was last on screen, and the
    # Offers list is a different list.
    quest_tab_mode = "taken"
    quest_sel_index = -1
    quest_sel_hint = None
    jump quest_tab_screen


# The shared screen. `quest_tab_mode` ("taken" or "offers") is set by the route that
# jumped here and survives the repaints below, which is all that differs between the two
# apps: which items are listed, the list's title, and what the empty pane says.
== quest_tab_screen
--- repaint
    # ONE GUI TAB, and it is the way back to the console. The PADD adds nothing to
    # the strip and changes nothing about it - it declares a back tab like any
    # other screen and the bar draws it the way it always has. Removing this line
    # is what forced the strip to synthesise a back entry, which is what kept
    # breaking the bar's own back button.
    gui_tab_back(CONSOLE_SELECT)
    default quest_tab_mode = "taken"
    offers_mode = quest_tab_mode == "offers"
    gui_activate_console("offers" if offers_mode else "quest")

    ship_id = sbs.get_ship_of_client(client_id)
    if offers_mode:
        items = quest_offers_tab_items(client_id, ship_id, CONSOLE_SELECT)
        empty_desc = "Select a quest from the list."
    else:
        items = quest_tab_items(client_id, ship_id)
        empty_desc = "Select a quest from the list."
    sel_desc = empty_desc
    # Selection persists across a gate-driven repaint (below) so the panel doesn't
    # jump when a station-specific job flips the controls.
    default quest_sel_index = -1
    # ...and so does the VIEW. Keeping the selection was never enough on its own: a
    # repaint builds a different listbox that starts at the top, so a job selected
    # below the fold came back held but invisible, and the row you clicked moved out
    # from under the cursor. `reveal` keeps it on screen, `hint` keeps it in the same
    # slot. This log is rebuilt from four places (a gate flip, any quest changing
    # state anywhere, Accept, Abandon), and three of those the player did not ask
    # for -- so the view moving is least expected exactly when it moved most.
    default quest_sel_hint = None

    # Quest list (left) + narrative (right) + accept/abandon controls.
    gui_section(style="area: 0,45px, 38,100; background:#1572;")
    list_title = quest_offers_title if offers_mode else quest_log_title
    qbox = gui_list_box(items, "item-gap:0.1em;", item_template=quest_log_template, title_template=list_title, select=True, collapsible=True, reveal=True, hint=quest_sel_hint)
    # An explicit selection beats the hint's, which is what makes this order safe:
    # the hint restores the VIEW, this line restores the SELECTION.
    #
    # `is not None` as well as >= 0: get_selected_index() returns None when nothing
    # is selected (a list that lost its selected job), and `None >= 0` raises.
    if quest_sel_index is not None and quest_sel_index >= 0:
        qbox.set_selected_index(quest_sel_index, False)

    sel = qbox.get_value()
    if sel is not None and not gui_list_box_is_header(sel):
        sel_desc = sel.get("desc")
    elif sel is not None:
        # A selected ARC is a quest too - it has its own description - but it renders as
        # a header, so the pane used to keep saying "Select a quest from the list".
        # quest_log_parent_summary returns its description plus a step checklist, and ""
        # for a bare Game/You/Ship group header, which really has nothing to show.
        sel_desc = quest_log_parent_summary(sel)
        if sel_desc == "":
            sel_desc = empty_desc

    gui_section(style="area: 38,45px, 100,90; background:#1572;")
    qdesc = gui_text_area("{sel_desc}", style="tag:q-desc;padding:10px,15px,10px,15px;")

    # Which controls THIS console may show for the selected job (per-quest override ->
    # mission default). The signature repaints the tab once when a selection changes
    # what this console can do (see the on-change below), so buttons<->text stay correct.
    gate = quest_tab_controls_gate(CONSOLE_SELECT, sel, QUEST_ACCEPT_CONSOLES, QUEST_ENGAGE_ENABLED, QUEST_ENGAGE_CONSOLES)
    gate_sig = gate.get("sig")

    on change qbox.get_value():
        sel = qbox.get_value()
        quest_sel_index = qbox.get_selected_index()
        if sel is not None and not gui_list_box_is_header(sel):
            sel_desc = sel.get("desc")
            qdesc.value = sel_desc
        elif sel is not None:
            sel_desc = quest_log_parent_summary(sel)
            if sel_desc == "":
                sel_desc = empty_desc
            qdesc.value = sel_desc
        if quest_tab_controls_gate(CONSOLE_SELECT, sel, QUEST_ACCEPT_CONSOLES, QUEST_ENGAGE_ENABLED, QUEST_ENGAGE_CONSOLES).get("sig") != gate_sig:
            # Taken from THIS widget, before the jump. It holds the view and will
            # never present again once the page is rebuilt, so there is nothing to
            # read it from afterwards.
            quest_sel_hint = qbox.get_selection_hint()
            jump repaint

    # Repaint when any displayed quest changes state (added / revealed / accepted /
    # completed / failed) from ANYWHERE - a kill, a timer, or another console - so the
    # list and buttons never go stale. On Offers, also when an offer provider says its
    # answer moved (a sortie posted, a station's work changing).
    on change quest_offers_tab_sig(client_id, ship_id, offers_mode):
        # The repaint the player did NOT ask for, so the view moving is most
        # jarring here. qbox is still the live widget and has presented, so its
        # hint is the current view even though no selection changed.
        quest_sel_hint = qbox.get_selection_hint()
        jump repaint

    gui_section(style="area: 38,90, 100,100;")
    gui_row("row-height: 2em;")
    if gate.get("show_engage"):
        # Travel to the selected job's destination. Mission-agnostic: emit the intent with
        # the quest's owner + key; the mission (e.g. Open Universe //signal/quest_engage)
        # resolves the on_reach target and performs the actual jump.
        on gui_message(gui_button("Engage")):
            qsel = qbox.get_value()
            if qsel is not None and not gui_list_box_is_header(qsel):
                signal_emit("quest_engage", {"QE_SHIP": ship_id, "QE_AGENT": qsel.get("agent_id"), "QE_KEY": qsel.get("key")})
    if gate.get("show_accept"):
        on gui_message(gui_button("Accept")):
            # client_id rides along for an offer that is not a quest yet (a sortie is
            # assigned to the pilot at this console).
            quest_tab_accept(qbox.get_value(), client_id)
            # Captured here rather than reused from the last selection change: the
            # player may have scrolled since, and the hint carries the SCROLL, not
            # just the selection.
            quest_sel_hint = qbox.get_selection_hint()
            jump repaint
    if gate.get("show_abandon"):
        on gui_message(gui_button("Abandon")):
            quest_tab_abandon(qbox.get_value())
            quest_sel_hint = qbox.get_selection_hint()
            jump repaint
    if gate.get("hint") != "":
        gui_text(f"$text:{gate.get('hint')};justify:left;font:gui-1;color:#bbb")

    await gui()
