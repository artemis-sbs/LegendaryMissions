default CONSOLE_SELECT = "" # Make sure variable exist at startup

# The shared LIBRARY tab. It renders every registered lore source merged into one book,
# a chapter per contributor - LM's own helpfile, Open Universe's codex, a mission's own
# lore - instead of each shipping a near-identical tab over the same renderer. The Codex
# was that duplicate: same document_screen, different hard-coded filename.
#
# NOTHING is registered here. `lore_register` (in the lm_lore addon, in universe_core,
# or in a mission) is what makes this tab exist, so a mission that loads this addon for
# the RENDERER and the quest log does not inherit anybody's fiction - and gets no empty
# Library either.

# THIS ADDON'S OWN TILE. An app is registered by the addon that has its screen, so a
# mission that does not load this addon never hears about it. They were all registered
# by `consoles`, which made every mission without this addon log `no //gui/app route`
# for it - and a logged error fails a headless test run.
gui_app_register("library", title="Library", icon="epadd.library", group="Mission",
                 sort=80, description="Codex, lore and ship records", boarding=True)

//gui/app/library
    document_root = lore_document("Library")
    document = document_flatten(document_root)
    document_type = "Library"
    document_topic = CONSOLE_SELECT.lower()
    document_back_tab = CONSOLE_SELECT

    jump document_screen
