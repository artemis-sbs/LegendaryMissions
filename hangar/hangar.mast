
shared hangar_version = 1
shared call_signs = hangar_get_call_signs()
shared next_call_sign = 0
# HANGAR_QUEST_DOC is provided by the quests addon. Default it here so the Flight
# Hangar console works even when quests is not loaded (the sortie board is then
# simply hidden) - the hangar addon no longer hard-depends on quests.
default shared HANGAR_QUEST_DOC = None

#
#  Background task to look for strays
#
# HANGAR_AUTO_MANAGE gates hangar's AMBIENT behavior that fires just from loading the addon:
# the find_stray_crafts background sweep and the //spawn routes that auto-populate player ships
# and friendly stations with craft. Defaults True so real missions are unchanged; a harness that
# only wants the hangar API (e.g. a conformance test range) sets it False to avoid those global
# spawns + perpetual tasks piling up across many rapidly-cycled scenarios.
default shared HANGAR_AUTO_MANAGE = True
shared find_stray = task_schedule(find_stray_crafts) if HANGAR_AUTO_MANAGE else None
default HANGAR_CONSOLE_ENABLED = True
# Just make sure the data loads
hangar_get_craft_data("terran")
#
# The route_spawn label is the entry point 
# it examines the SPAWNED_ID to either
# jump to another label proper for that item
# or END which stops running this task/flow 
#
//spawn if has_role(SPAWNED_ID, "__player__") and HANGAR_AUTO_MANAGE
    #
    # For now put on a fighter on the player ship
    #
    # If you want it on based on grid objects,
    # wait to be sure grid objects are one the 
    # ship
    # await delay_sim(2)
    #
---- wait_for_game_started ---
    #if not GAME_STARTED:
    await delay_sim(1)
    #    jump wait_for_game_started

    #
    # Player ships can be removed ate start
    #
    ->END if to_object(SPAWNED_ID) is None

    shuttle_count = grid_count_grid_data(SPAWNED.art_id, "shuttle", 0)
    fighter_count = grid_count_grid_data(SPAWNED.art_id, "fighter", 0)
    if fighter_count == 0:
        fighter_count = shuttle_count

    set_inventory_value(SPAWNED_ID, "MAX_SHUTTLE", shuttle_count)
    set_inventory_value(SPAWNED_ID, "MAX_FIGHTER", fighter_count)

    for x in range(0,fighter_count):
        hangar_random_craft_spawn(SPAWNED_ID, "fighter")

    for x in range(0,shuttle_count):
        hangar_random_craft_spawn(SPAWNED_ID, "shuttle")


//spawn if has_role(SPAWNED_ID, "station") and HANGAR_AUTO_MANAGE
    # Defensive craft go on stations FRIENDLY TO THE PLAYERS - not a hardcoded side.
    # Fire for any station, wait a tick so player sides exist (also the old "hope player
    # fighters spawn first" hack), then gate on friendliness. The friendly check lives in the
    # BODY, not the //spawn condition: is_allied_to_players iterates role("__player__"), so at
    # spawn-dispatch time (before players are up) a condition-side check would always be False.
    await delay_sim(1)
    ->END if to_object(SPAWNED_ID) is None
    ->END if not is_allied_to_players(SPAWNED_ID, "station")

    shuttle_count = grid_count_grid_data(SPAWNED.art_id, "shuttle", 0)
    fighter_count = grid_count_grid_data(SPAWNED.art_id, "fighter", 0)
    set_inventory_value(SPAWNED_ID, "MAX_SHUTTLE", shuttle_count)
    set_inventory_value(SPAWNED_ID, "MAX_FIGHTER", fighter_count)

    am = max(1,random.randint(0,fighter_count+shuttle_count))
    for x in range(0,am):
        hangar_random_craft_spawn(SPAWNED_ID)

    #for x in range(0,shuttle_count):
    #    hangar_shuttle_spawn(SPAWNED_ID, "tsn")



@console/hangar !0 ^50 "Flight Hangar" if HANGAR_CONSOLE_ENABLED
    " Fly fighter- shuttle and cargo missions
    jump show_hangar # This could be replaced with a new command gui_navigate("//console/hangar")

=== show_hangar ==
    # This is need for black hole, need to clear any ship assigned
    _original =  sbs.get_ship_of_client(client_id)
    side = "tsn"
    if _original:
        _obj = to_object(_original)
        if _obj is not None:
            side = _obj.side

    sbs.assign_client_to_ship(client_id, 0)

    # Hand back the comms role the cockpit borrowed (launch_to_cockpit). Only if THIS
    # is what granted it: a client that was already a comms console before it walked
    # into the hangar keeps what it came with.
    if get_inventory_value(client_id, "hangar_gave_comms", False):
        remove_role(client_id, "comms")
        set_inventory_value(client_id, "hangar_gave_comms", False)

    call_sign = get_inventory_value(client_id, "call_sign", None)
    if call_sign is None:
        call_sign = call_signs[next_call_sign]
        next_call_sign = (next_call_sign +1) % len(call_signs)
        set_inventory_value(client_id, "call_sign", call_sign)

    #
    # Get all the available rides 
    #

    crafts =[]
    docks = to_object_list(has_link("hangar_craft"))

    # Selections persist across the await gui() / jump show_hangar loop as IDs,
    # never as objects: a held Object is never re-validated (to_object is a no-op
    # on an Agent), so a craft or home dock destroyed while this screen is open
    # would leave a dead engine pointer. Resolve the ids to live objects for this
    # rebuild; to_space_object returns None when the object is gone, so a stale
    # selection self-clears in the "not in docks/crafts" checks below.
    default ride_choice_id = None
    default dock_choice_id = None
    ride_choice = to_space_object(ride_choice_id)
    dock_choice = to_space_object(dock_choice_id)


    #
    # Clear selections if they don't exist
    #
    if len(docks)>0:
        if dock_choice not in docks:
            dock_choice = docks[0]
            ride_choice = None
        crafts = hangar_get_crafts_at(dock_choice)

    if len(crafts)>0:
        # NOTE the `else: ride_choice = None` that used to live here cleared the
        # selection whenever it was VALID - inverted, and a large part of why craft
        # selection had "no consistent pattern" on re-entry: every rebuild dropped a
        # good selection and the next one re-derived a different default.
        if ride_choice not in crafts:
            # Nothing valid selected. Prefer the craft this client last FLEW (the rule
            # chosen for PRM-28), so coming back from a sortie re-selects what you were
            # in; fall back to the first in the list when it is gone - destroyed, or now
            # at another dock. Picking a craft by hand still wins, because that sets
            # ride_choice and this branch only runs when there is nothing valid.
            last_flown = to_space_object(get_inventory_value(client_id, "hangar_last_flown", None))
            if last_flown is not None and last_flown in crafts:
                ride_choice = last_flown
            else:
                ride_choice = crafts[0]
    

    # Persist the (possibly reset) selection back as ids for the next rebuild.
    ride_choice_id = to_id(ride_choice)
    dock_choice_id = to_id(dock_choice)

    gui_section(style="area: 0,0, 41,60;x-background: #fff1;")

    call_sign = get_inventory_value(client_id, "call_sign", "Selene")
    gui_section(style="area: 20px,6,40,6+40px;")
    gui_input("desc:Call sign", var="call_sign")
    on change call_sign:
        set_inventory_value(client_id, "call_sign", call_sign)

    gui_section(style="area: 20px,6+50px, 40, 60;")
    
    # reveal keeps a restored selection ON SCREEN; hint keeps it in the same SLOT.
    # This page is a loop -- await gui() falls through to `jump show_hangar` -- so
    # every interaction rebuilds all three lists, and without the hint each one
    # snaps back to its first screenful.
    #
    # set_value() below is enough to arm the reveal: it is armed in the listbox
    # CONSTRUCTOR, and a rebuild is a new listbox, so the restore only has to
    # happen before the first present. (set_selected_index re-arms it for a later
    # selection change on an already-presented widget; that is a different case.)
    default hangar_hints = None
    dock_picker = gui_list_box(docks,"background:#1572;padding:0,0,10px,0;", item_template=hangar_console_dock_template, title_template=hangar_console_dock_title_template, select=True, reveal=True, hint=hangar_hint(hangar_hints, "dock"))
    ride_picker = gui_list_box(crafts,"background:#1572;", item_template=hangar_console_ship_template, title_template=hangar_console_title_template, select=True, reveal=True, hint=hangar_hint(hangar_hints, "ride"))
    # Restore selection
    if dock_choice is not None:
        dock_picker.set_value(dock_choice)
        sbs.assign_client_to_ship(client_id, to_id(dock_choice))
    if ride_choice is not None:
        ride_picker.set_value(ride_choice)
        
    # ride_picker.title_background = "#1578"
    
    gui_activate_console("hangar")
    gui_tab_enable_top()

    # No gui_tab_back: an app has no Back of its own. The PADD's strip supplies
    # one Back to the tab you came from, and the status area goes home.
    # Live Air Wing roster as a top tab next to the hangar (see //gui/tab/airwing).
    gui_tab_enable("airwing")

    # Both bands start at 45px, the top strip every console in
    # consoles/layout_widgets.mast leaves for the tab bar. This view used to start at 0
    # and bled into it - and an engine widget is painted by the engine over MAST content,
    # so the tabs on this half of the screen were under the radar.
    #
    # The zoom control belongs to the view it zooms: a 45px band directly above it,
    # spanning the same width, which is what the cockpit (show_cockpit) and the standard
    # consoles do. Its own section, because an engine widget covers anything sharing its
    # row. Without it this was the one 2D view on the console you could not zoom, so you
    # picked a craft with no lay of the land (LM #603).
    gui_section(style="area: 41+1em,45px, 100,90px;")
    gui_layout_widget("radar_zoom_ctrl")

    gui_section(style="area: 41+1em,90px, 100,60;")
    gui_layout_widget("2dview")

    # Sortie board (quests addon only): the quest LIST and its briefing share one
    # full-width band below the 2D view. Guarded by HANGAR_QUEST_DOC so the hangar
    # console still works when the quests addon is not loaded.
    cockpit_type = None
    quest_choice = None
    quest_brief = "Select a sortie order"
    quest_box = None
    quest_brief_area = None
    if HANGAR_QUEST_DOC is not None:
        cockpit_type = hangar_cockpit_type(ride_choice)
        gui_section(style="area: 20px,60, 50,100-90px;background: #1572;")
        quest_box = gui_list_box(hangar_quest_items(HANGAR_QUEST_DOC, cockpit_type), "padding:0,0,10px,0;", item_template=hangar_quest_template, title_template=hangar_quest_title_template, select=True, reveal=True, hint=hangar_hint(hangar_hints, "quest"))

        gui_section(style="area: 50,60, 100,100-90px;background: #1572;")
        quest_brief_area = gui_text_area("{quest_brief}", style="tag:quest-brief;padding: 10px,15px,10px,15px;")
        on change quest_box.get_value():
            sel = quest_box.get_value()
            if sel is not None:
                quest_choice = sel.get("key")
                quest_brief = sel.get("desc")
                quest_brief_area.value = quest_brief

    fighter_change = 0
    ship_change_count = 0
    on change ride_picker.get_value() or ship_change_count:
        ride_choice = ride_picker.get_value()
        ride_choice_id = to_id(ride_choice)
        if ride_choice is not None:
            fighter = to_id(to_object(ride_choice))
            dock = get_science_selection(fighter)
            dock = to_object(dock)
            fighter_change += 1
    
            if dock is not None:
                sbs.assign_client_to_ship(client_id, dock.id)

            # Cockpit type can change (fighter <-> shuttle); refresh the board.
            if HANGAR_QUEST_DOC is not None:
                cockpit_type = hangar_cockpit_type(ride_choice)
                quest_box.items = hangar_quest_items(HANGAR_QUEST_DOC, cockpit_type)
                quest_choice = None
                quest_brief = "Select a sortie order"
                quest_brief_area.value = quest_brief

            stats = hangar_get_stats(client_id, fighter)
            gui_update("stats-1", "$text: {stats[0]}")
            gui_update("stats-2", "$text: {stats[1]}")


    
    on change dock_picker.get_value():
        dock_choice = dock_picker.get_value()
        dock_choice_id = to_id(dock_choice)
        if dock_choice is not None:
            crafts = hangar_get_crafts_at(dock_choice)
            ride_picker.items = crafts
            # set twice to make sure it catches a changes
            sbs.assign_client_to_ship(client_id, to_id(dock_choice))
            ride_picker.set_selected_index(0)
            ship_change_count += 1


    


    gui_section(style="area: 75,100-80px, 100,100-50px;background: #002;")
    

    # Set a counter to allow timed refresh
    # elegant or pure hack
    start_counter(client_id, "refresh_status")
    update_ticker = get_counter_elapsed_seconds(client_id, "refresh_status")+1

    if ride_choice is not None:
        if is_timer_finished(ride_choice, "refit"):
            gui_text("ready to launch", style="tag:refit-text")
        else:
            refit_time = format_time_remaining(ride_choice, "refit")
            gui_text("$text: refit - launch in {refit_time}", style="tag:refit-text")
    else:
        gui_text("select ship", style="tag:refit-text")

    on change update_ticker < get_counter_elapsed_seconds(client_id, "refresh_status"):
        fighter_change += 1
        update_ticker = get_counter_elapsed_seconds(client_id, "refresh_status")+1

    on change fighter_change:
        gui_update("refit-text", "$text: select ship")
        fighter = to_space_object(ride_choice_id)
        if fighter is not None:
            if is_timer_finished(fighter, "refit"):
                gui_update("refit-text", "$text: ready to launch")
            else:
                refit_time = format_time_remaining(fighter, "refit")
                gui_update("refit-text", "$text: refit - launch in {refit_time}")



    # If a thing launches or docks things need to refresh
    on change hangar_version:
        # A rebuild the player did not ask for -- somebody else launched or docked.
        # Least expected place for the view to move, so most worth carrying.
        hangar_hints = hangar_hints_capture(dock_picker, ride_picker, quest_box)
        jump show_hangar

    gui_section(style="area: 0,100-90px, 35,100;")
    # The text waterfall is gone (LOG_PANEL_PLAN.md) - it could not be styled from script.
    # gui_log_tail() is the same traffic in a text area this console owns.
    gui_log_tail()
    #
    # Fighter stats
    #
    gui_section(style="area: 35,100-50px, 75,100;")
    stats = hangar_get_stats(client_id, ride_choice)

    if stats is not None:
        gui_text(f"{stats[0]}", style="tag:stats-1")
        gui_row()
        gui_text(f"{stats[1]}", style="tag:stats-2")
    else:
        gui_text(f"", style="tag:stats-1")
        gui_row()
        gui_text(f"", style="tag:stats-2")
        


    gui_section(style="area: 75,100-50px, 100,100;")
    on gui_message(gui_button("Launch")):
        # Capture the selection BEFORE deciding anything. This page is a rebuild loop, so
        # any path back to show_hangar without hints resets all three lists to their first
        # screenful. The button's own bail-out captured, but launch_to_cockpit refuses in
        # three more places (no ride, not in standby, hangar_launch_craft says no) and
        # captured in none of them - so pressing Launch on a craft still in REFIT silently
        # moved the player's selection. Capturing here covers every route out.
        hangar_hints = hangar_hints_capture(dock_picker, ride_picker, quest_box)
        ride_select = to_space_object(ride_choice_id)
        if ride_select is not None:
            old_ship_id = sbs.get_ship_of_client(client_id)
            unlink(old_ship_id, "consoles", client_id)
            link(ride_select , "consoles", client_id)
            if quest_choice is not None and HANGAR_QUEST_DOC is not None:
                hangar_assign_quest(to_id(ride_select), HANGAR_QUEST_DOC, cockpit_type, quest_choice)
            jump launch_to_cockpit
        jump show_hangar



    #dock_picker.set_selected_index(0)
    
    await gui()
    #    + "Head to Bar":
    #        print("Bar")
    #        jump bar_enter
    #    + "Casino":
    #        print("Casino")
    #        #jump show_hangar
    #    + "Quarters":
    #        print("Quarters")
    #        #jump show_hangar


    # The loop rebuild, reached after any interaction that no handler consumed.
    # Captured HERE and not before await gui(): a listbox has no view until it has
    # presented -- its `sections` do not exist until then -- so a hint taken at
    # build time would carry nothing and quietly do nothing.
    hangar_hints = hangar_hints_capture(dock_picker, ride_picker, quest_box)
    jump show_hangar


# Air Wing roster as a hangar top tab (the alternate to the cockpit info-panel
# page). Reuses the same live roster data/template as the end screen.
//gui/app/airwing
    jump show_airwing

=== show_airwing ==
    gui_activate_console("hangar")
    gui_tab_enable_top()
    # No gui_tab_back: an app has no Back of its own. The PADD's strip supplies
    # one Back to the tab you came from, and the status area goes home.
    gui_tab_enable("airwing")

    gui_section(style="area: 10, 6, 90, 16;")
    """color:white;justify: center; font: gui-6;$text:Air Wing"""

    gui_section(style="area: 10, 16, 90, 90;")
    air_box = gui_list_box(hangar_pilot_items(), "padding:0,0,10px,0;", item_template=hangar_pilot_template, title_template=hangar_pilot_title_template, select=False)

    gui_section(style="area: 10, 90, 90, 98;")
    on gui_message(gui_button("Back to Hangar")):
        jump show_hangar

    # Refresh when craft launch / dock (kills update via inventory each represent).
    on change hangar_version:
        jump show_airwing

    await gui()
    jump show_airwing


==== launch_to_cockpit ======
    # ride_select is set in show_hangar (same task) before falling through here; default
    # it so a fresh entry is a clean None (the next line guards it) and the linter is quiet.
    default ride_select = None
    jump show_hangar if ride_select is None
    jump show_hangar if not has_role(ride_select, "standby")

    jump show_hangar if not hangar_launch_craft(to_id(ride_select), client_id)

    sbs.assign_client_to_ship(client_id,to_id(ride_select))
    # Remember what we flew, so the hangar re-selects it when this client comes back
    # (PRM-28). Stored per CLIENT, not per ship: it is that player's seat that returns.
    set_inventory_value(client_id, "hangar_last_flown", to_id(ride_select))
    set_inventory_value(ride_select, "client_id", client_id)
    set_dedicated_link(client_id, "craft_id", ride_select)
    sbs.send_grid_selection_info(ride_select.id, "", "white", "")

    mission_objective = get_inventory_value(ride_select, "current_objective")
    if mission_objective:
        home_id = get_dedicated_link(ride_select, "home_dock")
        hangar_objective_started(ride_select, home_id, mission_objective)

    # A fighter pilot is their own comms officer. `hail_answer` refuses a press from any
    # console without the `comms` role - deliberately, on the server, where hiding a
    # button cannot be relied on - so a cockpit that shows incoming calls has to hold it
    # or the answers would be drawn and then refused. Remembered rather than assumed:
    # the client may already have been a comms console before it walked into the hangar,
    # and returning must not take a role this never granted.
    set_inventory_value(client_id, "hangar_gave_comms", not has_role(client_id, "comms"))
    add_role(client_id, "comms")

    # Calls are ON for a fresh sortie. The library defaults a console to `off` because
    # on a bridge that is an opt-in: comms turns hails on when the captain wants them,
    # and a call the crew misses is still visible on someone else's screen. A fighter
    # has no someone else - an unticked box there means a pilot who can be called and
    # cannot hear it, and no reason to suspect a checkbox exists. Set at LAUNCH, not in
    # the page, so turning it off mid-flight sticks; the next sortie starts fresh.
    hail_where_set(client_id, "console")

    # Everything above happens ONCE per launch. Everything below is the page, and the
    # page is rebuilt whenever a call arrives - so it is its own label, and re-entering
    # it must never re-fly the craft.
=== show_cockpit ==
    # The craft this seat is flying. NOT sbs.get_ship_of_client: while a hail is placed
    # here the client can be assigned elsewhere, and the indicators would then read some
    # other ship's damage.
    _craft_id = to_id(get_dedicated_link(client_id, "craft_id"))

    # Cockpit layout: a full-screen overlay image with the engine widgets placed
    # explicitly on top (instead of gui_console("cockpit")'s default auto-layout),
    # the same approach the Mining Days mission uses. gui_activate_console marks
    # the console type so the //gui/cockpit info-panel route still fires.
    gui_activate_console("cockpit")

    gui_section(style="area:0,0,100,100;")
    # media_shared, not get_mission_dir_filename: it resolves the mission's own media/ OR
    # the unpacked shared pack, whichever has the art. The hardcoded path here said
    # "media/LegendaryMissions/hangar/..." and broke when 257a00b flattened the source
    # ("art lives once"), leaving IMAGE NOT FOUND with the mission name doubled in it.
    gui_image_stretch(media_shared("hangar/cockpit_overlay"))

    gui_section(style="area: 0,11,100,105;")
    gui_layout_widget("3dview")

    gui_section(style="area: 20,70+45px,37.5,99;")
    gui_layout_widget("2dview")

    gui_section(style="area: 20,70,37.5,70+45px;")
    gui_layout_widget("radar_zoom_ctrl")

    gui_section(style="area: 88,50,100,100;")
    gui_layout_widget("fighter_control")

    # The damage grid rides the forward pane, not the lower left. It is what the pilot
    # LOOKS at while flying - the internal fires, the damcons walking to them - so it
    # belongs in the eye line between the canopy struts, and the seat-level corner it
    # used to occupy is worth more as a place calls arrive (below).
    gui_section(style="area: 54,12,75,48;")
    gui_layout_widget("grid_control")

    gui_section(style="area: 41,69,59.7,90;")
    gui_layout_widget("helm_free_3d")

    # The ship's log, in the upper right where the objective overlay used to hang. An
    # overlay is the ATTENTION layer and must never carry information on its own - it
    # auto-dismisses, keeps no history, and a pilot who joins late never sees it - so a
    # standing read-out like the objective belongs on a durable surface. This is that
    # surface, and the history behind it is the info panel's Log/Ship/Mission tabs.
    #
    # Unfiltered (the default tab), not the Ship stream: the objective is a MISSION line,
    # and a strip that filtered to Ship would hide the very thing this replaced.
    #
    # It updates itself - gui_log_tail registers the widget so new traffic patches it in
    # place - so a line arriving does not need the page rebuilt.
    gui_section(style="area: 65,2,99,16;")
    gui_log_tail(count=5)

    # Register ship_data in the console widget list (no visible HUD slot). The
    # engine only renders a widget that's in the list send_client_widget_list
    # transmits at page creation; the //gui/cockpit info-panel ship_data tab only
    # sends a RECT (send_client_widget_rects), which positions but doesn't
    # register. Without this the tab has nothing to position and never appears.
    gui_update_widgets("ship_data", "")

    # The overhead band, and nothing but the controls. It sits over the canopy's centre
    # panel - the only part of the cockpit art still visible, since the 3D view starts
    # at 11% - and the buttons are CENTRED in it rather than packed to one edge: the
    # blanks either side are flexible columns, so the row stays centred whatever the
    # tether adds or takes away. The system lights used to share this strip and ran
    # into the objective banner; they now live over the right-hand dash.
    gui_section(style="area: 39,1,64,9;")
    gui_row(style="row-height:50px;")
    gui_blank()
    brain = gui_button("icon_index:134;color:#fff", style="col-width:50px;", on_press="hangar_grid_select", data={"sel_role":"computer"}, is_sub_task=True)

    # Grav-tether: one press nose-aim acquires a tetherable object and tethers it
    # (release on a second press); button goes cyan while tethered.
    #
    # Built only when the grav_tether addon is loaded - the press calls ITS
    # `lm_tether_press`, so a cockpit without it must not offer the button at all. A
    # mission that never heard of the tether gets a cockpit with one fewer control and
    # no warning, which is what a SUGGESTED dependency should feel like.
    if LM_HAS_TETHER:
        grav_tether = gui_button("icon_index:54;color:#fff", style="col-width:50px;", on_press="hangar_grav_tether", is_sub_task=True)

        # Reflect the ACTUAL tether state on the button (fires for a press, a warp-snap,
        # or an auto-release): cyan while this fighter is tethered, white when free.
        # .update replaces the whole style, so both props are carried.
        on change grav_tether_involves(sbs.get_ship_of_client(client_id)):
            if grav_tether_involves(sbs.get_ship_of_client(client_id)):
                grav_tether.update("icon_index:54;color:#0ff")
            else:
                grav_tether.update("icon_index:54;color:#fff")

    gui_blank()

    # System state, as lights, on the right-hand dash under the flight controls. Same
    # truth the damage grid shows - a node is `__damaged__` or it is not, drawn in the
    # same theme colors - so the pilot can read the ship without reading the grid, and
    # the two can never say different things.
    #
    # Stops at 87, not 88 where fighter_control begins: an engine widget paints over
    # what sits beside it, and the lights are centred in the box anyway, so the point of
    # gutter is free and removes a known way for the rightmost light to be eaten.
    gui_section(style="area: 61,87,87,99;")
    gui_row(style="row-height:50px;")
    gui_blank()
    system_icons = hangar_system_row(_craft_id, "col-width:50px;")
    gui_blank()
    on change hangar_system_signature(_craft_id):
        # Recolor in place. A pool that appeared or vanished (which cannot happen
        # without changing craft) returns False, and then the page is rebuilt.
        if not hangar_system_row_update(system_icons, _craft_id):
            jump show_cockpit

    # Incoming calls, in the corner the damage grid vacated. This IS the fighter's comms
    # console - there is no second seat and no main screen to send a hail to - so the
    # placement dial is the two states that exist here, Off and On, rather than the
    # bridge's four.
    gui_section(style="area: 0,45,17,95;")
    _hail_ship = viewscreen_home_ship(client_id)
    # Off means OFF here, which it does not on a bridge. `hail_answer` is gated on the
    # console, never on placement, so an unticked cockpit that still drew the queue
    # would let the pilot take a call they cannot read - a state that makes sense with
    # five consoles and none at all with one. Unticked, calls simply queue.
    #
    # The guard is hail_PLACED_here, not hail_SHOWS_here: the latter also asks whether
    # a conversation is open, so it would hide the queue and a call could never be seen
    # arriving.
    if hail_placed_here(client_id):
        # The conversation itself: who is calling and what they said.
        #
        # The portrait is sized HERE. hail_view's default row is 30, and every length
        # in the layout is a percentage of the SCREEN - so on a bridge console's tall
        # centre column that is a portrait, and in this 29-point panel it is taller than
        # the panel itself, which pushed the name, the line and the answers out of the
        # bottom and left the cockpit showing a face and nothing else. 9 leaves room for
        # the rest: ~3 points of heading, then the line and the answer list splitting
        # what is left. 14 of a 50-point panel reads as a portrait at both the
        # resolutions this was checked at; 9 was sized for the 29-point panel it had
        # before the top came up, and left the face a stamp.
        if hail_shows_here(client_id):
            hail_view(_hail_ship, client_id, face_style="row-height: 14;")
        # The queue when nothing is open, the answers when a scene has finished
        # talking. One call; the library owns which of those states applies.
        hail_choice_strip(_hail_ship, client_id, row_style="row-height:1fr;")

    # The dial, in the bottom corner UNDER the calls it governs. Its own section rather
    # than the last row of the one above: the calls are drawn conditionally, so a row
    # after them would ride up to the top of the panel on the (usual) quiet frame where
    # nothing else drew. A section pins it.
    #
    # orientation:BT stacks rows from the BOTTOM edge up, so the dial sits on the floor
    # of the frame rather than at the top of its own band - which is what buys the panel
    # above it the extra height. The band is deliberately taller than the one 30px row
    # in it: the row pins to the bottom whatever the screen size, where a band sized to
    # exactly 30px would only be right on one screen.
    gui_section(style="area: 0,90,17,99;orientation:BT;")
    gui_row(style="row-height:30px;")
    hail_where_checkbox(client_id, "col-width:90px;")

    # A hail arriving is not a press, so nothing would rebuild this page and the call
    # would sit unanswered until the pilot happened to change something else. The
    # revision folds in what waits, what is open and how far through it is.
    on change hail_console_revision(client_id):
        jump show_cockpit

    await gui()

--- hangar_grid_select
    _ship_id = sbs.get_ship_of_client(client_id)
    ->END if _ship_id is None or _ship_id==0
    if sel_role == "clear":
        set_grid_selection(_ship_id,0)
        sbs.send_grid_selection_info(_ship_id, "","", "")


    all_dcs = to_object_list(grid_objects(_ship_id) & role(sel_role))
    if len(all_dcs)==0:
        new_id = 0
    else:
        new_id=  all_dcs[0]

    set_grid_selection(_ship_id,new_id)
    follow_route_select_grid(_ship_id, new_id)


--- hangar_grav_tether
    # Belt and braces: the button is not built without the addon, but a label is a jump
    # target and `lm_tether_press` does not exist to jump to.
    ->END if not LM_HAS_TETHER
    _ship_id = sbs.get_ship_of_client(client_id)
    ->END if _ship_id is None or _ship_id==0
    # The whole interaction lives in the grav_tether addon (lm_tether_press): toggle to
    # release, act at once when the target says what to do, otherwise synthesize the
    # //popup/tether menu on what the nose found. Keeping it there rather than here means
    # the button and the popup cannot drift apart, and the cockpit owns only its console.
    lm_tether_press(_ship_id)
    ->END


//gui/cockpit
    # Info panel in the overlay's top-left panel slot (where Mining Days places
    # ship_data), but using LM's richer info panel so the Air Wing page is kept.
    gui_section(style="area:7,19,28,44;col-width:280px;")
    default tab = 1

    with gui_sub_section("col-width:280px;"):
        gui_row("row-height: 400px;")
        gui_info_panel(tab=tab)
        gui_info_panel_add("message", 83, gui_panel_console_message,None)
        # Live Air Wing roster as a cockpit info-panel page (same roster as the
        # end screen and the hangar Air Wing tab - kills/sorties update live).
        gui_info_panel_add("airwing", 155, hangar_airwing_panel, None)
        # The log's HISTORY, the same three tabs every bridge console carries. The strip
        # in the upper right is the ambient half - the last few lines, at a glance, no
        # interaction; these are the half it cannot be: filtered, scrollable, and still
        # there after the traffic has scrolled past. Ship is the craft's own news
        # (damage, systems, docking), Mission is objectives and quest beats, and Log is
        # everything - so a filter can never hide a line from the pilot.
        gui_info_panel_add("log", 112, gui_panel_log, None, gui_panel_log_tick)
        gui_info_panel_add("ship", 66, gui_panel_log_ship, None, gui_panel_log_tick)
        gui_info_panel_add("mission", 85, gui_panel_log_mission, None, gui_panel_log_tick)
        # gui_row("row-height: 100px;")
        # gui_layout_widget("text_waterfall")



//dock/hangar if has_roles(EVENT.parent_id, "cockpit")

    fighter_so = to_object(EVENT.parent_id)
    ->END if fighter_so is None
    name = fighter_so.name

    # TODO: Failed Mission
    task_schedule(hangar_schedule_mission, {"CRAFT_ID": fighter_so.id}, inherit=False)


    if hangar_attempt_dock_craft(fighter_so.id):
        fighter_client = get_inventory_value(fighter_so.id, "client_id")
        new_home = to_space_object(get_science_selection(fighter_so.id))
        
        if new_home is not None:
            signal_emit("cockpit_dock_success", {"craft_id": fighter_so.id, "home": new_home.id})
            comms_broadcast(0,f"pilot {name} docked at {new_home.name}")

        if fighter_client is not None:
            set_dedicated_link(fighter_client, "craft_id", None)    
            gui_reroute_client(fighter_client, show_hangar)

        

    ->END


# Credit fighter/shuttle kills + damage to the cockpit and its pilot, so the Air
# Wing roster is populated even in missions that don't load the results (consoles)
# addon. Fires only for cockpit attackers; the consoles addon credits bridge ships,
# so the two never double-count.
//damage/killed if not has_role(DAMAGE_SELECTED_ID, "standby")
    # KILLED (not DESTROY): the victim is still registered so its hull reads for
    # tonnage, and the attacker rides the damage event. DESTROY is a lifetime
    # removal (fires for script deletes; victim can be gone -> tonnage 0).
    hangar_credit_kill(DAMAGE_PARENT_ID, DAMAGE_SOURCE_ID, DAMAGE_SELECTED_ID)
    ->END

//damage/object if SETTINGS.get("TRACK_DAMAGE", True) and (has_role(DAMAGE_PARENT_ID, "cockpit") or has_role(DAMAGE_SOURCE_ID, "cockpit"))
    hangar_credit_damage(DAMAGE_PARENT_ID, DAMAGE_SOURCE_ID, EVENT.sub_float)
    ->END


==== find_stray_crafts ====
    await delay_sim(seconds=5) # hack for task_schedule in main



--- find_stray_craft_loop  --
    # TODO: Should this be converted to trigger on a client console change or client disconnect signal instead of a loop?
    await delay_sim(seconds=3) # Run every 23 seconds
    launched_crafts = role("hangar") & players_allied_members() - role("standby")
    for craft in launched_crafts:
        cid = get_inventory_value(craft, "client_id")
        cid_obj = to_object(cid) # Clients are also treated as Agents by MAST
        if cid_obj is None:
            print("Client disconnected")
            # The craft doesn't have a valid client_id inventory value.
            # Therefore we need to handle the situation.
            # Need to re-dock the craft
            # Can't really do anything about the client because we don't know anything about the client
            # TODO: Do we need to assign brains to the craft to return to its parent?
            # For now we'll just re-dock it immediately
            hangar_attempt_dock_craft(craft, None)
            continue
        #
        # check if this is the correct fighter
        #

        #TODO: This could cause issues if alternate tabs are added to cockpit

        c_type = sbs.get_type_of_client(cid)
        continue if craft == get_dedicated_link(cid, "craft_id") and c_type == "cockpit"
        so = to_object(craft)
        continue if so is None

        #TODO: Some people want the crafts to be left and need to be retrieved
        print("Craft console changed returning craft to hanger")

        redocked = hangar_attempt_dock_craft(craft, None)
        #if redocked:
        #    print("redocked")
        #else:
        #    print("redocked FAILED")
            
    jump find_stray_craft_loop


