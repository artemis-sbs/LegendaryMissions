provides hangar
# SOFT. The cockpit's grav-tether button calls `lm_tether_press`, which is that addon's,
# so without it the button would raise at the press - but making that a HARD requirement
# broke every mission that loads the hangar and had never heard of the tether, which is
# most of them (the `sbs create` template included). The button is guarded on
# LM_HAS_TETHER instead: with the addon it is there, without it the cockpit simply has
# one fewer control and nothing says a word.
suggests grav_tether
default shared LM_HAS_TETHER = False

import hangar.py
import hangar_loadout.mast
import hangar.mast
import missions.mast
import hangar_comms.mast
# The bar + casino are a separate, optional addon (sibling casino/ folder). The
# hangar does NOT import it - the loader auto-discovers casino/__init__.mast on
# its own, and the casino self-registers its top tab (gui_tab_add_top) only when
# present. So the hangar runs fine with or without the casino addon. (A hard
# import here would break any mission that ships the hangar but not the casino.)