# director addon
#
# One console ("Director") with two functions sharing the cv_show primitive:
#   * Highlight  (shippable) - show a chosen console for a chosen ship on a chosen
#                              program/stream screen; carousel to auto-cycle.
#                              Great as a streamer "director": one control window.
#   * Screen shots (dev only) - capture buttons that drive the SERVER screen
#                              (client 0 - the only surface gui_screenshot grabs).
#
# See README.md. EXPERIMENTAL: rendering gameplay widgets on a rerouted screen and
# the screenshot grab itself need in-engine verification.

# Enable/disable + optional pin via SETTINGS, like OPERATOR_MODE. The defaults are
# registered here so the addon works without editing settings.yaml; a DIRECTOR block
# in settings.yaml overrides them. Set pin to "" (empty) to skip the pin prompt.
#   DIRECTOR:
#       enable: true
#       pin: "000000"
settings_add_defaults({"DIRECTOR": {"enable": True, "pin": "000000"}})
shared DIRECTOR = settings_get_defaults().get("DIRECTOR", {"enable": True, "pin": "000000"})
shared DIRECTOR_enabled = DIRECTOR.get("enable", True)

# Consoles the panel can show/capture (shared so the panel + its tasks see it).
default shared CV_CONSOLES = ["helm", "weapons", "science", "engineering", "comms", "mainscreen", "cinematic"]

# Auto-follow's ship picker. Named `director_follow` rather than `director` because a
# module's own name becomes a MAST global too, and the addon already has `DIRECTOR`.
import director_follow.py
import panel.mast

# --- shared primitive --------------------------------------------------------
# Show <cv_console> for <cv_ship_id> on whichever client runs this label.
# Entered via gui_reroute_client(target, cv_show, {"cv_ship_id":.., "cv_console":..}).
=== cv_show
    default cv_ship_id = None
    default cv_console = "mainscreen"
    if cv_ship_id is not None:
        assign_client_to_ship(client_id, cv_ship_id)
    gui_console(cv_console)
    # A console is not just its widgets: it is also its TYPE and its ROLE, and
    # this label used to set neither.
    #
    # Anything that narrows an audience -- overlays, announce(), comms targeting --
    # resolves it through any_role(), so a screen with no console role is invisible
    # to all of them and the message is dropped in SILENCE, with nothing logged.
    # A director screen showing helm would miss every overlay a real helm gets,
    # which is exactly wrong for a program feed. show_main_game_screen has always
    # set all three; this now matches it.
    set_inventory_value(client_id, "CONSOLE_TYPE", cv_console)
    # Stale roles first, or a screen that used to be a mainscreen keeps answering
    # as one and receives both. The carousel re-enters this label per cycle, so
    # without this the roles would accumulate.
    for cv_name in gui_get_console_types():
        remove_role(client_id, cv_name)
    add_role(client_id, f"console, {cv_console}")
    await gui()
