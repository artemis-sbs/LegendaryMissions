# Director - the MAIN PAGE. "Play these rundowns."
#
# That sentence is the whole console now. It used to be "play these rundowns on these SCREENS",
# with a picker down the left listing every declared console - and the picker turned out to be
# answering a question nobody had. A console declares itself Program or Preview when it opens;
# that declaration IS its selection, so the list only ever restated what the operator had
# already said, one repaint behind, with an un-tick that could hold a screen back for no reason
# anybody wanted. Send goes to ALL the program screens. There is no wall.
#
# Everything that BUILDS a rundown item lives on the rundown tab. This page authors nothing,
# which is the correction the first version needed: it led with the authoring tools and had
# nowhere to say what should actually go out.
#
# director_play.mast owns playback; director_rundowns.py owns the item model; cv_show (in
# __init__.mast) is still the primitive that puts a console on a screen.

default shared cv_ship_id  = None          # fallback ship when an item has none
default shared cv_console  = "mainscreen"  # fallback console
default shared cv_status   = ""
default shared cv_dwell    = 6             # seconds a screen holds an item before advancing
default shared cv_watch_poll = 2           # seconds between live-refresh checks

# What Send last applied. Read by the player task, which runs server-side and outlives this
# page - so these are shared, not task variables.
default shared cv_rundowns  = None         # list of selected rundown keys
default shared cv_playing   = False
default shared cv_auto      = False        # the auto-director
# A live take from the editor: one item on every program screen, no advancing, until Resume or
# Stop clears it. Without the hold, a six-second dwell would overwrite it on the next tick and
# the button would read as doing nothing.
default shared cv_punch     = None
# Which unit the list picks in. "Rundowns" multi-selects whole rundowns and Send puts them on
# air; "Items" single-selects one item and it goes ON AIR THE MOMENT IT IS PICKED - no Send,
# because a clip launcher that needed a second press would not be one.
default shared cv_pick_mode = "Rundowns"

# ONE-TIME per ENTRY. The camera work is in director_cam_ensure, which EVERY tab calls -
# see director_cam.py for why that is not optional.
=== cv_ui
    director_cam_ensure(client_id)
    my_id = client_id
    jump cv_paint

# THE MAIN PAGE, and the repaint entry point.
#
# TOP-LEVEL (===), not an inline `--- repaint`: the live-refresh watcher reaches this with
# gui_task_jump, which resolves the name against the CONSOLE gui task. An inline label only
# resolves inside its own parent scope and fails with `command 0 not found`. Task variables
# survive the jump either way.
=== cv_paint
    default my_id      = client_id
    default rundown_lb = None

    # Re-seat before painting: staging a shot reassigns this client to whatever it is filming,
    # and every //focus route is gated on the client riding its own cam.
    director_cam_ensure(client_id)

    # Take the OUTGOING selection and view before anything is rebuilt. HERE rather than in the
    # handlers, because the watcher repaint has no handler to hang a save on - the GUI task is
    # parked in `await gui()` when that jump lands. By KEY, not by label: a row's text carries
    # its live item count and its hold, so it changes under a selection that has not moved.
    default run_keys = None
    # WHICH BRANCHES ARE SHUT, off the outgoing widget and before anything is rebuilt. The
    # listbox handles collapse internally, so this is the only place that state can be read.
    director_tree_remember_collapse(rundown_lb, run_keys)
    cv_pick_items = cv_pick_mode == "Items"
    # Only the kind of row THIS mode can select survives the carry-over: a mode change repaints
    # with the outgoing selection in hand, and restoring an item key onto a list with no item
    # rows marks something the operator can neither see nor unmark.
    cv_sel_keys  = director_tree_keep_selectable(director_selected_ids(rundown_lb, run_keys), cv_pick_items)
    cv_hint_runs = director_selection_hint(rundown_lb)

    # THE TREE. Rundowns ALONE while picking rundowns - the items are not the unit of choice
    # there, and sixty of them bury the four names being chosen between. In Items mode the
    # headers turn COLLAPSIBLE instead of selectable - see director_rundown_tree_rows.
    cv_runs   = director_rundown_tree_rows(director_play_on_air_ident(), cv_pick_items)
    run_items = cv_runs[0]
    run_keys  = cv_runs[1]

    # Tabs must be re-enabled on EVERY build: the enable set is read at swap time and then
    # cleared. Never gui_tab_add_top - that adds the tab to every console in the game.
    gui_tab_enable("rundown")
    gui_tab_back(CONSOLE_SELECT)
    if is_dev_build():
        gui_tab_enable("capture")
    gui_activate_console("director")

    # px, not percent: a percent section full of `em` rows is only correct at the resolution it
    # was tuned at. The tab strip owns the top 35px. gui-2 is 24px a line, so 2.4em = 58,
    # 2.2em = 53, 2em = 48.
    cv_ctrl_px = 219                    # send 58 + dwell 58 + on-air 48 + status 48 (+7)

    # ---- header: this director's NAME, and what it is driving ----------------------------
    # gui_text, never a """...""" row - that is a text area and it declines measurement.
    gui_section("area: 2, 40px, 98, 82px;")
    gui_row("row-height: 1.5em; font: gui-3;")
    gui_text("$text:" + gui_text_escape(director_cam_name(client_id)) + ";font:gui-3;color:#8cf;", "col-width: content;")
    cv_screens_w = gui_text("$text:" + gui_text_escape(director_screen_summary()) + ";font:gui-2;color:#9ab;")
    on change director_screen_summary():
        cv_screens_w.update("text:" + gui_text_escape(director_screen_summary()) + ";font:gui-2;color:#9ab;")

    # ---- the rundowns --------------------------------------------------------------------
    # `font:` on the listbox itself - a listbox resolves its own `em` against its own default
    # font. No col-width (that makes a listbox HORIZONTAL) and no `row-height: content` (that
    # raises); a bare number would be percent of SCREEN.
    gui_section(f"area: 2, 88px, 98, 100-{cv_ctrl_px}px;")
    # NO `reveal=`. It fires on every view re-establish, and a re-establish would drag the view
    # back to the selection while the operator was trying to scroll. `hint=` keeps the slot
    # without moving anything.
    cv_run_title = "Rundowns - pick one or more, then Send"
    if cv_pick_items:
        cv_run_title = "Items - picking one puts it ON AIR"
    rundown_lb = gui_list_box(run_items, "row-height: 1.7em; font: gui-2;", title_template=cv_run_title, item_template=director_rundown_row_template, select=True, multi=not cv_pick_items, collapsible=True, hint=cv_hint_runs)
    director_restore_ids(rundown_lb, run_keys, cv_sel_keys)
    on change rundown_lb.value:
        # ITEMS MODE IS A CLIP LAUNCHER: picking is the take.
        #
        # INLINE, WITH NO JUMP. A jump to a label that ends in `await gui()` without building
        # anything swaps the EMPTY pending layout in and the screen goes black; a jump to
        # cv_paint instead rebuilds, which re-fires this handler the moment the selection is
        # restored and loops. Doing the work here leaves the GUI task parked in cv_paint's own
        # `await gui()` - nothing swaps, nothing rebuilds, and the collapse and selection are
        # untouched. Same shape as consoles/common_console_select.mast's ship-select handler.
        #
        # Re-punching the same item is a no-op on air (same ident, so the player does not
        # re-route), which is what makes it safe for this to fire again after a repaint.
        if cv_pick_items:
            cv_take_item = director_tree_selected_item(director_selected_ids(rundown_lb, run_keys))
            if cv_take_item is None:
                shared cv_status = "pick an item"
            elif len(director_program_screens()) == 0:
                shared cv_status = "no program screens - open a client and declare it Program"
            else:
                shared cv_punch = cv_take_item
                shared cv_playing = True
                shared cv_status = "ON AIR " + str(cv_take_item["label"])

    # ---- controls -------------------------------------------------------------------------
    gui_section(f"area: 2, 100-{cv_ctrl_px}px, 98, 100-6px;")

    gui_row("row-height: 2.4em; font: gui-2;")
    sendb = gui_button("Send to Program", "col-width: 210px;")
    stopb = gui_button("Stop", "col-width: 110px;")
    resumeb = gui_button("Resume", "col-width: 120px;")
    refreshb = gui_button("Refresh", "col-width: 130px;")
    gui_text("$text:`Pick`;font:gui-2;", "col-width: content;")
    pick_rb = gui_radio("Rundowns,Items", var="cv_pick_mode", style="col-width: 240px;")
    gui_blank()
    on gui_message(pick_rb):
        # A repaint, deliberately: the two modes are a different LIST - collapsed branches and
        # multi-select against expanded branches and single-select - not a different reading of
        # the same one.
        jump cv_paint
    on gui_message(sendb):
        # get_selected_index() walks unfiltered_items, so a selection index IS an index into
        # the parallel list. Mapping back by LABEL breaks on the first duplicate.
        # A picked ITEM implies its rundown, so Send does the obvious thing in either mode.
        shared cv_rundowns = director_tree_selected_rundowns(director_selected_ids(rundown_lb, run_keys))
        # RELEASE BEFORE FORGETTING. director_play_reset() drops the record of which overlay
        # slots are up, and a card orphaned that way can never be named again - so it clears
        # them first. Send used not to, which is why a stuck lower third outlived Stop.
        director_play_reset()
        shared cv_punch = None
        shared cv_playing = True
        shared cv_status = "sent " + str(len(cv_rundowns)) + " rundowns"
    on gui_message(stopb):
        jump cv_stop
    on gui_message(resumeb):
        # Drop the take and let the rundown have the feed back.
        shared cv_punch = None
        shared cv_status = "resumed"
    on gui_message(refreshb):
        jump cv_paint

    gui_row("row-height: 2.4em; font: gui-2;")
    gui_text("$text:`Dwell (s)`;font:gui-2;", "col-width: content;")
    gui_int_slider("$text:int;low:2;high:30;", "col-width: 220px;", var="cv_dwell")
    # THE CHECKBOX FORM MATTERS. `state:` in the message is dead weight: Checkbox.__init__
    # parses it and then clobbers _value with the constructor argument, and _present emits
    # `state:` twice - the engine takes the first. Assigning `.value` after construction is the
    # only thing that renders a tick.
    autocb = gui_checkbox("text: Auto-director - let the action pick the order;", "col-width: 420px;")
    autocb.value = cv_auto
    gui_blank()
    on gui_message(autocb):
        shared cv_auto = not cv_auto

    # ON AIR, in EVERY build. The player owns this line and rewrites it twice a second, which
    # is exactly why it is not cv_status: the operator's own messages would be wiped half a
    # second after they appeared. gui_text_escape because the text can contain a colon, which
    # is a style-property separator.
    gui_row("row-height: 2.0em; font: gui-2;")
    cv_air_w = gui_text("$text:" + gui_text_escape(director_status_line(cv_air)) + ";font:gui-2;color:#fc8;background:#332;")
    on change cv_air:
        cv_air_w.update("text:" + gui_text_escape(director_status_line(cv_air)) + ";font:gui-2;color:#fc8;background:#332;")

    gui_row("row-height: 2.0em; font: gui-2;")
    cv_status_w = gui_text("$text:" + gui_text_escape(director_status_line(cv_status)) + ";font:gui-2;color:#8f8;background:#243;")
    on change cv_status:
        cv_status_w.update("text:" + gui_text_escape(director_status_line(cv_status)) + ";font:gui-2;color:#8f8;background:#243;")

    # THE WATCHER MUST STAY BELOW THE WIDGETS. StoryPage.on_new_gui() ends every end_on_new_gui
    # sub-task, and it fires from add_tag - on the FIRST TAGGED WIDGET of a build. Scheduled
    # after the widgets, a repaint cancels the previous one a few lines above and this replaces
    # it: one watcher, never a stack. Above the header text it would be killed the instant it
    # was created.
    gui_sub_task_schedule(cv_watch_task)
    await gui()

# THERE IS NO `cv_take_selected` AND NO `cv_paint_wait`, deliberately - the take is inline in
# the listbox handler above. Both labels existed here and both were wrong:
#
#   `cv_take_selected` ended in `jump cv_paint`, and the rebuild restored the selection, which
#   re-fired the handler, which came straight back - a repaint loop under the operator's hands.
#   `cv_paint_wait` was the attempt to fix that by parking instead, and `await gui()` in a label
#   that BUILDS NOTHING swaps the empty pending layout in: the screen went black until the next
#   repaint, and in the two failure branches nothing ever repainted it.
#
# A handler that only changes STATE needs no label and no jump at all. See README.md.

# Stop playback and hand every screen back to the engine's own camera. A separate label because
# the same thing has to happen from a button and from a torn-down console.
=== cv_stop
    shared cv_playing = False
    shared cv_punch = None
    # A director screen has no bridge to go back to - it IS a screen. So Stop releases the
    # camera and sends it back to its own holding page, program or preview.
    cv_stop_n = 0
    for scr in director_program_screens() + director_preview_screens():
        director_play_release(scr)
        gui_reroute_client(scr, cv_screen_home)
        cv_stop_n = cv_stop_n + 1
    director_play_reset()
    shared cv_status = "stopped - " + str(cv_stop_n) + " screens released"
    jump cv_paint

# LIVE REFRESH, AND IT DOES TWO DIFFERENT THINGS - which is the point.
#
#   SHAPE CHANGED (a console declared a mode, disconnected, was renamed) -> REPAINT. The list
#   has different rows in it, so it has to be rebuilt.
#   ON AIR CHANGED (the feed advanced, or an item was taken) -> RECOLOR IN PLACE. Only a colour
#   moved, and a repaint to move a colour is what cost a black frame, a repaint loop, the
#   operator's collapse and their scroll position.
#
# Folding the on-air ident into the repaint fingerprint - which is what this did - made every
# advance of the feed a full rebuild of the page. It is a `gui_update` per changed row instead.
#
# The fingerprint still ignores what each screen is SHOWING: the player rewrites a program
# screen's CONSOLE_TYPE every time it changes item, so watching that would repaint several times
# a dwell. "Refresh" covers the residual case.
#
# POLLED FAST (0.25s), because recolouring is a handful of gui_update calls rather than a page
# rebuild - so the green can follow the feed closely without any of the cost that made the old
# 2-second poll a compromise. cv_watch_poll still paces the repaint check.
=== cv_watch_task
    cv_watch_fp = director_mode_fingerprint()
    cv_watch_air = director_play_on_air_ident()
    cv_watch_age = 0.0
--- cv_watch_loop
    await delay_app(0.25)

    cv_air_now = director_play_on_air_ident()
    if cv_air_now != cv_watch_air:
        cv_watch_air = cv_air_now
        director_tree_recolor(cv_air_now)

    cv_watch_age = cv_watch_age + 0.25
    if cv_watch_age >= cv_watch_poll:
        cv_watch_age = 0.0
        cv_watch_now = director_mode_fingerprint()
        if cv_watch_now != cv_watch_fp:
            cv_watch_fp = cv_watch_now
            # A STRING, and a TOP-LEVEL label - see the note on cv_paint.
            gui_task_jump("cv_paint")
    jump cv_watch_loop
