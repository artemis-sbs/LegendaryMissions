# Director - the RUNDOWN EDITOR. Everything that makes an item lives here.
#
# Stage and Camera used to be two tabs. They are one thing: pick a subject, choose a shot, tick
# the overlays, add it - or put it on air now. Splitting them meant the rundown you were adding
# to was never on screen while you worked, which is the whole reason this page exists.
#
# The shot modes are the BRIDGE vocabulary - viewscreen.SHOT_LABELS, the science and weapons
# "On Screen" list - so a Director shot and a bridge shot of the same ship are the same shot.
# Framing comes from the subject's own hull radius (viewscreen_framing), not from a slider.
#
# THERE IS NO "SEND TO PREVIEW" BUTTON. Every control here restages as it is touched, so every
# console in Preview mode is already showing what is being built - a button to push it would
# only be a way to forget. That is why the handlers below call director_stage_* and do NOT
# repaint: a rebuild would throw away whatever is half-typed in the next box.

default shared cv_sub = "Stage"          # which sub-tab is showing
default shared cv_edit_mode = ""         # "" | new | rename - the rundown row morphs
default shared cv_new_name = ""
default shared cv_target_label = ""
default shared cv_preset_name = ""       # what Save calls the preset it writes
default shared cv_preset_kind = ""       # which row's Save was pressed

# What the 2D view last picked, and how it is framed. The bench in director_shots.py is the
# real state - these two mirror it because a widget `var=` and an `on change` both need a MAST
# name to watch.
default shared cv_subject_id = None
default shared cv_shot_mode_label = "Orbit"
default shared cv_hold = 0               # seconds this item holds on air; 0 = use the dwell
default shared cv_distance = 0           # explicit lens distance in units; 0 = automatic
# Which item row is selected, remembered ACROSS the recall repaint - it is both what the
# rebuild restores and what stops the restore re-firing the recall. None = nothing picked.
default shared cv_item_index = None

//gui/tab/rundown
    jump cv_edit

=== cv_edit
    # RE-SEAT. Staging reassigns this client to whatever it is filming, and the //focus routes
    # are gated on the client riding its own cam. See director_cam.py.
    cv_edit_cam = director_cam_ensure(client_id)

    gui_tab_enable("rundown")
    gui_tab_back(CONSOLE_SELECT)
    if is_dev_build():
        gui_tab_enable("capture")
    # EXPLICITLY on every sub-tab: pending_console resets to "" after each build, so omitting
    # the call does NOT revert the name - the previous one stays in force. `sci` in the name is
    # what makes consoledispatcher route a 2D click to the science selection.
    if cv_sub == "Stage":
        gui_activate_console("gamemaster_director_sci")
    else:
        gui_activate_console("director")

    cv_user = director_rundown_user_keys()
    cv_user_labels = cv_user[1]
    cv_item_rows = director_shot_item_rows(cv_target_rundown)
    cv_item_labels = cv_item_rows[0]

    # ---- sub-tab strip -------------------------------------------------------------------
    # gui_radio: comma-separated TEXT labels, engine-drawn active state. gui_tabbed_panel is
    # icon-only and cannot label these.
    gui_section(director_area("subtab"))
    gui_row(director_row_control("gui-3"))
    sub_rb = gui_radio("Stage,Console", var="cv_sub")
    gui_blank()
    on gui_message(sub_rb):
        jump cv_edit

    # ---- left: the rundown and its items --------------------------------------------------
    gui_section(director_area("rundown"))
    gui_row(director_row_control())
    if cv_edit_mode == "":
        gui_text("$text:`Rundown`;font:gui-2;", director_col("content"))
        target_dd = gui_drop_down("$text:{cv_target_label};list: " + ",".join(cv_user_labels) + ";", director_col("200px"))
        gui_blank()
        on gui_message(target_dd):
            shared cv_target_label = target_dd.value
            shared cv_target_rundown = director_rundown_key_for(cv_target_label)
            jump cv_edit
        gui_row(director_row_control())
        newb = gui_button("New", director_col("90px"))
        renameb = gui_button("Rename", director_col("110px"))
        delb = gui_button("Delete", director_col("110px"))
        gui_blank()
        on gui_message(newb):
            shared cv_new_name = ""
            shared cv_edit_mode = "new"
            jump cv_edit
        on gui_message(renameb):
            shared cv_new_name = cv_target_label
            shared cv_edit_mode = "rename"
            jump cv_edit
        on gui_message(delb):
            director_rundown_delete(cv_target_rundown)
            shared cv_target_rundown = None
            shared cv_target_label = ""
            jump cv_edit
    else:
        # THE ROW MORPHS rather than growing a second one - the item list keeps the column
        # either way, because that is the list actually worked in.
        name_in = gui_input("desc: rundown name;", director_col("200px"), var="cv_new_name")
        gui_blank()
        gui_row(director_row_control())
        saveb = gui_button("Save", director_col("100px"))
        cancelb = gui_button("Cancel", director_col("110px"))
        gui_blank()
        on gui_message(saveb):
            jump cv_edit_save
        on gui_message(cancelb):
            shared cv_edit_mode = ""
            jump cv_edit

    gui_section(director_area("items"))
    item_lb = gui_list_box(cv_item_labels, "row-height: 1.7em; font: gui-2;", title_template="Items", select=True, reveal=True)
    # RESTORE THE SELECTION the recall repaint carried in. False so it does not drag the view
    # back to the top - the operator is working in this list.
    if cv_item_index is not None:
        item_lb.set_selected_index(cv_item_index, False)
    # PICKING AN ITEM RECALLS IT onto the bench, so an existing beat is something you can edit
    # rather than a dead end. A repaint is unavoidable here - the bind picker, the mode radio,
    # the hold and distance sliders, the kind listbox and every field box change in value AND in
    # shape, which no `.update()` can express.
    #
    # THE GUARD IS THE POINT. The rebuild restores the selection three lines above, which
    # re-fires this handler; without the comparison that is a repaint loop under the operator's
    # hands, which this page has grown twice before (see panel.mast on cv_take_selected). Acting
    # only when the selection has MOVED terminates it: the restored index equals the remembered
    # one, so the second firing does nothing.
    on change item_lb.value:
        if item_lb.get_selected_index() != cv_item_index:
            shared cv_item_index = item_lb.get_selected_index()
            jump cv_edit_recall

    gui_section(director_area("itembtn"))
    gui_row(director_row_control())
    upb = gui_button("Up", director_col("80px"))
    downb = gui_button("Down", director_col("100px"))
    remb = gui_button("Remove", director_col("130px"))
    # REPLACE IS THE OTHER HALF OF RECALL. Add appends - which is what you want when you are
    # duplicating a beat and changing it - and this is what you want when you are FIXING one.
    # Stage only: the Console tab builds several items per press, so there is no single item for
    # a Replace to mean.
    if cv_sub == "Stage":
        repb = gui_button("Replace", director_col("130px"))
        on gui_message(repb):
            jump cv_edit_replace
    gui_blank()
    on gui_message(upb):
        director_rundown_item_move(cv_target_rundown, item_lb.get_selected_index(), -1)
        jump cv_edit
    on gui_message(downb):
        director_rundown_item_move(cv_target_rundown, item_lb.get_selected_index(), 1)
        jump cv_edit
    on gui_message(remb):
        director_rundown_item_remove(cv_target_rundown, item_lb.get_selected_index())
        # The row under the one just removed takes its index, so the remembered index would
        # recall a DIFFERENT beat on the next repaint. Forget it instead.
        shared cv_item_index = None
        jump cv_edit

    # ---- right: the tool ------------------------------------------------------------------
    if cv_sub == "Stage":
        jump cv_edit_stage
    jump cv_edit_console


# The rundown row committed. Separate label because Save has two meanings and neither belongs
# inline in a handler.
=== cv_edit_save
    if cv_edit_mode == "rename":
        director_rundown_rename(cv_target_rundown, cv_new_name)
        shared cv_target_label = cv_new_name
    else:
        shared cv_target_rundown = director_rundown_new(cv_new_name)
        shared cv_target_label = cv_new_name
    shared cv_edit_mode = ""
    shared cv_status = "rundown " + str(cv_new_name)
    jump cv_edit


# ---- STAGE: pick a subject, choose a shot, write the overlays, add or take -------------------
#
# THE 3D PREVIEW PANE IS GONE. It was a scaled approximation - overlays drawn into their own
# small slot set, at the wrong size, in an approximate rectangle - and every real Preview
# screen shows the actual thing, live, at full size. Losing it gave the whole width back to the
# overlay rows, which is what makes a template box wide enough to read.
=== cv_edit_stage
    # Comms and science will not OPEN on an object this side has no scan data for, so a first
    # click on a never-scanned contact would do nothing. //enable/science fills that in per
    # click; this pass covers what is already on screen when the editor opens.
    #
    # any_role, NOT role: role() is a single dict lookup and does not split on commas, so
    # role("__npc__,__player__") looks for a collection of that literal name, finds nothing,
    # and the loop never runs at all.
    for _st_id in any_role("__npc__,__player__"):
        science_update_scan_data(cv_edit_cam, _st_id, "Director")

    # EACH ENGINE WIDGET IN ITS OWN SECTION. Never share a row with MAST controls: the engine
    # draws its widget at its own size over whatever MAST put beside it.
    gui_section(director_area("view2d"))
    gui_row("row-height: 30px;")
    gui_layout_widget("radar_zoom_ctrl")
    gui_row()
    gui_layout_widget("science_2d_view")

    # The science object list, beside the radar. It is the same selection the 2D view drives -
    # this console is named `gamemaster_director_sci`, so consoledispatcher routes both to the
    # SCIENCE selection - so picking a name off the list stages that object exactly as clicking
    # it on the radar does, and a contact that is hard to hit with a mouse stops being hard.
    gui_section(director_area("scilist"))
    gui_row()
    gui_layout_widget("science_sorted_list")

    gui_section(director_area("ctrl"))

    # THE BIND PICKER IS THE POINT OF THIS ROW NOW. "Fixed" is what every item used to be: the
    # object that was clicked, baked in. The rest bind the subject to the Director's SELECTION,
    # resolved fresh every tick - so one item means "orbit whatever I am pointing at", and one
    # hop further means "chase whatever the selected ship's weapons officer is shooting at".
    # The last entry has no subject at all and makes the item pure furniture: a title, an
    # intro, an outro, a speaker card. See director_bind.py.
    gui_row(director_row_control())
    gui_text("$text:`Subject`;font:gui-2;", director_col("content"))
    cv_subj_w = gui_text("$text:" + gui_text_escape(director_subject_label(cv_subject_id)) + ";font:gui-2;color:#8f8;", director_col("150px"))
    clearb = gui_button("Clear", director_col("80px"))
    bind_dd = gui_drop_down("$text:" + director_stage_bind_label() + ";list: " + director_bind_list() + ";", director_col("260px"))
    mode_rb = gui_radio(director_shot_mode_list(), var="cv_shot_mode_label", style=director_col("330px"))
    on gui_message(clearb):
        jump cv_edit_unstage
    on change cv_subject_id:
        cv_subj_w.update("text:" + gui_text_escape(director_subject_label(cv_subject_id)) + ";font:gui-2;color:#8f8;")
        director_stage_subject(cv_subject_id)
    on gui_message(bind_dd):
        # NO REPAINT. Every control on this page restages live and a rebuild would throw away
        # whatever is half-typed in the next box - and nothing here changes SHAPE, because the
        # mode radio and the subject stay on screen for an overlay-only item. They are simply
        # not part of that item; director_stage_item ignores them.
        director_stage_bind_set_label(bind_dd.value)
    on gui_message(mode_rb):
        director_stage_mode_label(mode_rb.value)

    gui_row(director_row_control())
    addb = gui_button("Add to rundown", director_col("180px"))
    nowb = gui_button("Send to Program", director_col("200px"))
    # THE HOLD IS PART OF THE ITEM, not a setting. An establishing shot of a starbase wants ten
    # seconds where a chase in a firefight wants three, and the rundown is where that belongs -
    # the dwell stays the answer for everything with no opinion. 0 is the bottom stop and means
    # exactly that, which is why the label reads back rather than showing a bare number.
    gui_text("$text:`Hold`;font:gui-2;", director_col("content"))
    hold_sl = gui_int_slider("$text:int;low:0;high:30;", director_col("170px"), var="cv_hold")
    cv_hold_w = gui_text("$text:" + gui_text_escape(director_stage_hold_label()) + ";font:gui-1;color:#9ab;")
    on gui_message(addb):
        jump cv_edit_add
    on gui_message(nowb):
        jump cv_edit_punch
    on gui_message(hold_sl):
        director_stage_hold(hold_sl.value)
        cv_hold_w.update("text:" + gui_text_escape(director_stage_hold_label()) + ";font:gui-1;color:#9ab;")

    # ---- how far away the camera sits -------------------------------------------------------
    #
    # THE AUTOMATIC FRAMING IS STILL THE DEFAULT. The hand-built distance sliders of the first
    # version were deleted because a FIXED distance framed a starbase and a fighter equally
    # badly; this is not those. It is a per-item override, 0 means automatic, and the slider is
    # SEEDED from what the automatic framing would use for whatever is staged - so a fighter
    # starts near 1400 and a starbase near 4800 rather than at a bare 0 whose scale the operator
    # has to discover.
    #
    # THE SLIDER DOES NOT RESTAGE, alone on this page. Re-issuing the shot on every step of a
    # drag is a cut per step. "Dolly to" is what applies it, and seeing the move instead of a
    # cut is the whole reason there is a button.
    gui_row(director_row_control())
    gui_text("$text:`Distance`;font:gui-2;", director_col("content"))
    dist_sl = gui_int_slider("$text:int;low:0;high:20000;", director_col("260px"), var="cv_distance")
    dollyb = gui_button("Dolly to", director_col("130px"))
    autob = gui_button("Auto", director_col("90px"))
    cv_dist_w = gui_text("$text:" + gui_text_escape(director_stage_distance_label()) + ";font:gui-1;color:#9ab;")
    on gui_message(dist_sl):
        director_stage_distance(dist_sl.value)
        cv_dist_w.update("text:" + gui_text_escape(director_stage_distance_label()) + ";font:gui-1;color:#9ab;")
    on gui_message(dollyb):
        director_stage_dolly_to()
        cv_dist_w.update("text:" + gui_text_escape(director_stage_distance_label()) + ";font:gui-1;color:#9ab;")
        shared cv_status = director_stage_summary()
    on gui_message(autob):
        director_stage_distance_auto_set()
        shared cv_distance = director_stage_distance_display()
        dist_sl.value = cv_distance
        cv_dist_w.update("text:" + gui_text_escape(director_stage_distance_label()) + ";font:gui-1;color:#9ab;")

    # ---- the overlays: a KIND PICKER, and ONE field editor ---------------------------------
    #
    # This used to be one hand-unrolled row per overlay kind - four checkboxes, four preset
    # dropdowns, eight text boxes and four Save buttons, eighty lines of MAST. That put the
    # VOCABULARY in the layout: offering `lower_third_portrait` (a speaker card) or `credits`
    # (an intro/outro roll) meant another block here, another entry in two Python tables that
    # had to agree, and another 46px off the 2D view above.
    #
    # The kinds are a table in director_overlays.py now and this reads it. A seventh kind is
    # one line there and nothing at all here.
    #
    # TWO WIDGETS, TWO JOBS, and conflating them was the tempting mistake. The listbox says
    # WHICH overlays this item carries; the dropdown says WHOSE TEXT I am typing. They are
    # different questions - wanting to write the hero card before ticking it is ordinary - and
    # one widget meaning both would jump the boxes on every tick.
    gui_section(director_area("ovkinds"))
    # THE SELECTION IS THE ENABLED SET. multi=True, and an untick is a row LEAVING the
    # selection - there is no event of its own for one, which is why the handler replaces the
    # whole set rather than toggling.
    kind_lb = gui_list_box(director_overlay_kind_labels(), "row-height: 1.7em; font: gui-2;", title_template="Overlays", select=True, multi=True)
    director_restore_items(kind_lb, director_stage_on_labels())
    on change kind_lb.value:
        director_stage_set_kinds(director_selected_items(kind_lb))
        # The summary, not a fixed message: it is the only thing that says two ticked overlays
        # share a slot and one is drawn over the other. Lower third and Speaker both default to
        # the `lower_third` slot, so that is one tick away and looks like an overlay that
        # simply did not appear.
        shared cv_status = director_stage_summary()

    gui_section(director_area("ovedit"))

    # `cv_edit_kind` is read once, here, and used by every row below. Re-asking per row would
    # be the same answer four times and one more place for the two to drift.
    cv_edit_kind = director_stage_edit_kind()

    gui_row(director_row_control())
    gui_text("$text:`Editing`;font:gui-2;", director_col("content"))
    edit_dd = gui_drop_down("$text:" + director_stage_edit_kind_label() + ";list: " + ",".join(director_overlay_kind_labels()) + ";", director_col("150px"))
    preset_dd = gui_drop_down("$text:" + director_stage_preset(cv_edit_kind) + ";list: " + director_overlay_preset_list(cv_edit_kind) + ";", director_col("170px"))
    gui_blank()
    on gui_message(edit_dd):
        # A REPAINT, and this is the ONE place on this page one is right: the field boxes
        # change in NUMBER and in label, which no `.update()` can express. Same carve-out
        # cv_edit_save_preset already has, and the reason every other handler here does not
        # repaint - a rebuild throws away whatever is half-typed in the next box.
        director_stage_edit_set_label(edit_dd.value)
        jump cv_edit

    # ---- the field rows --------------------------------------------------------------------
    #
    # STILL UNROLLED. The kinds are data now, but this is not a loop over them - it is a loop
    # over the FIELDS of one kind, and an `on gui_message` block registered in a loop captures
    # the loop variable at its LAST value, so every box would write the last field. Three rows
    # because three is DIRECTOR_OVERLAY_MAX_FIELDS; the spare ones are hidden, and the section
    # is sized for three so it does not resize under the operator when the kind changes.
    #
    # The boxes take TEMPLATES, not text. `<<name>>` and `<<class>>` resolve against whatever
    # the item is pointed at, which is the only way one item - or a generated rundown of one
    # item per ship - can name each ship. See director_overlays.py for why the delimiter is
    # `<<...>>` and not `{...}`.
    if director_stage_edit_field_name(0) != "":
        gui_row(director_row_control())
        gui_text("$text:" + gui_text_escape(director_stage_edit_field_name(0)) + ";font:gui-2;color:#9ab;", director_col("90px"))
        in_f0 = gui_input("$text:" + gui_text_escape(director_stage_edit_field(0)) + ";desc: " + director_stage_edit_field_name(0) + ";", director_col("420px"))
        gui_blank()
        on gui_message(in_f0):
            director_stage_edit_set_field(0, in_f0.value)

    if director_stage_edit_field_name(1) != "":
        gui_row(director_row_control())
        gui_text("$text:" + gui_text_escape(director_stage_edit_field_name(1)) + ";font:gui-2;color:#9ab;", director_col("90px"))
        in_f1 = gui_input("$text:" + gui_text_escape(director_stage_edit_field(1)) + ";desc: " + director_stage_edit_field_name(1) + ";", director_col("420px"))
        gui_blank()
        on gui_message(in_f1):
            director_stage_edit_set_field(1, in_f1.value)

    if director_stage_edit_field_name(2) != "":
        gui_row(director_row_control())
        gui_text("$text:" + gui_text_escape(director_stage_edit_field_name(2)) + ";font:gui-2;color:#9ab;", director_col("90px"))
        in_f2 = gui_input("$text:" + gui_text_escape(director_stage_edit_field(2)) + ";desc: " + director_stage_edit_field_name(2) + ";", director_col("420px"))
        gui_blank()
        on gui_message(in_f2):
            director_stage_edit_set_field(2, in_f2.value)

    # THE PRESET HANDLER IS DOWN HERE, not beside its dropdown, because it assigns into the
    # field boxes and they do not exist yet up there. Applying a preset REPLACES what is typed,
    # so the boxes have to be told - the bench is the source of truth but the widgets hold
    # their own copy of it until they are.
    on gui_message(preset_dd):
        director_stage_apply_preset(cv_edit_kind, preset_dd.value)
        if director_stage_edit_field_name(0) != "":
            in_f0.value = director_stage_edit_field(0)
        if director_stage_edit_field_name(1) != "":
            in_f1.value = director_stage_edit_field(1)
        if director_stage_edit_field_name(2) != "":
            in_f2.value = director_stage_edit_field(2)

    gui_row(director_row_control())
    gui_text("$text:`Save preset as`;font:gui-2;", director_col("content"))
    gui_input("desc: preset name;", director_col("160px"), var="cv_preset_name")
    saveprb = gui_button("Save", director_col("70px"))
    cv_edit_status_w = gui_text("$text:" + gui_text_escape(director_status_line(cv_status)) + ";font:gui-2;color:#8f8;background:#243;")
    on gui_message(saveprb):
        shared cv_preset_kind = cv_edit_kind
        jump cv_edit_save_preset
    on change cv_status:
        cv_edit_status_w.update("text:" + gui_text_escape(director_status_line(cv_status)) + ";font:gui-2;color:#8f8;background:#243;")

    await gui()


# ---- CONSOLE: a ship and one or more console types -----------------------------------------
# ---- CONSOLE: which stations, for whatever the Stage is pointed at ---------------------------
#
# THE SHIPS LIST IS GONE. It answered a question the Stage's Subject/Bind row already answers,
# and two controls that can both say "which ship" are two controls that can disagree - the same
# duplicate the screen picker and the shot-mode picker were each deleted for. What is left is
# the one thing this tab is uniquely good at: ticking three stations and getting three items
# from one press.
#
# ONE BENCH, TWO VIEWS OF IT. The subject line below is read-only and comes from the same bench
# the Stage writes, so it is obvious what these items are about to be attached to - including
# when that is a BINDING, which is the case worth having: "the selected ship's helm" is one item
# that follows whoever the director clicks.
=== cv_edit_console
    gui_section(director_area("consoles"))
    console_lb = gui_list_box(CV_CONSOLES, "row-height: 1.7em; font: gui-2;", title_template="Consoles", select=True, multi=True, reveal=True)
    director_restore_items(console_lb, director_stage_consoles())
    on change console_lb.value:
        director_stage_consoles(director_selected_items(console_lb))
        shared cv_status = director_status_line(director_stage_console_problem())

    gui_section(director_area("conbtn"))
    gui_row(director_row_control())
    gui_text("$text:`Subject`;font:gui-2;", director_col("content"))
    gui_text("$text:" + gui_text_escape(director_stage_bind_label()) + ";font:gui-2;color:#8f8;", director_col("260px"))
    gui_text("$text:" + gui_text_escape(director_subject_label(director_stage_subject_id())) + ";font:gui-2;color:#9ab;")

    gui_row(director_row_control())
    addconb = gui_button("Add console items", director_col("230px"))
    gui_text("$text:`One item per ticked console, for the Stage's subject.`;font:gui-2;color:#9ab;")
    on gui_message(addconb):
        jump cv_edit_add_con

    gui_row(director_row_control())
    cv_con_status_w = gui_text("$text:" + gui_text_escape(director_status_line(cv_status)) + ";font:gui-2;color:#8f8;background:#243;")
    on change cv_status:
        cv_con_status_w.update("text:" + gui_text_escape(director_status_line(cv_status)) + ";font:gui-2;color:#8f8;background:#243;")

    await gui()


# ---- the actions ---------------------------------------------------------------------------

# Stop staging: drop the subject and let preview screens fall back to the next item up.
# Clearing the subject without this left the card on screen with nothing selected, which is the
# "it does not go away" report.
=== cv_edit_unstage
    shared cv_subject_id = None
    director_stage_subject(clear=True)
    shared cv_status = "cleared"
    jump cv_edit

# Load the picked item back onto the bench, then repaint so every control shows it. Entered
# only from the item list's `on change`, and only when the selection actually moved - see the
# guard there.
=== cv_edit_recall
    cv_recall_rows = director_rundown_items_of(cv_target_rundown)
    if cv_item_index is None or cv_item_index < 0 or cv_item_index >= len(cv_recall_rows):
        jump cv_edit
    cv_recall_item = cv_recall_rows[cv_item_index]
    director_stage_load(cv_recall_item)
    # The widgets bound with `var=` read these, so they have to move with the bench.
    shared cv_shot_mode_label = director_stage_mode_label()
    shared cv_hold = director_stage_hold()
    shared cv_distance = director_stage_distance_display()
    # A console item recalls onto the Console tab, because that is where its station lives.
    if cv_recall_item["kind"] == "con":
        shared cv_sub = "Console"
    shared cv_status = director_stage_load_summary(cv_recall_item)
    jump cv_edit

# Overwrite the picked item with what the bench now describes. The other half of recall: Add
# appends a beat, this one FIXES one.
=== cv_edit_replace
    if cv_target_rundown is None:
        shared cv_status = "make a rundown first"
        jump cv_edit
    if cv_item_index is None:
        shared cv_status = "pick an item to replace"
        jump cv_edit
    cv_rep_item = director_stage_item()
    if cv_rep_item is None:
        shared cv_status = director_stage_summary()
        jump cv_edit
    if director_rundown_item_replace(cv_target_rundown, cv_item_index, cv_rep_item):
        shared cv_status = "replaced with " + str(cv_rep_item["label"])
    else:
        shared cv_status = "that item is gone"
    jump cv_edit

=== cv_edit_add
    if cv_target_rundown is None:
        shared cv_status = "make a rundown first"
        jump cv_edit
    cv_add_item = director_stage_item()
    if cv_add_item is None:
        # THE REASON DEPENDS ON THE BIND, and "click something in the 2D view" is wrong for two
        # of the three modes: a bound item does not want a click, and an overlay-only item has
        # no subject to click. director_stage_summary knows which case this is; it is the only
        # thing that does.
        shared cv_status = director_stage_summary()
        jump cv_edit
    if director_rundown_add_item(cv_target_rundown, cv_add_item):
        shared cv_status = "added " + str(cv_add_item["label"])
    else:
        shared cv_status = "already in that rundown"
    jump cv_edit

# THE TAKE. It has to HOLD: on a six-second dwell an item that did not would be overwritten on
# the next advance and read as a button that does nothing. cv_punch overrides the play set
# entirely until Resume or Stop clears it, and it goes to EVERY program screen.
=== cv_edit_punch
    cv_punch_item = director_stage_item()
    if cv_punch_item is None:
        shared cv_status = director_stage_summary()
        jump cv_edit
    if len(director_program_screens()) == 0:
        shared cv_status = "no program screens - open a client and declare it Program"
        jump cv_edit
    shared cv_punch = cv_punch_item
    shared cv_playing = True
    shared cv_status = "ON AIR " + str(cv_punch_item["label"])
    jump cv_edit

# Save what is typed in one overlay row as a preset, under the name in the Save box. A repaint
# is right here and only here: the row's dropdown has to grow the new entry.
=== cv_edit_save_preset
    cv_saved = director_stage_save_preset(cv_preset_kind, cv_preset_name)
    if cv_saved is None:
        shared cv_status = "type a preset name first"
    else:
        shared cv_status = "saved preset " + str(cv_saved) + " for " + director_overlay_row_label(cv_preset_kind)
    jump cv_edit

=== cv_edit_add_con
    if cv_target_rundown is None:
        shared cv_status = "make a rundown first"
        jump cv_edit
    # REFUSE AT AUTHORING TIME, not just at play time. The play set already skips a console beat
    # that cannot be shown, so nothing breaks without this - but items sitting in the list doing
    # nothing forever are a mystery, and this is the line that explains them.
    cv_con_why = director_stage_console_problem()
    if cv_con_why != "":
        shared cv_status = cv_con_why
        jump cv_edit
    cv_add_n = 0
    for cv_add_it in director_stage_console_items():
        if director_rundown_add_item(cv_target_rundown, cv_add_it):
            cv_add_n = cv_add_n + 1
    shared cv_status = "added " + str(cv_add_n) + " console items"
    jump cv_edit
